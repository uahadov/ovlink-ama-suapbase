[
  {
    "id": "TC001",
    "title": "Register a new user and see verification email sent confirmation",
    "description": "Verifies a new user can submit the registration form and sees a confirmation that a verification email was sent.",
    "category": "User Registration",
    "priority": "High",
    "steps": [
      {
        "type": "action",
        "description": "Navigate to /register"
      },
      {
        "type": "assertion",
        "description": "Verify page title contains \"Register\""
      },
      {
        "type": "action",
        "description": "Type \"newuser+{{timestamp}}@example.com\" into the email field"
      },
      {
        "type": "action",
        "description": "Type \"ValidPass123!\" into the password field"
      },
      {
        "type": "action",
        "description": "Click the \"Register\" button"
      },
      {
        "type": "assertion",
        "description": "Verify text \"verification email sent\" is visible"
      },
      {
        "type": "assertion",
        "description": "Verify element \"Resend verification\" is visible"
      }
    ]
  },
