{
  "name": "url-shortener-plus",
  "version": "1.0.0",
  "description": "Gelişmiş URL kısaltma servisi",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "node --test --test-concurrency=1 test/**/*.test.js",
    "check:syntax": "node --check server.js routes/admin.js public/script.js public/lang.js",
    "check:security": "npm audit --omit=dev",
    "check:release": "npm test && npm run check:syntax && npm run check:security",
    "test:email": "node test-email.js",
    "check:database": "node check-database.js",
    "check:env": "node startup-check.js",
    "check:all": "npm run check:env && npm run check:database",
    "debug": "node --inspect server.js"
  },
  "dependencies": {
    "@node-saml/node-saml": "^5.1.0",
    "@polar-sh/sdk": "^0.49.0",
    "bcrypt": "^6.0.0",
    "compression": "^1.8.1",
    "connect-pg-simple": "^10.0.0",
    "connect-redis": "^9.0.0",
    "dotenv": "^16.4.7",
    "ejs": "^4.0.1",
    "express": "^4.22.1",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^8.2.2",
    "express-session": "^1.18.2",
    "express-validator": "^7.3.1",
    "geoip-lite": "^1.4.10",
    "helmet": "^8.1.0",
    "lusca": "^1.7.0",
    "nodemailer": "^9.0.1",
    "openid-client": "^5.6.5",
    "pg": "^8.21.0",
    "qrcode": "^1.5.4",
    "rate-limit-redis": "^4.2.2",
    "redis": "^5.8.3",
    "resend": "^6.13.0",
    "serverless-http": "^4.0.0",
    "speakeasy": "^2.0.0",
    "tsscmp": "^1.0.6",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@flydotio/dockerfile": "^0.7.10",
    "sqlite3": "^6.0.1"
  }
}
