<!doctype html>
<html lang="<%= (seo && seo.lang) ? seo.lang : 'en' %>">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="csrf-token" content="<%= csrfToken %>">
  <title><%= (seo && seo.title) ? seo.title : 'Ovlink' %></title>
  <meta name="description" content="<%= (seo && seo.description) ? seo.description : '' %>" />
  <meta name="keywords" content="<%= (seo && seo.keywords) ? seo.keywords : '' %>" />
  <meta name="robots" content="noindex,nofollow" />
  <link rel="canonical" href="<%= (seo && seo.canonical) ? seo.canonical : '' %>" />
  <link rel="alternate" hreflang="en" href="<%= (seo && seo.hreflangEn) ? seo.hreflangEn : '' %>" />
  <link rel="alternate" hreflang="az" href="<%= (seo && seo.hreflangAz) ? seo.hreflangAz : '' %>" />
  <link rel="alternate" hreflang="tr" href="<%= (seo && seo.hreflangTr) ? seo.hreflangTr : '' %>" />
  <link rel="alternate" hreflang="x-default" href="<%= (seo && seo.hreflangXDefault) ? seo.hreflangXDefault : '' %>" />
  <link rel="icon" href="/logo.ico" />
  <link rel="manifest" href="/site.webmanifest" />
  <link rel="preconnect" href="https://cdn.jsdelivr.net">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" integrity="sha384-9ndCyUaIbzAi2FUVXJi0CjmCapSmO7SnpJef0486qhLnuZ2cdeRhO02iuK6FUUVM" crossorigin="anonymous" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" integrity="sha384-iw3OoTErCYJJB9mCa8LNS2hbsQ7M3C0EpIsO/H5+EGAkPGc6rk+V8i04oW/K5xq0" crossorigin="anonymous" />
  <link rel="stylesheet" href="/style.css?v=<%= assetVersion %>" />
</head>

<body class="home-page auth-policy-page proceed-page">

  <% if (siteSettings && siteSettings.announcement_enabled === '1' && (siteSettings.announcement_text_az || siteSettings.announcement_text_tr || siteSettings.announcement_text_en)) { %>
    <div id="siteAnnouncement" class="site-announcement" data-az="<%= siteSettings.announcement_text_az || '' %>" data-tr="<%= siteSettings.announcement_text_tr || '' %>" data-en="<%= siteSettings.announcement_text_en || '' %>">
      <div class="container">
        <i class="fa-solid fa-bullhorn"></i>
        <span id="siteAnnouncementText"><%= siteSettings.announcement_text_az || siteSettings.announcement_text_tr || siteSettings.announcement_text_en %></span>
      </div>
    </div>
  <% } %>

  <nav class="navbar navbar-expand-lg navbar-light home-navbar shadow-sm">
    <div class="container">
      <a class="navbar-brand fw-bold d-flex align-items-center" href="/">
        <img src="/logo.webp" alt="Ovlink" class="home-brand-logo" />
      </a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#proceedNavbarContent"
        aria-controls="proceedNavbarContent" aria-expanded="false" aria-label="Menu toggle">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="proceedNavbarContent">
        <ul class="navbar-nav ms-auto align-items-lg-center">
          <li class="nav-item" id="navAuthGuestLogin">
            <a class="nav-link" href="/login"><i class="fa-solid fa-right-to-bracket"></i> <span data-i18n="nav_login">Giriş</span></a>
          </li>
          <li class="nav-item" id="navAuthGuestReg">
            <a class="nav-link" href="/register"><i class="fa-solid fa-user-plus"></i> <span data-i18n="nav_register">Qeydiyyat</span></a>
          </li>
          <li class="nav-item dropdown nav-user-dropdown d-none" id="navAuthUser">
            <a class="nav-link dropdown-toggle position-relative" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
              <i class="fa-solid fa-user-circle me-1"></i>
              <span id="navUserEmail" data-i18n="nav_my_account">Hesabım</span>
              <span id="navNotifBadge" class="notif-badge d-none">0</span>
            </a>
            <ul class="dropdown-menu dropdown-menu-end">
              <li><a class="dropdown-item" href="/dashboard"><i class="fa-solid fa-chart-line me-2"></i><span data-i18n="dashboard_stats_link">Statistika</span></a></li>
              <li><a class="dropdown-item" href="/account"><i class="fa-solid fa-user-gear me-2"></i><span data-i18n="profile_settings_title">Profil Parametrləri</span></a></li>
              <li>
                <a class="dropdown-item d-flex align-items-center justify-content-between" href="/notifications">
                  <span><i class="fa-solid fa-bell me-2"></i><span data-i18n="notif_center_title">Bildiriş Mərkəzi</span></span>
                  <span id="navNotifBadgeMenu" class="notif-menu-badge d-none">0</span>
                </a>
              </li>
              <li><hr class="dropdown-divider" /></li>
              <li><a id="navLogoutBtn" class="dropdown-item" href="#"><i class="fa-solid fa-right-from-bracket me-2"></i><span data-i18n="nav_logout">Çıxış</span></a></li>
            </ul>
          </li>
        </ul>

        <div class="dropdown ms-2 me-2">
          <button id="langToggleBtn" class="btn btn-sm fw-bold dropdown-toggle lang-pill" type="button" data-bs-toggle="dropdown" aria-expanded="false">AZ</button>
          <ul class="dropdown-menu dropdown-menu-end">
            <li><button class="dropdown-item lang-option" data-lang="az" type="button">AZ</button></li>
            <li><button class="dropdown-item lang-option" data-lang="tr" type="button">TR</button></li>
            <li><button class="dropdown-item lang-option" data-lang="en" type="button">EN</button></li>
          </ul>
        </div>

        <button class="theme-toggle home-theme-btn" aria-label="Temayı Değiştir">
          <i class="fa-solid fa-sun"></i>
        </button>
      </div>
    </div>
  </nav>

  <main class="auth-main-shell">
    <section id="hero" class="d-flex align-items-center auth-hero">
      <div class="container">
        <div class="text-center auth-hero-head">
          <div class="badge hero-chip rounded-pill px-3 py-2 mb-4 shadow-sm fw-semibold">
            <i class="fa-solid fa-link me-1"></i><span data-i18n="hero_badge">Ovlink - Next-Gen Link Management</span>
          </div>
          <h1 class="hero-title auth-display-title" data-i18n="password_title">Şifrə tələb olunur</h1>
          <p class="hero-subtitle auth-display-subtitle" data-i18n="password_subtitle">Bu link şifrə ilə qorunur.</p>
        </div>

        <div class="glass-card home-form-card auth-home-card proceed-card">
          <div class="auth-head-icon" aria-hidden="true">
            <i class="fa-solid fa-lock"></i>
          </div>

          <form id="proceedForm" novalidate>
            <div class="mb-3 auth-field">
              <label for="linkPasswordInput" class="form-label" data-i18n="password_input_label">Link Şifrəsi</label>
              <div class="input-group auth-input shadow-sm">
                <span class="input-group-text"><i class="fa-solid fa-key"></i></span>
                <input type="password" class="form-control" id="linkPasswordInput" required data-i18n="password_input_label" placeholder="Link Şifrəsi" autocomplete="current-password">
              </div>
            </div>

            <button type="submit" id="proceedSubmitBtn" class="btn btn-primary btn-lg w-100 rounded-pill py-3 fw-bold shadow-lg home-primary-btn auth-submit-btn">
              <span data-i18n="password_submit_btn">Göndər</span>
            </button>
          </form>

          <p id="proceedMessage" class="text-center small mt-3 mb-0 auth-message"></p>

          <div class="policy-back">
            <a href="/" class="btn home-outline-btn rounded-pill" data-i18n="nav_home">Ana Səhifə</a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <%- include('partials/public-footer', { footerClass: 'site-footer' }) %>

  <script nonce="<%= nonce %>">
    const proceedForm = document.getElementById('proceedForm');
    const proceedInput = document.getElementById('linkPasswordInput');
    const proceedBtn = document.getElementById('proceedSubmitBtn');
    const proceedMsg = document.getElementById('proceedMessage');

    const proceedSetMessage = (text, kind = 'danger') => {
      if (!proceedMsg) return;
      proceedMsg.className = `text-center small mt-3 mb-0 text-${kind}`;
      proceedMsg.textContent = text || '';
    };

    if (proceedForm) {
      proceedForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        const password = (proceedInput && proceedInput.value ? proceedInput.value : '').trim();
        if (!password) {
          proceedSetMessage(pickLang('Şifrəni daxil edin.', 'Şifre girin.', 'Please enter the password.'), 'danger');
          return;
        }

        if (proceedBtn) {
          proceedBtn.disabled = true;
          proceedBtn.textContent = pickLang('Yoxlanılır...', 'Kontrol ediliyor...', 'Checking...');
        }

        try {
          if (!getCsrfToken()) {
            await refreshCsrfToken();
          }
          const res = await postJsonWithCsrf('/verify/<%= shortPath %>', { password, lang: currentLang });
          const data = await res.json().catch(() => ({}));

          if (!res.ok) {
            proceedSetMessage(data.error || pickLang('Şifrə doğrulanmadı.', 'Şifre doğrulanamadı.', 'Password verification failed.'), 'danger');
            return;
          }

          if (data.success && data.redirect) {
            proceedSetMessage(pickLang('Yönləndirilirsiniz...', 'Yönlendiriliyorsunuz...', 'Redirecting...'), 'success');
            window.location.href = data.redirect;
            return;
          }

          proceedSetMessage(pickLang('Yönləndirmə alınmadı.', 'Yönlendirme alınamadı.', 'Redirect could not be started.'), 'danger');
        } catch (err) {
          proceedSetMessage((err && err.message) || pickLang('Xəta baş verdi.', 'Bir hata oluştu.', 'An error occurred.'), 'danger');
        } finally {
          if (proceedBtn) {
            proceedBtn.disabled = false;
            proceedBtn.textContent = pickLang('Göndər', 'Gönder', 'Submit');
          }
        }
      });
    }
  </script>

  <script nonce="<%= nonce %>" src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js" integrity="sha384-geWF76RCwLtnZ8qwWowPQNguL3RmwHVBC9FhGdlKrxdiJJigb/j/68SIy3Te4Bkz" crossorigin="anonymous"></script>
  <script nonce="<%= nonce %>" src="/lang.js?v=<%= assetVersion %>"></script>
  <script nonce="<%= nonce %>" src="/script.js?v=<%= assetVersion %>"></script>
</body>

</html>



