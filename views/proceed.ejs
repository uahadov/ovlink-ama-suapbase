<!doctype html>
<html lang="<%= (seo && seo.lang) ? seo.lang : 'en' %>">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="csrf-token" content="<%= csrfToken %>">
  <title><%= (seo && seo.title) ? seo.title : 'Ovlink' %></title>
  <meta name="description" content="<%= (seo && seo.description) ? seo.description : '' %>" />
  <meta name="keywords" content="<%= (seo && seo.keywords) ? seo.keywords : '' %>" />
  <meta name="robots" content="noindex,nofollow" />
  <link rel="canonical" href="<%= (seo && seo.canonical) ? seo.canonical : '' %>" />
  <link rel="alternate" hreflang="en" href="<%= (seo && seo.hreflangEn) ? seo.hreflangEn : '' %>" />
  <link rel="alternate" hreflang="az" href="<%= (seo && seo.hreflangAz) ? seo.hreflangAz : '' %>" />
  <link rel="alternate" hreflang="tr" href="<%= (seo && seo.hreflangTr) ? seo.hreflangTr : '' %>" />
  <link rel="alternate" hreflang="x-default" href="<%= (seo && seo.hreflangXDefault) ? seo.hreflangXDefault : '' %>" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=<%= assetVersion %>" />
  <link rel="icon" href="/logo.ico" />
  <link rel="manifest" href="/site.webmanifest" />

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

  <link rel="stylesheet" href="/home.css?v=<%= assetVersion %>" />
</head>

<body class="ovx home-page auth-page proceed-page">

  <!-- Skip to content for accessibility -->
  <a href="#mainContent" class="m-skip-link" data-i18n="skip_to_content">Skip to content</a>

  <!-- Ambient background glow -->
  <div id="cursorGlow" aria-hidden="true"></div>

  <% if (siteSettings && siteSettings.announcement_enabled === '1' && (siteSettings.announcement_text_az || siteSettings.announcement_text_tr || siteSettings.announcement_text_en)) { %>
    <div id="siteAnnouncement" class="site-announcement" data-az="<%= siteSettings.announcement_text_az || '' %>" data-tr="<%= siteSettings.announcement_text_tr || '' %>" data-en="<%= siteSettings.announcement_text_en || '' %>">
      <div class="shell">
        <i class="fa-solid fa-bullhorn" aria-hidden="true"></i>
        <span id="siteAnnouncementText"><%= siteSettings.announcement_text_az || siteSettings.announcement_text_tr || siteSettings.announcement_text_en %></span>
      </div>
    </div>
  <% } %>

  <%- include('partials/home-navbar') %>

  <main class="m-auth-shell" id="mainContent">
    <div class="m-auth-container">
      <div class="m-auth-head">
        <div class="m-auth-eyebrow">
          <span data-i18n="hero_badge">Ovlink - Next-Gen Link Management</span>
        </div>
        <h1 class="m-auth-title" data-i18n="password_title">Şifrə tələb olunur</h1>
        <p class="m-auth-sub" data-i18n="password_subtitle">Bu link şifrə ilə qorunur.</p>
      </div>

      <div class="m-auth-card">
        <div class="m-auth-glyph" aria-hidden="true">
          <i class="fa-solid fa-shield-halved"></i>
        </div>

        <form id="proceedForm" novalidate>
          <div class="m-auth-field">
            <label for="linkPasswordInput" class="m-auth-label" data-i18n="password_input_label">Link Şifrəsi</label>
            <div class="m-auth-input-wrap">
              <i class="fa-solid fa-key m-auth-input-icon" aria-hidden="true"></i>
              <input type="password" class="m-auth-input" id="linkPasswordInput" required data-i18n-placeholder="password_input_label" placeholder="Link Şifrəsi" autocomplete="current-password">
            </div>
          </div>

          <button type="submit" id="proceedSubmitBtn" class="m-cta m-cta--white m-auth-submit">
            <span data-i18n="password_submit_btn">Göndər</span> <i class="fa-solid fa-arrow-right ms-2" aria-hidden="true"></i>
          </button>
        </form>

        <p id="proceedMessage" class="m-auth-msg auth-message"></p>

        <div class="m-auth-footer">
          <a href="/" class="m-cta m-cta--outline m-cta--sm m-auth-back-btn">
            <i class="fa-solid fa-house" aria-hidden="true"></i>
            <span data-i18n="nav_home">Ana Səhifə</span>
          </a>
        </div>
      </div>
    </div>
  </main>

  <%- include('partials/home-footer') %>

  <script nonce="<%= nonce %>" src="/lang.js?v=<%= assetVersion %>"></script>
  <script nonce="<%= nonce %>" src="/script.js?v=<%= assetVersion %>"></script>
  <script nonce="<%= nonce %>">
    (function () {
      /* ─── Navbar dropdown & mobile menu ─── */
      function setupDropdown(btnId, panelId) {
        var btn = document.getElementById(btnId);
        var panel = document.getElementById(panelId);
        if (!btn || !panel) return;
        btn.addEventListener('click', function(e) {
          e.stopPropagation();
          var isExpanded = panel.classList.contains('open');
          document.querySelectorAll('.m-lang-panel, .m-user-panel').forEach(function(p) { p.classList.remove('open'); });
          document.querySelectorAll('.m-lang-btn, .m-user-btn').forEach(function(b) { b.setAttribute('aria-expanded', 'false'); });
          if (!isExpanded) {
            panel.classList.add('open');
            btn.setAttribute('aria-expanded', 'true');
          }
        });
      }
      setupDropdown('langToggleBtn', 'ovxLangPanel');
      setupDropdown('langToggleBtnMobile', 'ovxLangPanelMobile');
      setupDropdown('navUserMenuBtn', 'ovxUserPanel');
      document.addEventListener('click', function() {
        document.querySelectorAll('.m-lang-panel, .m-user-panel').forEach(function(p) { p.classList.remove('open'); });
        document.querySelectorAll('.m-lang-btn, .m-user-btn').forEach(function(b) { b.setAttribute('aria-expanded', 'false'); });
      });

      var burger = document.getElementById('mBurger');
      var mobileMenu = document.getElementById('mMobileMenu');
      var mClose = document.getElementById('mMobileClose');
      function closeMobileMenu() {
        if (mobileMenu && mobileMenu.classList.contains('open')) {
          mobileMenu.classList.remove('open');
          document.body.style.overflow = '';
          if (burger) burger.setAttribute('aria-expanded', 'false');
        }
      }
      if (burger && mobileMenu) {
        burger.addEventListener('click', function(){
          mobileMenu.classList.add('open');
          document.body.style.overflow = 'hidden';
          burger.setAttribute('aria-expanded', 'true');
        });
      }
      if (mClose) mClose.addEventListener('click', closeMobileMenu);
      document.addEventListener('keydown', function(e){
        if (e.key === 'Escape') closeMobileMenu();
      });

      /* ─── Button ripple effect ─── */
      document.querySelectorAll('.m-cta, .m-btn-solid').forEach(function(btn) {
        btn.addEventListener('click', function(e) {
          var r = btn.getBoundingClientRect();
          var rip = document.createElement('span');
          rip.className = 'm-ripple';
          rip.style.left = (e.clientX - r.left) + 'px';
          rip.style.top  = (e.clientY - r.top) + 'px';
          btn.appendChild(rip);
          setTimeout(function() { rip.remove(); }, 600);
        });
      });

      /* ─── Ambient Glow Mouse Tracking ─── */
      var glow = document.getElementById('cursorGlow');
      if (glow && window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
        document.addEventListener('mousemove', function(e) {
          glow.style.left = e.clientX + 'px';
          glow.style.top = e.clientY + 'px';
        }, { passive: true });
      }
    })();

    /* ─── Password Gate Form Verification Flow ─── */
    var proceedForm = document.getElementById('proceedForm');
    var proceedInput = document.getElementById('linkPasswordInput');
    var proceedBtn = document.getElementById('proceedSubmitBtn');
    var proceedMsg = document.getElementById('proceedMessage');

    function proceedSetMessage(text, kind) {
      kind = kind || 'danger';
      if (!proceedMsg) return;
      proceedMsg.className = 'm-auth-msg auth-message text-center small text-' + kind;
      proceedMsg.textContent = text || '';
    }

    if (proceedForm) {
      proceedForm.addEventListener('submit', async function (e) {
        e.preventDefault();
        var password = (proceedInput && proceedInput.value ? proceedInput.value : '').trim();
        if (!password) {
          proceedSetMessage(typeof pickLang === 'function' ? pickLang('Şifrəni daxil edin.', 'Şifre girin.', 'Please enter the password.') : 'Şifrəni daxil edin.', 'danger');
          return;
        }

        if (proceedBtn) {
          proceedBtn.disabled = true;
          var checkingText = typeof pickLang === 'function' ? pickLang('Yoxlanılır...', 'Kontrol ediliyor...', 'Checking...') : 'Yoxlanılır...';
          proceedBtn.innerHTML = '<span>' + checkingText + '</span> <i class="fa-solid fa-spinner fa-spin ms-2" aria-hidden="true"></i>';
        }

        try {
          if (typeof getCsrfToken === 'function' && !getCsrfToken()) {
            if (typeof refreshCsrfToken === 'function') await refreshCsrfToken();
          }
          var activeLang = (typeof currentLang !== 'undefined') ? currentLang : 'az';
          var res = await postJsonWithCsrf('/verify/<%= shortPath %>', { password: password, lang: activeLang });
          var data = await res.json().catch(function () { return {}; });

          if (!res.ok) {
            var failText = typeof pickLang === 'function' ? pickLang('Şifrə doğrulanmadı.', 'Şifre doğrulanamadı.', 'Password verification failed.') : 'Şifrə doğrulanmadı.';
            proceedSetMessage(data.error || failText, 'danger');
            return;
          }

          if (data.success && data.redirect) {
            var redirectText = typeof pickLang === 'function' ? pickLang('Yönləndirilirsiniz...', 'Yönlendiriliyorsunuz...', 'Redirecting...') : 'Yönləndirilirsiniz...';
            proceedSetMessage(redirectText, 'success');
            window.location.href = data.redirect;
            return;
          }

          var startFailText = typeof pickLang === 'function' ? pickLang('Yönləndirmə alınmadı.', 'Yönlendirme alınamadı.', 'Redirect could not be started.') : 'Yönləndirmə alınmadı.';
          proceedSetMessage(startFailText, 'danger');
        } catch (err) {
          var errText = typeof pickLang === 'function' ? pickLang('Xəta baş verdi.', 'Bir hata oluştu.', 'An error occurred.') : 'Xəta baş verdi.';
          proceedSetMessage((err && err.message) || errText, 'danger');
        } finally {
          if (proceedBtn) {
            proceedBtn.disabled = false;
            var submitText = typeof pickLang === 'function' ? pickLang('Göndər', 'Gönder', 'Submit') : 'Göndər';
            proceedBtn.innerHTML = '<span data-i18n="password_submit_btn">' + submitText + '</span> <i class="fa-solid fa-arrow-right ms-2" aria-hidden="true"></i>';
          }
        }
      });
    }
  </script>
</body>

</html>



