<!doctype html>
<html lang="<%= (seo && seo.lang) ? seo.lang : 'en' %>">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="csrf-token" content="<%= csrfToken %>">
  <title><%= (seo && seo.title) ? seo.title : 'Ovlink' %></title>
  <meta name="description" content="<%= (seo && seo.description) ? seo.description : '' %>" />
  <meta name="keywords" content="<%= (seo && seo.keywords) ? seo.keywords : '' %>" />
  <meta name="robots" content="noindex,nofollow" />
  <link rel="canonical" href="<%= (seo && seo.canonical) ? seo.canonical : '' %>" />
  <link rel="alternate" hreflang="en" href="<%= (seo && seo.hreflangEn) ? seo.hreflangEn : '' %>" />
  <link rel="alternate" hreflang="az" href="<%= (seo && seo.hreflangAz) ? seo.hreflangAz : '' %>" />
  <link rel="alternate" hreflang="tr" href="<%= (seo && seo.hreflangTr) ? seo.hreflangTr : '' %>" />
  <link rel="alternate" hreflang="x-default" href="<%= (seo && seo.hreflangXDefault) ? seo.hreflangXDefault : '' %>" />
  <link rel="icon" href="/logo.ico" />
  <link rel="manifest" href="/site.webmanifest" />
  <link rel="preconnect" href="https://cdn.jsdelivr.net">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
  <link rel="stylesheet" href="/style.css?v=<%= assetVersion %>" />
</head>

<body class="home-page auth-policy-page proceed-page">

  <% if (siteSettings && siteSettings.announcement_enabled === '1' && (siteSettings.announcement_text_az || siteSettings.announcement_text_tr || siteSettings.announcement_text_en)) { %>
    <div id="siteAnnouncement" class="site-announcement" data-az="<%= siteSettings.announcement_text_az || '' %>" data-tr="<%= siteSettings.announcement_text_tr || '' %>" data-en="<%= siteSettings.announcement_text_en || '' %>">
      <div class="container">
        <i class="fa-solid fa-bullhorn"></i>
        <span id="siteAnnouncementText"><%= siteSettings.announcement_text_az || siteSettings.announcement_text_tr || siteSettings.announcement_text_en %></span>
      </div>
    </div>
  <% } %>

  <%- include('partials/public-navbar') %>

  <main class="auth-main-shell">
    <section id="hero" class="d-flex align-items-center auth-hero">
      <div class="container">
        <div class="text-center auth-hero-head">
          <div class="badge hero-chip rounded-pill px-3 py-2 mb-4 shadow-sm fw-semibold">
            <i class="fa-solid fa-link me-1"></i><span data-i18n="hero_badge">Ovlink - Next-Gen Link Management</span>
          </div>
          <h1 class="hero-title auth-display-title" data-i18n="password_title">Şifrə tələb olunur</h1>
          <p class="hero-subtitle auth-display-subtitle" data-i18n="password_subtitle">Bu link şifrə ilə qorunur.</p>
        </div>

        <div class="glass-card home-form-card auth-home-card proceed-card">
          <div class="auth-head-icon" aria-hidden="true">
            <i class="fa-solid fa-lock"></i>
          </div>

          <form id="proceedForm" novalidate>
            <div class="mb-3 auth-field">
              <label for="linkPasswordInput" class="form-label" data-i18n="password_input_label">Link Şifrəsi</label>
              <div class="input-group auth-input shadow-sm">
                <span class="input-group-text"><i class="fa-solid fa-key"></i></span>
                <input type="password" class="form-control" id="linkPasswordInput" required data-i18n-placeholder="password_input_label" placeholder="Link Şifrəsi" autocomplete="current-password">
              </div>
            </div>

            <button type="submit" id="proceedSubmitBtn" class="btn btn-primary btn-lg w-100 rounded-pill py-3 fw-bold shadow-lg home-primary-btn auth-submit-btn">
              <span data-i18n="password_submit_btn">Göndər</span>
            </button>
          </form>

          <p id="proceedMessage" class="text-center small mt-3 mb-0 auth-message"></p>

          <div class="policy-back">
            <a href="/" class="btn home-outline-btn rounded-pill" data-i18n="nav_home">Ana Səhifə</a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <%- include('partials/public-footer', { footerClass: 'site-footer' }) %>

  <script nonce="<%= nonce %>">
    const proceedForm = document.getElementById('proceedForm');
    const proceedInput = document.getElementById('linkPasswordInput');
    const proceedBtn = document.getElementById('proceedSubmitBtn');
    const proceedMsg = document.getElementById('proceedMessage');

    const proceedSetMessage = (text, kind = 'danger') => {
      if (!proceedMsg) return;
      proceedMsg.className = `text-center small mt-3 mb-0 text-${kind}`;
      proceedMsg.textContent = text || '';
    };

    if (proceedForm) {
      proceedForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        const password = (proceedInput && proceedInput.value ? proceedInput.value : '').trim();
        if (!password) {
          proceedSetMessage(pickLang('Şifrəni daxil edin.', 'Şifre girin.', 'Please enter the password.'), 'danger');
          return;
        }

        if (proceedBtn) {
          proceedBtn.disabled = true;
          proceedBtn.textContent = pickLang('Yoxlanılır...', 'Kontrol ediliyor...', 'Checking...');
        }

        try {
          if (!getCsrfToken()) {
            await refreshCsrfToken();
          }
          const res = await postJsonWithCsrf('/verify/<%= shortPath %>', { password, lang: currentLang });
          const data = await res.json().catch(() => ({}));

          if (!res.ok) {
            proceedSetMessage(data.error || pickLang('Şifrə doğrulanmadı.', 'Şifre doğrulanamadı.', 'Password verification failed.'), 'danger');
            return;
          }

          if (data.success && data.redirect) {
            proceedSetMessage(pickLang('Yönləndirilirsiniz...', 'Yönlendiriliyorsunuz...', 'Redirecting...'), 'success');
            window.location.href = data.redirect;
            return;
          }

          proceedSetMessage(pickLang('Yönləndirmə alınmadı.', 'Yönlendirme alınamadı.', 'Redirect could not be started.'), 'danger');
        } catch (err) {
          proceedSetMessage((err && err.message) || pickLang('Xəta baş verdi.', 'Bir hata oluştu.', 'An error occurred.'), 'danger');
        } finally {
          if (proceedBtn) {
            proceedBtn.disabled = false;
            proceedBtn.textContent = pickLang('Göndər', 'Gönder', 'Submit');
          }
        }
      });
    }
  </script>

  <script nonce="<%= nonce %>" src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script nonce="<%= nonce %>" src="/lang.js?v=<%= assetVersion %>"></script>
  <script nonce="<%= nonce %>" src="/script.js?v=<%= assetVersion %>"></script>
</body>

</html>



