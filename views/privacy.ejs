<!doctype html>
<html lang="<%= (seo && seo.lang) ? seo.lang : 'en' %>">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="csrf-token" content="<%= csrfToken %>">
  <title><%= (seo && seo.title) ? seo.title : 'Ovlink' %></title>
  <link rel="icon" href="/logo.ico" />
  <link rel="manifest" href="/site.webmanifest" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap" media="print" id="gf-css" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" media="print" id="fa-css" />
  <script nonce="<%= nonce %>">
    document.getElementById("gf-css").media = "all";
    document.getElementById("fa-css").media = "all";
  </script>
  <noscript>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
  </noscript>
  
  <link rel="stylesheet" href="/style.css?v=<%= assetVersion %>" />
  <meta name="description" content="<%= (seo && seo.description) ? seo.description : '' %>" />
  <meta name="keywords" content="<%= (seo && seo.keywords) ? seo.keywords : '' %>" />
  <link rel="canonical" href="<%= (seo && seo.canonical) ? seo.canonical : '' %>" />
  <link rel="alternate" hreflang="en" href="<%= (seo && seo.hreflangEn) ? seo.hreflangEn : '' %>" />
  <link rel="alternate" hreflang="az" href="<%= (seo && seo.hreflangAz) ? seo.hreflangAz : '' %>" />
  <link rel="alternate" hreflang="tr" href="<%= (seo && seo.hreflangTr) ? seo.hreflangTr : '' %>" />
  <link rel="alternate" hreflang="x-default" href="<%= (seo && seo.hreflangXDefault) ? seo.hreflangXDefault : '' %>" />
  <meta property="og:title" content="<%= (seo && seo.ogTitle) ? seo.ogTitle : '' %>" />
  <meta property="og:description" content="<%= (seo && seo.ogDescription) ? seo.ogDescription : '' %>" />
  <meta property="og:url" content="<%= (seo && seo.ogUrl) ? seo.ogUrl : '' %>" />
  <meta property="og:type" content="website" />
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content="<%= (seo && seo.twitterTitle) ? seo.twitterTitle : '' %>" />
  <meta name="twitter:description" content="<%= (seo && seo.twitterDescription) ? seo.twitterDescription : '' %>" />
  <% if (seo && seo.jsonLd) { %>
  <script nonce="<%= nonce %>" type="application/ld+json"><%- seo.jsonLd %></script>
  <% } %>
</head>

<body class="home-page policy-page animated-gradient-bg">

  <% if (siteSettings && siteSettings.announcement_enabled === '1' && (siteSettings.announcement_text_az || siteSettings.announcement_text_tr || siteSettings.announcement_text_en)) { %>
    <div id="siteAnnouncement" class="site-announcement" data-az="<%= siteSettings.announcement_text_az || '' %>" data-tr="<%= siteSettings.announcement_text_tr || '' %>" data-en="<%= siteSettings.announcement_text_en || '' %>">
      <div class="container">
        <i class="fa-solid fa-bullhorn"></i>
        <span id="siteAnnouncementText"><%= siteSettings.announcement_text_az || siteSettings.announcement_text_tr || siteSettings.announcement_text_en %></span>
      </div>
    </div>
  <% } %>

  <div id="particlesContainer" class="particles-container"></div>

  <%- include('partials/public-navbar') %>

  <main class="policy-main">
    <section class="container">
      <div class="policy-shell">
        <div class="policy-head">
          <div class="badge hero-chip rounded-pill px-3 py-2 mb-3 shadow-sm fw-semibold">
            <i class="fa-solid fa-link me-1"></i><span data-i18n="hero_badge">Ovlink - Next-Gen Link Management</span>
          </div>
          <h1 class="policy-title" data-i18n="privacy_title">Məxfilik Siyasəti</h1>
        </div>

        <div class="policy-list">
          <article class="policy-card">
            <h3 class="fw-bold"><i class="fa-solid fa-database me-2"></i><span data-i18n="privacy_data_collection_title">Topladığımız məlumatlar</span></h3>
            <p data-i18n="privacy_data_collection_text">Ovlink istifadə edilərkən emal olunan məlumatlar: hesab məlumatları (e-poçt, şifrə hash-i, auth provider, hesab/giriş vaxtları), link məlumatları (hədəf URL, qısa kod, alias, bitmə tarixi, klik limiti, seçilmiş domen, link şifrəsinin hash-i), klik statistikası (klik vaxtı, tam IP ünvanı, brauzer, əməliyyat sistemi, ölkə, şəhər), təhlükəsizlik/sessiya qeydləri (session token, user-agent, cihaz etiketi, country, device fingerprint, IP hash), Pro funksiyalar üçün API açarı meta-məlumatları (ad, prefix, last4, istifadə vaxtı), webhook konfiqurasiyaları (URL, event siyahısı, aktivlik statusu, failure sayğacı) və webhook çatdırılma logları (status, cəhd sayı, HTTP kodu, retry vaxtı), həmçinin şikayət/moderasiya məlumatları.</p>
          </article>

          <article class="policy-card">
            <h3 class="fw-bold"><i class="fa-solid fa-user-shield me-2"></i><span data-i18n="privacy_account_title">Hesab məlumatları</span></h3>
            <p data-i18n="privacy_account_text">Şifrələr açıq mətn kimi saxlanılmır; yalnız hash dəyəri saxlanılır. E-poçt təsdiqi, şifrə bərpası tokenləri və sessiya idarəetməsi hesab təhlükəsizliyi üçün istifadə olunur.</p>
          </article>

          <article class="policy-card">
            <h3 class="fw-bold"><i class="fa-solid fa-chart-line me-2"></i><span data-i18n="privacy_analytics_title">Statistika və təhlükəsizlik</span></h3>
            <p data-i18n="privacy_analytics_text">Məlumatlar xidmət funksionallığı, statistikaların göstərilməsi, sui-istifadənin azaldılması və təhlükəsizlik üçün emal olunur. Redirect consent rejimində istifadəçi 'essential' seçərsə minimal klik qeydi, 'analytics' seçərsə brauzer/OS/ölkə statistikası saxlanılır. İstifadəçi davam etməzsə yönləndirmə və klik qeydiyyatı baş vermir.</p>
          </article>

          <article class="policy-card">
            <h3 class="fw-bold"><i class="fa-solid fa-network-wired me-2"></i><span data-i18n="privacy_ip_handling_title">IP məlumatlarının idarəsi</span></h3>
            <p data-i18n="privacy_ip_handling_text">Sorğu zamanı IP məlumatı geolokasiya və təhlükəsizlik yoxlamaları üçün emal olunur. Yeni cihaz bildiriş e-poçtlarında tam IP göstərilmir və cihaz sessiyalarında tam IP əvəzinə IP hash saxlanılır. Klik qeydlərində isə təhlükəsizlik və analitika məqsədi ilə tam IP ünvanı və şəhər məlumatları saxlanılır.</p>
          </article>

          <article class="policy-card">
            <h3 class="fw-bold"><i class="fa-solid fa-flag me-2"></i><span data-i18n="privacy_moderation_title">Şikayətlər və moderasiya</span></h3>
            <p data-i18n="privacy_moderation_text">İstifadəçilər linkləri şikayət edə bilər. Təhlükəsizlik məqsədi ilə linklər deaktiv edilə, domenlər bloklana və hesablar məhdudlaşdırıla bilər.</p>
          </article>

          <article class="policy-card">
            <h3 class="fw-bold"><i class="fa-solid fa-cookie-bite me-2"></i><span data-i18n="privacy_cookies_title">Kukilər</span></h3>
            <p data-i18n="privacy_cookies_text">Sayt connect.sid (sessiya), ovlink_redirect_consent (redirect razılığı) və lang_default (dil seçimi) cookie-lərindən istifadə edir. localStorage-da tema, dil və cookie banner razılığı (cookieConsent) saxlanıla bilər. Reklam aktiv olduqda reklam iframe-lərində üçüncü tərəf cookie və oxşar identifikator texnologiyaları işləyə bilər.</p>
          </article>

          <article class="policy-card">
            <h3 class="fw-bold"><i class="fa-solid fa-handshake me-2"></i><span data-i18n="privacy_third_party_title">Üçüncü tərəflər</span></h3>
            <p data-i18n="privacy_third_party_text">Xidmət Resend (e-poçt), Google OAuth (qeydiyyat üçün), Telegram (bot inteqrasiyası), CDN kitabxanaları və reklam vendorları (infrastruktur tərəfdaşları) kimi üçüncü tərəflərdən istifadə edir. Telegram botla əlaqələndirmə üçün sizin Telegram ID-niz bazada istifadəçi ID-nizlə əlaqələndirilir.</p>
          </article>

          <article class="policy-card">
            <h3 class="fw-bold"><i class="fa-solid fa-shield-virus me-2"></i><span data-i18n="privacy_disclaimer_title">Təhlükəsizlik bildirişi</span></h3>
            <p data-i18n="privacy_disclaimer_text">Təhlükəsizlik tədbirləri görürük, lakin internet mühitində tam təhlükəsizlik zəmanəti yoxdur.</p>
          </article>

          <article class="policy-card">
            <h3 class="fw-bold"><i class="fa-solid fa-clock-rotate-left me-2"></i><span data-i18n="privacy_retention_title">Saxlama müddəti</span></h3>
            <p data-i18n="privacy_retention_text">Məlumatlar xidmətin işləməsi, təhlükəsizlik, hüquqi öhdəliklər və mübahisələrin həlli üçün zəruri olduğu müddətdə saxlanılır.</p>
          </article>
        </div>

        <div class="policy-back">
          <a href="/" class="btn home-outline-btn rounded-pill" data-i18n="nav_home">Ana Səhifə</a>
        </div>
      </div>
    </section>
  </main>

  <%- include('partials/public-footer', { footerClass: 'site-footer' }) %>

  <script nonce="<%= nonce %>" src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script nonce="<%= nonce %>" src="/lang.js?v=<%= assetVersion %>"></script>
  <script nonce="<%= nonce %>" src="/script.js?v=<%= assetVersion %>"></script>
</body>

</html>



