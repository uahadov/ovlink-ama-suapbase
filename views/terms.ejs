<!doctype html>
<html lang="<%= (seo && seo.lang) ? seo.lang : 'en' %>">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="csrf-token" content="<%= csrfToken %>">
  <title><%= (seo && seo.title) ? seo.title : 'Ovlink — Terms of Service' %></title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=<%= assetVersion %>" />
  <link rel="icon" href="/logo.ico" />
  <link rel="manifest" href="/site.webmanifest" />

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

  <link rel="stylesheet" href="/home.css?v=<%= assetVersion %>" />

  <meta name="description" content="<%= (seo && seo.description) ? seo.description : '' %>" />
  <meta name="keywords" content="<%= (seo && seo.keywords) ? seo.keywords : '' %>" />
  <link rel="canonical" href="<%= (seo && seo.canonical) ? seo.canonical : '' %>" />
  <link rel="alternate" hreflang="en" href="<%= (seo && seo.hreflangEn) ? seo.hreflangEn : '' %>" />
  <link rel="alternate" hreflang="az" href="<%= (seo && seo.hreflangAz) ? seo.hreflangAz : '' %>" />
  <link rel="alternate" hreflang="tr" href="<%= (seo && seo.hreflangTr) ? seo.hreflangTr : '' %>" />
  <link rel="alternate" hreflang="x-default" href="<%= (seo && seo.hreflangXDefault) ? seo.hreflangXDefault : '' %>" />
  <meta property="og:title" content="<%= (seo && seo.ogTitle) ? seo.ogTitle : '' %>" />
  <meta property="og:description" content="<%= (seo && seo.ogDescription) ? seo.ogDescription : '' %>" />
  <meta property="og:url" content="<%= (seo && seo.ogUrl) ? seo.ogUrl : '' %>" />
  <meta property="og:type" content="website" />
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content="<%= (seo && seo.twitterTitle) ? seo.twitterTitle : '' %>" />
  <meta name="twitter:description" content="<%= (seo && seo.twitterDescription) ? seo.twitterDescription : '' %>" />
  <% if (seo && seo.jsonLd) { %>
  <script nonce="<%= nonce %>" type="application/ld+json"><%- seo.jsonLd %></script>
  <% } %>
</head>

<body class="ovx home-page legal-page terms-page">

  <!-- Top reading progress bar -->
  <div id="readingProgress" class="m-reading-progress" aria-hidden="true"></div>

  <!-- Skip to content for accessibility -->
  <a href="#mainContent" class="m-skip-link" data-i18n="skip_to_content">Skip to content</a>

  <!-- Ambient background glow -->
  <div id="cursorGlow" aria-hidden="true"></div>

  <% if (siteSettings && siteSettings.announcement_enabled === '1' && (siteSettings.announcement_text_az || siteSettings.announcement_text_tr || siteSettings.announcement_text_en)) { %>
    <div id="siteAnnouncement" class="site-announcement" data-az="<%= siteSettings.announcement_text_az || '' %>" data-tr="<%= siteSettings.announcement_text_tr || '' %>" data-en="<%= siteSettings.announcement_text_en || '' %>">
      <div class="shell">
        <i class="fa-solid fa-bullhorn"></i>
        <span id="siteAnnouncementText"><%= siteSettings.announcement_text_az || siteSettings.announcement_text_tr || siteSettings.announcement_text_en %></span>
      </div>
    </div>
  <% } %>

  <%- include('partials/home-navbar') %>

  <main class="m-page-shell m-page-shell--top" id="mainContent">
    <div class="shell" style="max-width: 1080px; width: 100%;">

      <!-- Header / Hero Section -->
      <section class="m-content-hero" aria-labelledby="termsPageHeading">
        <div class="m-hero-eyebrow mb-3" style="display:inline-flex; align-items:center; gap:8px; margin-bottom: 18px;">
          <span class="m-live-dot" aria-hidden="true"></span>
          <span data-i18n="hero_badge">Ovlink - Next-Gen Link Management</span>
        </div>
        <h1 id="termsPageHeading" data-i18n="terms_title">İstifadə Şərtləri</h1>
        <p>
          Clear terms and conditions regarding service boundaries, accounts, fair limits, and unacceptable abuse.
        </p>
      </section>

      <!-- 2-Column Legal Shell: Sticky TOC + Content -->
      <div class="m-legal-layout">

        <!-- Left Sticky TOC -->
        <nav class="m-legal-toc" aria-label="Table of Contents">
          <div class="m-legal-toc-title">Mündəricat</div>
          <a href="#sec-intro" class="m-legal-toc-link active" data-i18n="terms_intro_title">Ümumi müddəalar</a>
          <a href="#sec-use" class="m-legal-toc-link" data-i18n="terms_use_title">İstifadə qaydaları</a>
          <a href="#sec-limits" class="m-legal-toc-link" data-i18n="terms_limits_title">Hesab Limitləri</a>
          <a href="#sec-content" class="m-legal-toc-link" data-i18n="terms_content_title">Məzmun məsuliyyəti</a>
          <a href="#sec-suspension" class="m-legal-toc-link" data-i18n="terms_suspension_title">Məhdudiyyət və dayandırma</a>
          <a href="#sec-limit" class="m-legal-toc-link" data-i18n="terms_limit_title">Məsuliyyətin məhdudlaşdırılması</a>
          <a href="#sec-privacy" class="m-legal-toc-link" data-i18n="terms_privacy_title">Məxfilik və məlumatların işlənməsi</a>
          <a href="#sec-contact" class="m-legal-toc-link" data-i18n="terms_contact_title">Əlaqə</a>
        </nav>

        <!-- Right Content Articles -->
        <div class="m-legal-content">

          <!-- Section 1: General Provisions -->
          <article class="m-legal-section" id="sec-intro">
            <div class="m-legal-section-header">
              <i class="fa-solid fa-file-signature" aria-hidden="true"></i>
              <h2 class="m-legal-section-title" data-i18n="terms_intro_title">Ümumi müddəalar</h2>
            </div>
            <p class="m-legal-section-text" data-i18n="terms_intro_text">
              Ovlink URL qısaltma, yönləndirmə və link idarəetmə xidməti təqdim edir. Xidmətdən istifadə etməklə bu şərtləri, Məxfilik Siyasətini və Cookie Siyasətini qəbul etmiş olursunuz.
            </p>
          </article>

          <!-- Section 2: Usage Rules -->
          <article class="m-legal-section" id="sec-use">
            <div class="m-legal-section-header">
              <i class="fa-solid fa-user-check" aria-hidden="true"></i>
              <h2 class="m-legal-section-title" data-i18n="terms_use_title">İstifadə qaydaları</h2>
            </div>
            <p class="m-legal-section-text" data-i18n="terms_use_text">
              Xidmətdən yalnız qanuni və legitim məqsədlərlə istifadə edilməlidir. Phishing, zərərli proqram yayımı, fırıldaqçılıq, spam, saxta yönləndirmə və hüquqa zidd məzmun qadağandır.
            </p>
          </article>

          <!-- Section 3: Account Limits -->
          <article class="m-legal-section" id="sec-limits">
            <div class="m-legal-section-header">
              <i class="fa-solid fa-scale-balanced" aria-hidden="true"></i>
              <h2 class="m-legal-section-title" data-i18n="terms_limits_title">Hesab Limitləri</h2>
            </div>
            <p class="m-legal-section-text" data-i18n="terms_limits_text">
              Qeydiyyatsız (Guest) istifadəçilər gün ərzində maksimum 5 link yarada bilər. Free plan üçün gündəlik 50, ümumi 1000 link; Pro plan üçün gündəlik 500, ümumi 50.000 link limiti var. Sistem resurslarını qorumaq məqsədi ilə API və webhook kimi əlavə xüsusiyyətlər yalnız Pro planda mövcuddur.
            </p>
          </article>

          <!-- Section 4: Content Responsibility -->
          <article class="m-legal-section" id="sec-content">
            <div class="m-legal-section-header">
              <i class="fa-solid fa-shield-heart" aria-hidden="true"></i>
              <h2 class="m-legal-section-title" data-i18n="terms_content_title">Məzmun məsuliyyəti</h2>
            </div>
            <p class="m-legal-section-text" data-i18n="terms_content_text">
              Yaratdığınız qısa linklər, hədəf məzmunun qanuniliyi və paylaşım icazəsi üçün məsuliyyət sizə aiddir. Qaydaları pozan və ya riskli hesab olunan linklər siyasətə uyğun məhdudlaşdırıla, deaktiv edilə və ya silinə bilər.
            </p>
          </article>

          <!-- Section 5: Suspension -->
          <article class="m-legal-section" id="sec-suspension">
            <div class="m-legal-section-header">
              <i class="fa-solid fa-ban" aria-hidden="true"></i>
              <h2 class="m-legal-section-title" data-i18n="terms_suspension_title">Məhdudiyyət və dayandırma</h2>
            </div>
            <p class="m-legal-section-text" data-i18n="terms_suspension_text">
              Sui-istifadə, təhlükəsizlik riski və ya hüquqi tələb hallarında linklər və hesablar müvəqqəti və ya daimi olaraq məhdudlaşdırıla, deaktiv edilə və ya silinə bilər.
            </p>
          </article>

          <!-- Section 6: Limitation of Liability -->
          <article class="m-legal-section" id="sec-limit">
            <div class="m-legal-section-header">
              <i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i>
              <h2 class="m-legal-section-title" data-i18n="terms_limit_title">Məsuliyyətin məhdudlaşdırılması</h2>
            </div>
            <p class="m-legal-section-text" data-i18n="terms_limit_text">
              Xidmət olduğu kimi təqdim olunur. Davamlı əlçatanlıq və ya müəyyən məqsədə tam uyğunluq üzrə zəmanət verilmir; qanunun icazə verdiyi həddə dolayı və nəticəvi zərərlər üzrə məsuliyyət məhdudlaşdırılır.
            </p>
          </article>

          <!-- Section 7: Privacy Reference -->
          <article class="m-legal-section" id="sec-privacy">
            <div class="m-legal-section-header">
              <i class="fa-solid fa-user-shield" aria-hidden="true"></i>
              <h2 class="m-legal-section-title" data-i18n="terms_privacy_title">Məxfilik və məlumatların işlənməsi</h2>
            </div>
            <p class="m-legal-section-text" data-i18n="terms_privacy_text">
              Hesab, link, sessiya və klik statistika məlumatları funksionallıq, təhlükəsizlik, moderasiya və dəstək üçün işlənir. Reklam aktivdirsə reklam vendorlarının cookie/identifikator istifadəsi Məxfilik və Cookie siyasətlərində açıqlanır.
            </p>
          </article>

          <!-- Section 8: Contact -->
          <article class="m-legal-section" id="sec-contact">
            <div class="m-legal-section-header">
              <i class="fa-solid fa-envelope-open-text" aria-hidden="true"></i>
              <h2 class="m-legal-section-title" data-i18n="terms_contact_title">Əlaqə</h2>
            </div>
            <p class="m-legal-section-text" data-i18n="terms_contact_text">
              Suallarınız üçün bizimlə əlaqə saxlayın: support@ovlink.sbs
            </p>
          </article>

        </div>

      </div>

      <!-- Action Navigation Footer -->
      <div style="display: flex; gap: 14px; justify-content: center; align-items: center; flex-wrap: wrap; margin-top: 48px;">
        <a href="/" class="m-cta m-cta--outline" style="padding: 10px 22px; font-size: 13.5px;">
          <i class="fa-solid fa-arrow-left" style="font-size: 11px;" aria-hidden="true"></i>
          <span data-i18n="nav_home">Home</span>
        </a>
        <a href="/privacy" class="m-cta m-cta--white" style="padding: 10px 22px; font-size: 13.5px;">
          <span data-i18n="privacy_title">Məxfilik Siyasəti</span>
          <i class="fa-solid fa-arrow-right" style="font-size: 11px;" aria-hidden="true"></i>
        </a>
        <a href="/cookie-policy" class="m-cta m-cta--outline" style="padding: 10px 22px; font-size: 13.5px;">
          <span data-i18n="cookie_policy_title">Kuki Siyasəti</span>
        </a>
      </div>

    </div>
  </main>

  <%- include('partials/home-footer') %>

  <script nonce="<%= nonce %>" src="/lang.js?v=<%= assetVersion %>"></script>
  <script nonce="<%= nonce %>" src="/script.js?v=<%= assetVersion %>"></script>
  <script nonce="<%= nonce %>">
    (function () {
      /* ─── Reading Progress Bar ─── */
      var progressBar = document.getElementById('readingProgress');
      function updateProgress() {
        if (!progressBar) return;
        var totalHeight = document.documentElement.scrollHeight - window.innerHeight;
        if (totalHeight <= 0) return;
        var progress = (window.scrollY / totalHeight) * 100;
        progressBar.style.width = Math.min(100, Math.max(0, progress)) + '%';
      }
      window.addEventListener('scroll', updateProgress, { passive: true });

      /* ─── ScrollSpy for TOC ─── */
      var tocLinks = document.querySelectorAll('.m-legal-toc-link');
      var sections = document.querySelectorAll('.m-legal-section');
      if (sections.length && tocLinks.length && 'IntersectionObserver' in window) {
        var observer = new IntersectionObserver(function(entries) {
          entries.forEach(function(entry) {
            if (entry.isIntersecting) {
              var id = entry.target.getAttribute('id');
              tocLinks.forEach(function(link) {
                if (link.getAttribute('href') === '#' + id) {
                  link.classList.add('active');
                } else {
                  link.classList.remove('active');
                }
              });
            }
          });
        }, { rootMargin: '-20% 0px -70% 0px' });
        sections.forEach(function(sec) { observer.observe(sec); });
      }

      /* ─── Navbar interactive logic ─── */
      function setupDropdown(btnId, panelId) {
        var btn = document.getElementById(btnId);
        var panel = document.getElementById(panelId);
        if (!btn || !panel) return;
        btn.addEventListener('click', function(e) {
          e.stopPropagation();
          var isExpanded = panel.classList.contains('open');
          document.querySelectorAll('.m-lang-panel, .m-user-panel').forEach(function(p) { p.classList.remove('open'); });
          document.querySelectorAll('.m-lang-btn, .m-user-btn').forEach(function(b) { b.setAttribute('aria-expanded', 'false'); });
          if (!isExpanded) {
            panel.classList.add('open');
            btn.setAttribute('aria-expanded', 'true');
          }
        });
      }
      setupDropdown('langToggleBtn', 'ovxLangPanel');
      setupDropdown('langToggleBtnMobile', 'ovxLangPanelMobile');
      setupDropdown('navUserMenuBtn', 'ovxUserPanel');
      document.addEventListener('click', function() {
        document.querySelectorAll('.m-lang-panel, .m-user-panel').forEach(function(p) { p.classList.remove('open'); });
        document.querySelectorAll('.m-lang-btn, .m-user-btn').forEach(function(b) { b.setAttribute('aria-expanded', 'false'); });
      });

      /* ─── Mobile Menu ─── */
      var burger = document.getElementById('mBurger');
      var mobileMenu = document.getElementById('mMobileMenu');
      var mClose = document.getElementById('mMobileClose');
      function closeMobileMenu() {
        if (mobileMenu && mobileMenu.classList.contains('open')) {
          mobileMenu.classList.remove('open');
          document.body.style.overflow = '';
          if (burger) burger.setAttribute('aria-expanded', 'false');
        }
      }
      if (burger && mobileMenu) {
        burger.addEventListener('click', function(){
          mobileMenu.classList.add('open');
          document.body.style.overflow = 'hidden';
          burger.setAttribute('aria-expanded', 'true');
        });
      }
      if (mClose) mClose.addEventListener('click', closeMobileMenu);
      document.addEventListener('keydown', function(e){
        if (e.key === 'Escape') closeMobileMenu();
      });

      /* ─── Button ripple effect ─── */
      document.querySelectorAll('.m-cta, .m-btn-solid').forEach(function(btn) {
        btn.addEventListener('click', function(e) {
          var r = btn.getBoundingClientRect();
          var size = Math.max(r.width, r.height);
          var span = document.createElement('span');
          span.className = 'm-ripple';
          span.style.width = span.style.height = size + 'px';
          span.style.left  = (e.clientX - r.left  - size / 2) + 'px';
          span.style.top   = (e.clientY - r.top   - size / 2) + 'px';
          btn.appendChild(span);
          setTimeout(function(){ span.remove(); }, 600);
        });
      });
    })();
  </script>
</body>

</html>
