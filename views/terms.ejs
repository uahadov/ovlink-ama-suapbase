<!doctype html>
<html lang="<%= (seo && seo.lang) ? seo.lang : 'en' %>">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="csrf-token" content="<%= csrfToken %>">
  <title><%= (seo && seo.title) ? seo.title : 'Ovlink' %></title>
  <link rel="icon" href="/logo.ico" />
  <link rel="manifest" href="/site.webmanifest" />
  <link rel="preconnect" href="https://cdn.jsdelivr.net">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" integrity="sha384-9ndCyUaIbzAi2FUVXJi0CjmCapSmO7SnpJef0486qhLnuZ2cdeRhO02iuK6FUUVM" crossorigin="anonymous" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" integrity="sha384-iw3OoTErCYJJB9mCa8LNS2hbsQ7M3C0EpIsO/H5+EGAkPGc6rk+V8i04oW/K5xq0" crossorigin="anonymous" />
  <link rel="stylesheet" href="/style.css?v=<%= assetVersion %>" />
  <meta name="description" content="<%= (seo && seo.description) ? seo.description : '' %>" />
  <meta name="keywords" content="<%= (seo && seo.keywords) ? seo.keywords : '' %>" />
  <link rel="canonical" href="<%= (seo && seo.canonical) ? seo.canonical : '' %>" />
  <link rel="alternate" hreflang="en" href="<%= (seo && seo.hreflangEn) ? seo.hreflangEn : '' %>" />
  <link rel="alternate" hreflang="az" href="<%= (seo && seo.hreflangAz) ? seo.hreflangAz : '' %>" />
  <link rel="alternate" hreflang="tr" href="<%= (seo && seo.hreflangTr) ? seo.hreflangTr : '' %>" />
  <link rel="alternate" hreflang="x-default" href="<%= (seo && seo.hreflangXDefault) ? seo.hreflangXDefault : '' %>" />
  <meta property="og:title" content="<%= (seo && seo.ogTitle) ? seo.ogTitle : '' %>" />
  <meta property="og:description" content="<%= (seo && seo.ogDescription) ? seo.ogDescription : '' %>" />
  <meta property="og:url" content="<%= (seo && seo.ogUrl) ? seo.ogUrl : '' %>" />
  <meta property="og:type" content="website" />
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content="<%= (seo && seo.twitterTitle) ? seo.twitterTitle : '' %>" />
  <meta name="twitter:description" content="<%= (seo && seo.twitterDescription) ? seo.twitterDescription : '' %>" />
  <% if (seo && seo.jsonLd) { %>
  <script nonce="<%= nonce %>" type="application/ld+json"><%- seo.jsonLd %></script>
  <% } %>
</head>

<body class="home-page policy-page animated-gradient-bg">

  <% if (siteSettings && siteSettings.announcement_enabled === '1' && (siteSettings.announcement_text_az || siteSettings.announcement_text_tr || siteSettings.announcement_text_en)) { %>
    <div id="siteAnnouncement" class="site-announcement" data-az="<%= siteSettings.announcement_text_az || '' %>" data-tr="<%= siteSettings.announcement_text_tr || '' %>" data-en="<%= siteSettings.announcement_text_en || '' %>">
      <div class="container">
        <i class="fa-solid fa-bullhorn"></i>
        <span id="siteAnnouncementText"><%= siteSettings.announcement_text_az || siteSettings.announcement_text_tr || siteSettings.announcement_text_en %></span>
      </div>
    </div>
  <% } %>

  <div id="particlesContainer" class="particles-container"></div>

  <nav class="navbar navbar-expand-lg navbar-light home-navbar shadow-sm">
    <div class="container">
      <a class="navbar-brand fw-bold d-flex align-items-center" href="/">
        <img src="/logo.webp" alt="Ovlink" class="home-brand-logo" />
      </a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#policyNavbarContent"
        aria-controls="policyNavbarContent" aria-expanded="false" aria-label="Menu toggle">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="policyNavbarContent">
        <ul class="navbar-nav ms-auto align-items-lg-center">
          <li class="nav-item" id="navAuthGuestLogin">
            <a class="nav-link" href="/login"><i class="fa-solid fa-right-to-bracket"></i> <span data-i18n="nav_login">Giriş</span></a>
          </li>
          <li class="nav-item" id="navAuthGuestReg">
            <a class="nav-link" href="/register"><i class="fa-solid fa-user-plus"></i> <span data-i18n="nav_register">Qeydiyyat</span></a>
          </li>
          <li class="nav-item dropdown nav-user-dropdown d-none" id="navAuthUser">
            <a class="nav-link dropdown-toggle position-relative" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
              <i class="fa-solid fa-user-circle me-1"></i>
              <span id="navUserEmail" data-i18n="nav_my_account">Hesabım</span>
              <span id="navNotifBadge" class="notif-badge d-none">0</span>
            </a>
            <ul class="dropdown-menu dropdown-menu-end">
              <li><a class="dropdown-item" href="/dashboard"><i class="fa-solid fa-chart-line me-2"></i><span data-i18n="dashboard_stats_link">Statistika</span></a></li>
              <li><a class="dropdown-item" href="/account"><i class="fa-solid fa-user-gear me-2"></i><span data-i18n="profile_settings_title">Profil Parametrləri</span></a></li>
              <li>
                <a class="dropdown-item d-flex align-items-center justify-content-between" href="/notifications">
                  <span><i class="fa-solid fa-bell me-2"></i><span data-i18n="notif_center_title">Bildiriş Mərkəzi</span></span>
                  <span id="navNotifBadgeMenu" class="notif-menu-badge d-none">0</span>
                </a>
              </li>
              <li><hr class="dropdown-divider" /></li>
              <li><a id="navLogoutBtn" class="dropdown-item" href="#"><i class="fa-solid fa-right-from-bracket me-2"></i><span data-i18n="nav_logout">Çıxış</span></a></li>
            </ul>
          </li>
        </ul>

        <div class="dropdown ms-2 me-2">
          <button id="langToggleBtn" class="btn btn-sm fw-bold dropdown-toggle lang-pill" type="button" data-bs-toggle="dropdown" aria-expanded="false">AZ</button>
          <ul class="dropdown-menu dropdown-menu-end">
            <li><button class="dropdown-item lang-option" data-lang="az" type="button">AZ</button></li>
            <li><button class="dropdown-item lang-option" data-lang="tr" type="button">TR</button></li>
            <li><button class="dropdown-item lang-option" data-lang="en" type="button">EN</button></li>
          </ul>
        </div>

        <button class="theme-toggle home-theme-btn theme-toggle-animated" aria-label="Temayı Değiştir">
          <i class="fa-solid fa-sun"></i>
        </button>
      </div>
    </div>
  </nav>

  <main class="policy-main">
    <section class="container">
      <div class="policy-shell">
        <div class="policy-head">
          <div class="badge hero-chip rounded-pill px-3 py-2 mb-3 shadow-sm fw-semibold">
            <i class="fa-solid fa-link me-1"></i><span data-i18n="hero_badge">Ovlink - Next-Gen Link Management</span>
          </div>
          <h1 class="policy-title" data-i18n="terms_title">İstifadə Şərtləri</h1>
        </div>

        <div class="policy-list">
          <article class="policy-card">
            <h3 class="fw-bold"><i class="fa-solid fa-file-signature me-2"></i><span data-i18n="terms_intro_title">Ümumi müddəalar</span></h3>
            <p data-i18n="terms_intro_text">Ovlink URL qısaltma, yönləndirmə və link idarəetmə xidməti təqdim edir. Xidmətdən istifadə etməklə bu şərtləri, Məxfilik Siyasətini və Cookie Siyasətini qəbul etmiş olursunuz.</p>
          </article>

          <article class="policy-card">
            <h3 class="fw-bold"><i class="fa-solid fa-user-check me-2"></i><span data-i18n="terms_use_title">İstifadə qaydaları</span></h3>
            <p data-i18n="terms_use_text">Xidmətdən yalnız qanuni və legitim məqsədlərlə istifadə edilməlidir. Phishing, zərərli proqram yayımı, fırıldaqçılıq, spam, saxta yönləndirmə və hüquqa zidd məzmun qadağandır.</p>
          </article>

          <article class="policy-card">
            <h3 class="fw-bold"><i class="fa-solid fa-shield-heart me-2"></i><span data-i18n="terms_content_title">Məzmun məsuliyyəti</span></h3>
            <p data-i18n="terms_content_text">Yaratdığınız qısa linklər, hədəf məzmunun qanuniliyi və paylaşım icazəsi üçün məsuliyyət sizə aiddir. Qaydaları pozan və ya riskli hesab olunan linklər siyasətə uyğun məhdudlaşdırıla, deaktiv edilə və ya silinə bilər.</p>
          </article>

          <article class="policy-card">
            <h3 class="fw-bold"><i class="fa-solid fa-ban me-2"></i><span data-i18n="terms_suspension_title">Məhdudiyyət və dayandırma</span></h3>
            <p data-i18n="terms_suspension_text">Sui-istifadə, təhlükəsizlik riski və ya hüquqi tələb hallarında linklər və hesablar müvəqqəti və ya daimi olaraq məhdudlaşdırıla, deaktiv edilə və ya silinə bilər.</p>
          </article>

          <article class="policy-card">
            <h3 class="fw-bold"><i class="fa-solid fa-triangle-exclamation me-2"></i><span data-i18n="terms_limit_title">Məsuliyyətin məhdudlaşdırılması</span></h3>
            <p data-i18n="terms_limit_text">Xidmət olduğu kimi təqdim olunur. Davamlı əlçatanlıq və ya müəyyən məqsədə tam uyğunluq üzrə zəmanət verilmir; qanunun icazə verdiyi həddə dolayı və nəticəvi zərərlər üzrə məsuliyyət məhdudlaşdırılır.</p>
          </article>

          <article class="policy-card">
            <h3 class="fw-bold"><i class="fa-solid fa-user-shield me-2"></i><span data-i18n="terms_privacy_title">Məxfilik və məlumatların işlənməsi</span></h3>
            <p data-i18n="terms_privacy_text">Hesab, link, sessiya və klik statistika məlumatları funksionallıq, təhlükəsizlik, moderasiya və dəstək üçün işlənir. Reklam aktivdirsə reklam vendorlarının cookie/identifikator istifadəsi Məxfilik və Cookie siyasətlərində açıqlanır.</p>
          </article>

          <article class="policy-card">
            <h3 class="fw-bold"><i class="fa-solid fa-envelope-open-text me-2"></i><span data-i18n="terms_contact_title">Əlaqə</span></h3>
            <p data-i18n="terms_contact_text">Suallarınız üçün bizimlə əlaqə saxlayın: support@ovlink.sbs</p>
          </article>
        </div>

        <div class="policy-back">
          <a href="/" class="btn home-outline-btn rounded-pill" data-i18n="nav_home">Ana Səhifə</a>
        </div>
      </div>
    </section>
  </main>

  <%- include('partials/public-footer', { footerClass: 'site-footer' }) %>

  <script nonce="<%= nonce %>" src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js" integrity="sha384-geWF76RCwLtnZ8qwWowPQNguL3RmwHVBC9FhGdlKrxdiJJigb/j/68SIy3Te4Bkz" crossorigin="anonymous"></script>
  <script nonce="<%= nonce %>" src="/lang.js?v=<%= assetVersion %>"></script>
  <script nonce="<%= nonce %>" src="/script.js?v=<%= assetVersion %>"></script>
</body>

</html>



