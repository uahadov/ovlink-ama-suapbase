<!doctype html>
<html lang="<%= (seo && seo.lang) ? seo.lang : 'en' %>">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="csrf-token" content="<%= csrfToken %>">
  <title><%= (seo && seo.title) ? seo.title : 'Ovlink - Pro Activation' %></title>
  <link rel="icon" href="/logo.ico" />
  <link rel="manifest" href="/site.webmanifest" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
  
  <link rel="stylesheet" href="/home.css?v=<%= assetVersion %>" />
  <meta name="description" content="<%= (seo && seo.description) ? seo.description : '' %>" />
  <meta name="keywords" content="<%= (seo && seo.keywords) ? seo.keywords : '' %>" />
  <link rel="canonical" href="<%= (seo && seo.canonical) ? seo.canonical : '' %>" />
  <link rel="alternate" hreflang="en" href="<%= (seo && seo.hreflangEn) ? seo.hreflangEn : '' %>" />
  <link rel="alternate" hreflang="az" href="<%= (seo && seo.hreflangAz) ? seo.hreflangAz : '' %>" />
  <link rel="alternate" hreflang="tr" href="<%= (seo && seo.hreflangTr) ? seo.hreflangTr : '' %>" />
  <link rel="alternate" hreflang="x-default" href="<%= (seo && seo.hreflangXDefault) ? seo.hreflangXDefault : '' %>" />
  <meta property="og:title" content="<%= (seo && seo.ogTitle) ? seo.ogTitle : '' %>" />
  <meta property="og:description" content="<%= (seo && seo.ogDescription) ? seo.ogDescription : '' %>" />
  <meta property="og:url" content="<%= (seo && seo.ogUrl) ? seo.ogUrl : '' %>" />
  <meta property="og:type" content="website" />
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content="<%= (seo && seo.twitterTitle) ? seo.twitterTitle : '' %>" />
  <meta name="twitter:description" content="<%= (seo && seo.twitterDescription) ? seo.twitterDescription : '' %>" />
  <% if (seo && seo.jsonLd) { %>
  <script nonce="<%= nonce %>" type="application/ld+json"><%- seo.jsonLd %></script>
  <% } %>
</head>

<body class="ovx home-page pro-page">

  <!-- Ambient Cursor Glow -->
  <div id="cursorGlow" aria-hidden="true"></div>

  <% if (siteSettings && siteSettings.announcement_enabled === '1' && (siteSettings.announcement_text_az || siteSettings.announcement_text_tr || siteSettings.announcement_text_en)) { %>
    <div id="siteAnnouncement" class="site-announcement" data-az="<%= siteSettings.announcement_text_az || '' %>" data-tr="<%= siteSettings.announcement_text_tr || '' %>" data-en="<%= siteSettings.announcement_text_en || '' %>">
      <div class="shell">
        <i class="fa-solid fa-bullhorn"></i>
        <span id="siteAnnouncementText"><%= siteSettings.announcement_text_az || siteSettings.announcement_text_tr || siteSettings.announcement_text_en %></span>
      </div>
    </div>
  <% } %>

  <%- include('partials/home-navbar') %>

  <main class="m-page-shell m-page-shell--top" id="mainContent">
    <div class="shell" style="max-width: 900px; width: 100%;">

      <article class="m-pro-success-card">

        <!-- Animated Golden Halo Crown SVG -->
        <div class="m-pro-halo-svg-wrap" aria-hidden="true">
          <svg width="120" height="120" viewBox="0 0 120 120" fill="none" xmlns="http://www.w3.org/2000/svg">
            <defs>
              <linearGradient id="proGoldGrad" x1="0" y1="0" x2="120" y2="120" gradientUnits="userSpaceOnUse">
                <stop stop-color="#fbbf24"/>
                <stop offset="0.5" stop-color="#f59e0b"/>
                <stop offset="1" stop-color="#ffffff"/>
              </linearGradient>
              <filter id="proHaloGlow" x="-20%" y="-20%" width="140%" height="140%">
                <feGaussianBlur stdDeviation="6" result="blur"/>
                <feComposite in="SourceGraphic" in2="blur" operator="over"/>
              </filter>
            </defs>

            <!-- Outer Rotating Spark Ring -->
            <g class="m-anim-halo">
              <circle cx="60" cy="60" r="50" stroke="url(#proGoldGrad)" stroke-width="1.5" stroke-dasharray="6 8" opacity="0.7"/>
              <circle cx="60" cy="10" r="2.5" fill="#fbbf24"/>
              <circle cx="110" cy="60" r="2.5" fill="#f59e0b"/>
              <circle cx="60" cy="110" r="2.5" fill="#fbbf24"/>
              <circle cx="10" cy="60" r="2.5" fill="#f59e0b"/>
            </g>

            <!-- Inner Solid Shield Circle -->
            <circle cx="60" cy="60" r="38" fill="#111111" stroke="rgba(251, 191, 36, 0.4)" stroke-width="2"/>

            <!-- Crown / Star Glyph at center -->
            <path d="M 44 68 L 48 50 L 55 58 L 60 46 L 65 58 L 72 50 L 76 68 Z" fill="url(#proGoldGrad)" filter="url(#proHaloGlow)"/>
            <circle cx="48" cy="48" r="2" fill="#ffffff"/>
            <circle cx="60" cy="44" r="2.5" fill="#ffffff"/>
            <circle cx="72" cy="48" r="2" fill="#ffffff"/>
          </svg>
        </div>

        <!-- Live Status Pill -->
        <div>
          <div class="m-pro-status-pill">
            <span class="m-live-dot" style="background:#22c55e;" aria-hidden="true"></span>
            <span>PRO_TIER_ACTIVE</span>
          </div>
        </div>

        <!-- Heading & Intro -->
        <h1 data-i18n="pro_success_title">Ödəniş uğurla tamamlandı!</h1>
        <p class="m-lead" data-i18n="pro_success_intro">Təbriklər! Ovlink Pro abunəliyiniz uğurla aktivləşdirildi.</p>

        <!-- Entitlements Bento Grid -->
        <div class="m-pro-perks-grid">
          <div class="m-pro-perk-card">
            <i class="fa-solid fa-infinity"></i>
            <div class="m-pro-perk-info">
              <h4 data-i18n="pro_perk_1_title">Limitsiz Linklər və Kliklər</h4>
              <p data-i18n="pro_perk_1_desc">Aylıq limit olmaksızın dilediğiniz kadar link yaradın və yönləndirmə əldə edin.</p>
            </div>
          </div>

          <div class="m-pro-perk-card">
            <i class="fa-solid fa-users-viewfinder"></i>
            <div class="m-pro-perk-info">
              <h4 data-i18n="pro_perk_2_title">Komanda Workspaces & SAML SSO</h4>
              <p data-i18n="pro_perk_2_desc">Komanda üzvlərini dəvət edin, rolları idarə edin və müəssisə daxilolmasını aktiv edin.</p>
            </div>
          </div>

          <div class="m-pro-perk-card">
            <i class="fa-solid fa-globe"></i>
            <div class="m-pro-perk-info">
              <h4 data-i18n="pro_perk_3_title">Xüsusi Korporativ Domenlər</h4>
              <p data-i18n="pro_perk_3_desc">Öz domeniniz altında qısa linklər təqdim edərək brend etibarınızı artırın.</p>
            </div>
          </div>

          <div class="m-pro-perk-card">
            <i class="fa-solid fa-code"></i>
            <div class="m-pro-perk-info">
              <h4 data-i18n="pro_perk_4_title">REST API & Webhook V2</h4>
              <p data-i18n="pro_perk_4_desc">Avtomatlaşdırma üçün limitsiz API açarları və real-time webhook bildirişləri.</p>
            </div>
          </div>
        </div>

        <!-- Action Row -->
        <div class="m-pro-action-row">
          <a href="/dashboard" class="m-btn m-btn-solid" style="display:inline-flex; align-items:center; gap:8px; padding: 12px 28px; border-radius: 999px; text-decoration:none;" data-i18n="pro_success_cta">
            <i class="fa-solid fa-chart-pie"></i>
            <span>Dashboard-a Keç</span>
          </a>
          <button id="proManageBtn" type="button" class="m-btn m-btn-ghost" style="display:inline-flex; align-items:center; gap:8px; padding: 12px 24px; border-radius: 999px;" data-is-logged-in="<%= isLoggedIn %>" data-i18n="pro_manage_cta">
            <i class="fa-solid fa-credit-card"></i>
            <span>Polar Portalına Keç</span>
          </button>
        </div>

      </article>

    </div>
  </main>

  <%- include('partials/home-footer') %>

  <script nonce="<%= nonce %>" src="/lang.js?v=<%= assetVersion %>"></script>
  <script nonce="<%= nonce %>" src="/home.js?v=<%= assetVersion %>"></script>
  <script nonce="<%= nonce %>" src="/script.js?v=<%= assetVersion %>"></script>
  <script nonce="<%= nonce %>">
    (function () {
      // Auto-poll session to synchronize Pro status in navbar immediately
      let attempts = 0;
      const maxAttempts = 6;
      function checkProSync() {
        if (attempts >= maxAttempts) return;
        attempts++;
        fetch('/api/me', { headers: { 'Accept': 'application/json' } })
          .then(function(res) { return res.json(); })
          .then(function(data) {
            if (data && data.user && data.user.plan && data.user.plan.tier === 'pro') {
              window.__userPlan = 'pro';
              // Update badge if present
              var badge = document.getElementById('userProBadge');
              if (badge) badge.style.display = 'inline-flex';
            } else {
              setTimeout(checkProSync, 2000);
            }
          })
          .catch(function() {
            setTimeout(checkProSync, 3000);
          });
      }
      setTimeout(checkProSync, 1200);
    })();
  </script>
</body>

</html>

