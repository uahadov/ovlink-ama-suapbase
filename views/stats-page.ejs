  <!-- Monolith Motion & Interaction Engine -->
  <script nonce="<%= nonce %>">
  (function(){
    var isMobile = !matchMedia('(hover:hover)').matches;

    /* ─── 1. Custom Cursor ─── */
    var arrow = document.getElementById('mCursorArrow');
    var ring  = document.getElementById('mCursorRing');
    if (arrow && ring && !isMobile) {
      var mx = -100, my = -100, rx = -100, ry = -100;
      var rafId = null;
      function loop(){
        rx += (mx - rx) * 0.15;
        ry += (my - ry) * 0.15;
        ring.style.transform = 'translate(' + rx + 'px,' + ry + 'px) translate(-50%,-50%)';
        if (Math.abs(mx - rx) > 0.1 || Math.abs(my - ry) > 0.1) {
          rafId = requestAnimationFrame(loop);
        } else {
          rx = mx; ry = my;
          ring.style.transform = 'translate(' + rx + 'px,' + ry + 'px) translate(-50%,-50%)';
          rafId = null;
        }
      }
      function updatePos(e){
        mx = e.clientX; my = e.clientY;
        arrow.style.transform = 'translate(' + mx + 'px,' + my + 'px)';
        if (!rafId) rafId = requestAnimationFrame(loop);
      }
      window.addEventListener('mousemove', updatePos, {passive:true});
      window.addEventListener('pointermove', updatePos, {passive:true});
      document.addEventListener('mouseover', function(e){
        var interactive = e.target && e.target.closest && e.target.closest('a,button,input,textarea,select,label,[role="button"]');
        if (interactive) {
          arrow.classList.add('hover');
          ring.classList.add('hover');
        } else {
          arrow.classList.remove('hover');
          ring.classList.remove('hover');
        }
      }, {passive:true});
      document.addEventListener('mousedown', function(){
        arrow.classList.add('clicking');
        ring.classList.add('clicking');
      });
      document.addEventListener('mouseup', function(){
        arrow.classList.remove('clicking');
        ring.classList.remove('clicking');
      });
      document.addEventListener('mouseleave', function(){
        arrow.classList.add('hidden');
        ring.classList.add('hidden');
      });
      document.addEventListener('mouseenter', function(){
        arrow.classList.remove('hidden');
        ring.classList.remove('hidden');
      });
    } else {
      if (arrow) arrow.style.display = 'none';
      if (ring)  ring.style.display  = 'none';
    }

    /* ─── 2. Cursor Glow ─── */
    var glow = document.getElementById('cursorGlow');
    if (glow && !isMobile) {
      document.addEventListener('mousemove', function(e){
        glow.style.left = e.clientX + 'px';
        glow.style.top  = e.clientY + 'px';
      }, {passive:true});
    } else if (glow) {
      glow.style.display = 'none';
    }

    /* ─── 3. Scroll Progress Bar ─── */
    var sbFill = document.getElementById('mScrollBar-fill');
    if (sbFill) {
      window.addEventListener('scroll', function(){
        var h = document.documentElement;
        var pct = (h.scrollTop || document.body.scrollTop) / (h.scrollHeight - h.clientHeight) * 100;
        sbFill.style.width = pct + '%';
      }, {passive:true});
    }

    /* ─── 4. Nav scroll class ─── */
    var nav = document.getElementById('mNav');
    if (nav) {
      var onScroll = function(){ nav.classList.toggle('scrolled', window.scrollY > 10); };
      window.addEventListener('scroll', onScroll, {passive:true});
      onScroll();
    }

    /* ─── 5. Ripple Effect ─── */
    function addRipple(btn) {
      btn.addEventListener('click', function(e){
        var r = btn.getBoundingClientRect();
        var size = Math.max(r.width, r.height);
        var span = document.createElement('span');
        span.className = 'm-ripple';
        span.style.width = span.style.height = size + 'px';
        span.style.left  = (e.clientX - r.left  - size / 2) + 'px';
        span.style.top   = (e.clientY - r.top   - size / 2) + 'px';
        btn.appendChild(span);
        setTimeout(function(){ span.remove(); }, 600);
      });
    }
    document.querySelectorAll('.m-cta, .m-btn-solid').forEach(addRipple);

    /* ─── Navbar dropdowns & mobile menu are managed by partials/home-navbar ─── */
  })();
  </script>
</body>

