<!DOCTYPE html>
<html lang="en" dir="<%= (typeof dir !== 'undefined' && dir) ? dir : 'ltr' %>">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="csrf-token" content="<%= csrfToken %>" />
  <title data-i18n="stats_title">Statistics</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=<%= assetVersion %>" />
  <link rel="icon" href="/logo.ico" />

  <!-- Fonts & Icons -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="/vendor/fontawesome/css/all.min.css?v=<%= assetVersion %>" />

  <!-- Monolith Home CSS -->
  <link rel="stylesheet" href="/home.css?v=<%= assetVersion %>" />

  <!-- Chart.js 4.4.1 -->
  <script nonce="<%= nonce %>" src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>

  <!-- Monolith Linear-grade Analytics Scoped Styles -->
  <style nonce="<%= (typeof nonce !== 'undefined' ? nonce : '') %>">
    /* ================================================================
       OVLINK LUXURY ANALYTICS — LINEAR / MONOLITH THEME
       ================================================================ */
    .ovx.stats-detail-page {
      min-height: 100vh;
      background: var(--c-bg, #09090b);
      color: var(--c-text, #f0f0f0);
      display: flex;
      flex-direction: column;
    }

    .ovx .m-analytics-main {
      flex: 1;
      padding: calc(var(--nav-h, 60px) + 36px) 0 80px;
      position: relative;
    }

    .ovx .m-analytics-shell {
      max-width: 1140px;
      margin: 0 auto;
      padding: 0 28px;
    }

    /* Executive Top Bar */
    .ovx .m-exec-topbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 16px;
      margin-bottom: 28px;
      padding-bottom: 20px;
      border-bottom: 1px solid var(--c-border, rgba(255, 255, 255, 0.07));
    }

    .ovx .m-exec-left {
      display: flex;
      align-items: center;
      gap: 12px;
      flex-wrap: wrap;
    }

    .ovx .m-link-pill {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: rgba(255, 255, 255, 0.03);
      border: 1px solid var(--c-border, rgba(255, 255, 255, 0.08));
      padding: 6px 14px;
      border-radius: 100px;
      font-size: 13px;
      color: #ffffff;
      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
      font-weight: 500;
    }

    .ovx .m-link-pill .domain-prefix {
      color: var(--c-muted, #888888);
    }

    .ovx .m-copy-btn {
      background: transparent;
      border: none;
      color: var(--c-muted, #888888);
      cursor: pointer;
      padding: 2px 4px;
      font-size: 13px;
      display: inline-flex;
      align-items: center;
      transition: color 0.18s ease;
      line-height: 1;
    }

    .ovx .m-copy-btn:hover {
      color: #ffffff;
    }

    .ovx .m-copy-btn.copied {
      color: #22c55e !important;
    }

    .ovx .m-status-pill {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-size: 11px;
      font-weight: 600;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      padding: 4px 10px;
      border-radius: 100px;
      background: rgba(34, 197, 94, 0.1);
      border: 1px solid rgba(34, 197, 94, 0.25);
      color: #4ade80;
    }

    .ovx .m-status-dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: #4ade80;
      box-shadow: 0 0 8px #4ade80;
    }

    .ovx .m-target-preview {
      font-size: 12.5px;
      color: var(--c-muted, #888888);
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      max-width: 280px;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      transition: color 0.18s ease;
    }

    .ovx .m-target-preview:hover {
      color: #ffffff;
      text-decoration: underline;
    }

    .ovx .m-exec-right {
      display: flex;
      align-items: center;
      gap: 10px;
      flex-wrap: wrap;
    }

    /* Range Switcher (7D, 30D, All Time) */
    .ovx .m-range-switcher {
      display: inline-flex;
      background: rgba(255, 255, 255, 0.03);
      border: 1px solid var(--c-border, rgba(255, 255, 255, 0.08));
      border-radius: 100px;
      padding: 3px;
      gap: 2px;
    }

    .ovx .m-range-btn {
      background: transparent;
      border: none;
      color: var(--c-muted, #888888);
      font-size: 12px;
      font-weight: 600;
      padding: 5px 12px;
      border-radius: 100px;
      cursor: pointer;
      transition: all 0.18s var(--ease, ease);
    }

    .ovx .m-range-btn:hover {
      color: #ffffff;
    }

    .ovx .m-range-btn.active {
      background: #ffffff;
      color: #000000;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
    }

    /* Executive KPI Grid (4 High-Density Bento Cards) */
    .ovx .m-kpi-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 18px;
      margin-bottom: 24px;
    }

    .ovx .m-kpi-card {
      background: #111114;
      border: 1px solid var(--c-border, rgba(255, 255, 255, 0.07));
      border-radius: 16px;
      padding: 22px 24px;
      transition: border-color 0.25s var(--ease, ease), transform 0.2s ease;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      position: relative;
      overflow: hidden;
    }

    .ovx .m-kpi-card:hover {
      border-color: var(--c-border-hi, rgba(255, 255, 255, 0.16));
      transform: translateY(-1px);
    }

    .ovx .m-kpi-label {
      font-size: 11.5px;
      font-weight: 600;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--c-faint, #737373);
      margin-bottom: 12px;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .ovx .m-kpi-label i {
      font-size: 12px;
      color: var(--c-muted, #888888);
    }

    .ovx .m-kpi-badge {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      font-size: 10.5px;
      font-weight: 600;
      padding: 2px 7px;
      border-radius: 100px;
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid rgba(255, 255, 255, 0.09);
      color: #a1a1aa;
      font-family: ui-monospace, SFMono-Regular, monospace;
      margin-left: auto;
    }

    .ovx .m-kpi-badge.live {
      background: rgba(34, 197, 94, 0.1);
      border-color: rgba(34, 197, 94, 0.25);
      color: #4ade80;
    }

    .ovx .m-kpi-value {
      font-size: clamp(24px, 2.2vw, 32px);
      font-weight: 700;
      letter-spacing: -0.035em;
      color: #ffffff;
      line-height: 1.15;
      margin-bottom: 8px;
      font-feature-settings: "cv02", "cv03", "cv04", "cv11";
      display: flex;
      align-items: center;
      gap: 8px;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .ovx .m-kpi-sub {
      font-size: 12px;
      color: var(--c-muted, #888888);
      line-height: 1.4;
      margin: 0;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    /* Main Chart Section (Clicks Over Time) */
    .ovx .m-chart-section {
      background: #111114;
      border: 1px solid var(--c-border, rgba(255, 255, 255, 0.07));
      border-radius: 16px;
      padding: 26px 28px;
      margin-bottom: 24px;
      transition: border-color 0.25s var(--ease, ease);
    }

    .ovx .m-chart-section:hover {
      border-color: var(--c-border-hi, rgba(255, 255, 255, 0.16));
    }

    .ovx .m-chart-header {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 14px;
      margin-bottom: 18px;
    }

    .ovx .m-chart-title {
      font-size: 16px;
      font-weight: 600;
      letter-spacing: -0.015em;
      color: #ffffff;
      margin: 0 0 4px 0;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .ovx .m-chart-title i {
      font-size: 13px;
      color: var(--c-muted, #888888);
    }

    .ovx .m-chart-sub {
      font-size: 12.5px;
      color: var(--c-muted, #888888);
      margin: 0;
    }

    .ovx .m-chart-controls {
      display: flex;
      align-items: center;
      gap: 8px;
      flex-wrap: wrap;
    }

    .ovx .m-pill-group {
      display: inline-flex;
      background: rgba(255, 255, 255, 0.03);
      border: 1px solid var(--c-border, rgba(255, 255, 255, 0.08));
      border-radius: 100px;
      padding: 2px;
      gap: 2px;
    }

    .ovx .m-pill-btn {
      background: transparent;
      border: none;
      color: var(--c-muted, #888888);
      font-size: 11px;
      font-weight: 600;
      padding: 4px 9px;
      border-radius: 100px;
      cursor: pointer;
      transition: all 0.18s ease;
      display: inline-flex;
      align-items: center;
      gap: 5px;
    }

    .ovx .m-pill-btn:hover {
      color: #ffffff;
    }

    .ovx .m-pill-btn.active {
      background: rgba(255, 255, 255, 0.14);
      color: #ffffff;
    }

    .ovx .m-chart-stat-strip {
      display: flex;
      align-items: center;
      gap: 20px;
      background: rgba(255, 255, 255, 0.02);
      border: 1px solid rgba(255, 255, 255, 0.05);
      border-radius: 10px;
      padding: 8px 14px;
      margin-bottom: 20px;
      flex-wrap: wrap;
    }

    .ovx .m-stat-item {
      display: flex;
      align-items: baseline;
      gap: 6px;
      font-size: 12px;
    }

    .ovx .m-stat-k {
      color: var(--c-faint, #737373);
      text-transform: uppercase;
      font-size: 10px;
      letter-spacing: 0.06em;
      font-weight: 600;
    }

    .ovx .m-stat-v {
      color: #ffffff;
      font-weight: 700;
      font-family: ui-monospace, SFMono-Regular, monospace;
      font-size: 13px;
    }

    .ovx .m-chart-meta-chips {
      display: flex;
      align-items: center;
      gap: 8px;
      flex-wrap: wrap;
    }

    .ovx .m-meta-chip {
      font-size: 11px;
      font-weight: 500;
      color: var(--c-muted, #888888);
      background: rgba(255, 255, 255, 0.03);
      border: 1px solid var(--c-border, rgba(255, 255, 255, 0.08));
      padding: 3px 9px;
      border-radius: 100px;
    }

    .ovx .m-chart-canvas-wrap {
      position: relative;
      width: 100%;
      height: 290px;
      display: flex;
      align-items: center;
      justify-content: center;
      box-sizing: border-box;
    }

    .ovx .m-chart-empty {
      position: absolute;
      inset: 0;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 10px;
      color: var(--c-faint, #737373);
      font-size: 13.5px;
      font-weight: 500;
      text-align: center;
      pointer-events: none;
    }

    .ovx .m-chart-empty i {
      font-size: 28px;
      opacity: 0.5;
    }

    /* Bottom Two-Column Panels */
    .ovx .m-split-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 20px;
    }

    .ovx .m-breakdown-panel {
      background: #111114;
      border: 1px solid var(--c-border, rgba(255, 255, 255, 0.07));
      border-radius: 16px;
      padding: 26px 28px;
      transition: border-color 0.25s var(--ease, ease);
      display: flex;
      flex-direction: column;
    }

    .ovx .m-breakdown-panel:hover {
      border-color: var(--c-border-hi, rgba(255, 255, 255, 0.16));
    }

    .ovx .m-panel-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 20px;
      padding-bottom: 12px;
      border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    }

    .ovx .m-panel-heading {
      font-size: 15px;
      font-weight: 600;
      color: #ffffff;
      margin: 0;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .ovx .m-panel-heading i {
      font-size: 13px;
      color: var(--c-muted, #888888);
    }

    /* Panel Tab Buttons (OS vs Browsers) */
    .ovx .m-panel-tabs {
      display: inline-flex;
      background: rgba(255, 255, 255, 0.03);
      border: 1px solid var(--c-border, rgba(255, 255, 255, 0.08));
      border-radius: 100px;
      padding: 2px;
      gap: 2px;
    }

    .ovx .m-tab-pill {
      background: transparent;
      border: none;
      color: var(--c-muted, #888888);
      font-size: 11.5px;
      font-weight: 600;
      padding: 4px 10px;
      border-radius: 100px;
      cursor: pointer;
      transition: all 0.18s ease;
    }

    .ovx .m-tab-pill:hover {
      color: #ffffff;
    }

    .ovx .m-tab-pill.active {
      background: rgba(255, 255, 255, 0.12);
      color: #ffffff;
    }

    /* Ranked Data Rows */
    .ovx .m-data-list {
      display: flex;
      flex-direction: column;
      gap: 14px;
      min-height: 180px;
    }

    .ovx .m-data-row {
      display: flex;
      flex-direction: column;
      gap: 6px;
      transition: opacity 0.18s ease;
    }

    .ovx .m-data-row-main {
      display: flex;
      align-items: center;
      justify-content: space-between;
      font-size: 13.5px;
    }

    .ovx .m-data-left {
      display: flex;
      align-items: center;
      gap: 10px;
      color: #ffffff;
      font-weight: 500;
    }

    .ovx .m-rank-index {
      font-size: 11px;
      font-weight: 600;
      color: var(--c-faint, #737373);
      font-family: ui-monospace, SFMono-Regular, monospace;
      width: 14px;
    }

    .ovx .m-geo-tag {
      font-size: 11px;
      font-weight: 700;
      font-family: ui-monospace, SFMono-Regular, monospace;
      background: rgba(255, 255, 255, 0.06);
      border: 1px solid rgba(255, 255, 255, 0.1);
      padding: 2px 6px;
      border-radius: 6px;
      color: #ffffff;
      min-width: 24px;
      text-align: center;
    }

    .ovx .m-tech-icon {
      font-size: 14px;
      color: var(--c-muted, #888888);
      width: 16px;
      text-align: center;
    }

    .ovx .m-data-right {
      display: flex;
      align-items: baseline;
      gap: 8px;
      font-family: ui-monospace, SFMono-Regular, monospace;
    }

    .ovx .m-pct-val {
      font-size: 13px;
      font-weight: 600;
      color: #ffffff;
    }

    .ovx .m-count-val {
      font-size: 11.5px;
      color: var(--c-faint, #737373);
    }

    /* Hairline Progress Bar */
    .ovx .m-hairline-track {
      width: 100%;
      height: 2px;
      background: rgba(255, 255, 255, 0.06);
      border-radius: 2px;
      overflow: hidden;
    }

    .ovx .m-hairline-fill {
      height: 100%;
      background: #ffffff;
      border-radius: 2px;
      transition: width 0.4s var(--ease, ease);
    }

    .ovx .m-list-empty {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      flex: 1;
      gap: 8px;
      color: var(--c-faint, #737373);
      font-size: 13px;
      padding: 36px 0;
      text-align: center;
    }

    .ovx .m-list-empty i {
      font-size: 22px;
      opacity: 0.5;
    }

    /* Live Activity Stream Section */
    .ovx .m-activity-section {
      background: #111114;
      border: 1px solid var(--c-border, rgba(255, 255, 255, 0.07));
      border-radius: 16px;
      padding: 26px 28px;
      margin-top: 24px;
      transition: border-color 0.25s var(--ease, ease);
    }

    .ovx .m-activity-section:hover {
      border-color: var(--c-border-hi, rgba(255, 255, 255, 0.16));
    }

    .ovx .m-table-responsive {
      width: 100%;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
    }

    .ovx .m-activity-table {
      width: 100%;
      border-collapse: collapse;
      text-align: left;
      font-size: 13px;
    }

    .ovx .m-activity-table th {
      padding: 10px 14px;
      font-size: 11px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: var(--c-faint, #737373);
      border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    }

    .ovx .m-activity-table td {
      padding: 12px 14px;
      border-bottom: 1px solid rgba(255, 255, 255, 0.03);
      color: #d4d4d8;
      vertical-align: middle;
    }

    .ovx .m-activity-table tr:hover td {
      background: rgba(255, 255, 255, 0.02);
      color: #ffffff;
    }

    .ovx .m-activity-table tr:last-child td {
      border-bottom: none;
    }

    .ovx .m-td-num {
      font-family: ui-monospace, SFMono-Regular, monospace;
      color: var(--c-faint, #737373);
      font-size: 11px;
      width: 32px;
    }

    .ovx .m-td-time {
      font-family: ui-monospace, SFMono-Regular, monospace;
      font-size: 12px;
      color: #a1a1aa;
      display: inline-flex;
      align-items: baseline;
      gap: 6px;
    }

    .ovx .m-td-subtime {
      color: var(--c-faint, #737373);
      font-size: 11px;
    }

    .ovx .m-td-badge {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      font-size: 13px;
    }

    .ovx .m-flag-emoji {
      font-size: 16px;
      line-height: 1;
      vertical-align: middle;
    }

    .ovx .m-table-empty {
      text-align: center;
      padding: 36px 0 !important;
      color: var(--c-faint, #737373);
    }

    .ovx .m-table-empty i {
      font-size: 22px;
      opacity: 0.5;
      display: block;
      margin-bottom: 8px;
    }

    /* Responsive Queries */
    @media (max-width: 1080px) {
      .ovx .m-kpi-grid {
        grid-template-columns: repeat(2, 1fr);
        gap: 14px;
      }
    }

    @media (max-width: 768px) {
      .ovx .m-kpi-grid {
        grid-template-columns: 1fr;
        gap: 12px;
      }
      .ovx .m-split-grid {
        grid-template-columns: 1fr;
        gap: 16px;
      }
      .ovx .m-chart-section,
      .ovx .m-breakdown-panel,
      .ovx .m-activity-section,
      .ovx .m-kpi-card {
        padding: 20px 16px;
      }
      .ovx .m-exec-topbar {
        flex-direction: column;
        align-items: flex-start;
      }
      .ovx .m-chart-stat-strip {
        gap: 12px;
      }
    }
  </style>
</head>

<body class="ovx app-page stats-detail-page" data-short-code="<%= shortCode %>" data-essential-marker="<%= consentMarker %>">

  <!-- Skip to content for accessibility -->
  <a href="#mainContent" class="m-skip-link" data-i18n="skip_to_content">Skip to content</a>

  <!-- Custom Monolith Cursor -->
  <div id="mCursorArrow" aria-hidden="true">
    <svg width="30" height="30" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M4.5 3.5L27 13.5L16.5 17.5L12 28.5L4.5 3.5Z" fill="#0a0a0a" stroke="#ffffff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  </div>
  <div id="mCursorRing" aria-hidden="true"></div>

  <!-- Scroll Progress -->
  <div id="mScrollBar" aria-hidden="true"><div id="mScrollBar-fill"></div></div>

  <!-- Ambient Cursor Glow -->
  <div id="cursorGlow" aria-hidden="true"></div>

  <!-- Announcement ribbon -->
  <% if (siteSettings && siteSettings.announcement_enabled === '1' && (siteSettings.announcement_text_az || siteSettings.announcement_text_tr || siteSettings.announcement_text_en)) { %>
    <div id="siteAnnouncement" class="m-ribbon" data-az="<%= siteSettings.announcement_text_az || '' %>" data-tr="<%= siteSettings.announcement_text_tr || '' %>" data-en="<%= siteSettings.announcement_text_en || '' %>">
      <i class="fa-solid fa-bullhorn" aria-hidden="true"></i>
      <span id="siteAnnouncementText"><%= siteSettings.announcement_text_az || siteSettings.announcement_text_tr || siteSettings.announcement_text_en %></span>
    </div>
  <% } %>

  <!-- Monolith Navigation -->
  <%- include('partials/home-navbar') %>

  <!-- Main Analytics Container -->
  <main class="m-analytics-main" id="mainContent">
    <div class="m-analytics-shell">

      <!-- 1. Executive Top Bar -->
      <header class="m-exec-topbar">
        <div class="m-exec-left">
          <div class="m-link-pill">
            <i class="fa-solid fa-link" style="font-size: 11px; color: var(--c-muted, #888888);"></i>
            <span class="domain-prefix">ovlink.sbs/</span><span><%= shortCode %></span>
            <button type="button" class="m-copy-btn" id="copyLinkBtn" title="Copy link" aria-label="Copy short link">
              <i class="fa-regular fa-copy"></i>
            </button>
          </div>

          <span class="m-status-pill">
            <span class="m-status-dot"></span>
            <span data-i18n="stats_status_active">Aktiv</span>
          </span>

          <% if (typeof originalUrl === 'string' && originalUrl.trim()) { %>
