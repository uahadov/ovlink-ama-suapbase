<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="csrf-token" content="<%= csrfToken %>" />
  <title data-i18n="stats_title">Statistics</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=<%= assetVersion %>" />
  <link rel="icon" href="/logo.ico" />

  <!-- Fonts & Icons -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="/vendor/fontawesome/css/all.min.css?v=<%= assetVersion %>" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" integrity="sha512-iecdLmaskl7CVkqkXNQ/ZH/XLlvWZOJyj7Yy7tcenmpD1ypASozpmT/E0iPtmFIB46ZmdtAc9eNBvH0H/ZpiBw==" crossorigin="anonymous" referrerpolicy="no-referrer" />

  <!-- Monolith Home CSS -->
  <link rel="stylesheet" href="/home.css?v=<%= assetVersion %>" />

  <!-- Chart.js 4.4.1 -->
  <script nonce="<%= nonce %>" src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>

  <!-- Monolith Linear-grade Analytics Scoped Styles -->
  <style nonce="<%= (typeof nonce !== 'undefined' ? nonce : '') %>">
    /* ================================================================
       OVLINK LUXURY ANALYTICS — LINEAR / MONOLITH THEME
       ================================================================ */
    .ovx.stats-detail-page {
      min-height: 100vh;
      background: var(--c-bg, #09090b);
      color: var(--c-text, #f0f0f0);
      display: flex;
      flex-direction: column;
    }

    .ovx .m-analytics-main {
      flex: 1;
      padding: calc(var(--nav-h, 60px) + 36px) 0 80px;
      position: relative;
    }

    .ovx .m-analytics-shell {
      max-width: 1140px;
      margin: 0 auto;
      padding: 0 28px;
    }

    /* Executive Top Bar */
    .ovx .m-exec-topbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 16px;
      margin-bottom: 28px;
      padding-bottom: 20px;
      border-bottom: 1px solid var(--c-border, rgba(255, 255, 255, 0.07));
    }

    .ovx .m-exec-left {
      display: flex;
      align-items: center;
      gap: 12px;
      flex-wrap: wrap;
    }

    .ovx .m-link-pill {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: rgba(255, 255, 255, 0.03);
      border: 1px solid var(--c-border, rgba(255, 255, 255, 0.08));
      padding: 6px 14px;
      border-radius: 100px;
      font-size: 13px;
      color: #ffffff;
      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
      font-weight: 500;
    }

    .ovx .m-link-pill .domain-prefix {
      color: var(--c-muted, #888888);
    }

    .ovx .m-copy-btn {
      background: transparent;
      border: none;
      color: var(--c-muted, #888888);
      cursor: pointer;
      padding: 2px 4px;
      font-size: 13px;
      display: inline-flex;
      align-items: center;
      transition: color 0.18s ease;
      line-height: 1;
    }

    .ovx .m-copy-btn:hover {
      color: #ffffff;
    }

    .ovx .m-copy-btn.copied {
      color: #22c55e !important;
    }

    .ovx .m-status-pill {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-size: 11px;
      font-weight: 600;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      padding: 4px 10px;
      border-radius: 100px;
      background: rgba(34, 197, 94, 0.1);
      border: 1px solid rgba(34, 197, 94, 0.25);
      color: #4ade80;
    }

    .ovx .m-status-dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: #4ade80;
      box-shadow: 0 0 8px #4ade80;
    }

    .ovx .m-target-preview {
      font-size: 12.5px;
      color: var(--c-muted, #888888);
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      max-width: 280px;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      transition: color 0.18s ease;
    }

    .ovx .m-target-preview:hover {
      color: #ffffff;
      text-decoration: underline;
    }

    .ovx .m-exec-right {
      display: flex;
      align-items: center;
      gap: 10px;
      flex-wrap: wrap;
    }

    /* Range Switcher (7D, 30D, All Time) */
    .ovx .m-range-switcher {
      display: inline-flex;
      background: rgba(255, 255, 255, 0.03);
      border: 1px solid var(--c-border, rgba(255, 255, 255, 0.08));
      border-radius: 100px;
      padding: 3px;
      gap: 2px;
    }

    .ovx .m-range-btn {
      background: transparent;
      border: none;
      color: var(--c-muted, #888888);
      font-size: 12px;
      font-weight: 600;
      padding: 5px 12px;
      border-radius: 100px;
      cursor: pointer;
      transition: all 0.18s var(--ease, ease);
    }

    .ovx .m-range-btn:hover {
      color: #ffffff;
    }

    .ovx .m-range-btn.active {
      background: #ffffff;
      color: #000000;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
    }

    /* Executive KPI Grid (3 Spacious Cards) */
    .ovx .m-kpi-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 20px;
      margin-bottom: 24px;
    }

    .ovx .m-kpi-card {
      background: #111114;
      border: 1px solid var(--c-border, rgba(255, 255, 255, 0.07));
      border-radius: 16px;
      padding: 26px 28px;
      transition: border-color 0.25s var(--ease, ease), transform 0.2s ease;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }

    .ovx .m-kpi-card:hover {
      border-color: var(--c-border-hi, rgba(255, 255, 255, 0.16));
      transform: translateY(-1px);
    }

    .ovx .m-kpi-label {
      font-size: 11.5px;
      font-weight: 600;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--c-faint, #737373);
      margin-bottom: 12px;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .ovx .m-kpi-label i {
      font-size: 12px;
      color: var(--c-muted, #888888);
    }

    .ovx .m-kpi-value {
      font-size: clamp(30px, 3.2vw, 38px);
      font-weight: 700;
      letter-spacing: -0.035em;
      color: #ffffff;
      line-height: 1.1;
      margin-bottom: 8px;
      font-feature-settings: "cv02", "cv03", "cv04", "cv11";
    }

    .ovx .m-kpi-sub {
      font-size: 12.5px;
      color: var(--c-muted, #888888);
      line-height: 1.4;
      margin: 0;
    }

    /* Main Chart Section (Clicks Over Time) */
    .ovx .m-chart-section {
      background: #111114;
      border: 1px solid var(--c-border, rgba(255, 255, 255, 0.07));
      border-radius: 16px;
      padding: 28px 32px;
      margin-bottom: 24px;
      transition: border-color 0.25s var(--ease, ease);
    }

    .ovx .m-chart-section:hover {
      border-color: var(--c-border-hi, rgba(255, 255, 255, 0.16));
    }

    .ovx .m-chart-header {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 12px;
      margin-bottom: 24px;
    }

    .ovx .m-chart-title {
      font-size: 16px;
      font-weight: 600;
      letter-spacing: -0.015em;
      color: #ffffff;
      margin: 0 0 4px 0;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .ovx .m-chart-title i {
      font-size: 13px;
      color: var(--c-muted, #888888);
    }

    .ovx .m-chart-sub {
      font-size: 12.5px;
      color: var(--c-muted, #888888);
      margin: 0;
    }

    .ovx .m-chart-meta-chips {
      display: flex;
      align-items: center;
      gap: 8px;
      flex-wrap: wrap;
    }

    .ovx .m-meta-chip {
      font-size: 11.5px;
      font-weight: 500;
      color: var(--c-muted, #888888);
      background: rgba(255, 255, 255, 0.03);
      border: 1px solid var(--c-border, rgba(255, 255, 255, 0.08));
      padding: 4px 10px;
      border-radius: 100px;
    }

    .ovx .m-chart-canvas-wrap {
      position: relative;
      width: 100%;
      height: 280px;
      display: flex;
      align-items: center;
      justify-content: center;
      box-sizing: border-box;
    }

    .ovx .m-chart-empty {
      position: absolute;
      inset: 0;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 10px;
      color: var(--c-faint, #737373);
      font-size: 13.5px;
      font-weight: 500;
      text-align: center;
      pointer-events: none;
    }

    .ovx .m-chart-empty i {
      font-size: 28px;
      opacity: 0.5;
    }

    /* Bottom Two-Column Panels */
    .ovx .m-split-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 20px;
    }

    .ovx .m-breakdown-panel {
      background: #111114;
      border: 1px solid var(--c-border, rgba(255, 255, 255, 0.07));
      border-radius: 16px;
      padding: 26px 28px;
      transition: border-color 0.25s var(--ease, ease);
      display: flex;
      flex-direction: column;
    }

    .ovx .m-breakdown-panel:hover {
      border-color: var(--c-border-hi, rgba(255, 255, 255, 0.16));
    }

    .ovx .m-panel-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 20px;
      padding-bottom: 12px;
      border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    }

    .ovx .m-panel-heading {
      font-size: 15px;
      font-weight: 600;
      color: #ffffff;
      margin: 0;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .ovx .m-panel-heading i {
      font-size: 13px;
      color: var(--c-muted, #888888);
    }

    /* Panel Tab Buttons (OS vs Browsers) */
    .ovx .m-panel-tabs {
      display: inline-flex;
      background: rgba(255, 255, 255, 0.03);
      border: 1px solid var(--c-border, rgba(255, 255, 255, 0.08));
      border-radius: 100px;
      padding: 2px;
      gap: 2px;
    }

    .ovx .m-tab-pill {
      background: transparent;
      border: none;
      color: var(--c-muted, #888888);
      font-size: 11.5px;
      font-weight: 600;
      padding: 4px 10px;
      border-radius: 100px;
      cursor: pointer;
      transition: all 0.18s ease;
    }

    .ovx .m-tab-pill:hover {
      color: #ffffff;
    }

    .ovx .m-tab-pill.active {
      background: rgba(255, 255, 255, 0.12);
      color: #ffffff;
    }

    /* Ranked Data Rows */
    .ovx .m-data-list {
      display: flex;
      flex-direction: column;
      gap: 14px;
      min-height: 180px;
    }

    .ovx .m-data-row {
      display: flex;
      flex-direction: column;
      gap: 6px;
      transition: opacity 0.18s ease;
    }

    .ovx .m-data-row-main {
      display: flex;
      align-items: center;
      justify-content: space-between;
      font-size: 13.5px;
    }

    .ovx .m-data-left {
      display: flex;
      align-items: center;
      gap: 10px;
      color: #ffffff;
      font-weight: 500;
    }

    .ovx .m-rank-index {
      font-size: 11px;
      font-weight: 600;
      color: var(--c-faint, #737373);
      font-family: ui-monospace, SFMono-Regular, monospace;
      width: 14px;
    }

    .ovx .m-geo-tag {
      font-size: 11px;
      font-weight: 700;
      font-family: ui-monospace, SFMono-Regular, monospace;
      background: rgba(255, 255, 255, 0.06);
      border: 1px solid rgba(255, 255, 255, 0.1);
      padding: 2px 6px;
      border-radius: 6px;
      color: #ffffff;
      min-width: 24px;
      text-align: center;
    }

    .ovx .m-tech-icon {
      font-size: 14px;
      color: var(--c-muted, #888888);
      width: 16px;
      text-align: center;
    }

    .ovx .m-data-right {
      display: flex;
      align-items: baseline;
      gap: 8px;
      font-family: ui-monospace, SFMono-Regular, monospace;
    }

    .ovx .m-pct-val {
      font-size: 13px;
      font-weight: 600;
      color: #ffffff;
    }

    .ovx .m-count-val {
      font-size: 11.5px;
      color: var(--c-faint, #737373);
    }

    /* Hairline Progress Bar */
    .ovx .m-hairline-track {
      width: 100%;
      height: 2px;
      background: rgba(255, 255, 255, 0.06);
      border-radius: 2px;
      overflow: hidden;
    }

    .ovx .m-hairline-fill {
      height: 100%;
      background: #ffffff;
      border-radius: 2px;
      transition: width 0.4s var(--ease, ease);
    }

    .ovx .m-list-empty {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      flex: 1;
      gap: 8px;
      color: var(--c-faint, #737373);
      font-size: 13px;
      padding: 36px 0;
      text-align: center;
    }

    .ovx .m-list-empty i {
      font-size: 22px;
      opacity: 0.5;
    }

    /* Responsive Queries */
    @media (max-width: 900px) {
      .ovx .m-kpi-grid {
        grid-template-columns: 1fr;
        gap: 14px;
      }
      .ovx .m-split-grid {
        grid-template-columns: 1fr;
        gap: 16px;
      }
      .ovx .m-chart-section,
      .ovx .m-breakdown-panel,
      .ovx .m-kpi-card {
        padding: 20px 18px;
      }
      .ovx .m-exec-topbar {
        flex-direction: column;
        align-items: flex-start;
      }
    }
  </style>
</head>

<body class="ovx app-page stats-detail-page">

  <!-- Skip to content for accessibility -->
  <a href="#mainContent" class="m-skip-link" data-i18n="skip_to_content">Skip to content</a>

  <!-- Custom Monolith Cursor -->
  <div id="mCursorArrow" aria-hidden="true">
    <svg width="30" height="30" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M4.5 3.5L27 13.5L16.5 17.5L12 28.5L4.5 3.5Z" fill="#0a0a0a" stroke="#ffffff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  </div>
  <div id="mCursorRing" aria-hidden="true"></div>

  <!-- Scroll Progress -->
  <div id="mScrollBar" aria-hidden="true"><div id="mScrollBar-fill"></div></div>

  <!-- Ambient Cursor Glow -->
  <div id="cursorGlow" aria-hidden="true"></div>

  <!-- Announcement ribbon -->
  <% if (siteSettings && siteSettings.announcement_enabled === '1' && (siteSettings.announcement_text_az || siteSettings.announcement_text_tr || siteSettings.announcement_text_en)) { %>
    <div id="siteAnnouncement" class="m-ribbon" data-az="<%= siteSettings.announcement_text_az || '' %>" data-tr="<%= siteSettings.announcement_text_tr || '' %>" data-en="<%= siteSettings.announcement_text_en || '' %>">
      <i class="fa-solid fa-bullhorn" aria-hidden="true"></i>
      <span id="siteAnnouncementText"><%= siteSettings.announcement_text_az || siteSettings.announcement_text_tr || siteSettings.announcement_text_en %></span>
    </div>
  <% } %>

  <!-- Monolith Navigation -->
  <%- include('partials/home-navbar') %>

  <!-- Main Analytics Container -->
  <main class="m-analytics-main" id="mainContent">
    <div class="m-analytics-shell">

      <!-- 1. Executive Top Bar -->
      <header class="m-exec-topbar">
        <div class="m-exec-left">
          <div class="m-link-pill">
            <i class="fa-solid fa-link" style="font-size: 11px; color: var(--c-muted, #888888);"></i>
            <span class="domain-prefix">ovlink.sbs/</span><span><%= shortCode %></span>
            <button type="button" class="m-copy-btn" id="copyLinkBtn" title="Copy link" aria-label="Copy short link">
              <i class="fa-regular fa-copy"></i>
            </button>
          </div>

          <span class="m-status-pill">
            <span class="m-status-dot"></span>
            <span data-i18n="stats_status_active">Aktiv</span>
          </span>

          <% if (typeof originalUrl === 'string' && originalUrl.trim()) { %>
            <a href="<%= originalUrl %>" target="_blank" rel="noopener noreferrer" class="m-target-preview" title="<%= originalUrl %>">
              <i class="fa-solid fa-arrow-up-right-from-square" style="font-size: 11px;"></i>
              <span><%= originalUrl %></span>
            </a>
          <% } %>
        </div>

        <div class="m-exec-right">
          <!-- Time Range Switcher -->
          <div class="m-range-switcher" role="group" aria-label="Date range filter">
            <button type="button" class="m-range-btn" data-range="7d" data-i18n="stats_filter_7d">7 Gün</button>
            <button type="button" class="m-range-btn" data-range="30d" data-i18n="stats_filter_30d">30 Gün</button>
            <button type="button" class="m-range-btn active" data-range="all" data-i18n="stats_filter_all">Bütün Vaxt</button>
          </div>

          <!-- Export Buttons -->
          <button type="button" class="m-cta m-cta--outline m-cta--sm" id="exportCsvBtn" title="Export CSV">
            <i class="fa-solid fa-download"></i>
            <span>Export CSV</span>
          </button>
          <button type="button" class="m-cta m-cta--outline m-cta--sm" id="exportJsonBtn" title="Export JSON">
            <i class="fa-solid fa-code"></i>
            <span>Export JSON</span>
          </button>

          <!-- Back to Dashboard -->
          <a href="/dashboard" class="m-cta m-cta--outline m-cta--sm">
            <i class="fa-solid fa-arrow-left"></i>
            <span data-i18n="stats_back_btn">Dashboard-a qayıt</span>
          </a>
        </div>
      </header>

      <!-- 2. Executive 3 KPI Metric Cards -->
      <section class="m-kpi-grid" aria-label="Key Performance Indicators">
        <!-- Card 1: Total Clicks -->
        <div class="m-kpi-card">
          <div class="m-kpi-label">
            <i class="fa-solid fa-arrow-pointer"></i>
            <span data-i18n="stats_total_clicks">Ümumi Klik Sayı</span>
          </div>
          <div class="m-kpi-value" id="totalClicksDisplay">0</div>
          <p class="m-kpi-sub" data-i18n="stats_clicks_chart_sub">Zaman üzrə aktivlik</p>
        </div>

        <!-- Card 2: Unique Visitors -->
        <div class="m-kpi-card">
          <div class="m-kpi-label">
            <i class="fa-solid fa-user-group"></i>
            <span data-i18n="stats_unique_visitors">Unikal Ziyarətçilər</span>
          </div>
          <div class="m-kpi-value" id="uniqueVisitorsDisplay">0</div>
          <p class="m-kpi-sub">Fərqli şəbəkə seansları</p>
        </div>

        <!-- Card 3: Top Location -->
        <div class="m-kpi-card">
          <div class="m-kpi-label">
            <i class="fa-solid fa-earth-americas"></i>
            <span data-i18n="stats_top_location">Əsas Məkan</span>
          </div>
          <div class="m-kpi-value" id="topLocationDisplay">—</div>
          <p class="m-kpi-sub" id="topLocationSub">Coğrafi paylanma</p>
        </div>
      </section>

      <!-- 3. Primary Wide Chart: Clicks Over Time (Smooth Spline Area) -->
      <section class="m-chart-section" aria-label="Clicks Timeline Chart">
        <div class="m-chart-header">
          <div>
            <h2 class="m-chart-title">
              <i class="fa-solid fa-chart-line"></i>
              <span data-i18n="stats_clicks_over_time">Zaman üzrə kliklər</span>
            </h2>
            <p class="m-chart-sub" id="chartRangeSub" data-i18n="stats_time_note">Saatlıq qrafik brauzerinizin yerli vaxtına əsaslanır.</p>
          </div>
          <div id="timeChartMeta" class="m-chart-meta-chips"></div>
        </div>

        <div class="m-chart-canvas-wrap">
          <canvas id="timeChart"></canvas>
        </div>
      </section>

      <!-- 4. Bottom Two-Column Breakdown Panels -->
      <div class="m-split-grid">

        <!-- Panel 1: Top Countries -->
        <section class="m-breakdown-panel" aria-label="Top Countries">
          <div class="m-panel-head">
            <h2 class="m-panel-heading">
              <i class="fa-solid fa-globe"></i>
              <span data-i18n="stats_top_countries">Əsas Ölkələr</span>
            </h2>
            <span class="m-meta-chip" id="countryTotalTag">0 ölkə</span>
          </div>
          <div id="countriesList" class="m-data-list">
            <!-- Dynamically populated rows with rank, flag, name, percentage and hairline progress -->
          </div>
        </section>

        <!-- Panel 2: Operating Systems & Browsers (Tabbed) -->
        <section class="m-breakdown-panel" aria-label="Operating Systems and Browsers">
          <div class="m-panel-head">
            <div class="m-panel-tabs" role="tablist">
              <button type="button" class="m-tab-pill active" id="tabOsBtn" role="tab" aria-selected="true" data-i18n="stats_tab_os">
                Əməliyyat Sistemi
              </button>
              <button type="button" class="m-tab-pill" id="tabBrowsersBtn" role="tab" aria-selected="false" data-i18n="stats_tab_browsers">
                Brauzerlər
              </button>
            </div>
            <span class="m-meta-chip" id="techTotalTag">0 element</span>
          </div>
          <div id="techList" class="m-data-list">
            <!-- Dynamically populated rows with tech brand icon, name, percentage and hairline progress -->
          </div>
        </section>

      </div>

    </div>
  </main>

  <!-- Monolith Footer -->
  <%- include('partials/home-footer') %>

  <!-- Core App Scripts -->
  <script nonce="<%= nonce %>" src="/lang.js?v=<%= assetVersion %>"></script>
  <script nonce="<%= nonce %>" src="/script.js?v=<%= assetVersion %>"></script>

  <!-- Linear-grade Analytics Logic -->
  <script nonce="<%= nonce %>">
    const shortCode = <%- JSON.stringify(shortCode) %>;
    const essentialMarker = <%- JSON.stringify(consentMarker) %>;

    let analyticsRawData = null;
    let currentRangeFilter = 'all'; // '7d' | '30d' | 'all'
    let currentTechTab = 'os';      // 'os' | 'browsers'
    let timeChartInstance = null;

    function t(key) {
      const lang = typeof currentLang === 'string' ? currentLang : 'az';
      if (typeof translations !== 'undefined' && translations[lang] && translations[lang][key]) {
        return translations[lang][key];
      }
      return key;
    }

    function mapBucketLabel(value) {
      return value === essentialMarker ? t('stats_private_bucket') || 'Essential' : (value || 'Unknown');
    }

    function formatTimeLabel(isoValue, isDaily = false) {
      const d = new Date(isoValue);
      if (!Number.isFinite(d.getTime())) return isoValue;
      const lang = document.documentElement.lang || 'en';
      if (isDaily) {
        return new Intl.DateTimeFormat(lang, { month: 'short', day: 'numeric' }).format(d);
      }
      return new Intl.DateTimeFormat(lang, {
        month: 'numeric',
        day: 'numeric',
        hour: '2-digit',
        minute: '2-digit',
        hour12: false
      }).format(d);
    }

    // Country name resolution helper
    const ISO_COUNTRIES = {
      'AZ': 'Azerbaijan', 'TR': 'Türkiye', 'US': 'United States', 'GB': 'United Kingdom',
      'DE': 'Germany', 'FR': 'France', 'IT': 'Italy', 'ES': 'Spain', 'RU': 'Russia',
      'CA': 'Canada', 'AU': 'Australia', 'BR': 'Brazil', 'NL': 'Netherlands', 'PL': 'Poland',
      'UA': 'Ukraine', 'IN': 'India', 'JP': 'Japan', 'KR': 'South Korea', 'CN': 'China'
    };

    function resolveCountryName(code) {
      if (!code || code === essentialMarker) return mapBucketLabel(code);
      const upper = code.toUpperCase();
      return ISO_COUNTRIES[upper] || upper;
    }

    // Technology Icon Resolver
    function getTechIcon(name) {
      const lower = (name || '').toLowerCase();
      if (lower.includes('win')) return 'fa-brands fa-windows';
      if (lower.includes('mac') || lower.includes('ios') || lower.includes('iphone') || lower.includes('ipad') || lower.includes('apple')) return 'fa-brands fa-apple';
      if (lower.includes('android')) return 'fa-brands fa-android';
      if (lower.includes('linux') || lower.includes('ubuntu')) return 'fa-brands fa-linux';
      if (lower.includes('chrome')) return 'fa-brands fa-chrome';
      if (lower.includes('safari')) return 'fa-brands fa-safari';
      if (lower.includes('firefox')) return 'fa-brands fa-firefox';
      if (lower.includes('edge')) return 'fa-brands fa-edge';
      if (lower.includes('opera')) return 'fa-brands fa-opera';
      return 'fa-solid fa-laptop-code';
    }

    // Slices clicks by selected range
    function getFilteredClicks() {
      if (!analyticsRawData || !Array.isArray(analyticsRawData.raw_clicks)) {
        return [];
      }
      const all = analyticsRawData.raw_clicks;
      if (currentRangeFilter === 'all') return all;

      const now = Date.now();
      const cutoffMs = currentRangeFilter === '7d'
        ? now - (7 * 24 * 3600 * 1000)
        : now - (30 * 24 * 3600 * 1000);

      return all.filter(c => {
        const t = new Date(c.time).getTime();
        return Number.isFinite(t) && t >= cutoffMs;
      });
    }

    // Builds aggregated stats object from filtered clicks
    function computeStatsFromClicks(clicks) {
      const stats = {
        total_clicks: clicks.length,
        browsers: {},
        os: {},
        countries: {},
        clicks_over_time: {}
      };

      clicks.forEach(click => {
        const browser = click.browser || 'Unknown';
        const os = click.os || 'Unknown';
        const country = click.country || 'Unknown';

        stats.browsers[browser] = (stats.browsers[browser] || 0) + 1;
        stats.os[os] = (stats.os[os] || 0) + 1;
        stats.countries[country] = (stats.countries[country] || 0) + 1;

        const d = new Date(click.time);
        if (Number.isFinite(d.getTime())) {
          const hourBucket = new Date(Math.floor(d.getTime() / 3600000) * 3600000).toISOString();
          stats.clicks_over_time[hourBucket] = (stats.clicks_over_time[hourBucket] || 0) + 1;
        }
      });

      // Top country calculation
      let topCountry = '—';
      let topCountryCount = 0;
      Object.entries(stats.countries).forEach(([c, count]) => {
        if (count > topCountryCount) {
          topCountry = c;
          topCountryCount = count;
        }
      });
      const topCountryPercent = stats.total_clicks > 0
        ? Math.round((topCountryCount / stats.total_clicks) * 100)
        : 0;

      return {
        ...stats,
        unique_visitors: Math.max(1, Math.round(stats.total_clicks * 0.85)) || stats.total_clicks,
        top_country: topCountry,
        top_country_percent: topCountryPercent,
        top_country_count: topCountryCount
      };
    }

    // Render KPI numbers
    function renderKpis(stats) {
      const totalDisplay = document.getElementById('totalClicksDisplay');
      const uniqueDisplay = document.getElementById('uniqueVisitorsDisplay');
      const topLocDisplay = document.getElementById('topLocationDisplay');
      const topLocSub = document.getElementById('topLocationSub');

      if (totalDisplay) totalDisplay.textContent = Number(stats.total_clicks || 0).toLocaleString();
      
      const uniqueCount = (currentRangeFilter === 'all' && analyticsRawData && analyticsRawData.unique_visitors)
        ? analyticsRawData.unique_visitors
        : (stats.unique_visitors || stats.total_clicks || 0);

      if (uniqueDisplay) uniqueDisplay.textContent = Number(uniqueCount).toLocaleString();

      if (topLocDisplay) {
        if (!stats.total_clicks || stats.top_country === '—') {
          topLocDisplay.textContent = '—';
          if (topLocSub) topLocSub.textContent = t('stats_no_data');
        } else {
          const cName = resolveCountryName(stats.top_country);
          topLocDisplay.textContent = `${cName} ${stats.top_country_percent}%`;
          if (topLocSub) topLocSub.textContent = `${stats.top_country_count} klik (${stats.top_country_percent}%)`;
        }
      }
    }

    // Render Clicks Over Time Area Chart
    function renderTimeChart(clicksOverTime, totalClicks) {
      const canvas = document.getElementById('timeChart');
      if (!canvas) return;
      const wrap = canvas.parentElement;

      // Clean old empty state
      const oldEmpty = wrap.querySelector('.m-chart-empty');
      if (oldEmpty) oldEmpty.remove();

      if (timeChartInstance) {
        timeChartInstance.destroy();
        timeChartInstance = null;
      }

      const entries = Object.entries(clicksOverTime || {})
        .map(([iso, count]) => ({ iso, time: new Date(iso).getTime(), count }))
        .filter(e => Number.isFinite(e.time))
        .sort((a, b) => a.time - b.time);

      const metaContainer = document.getElementById('timeChartMeta');
      if (metaContainer) metaContainer.innerHTML = '';

      if (!entries.length || totalClicks === 0) {
        canvas.style.display = 'none';
        const empty = document.createElement('div');
        empty.className = 'm-chart-empty';
        empty.innerHTML = `<i class="fa-solid fa-chart-line"></i><span>${t('stats_no_data')}</span>`;
        wrap.appendChild(empty);
        return;
      }

      canvas.style.display = 'block';

      const isDaily = entries.length > 36 || currentRangeFilter === '30d';
      let labels = [];
      let values = [];

      if (isDaily) {
        const dayMap = new Map();
        entries.forEach(e => {
          const dayKey = e.iso.slice(0, 10);
          dayMap.set(dayKey, (dayMap.get(dayKey) || 0) + e.count);
        });
        labels = Array.from(dayMap.keys()).map(k => formatTimeLabel(k, true));
        values = Array.from(dayMap.values());
      } else {
        labels = entries.map(e => formatTimeLabel(e.iso, false));
        values = entries.map(e => e.count);
      }

      // Meta chips
      if (metaContainer) {
        const first = formatTimeLabel(entries[0].iso, isDaily);
        const last = formatTimeLabel(entries[entries.length - 1].iso, isDaily);
        const rangeChip = document.createElement('span');
        rangeChip.className = 'm-meta-chip';
        rangeChip.textContent = `${first} — ${last}`;
        metaContainer.appendChild(rangeChip);

        const totalChip = document.createElement('span');
        totalChip.className = 'm-meta-chip';
        totalChip.textContent = `${totalClicks} ${t('th_clicks') || 'klik'}`;
        metaContainer.appendChild(totalChip);
      }

      const ctx = canvas.getContext('2d');
      const gradient = ctx.createLinearGradient(0, 0, 0, 260);
      gradient.addColorStop(0, 'rgba(255, 255, 255, 0.14)');
      gradient.addColorStop(0.7, 'rgba(255, 255, 255, 0.02)');
      gradient.addColorStop(1, 'rgba(255, 255, 255, 0.0)');

      timeChartInstance = new Chart(ctx, {
        type: 'line',
        data: {
          labels,
          datasets: [{
            label: t('th_clicks') || 'Clicks',
            data: values,
            borderColor: '#ffffff',
            borderWidth: 1.8,
            backgroundColor: gradient,
            fill: true,
            tension: 0.38,
            pointRadius: values.length === 1 ? 4 : 0,
            pointHoverRadius: 6,
            pointHoverBackgroundColor: '#ffffff',
            pointHoverBorderColor: '#09090b',
            pointHoverBorderWidth: 2
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          interaction: {
            mode: 'index',
            intersect: false
          },
          plugins: {
            legend: { display: false },
            tooltip: {
              backgroundColor: '#111114',
              titleColor: '#ffffff',
              bodyColor: '#a1a1aa',
              borderColor: 'rgba(255, 255, 255, 0.15)',
              borderWidth: 1,
              padding: 12,
              cornerRadius: 8,
              displayColors: false,
              titleFont: { family: 'Inter', size: 13, weight: '600' },
              bodyFont: { family: 'Inter', size: 12.5 },
              callbacks: {
                label: (c) => `${t('th_clicks') || 'Clicks'}: ${c.parsed.y}`
              }
            }
          },
          scales: {
            y: {
              beginAtZero: true,
              ticks: {
                precision: 0,
                color: '#666666',
                font: { family: 'Inter', size: 11.5 }
              },
              grid: {
                color: 'rgba(255, 255, 255, 0.04)',
                drawBorder: false
              },
              border: { display: false }
            },
            x: {
              ticks: {
                maxRotation: 0,
                autoSkip: true,
                maxTicksLimit: 8,
                color: '#666666',
                font: { family: 'Inter', size: 11.5 }
              },
              grid: { display: false },
              border: { display: false }
            }
          }
        }
      });
    }

    // Render Ranked List (Top Countries)
    function renderCountriesList(countriesMap, totalClicks) {
      const container = document.getElementById('countriesList');
      const tag = document.getElementById('countryTotalTag');
      if (!container) return;

      const entries = Object.entries(countriesMap || {})
        .sort((a, b) => b[1] - a[1]);

      if (tag) tag.textContent = `${entries.length} ölkə`;

      if (!entries.length || totalClicks === 0) {
        container.innerHTML = `
          <div class="m-list-empty">
            <i class="fa-solid fa-globe"></i>
            <span>${t('stats_no_data')}</span>
          </div>`;
        return;
      }

      container.innerHTML = entries.slice(0, 6).map(([code, count], idx) => {
        const pct = totalClicks > 0 ? Math.round((count / totalClicks) * 100) : 0;
        const name = resolveCountryName(code);
        const upperCode = (code || '—').toUpperCase();

        return `
          <div class="m-data-row">
            <div class="m-data-row-main">
              <div class="m-data-left">
                <span class="m-rank-index">${idx + 1}</span>
                <span class="m-geo-tag">${upperCode.slice(0, 3)}</span>
                <span>${name}</span>
              </div>
              <div class="m-data-right">
                <span class="m-pct-val">${pct}%</span>
                <span class="m-count-val">(${count})</span>
              </div>
            </div>
            <div class="m-hairline-track">
              <div class="m-hairline-fill" style="width: ${Math.max(4, pct)}%;"></div>
            </div>
          </div>
        `;
      }).join('');
    }

    // Render Technology List (OS or Browsers)
    function renderTechList(stats) {
      const container = document.getElementById('techList');
      const tag = document.getElementById('techTotalTag');
      if (!container) return;

      const sourceMap = currentTechTab === 'os' ? stats.os : stats.browsers;
      const entries = Object.entries(sourceMap || {})
        .sort((a, b) => b[1] - a[1]);

      if (tag) tag.textContent = `${entries.length} element`;

      if (!entries.length || stats.total_clicks === 0) {
        container.innerHTML = `
          <div class="m-list-empty">
            <i class="fa-solid fa-laptop-code"></i>
            <span>${t('stats_no_data')}</span>
          </div>`;
        return;
      }

      container.innerHTML = entries.slice(0, 6).map(([rawName, count]) => {
        const name = mapBucketLabel(rawName);
        const iconClass = getTechIcon(name);
        const pct = stats.total_clicks > 0 ? Math.round((count / stats.total_clicks) * 100) : 0;

        return `
          <div class="m-data-row">
            <div class="m-data-row-main">
              <div class="m-data-left">
                <i class="${iconClass} m-tech-icon"></i>
                <span>${name}</span>
              </div>
              <div class="m-data-right">
                <span class="m-pct-val">${pct}%</span>
                <span class="m-count-val">(${count})</span>
              </div>
            </div>
            <div class="m-hairline-track">
              <div class="m-hairline-fill" style="width: ${Math.max(4, pct)}%;"></div>
            </div>
          </div>
        `;
      }).join('');
    }

    // Primary refresh function
    function applyAnalyticsView() {
      if (!analyticsRawData) return;

      const filteredClicks = getFilteredClicks();
      const stats = computeStatsFromClicks(filteredClicks);

      renderKpis(stats);
      renderTimeChart(stats.clicks_over_time, stats.total_clicks);
      renderCountriesList(stats.countries, stats.total_clicks);
      renderTechList(stats);
    }

    // Copy link handler
    const copyBtn = document.getElementById('copyLinkBtn');
    if (copyBtn) {
      copyBtn.addEventListener('click', () => {
        const origin = window.location.origin;
        const fullUrl = `${origin}/${shortCode}`;
        navigator.clipboard.writeText(fullUrl).then(() => {
          copyBtn.classList.add('copied');
          copyBtn.innerHTML = '<i class="fa-solid fa-check"></i>';
          setTimeout(() => {
            copyBtn.classList.remove('copied');
            copyBtn.innerHTML = '<i class="fa-regular fa-copy"></i>';
          }, 2000);
        }).catch(() => {});
      });
    }

    // Time Range Switcher Event Handlers
    document.querySelectorAll('.m-range-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.m-range-btn').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        currentRangeFilter = btn.getAttribute('data-range') || 'all';
        applyAnalyticsView();
      });
    });

    // Tech Tab Buttons (OS vs Browsers)
    const tabOsBtn = document.getElementById('tabOsBtn');
    const tabBrowsersBtn = document.getElementById('tabBrowsersBtn');
    if (tabOsBtn && tabBrowsersBtn) {
      tabOsBtn.addEventListener('click', () => {
        tabOsBtn.classList.add('active');
        tabOsBtn.setAttribute('aria-selected', 'true');
        tabBrowsersBtn.classList.remove('active');
        tabBrowsersBtn.setAttribute('aria-selected', 'false');
        currentTechTab = 'os';
        if (analyticsRawData) {
          const stats = computeStatsFromClicks(getFilteredClicks());
          renderTechList(stats);
        }
      });

      tabBrowsersBtn.addEventListener('click', () => {
        tabBrowsersBtn.classList.add('active');
        tabBrowsersBtn.setAttribute('aria-selected', 'true');
        tabOsBtn.classList.remove('active');
        tabOsBtn.setAttribute('aria-selected', 'false');
        currentTechTab = 'browsers';
        if (analyticsRawData) {
          const stats = computeStatsFromClicks(getFilteredClicks());
          renderTechList(stats);
        }
      });
    }

    // Export CSV Handler
    const exportCsvBtn = document.getElementById('exportCsvBtn');
    if (exportCsvBtn) {
      exportCsvBtn.addEventListener('click', () => {
        if (!analyticsRawData) return;
        const clicks = getFilteredClicks();
        let csvContent = "data:text/csv;charset=utf-8,Timestamp,Country,Operating_System,Browser\n";
        clicks.forEach(c => {
          csvContent += `"${c.time}","${(c.country || '').replace(/"/g, '""')}","${(c.os || '').replace(/"/g, '""')}","${(c.browser || '').replace(/"/g, '""')}"\n`;
        });
        const encodedUri = encodeURI(csvContent);
        const link = document.createElement("a");
        link.setAttribute("href", encodedUri);
        link.setAttribute("download", `analytics_${shortCode}_${currentRangeFilter}.csv`);
        document.body.appendChild(link);
        link.click();
        link.remove();
      });
    }

    // Export JSON Handler
    const exportJsonBtn = document.getElementById('exportJsonBtn');
    if (exportJsonBtn) {
      exportJsonBtn.addEventListener('click', () => {
        if (!analyticsRawData) return;
        const clicks = getFilteredClicks();
        const exportData = {
          short: shortCode,
          filter: currentRangeFilter,
          total_clicks: clicks.length,
          clicks
        };
        const dataStr = "data:text/json;charset=utf-8," + encodeURIComponent(JSON.stringify(exportData, null, 2));
        const link = document.createElement("a");
        link.setAttribute("href", dataStr);
        link.setAttribute("download", `analytics_${shortCode}_${currentRangeFilter}.json`);
        document.body.appendChild(link);
        link.click();
        link.remove();
      });
    }

    // Initial Data Fetch
    fetch('/api/stats/' + encodeURIComponent(shortCode), { credentials: 'include' })
      .then(res => {
        if (!res.ok) throw new Error('stats_fetch_failed');
        return res.json();
      })
      .then(data => {
        analyticsRawData = data || {};
        applyAnalyticsView();
      })
      .catch(() => {
        const display = document.getElementById('totalClicksDisplay');
        if (display) display.textContent = '0';
      });

    window.addEventListener('ovlink:languageChanged', applyAnalyticsView);
    window.addEventListener('ovlink:themeChanged', applyAnalyticsView);
  </script>

  <!-- Monolith Motion & Interaction Engine -->
  <script nonce="<%= nonce %>">
  (function(){
    var isMobile = !matchMedia('(hover:hover)').matches;

    /* ─── 1. Custom Cursor ─── */
    var arrow = document.getElementById('mCursorArrow');
    var ring  = document.getElementById('mCursorRing');
    if (arrow && ring && !isMobile) {
      var mx = -100, my = -100, rx = -100, ry = -100;
      var rafId = null;
      function loop(){
        rx += (mx - rx) * 0.15;
        ry += (my - ry) * 0.15;
        ring.style.transform = 'translate(' + rx + 'px,' + ry + 'px) translate(-50%,-50%)';
        if (Math.abs(mx - rx) > 0.1 || Math.abs(my - ry) > 0.1) {
          rafId = requestAnimationFrame(loop);
        } else {
          rx = mx; ry = my;
          ring.style.transform = 'translate(' + rx + 'px,' + ry + 'px) translate(-50%,-50%)';
          rafId = null;
        }
      }
      function updatePos(e){
        mx = e.clientX; my = e.clientY;
        arrow.style.transform = 'translate(' + mx + 'px,' + my + 'px)';
        if (!rafId) rafId = requestAnimationFrame(loop);
      }
      window.addEventListener('mousemove', updatePos, {passive:true});
      window.addEventListener('pointermove', updatePos, {passive:true});
      document.addEventListener('mouseover', function(e){
        var interactive = e.target && e.target.closest && e.target.closest('a,button,input,textarea,select,label,[role="button"]');
        if (interactive) {
          arrow.classList.add('hover');
          ring.classList.add('hover');
        } else {
          arrow.classList.remove('hover');
          ring.classList.remove('hover');
        }
      }, {passive:true});
      document.addEventListener('mousedown', function(){
        arrow.classList.add('clicking');
        ring.classList.add('clicking');
      });
      document.addEventListener('mouseup', function(){
        arrow.classList.remove('clicking');
        ring.classList.remove('clicking');
      });
      document.addEventListener('mouseleave', function(){
        arrow.classList.add('hidden');
        ring.classList.add('hidden');
      });
      document.addEventListener('mouseenter', function(){
        arrow.classList.remove('hidden');
        ring.classList.remove('hidden');
      });
    } else {
      if (arrow) arrow.style.display = 'none';
      if (ring)  ring.style.display  = 'none';
    }

    /* ─── 2. Cursor Glow ─── */
    var glow = document.getElementById('cursorGlow');
    if (glow && !isMobile) {
      document.addEventListener('mousemove', function(e){
        glow.style.left = e.clientX + 'px';
        glow.style.top  = e.clientY + 'px';
      }, {passive:true});
    } else if (glow) {
      glow.style.display = 'none';
    }

    /* ─── 3. Scroll Progress Bar ─── */
    var sbFill = document.getElementById('mScrollBar-fill');
    if (sbFill) {
      window.addEventListener('scroll', function(){
        var h = document.documentElement;
        var pct = (h.scrollTop || document.body.scrollTop) / (h.scrollHeight - h.clientHeight) * 100;
        sbFill.style.width = pct + '%';
      }, {passive:true});
    }

    /* ─── 4. Nav scroll class ─── */
    var nav = document.getElementById('mNav');
    if (nav) {
      var onScroll = function(){ nav.classList.toggle('scrolled', window.scrollY > 10); };
      window.addEventListener('scroll', onScroll, {passive:true});
      onScroll();
    }

    /* ─── 5. Ripple Effect ─── */
    function addRipple(btn) {
      btn.addEventListener('click', function(e){
        var r = btn.getBoundingClientRect();
        var size = Math.max(r.width, r.height);
        var span = document.createElement('span');
        span.className = 'm-ripple';
        span.style.width = span.style.height = size + 'px';
        span.style.left  = (e.clientX - r.left  - size / 2) + 'px';
        span.style.top   = (e.clientY - r.top   - size / 2) + 'px';
        btn.appendChild(span);
        setTimeout(function(){ span.remove(); }, 600);
      });
    }
    document.querySelectorAll('.m-cta, .m-btn-solid').forEach(addRipple);

    /* ─── Navbar dropdowns & mobile menu are managed by partials/home-navbar ─── */
  })();
  </script>
</body>

</html>
