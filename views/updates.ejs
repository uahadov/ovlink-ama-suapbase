<!doctype html>
<html lang="<%= (seo && seo.lang) ? seo.lang : 'en' %>">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="csrf-token" content="<%= csrfToken %>">
  <title><%= (seo && seo.title) ? seo.title : 'Ovlink — Updates & Changelog' %></title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=<%= assetVersion %>" />
  <link rel="icon" href="/logo.ico" />
  <link rel="manifest" href="/site.webmanifest" />

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin>
  <link rel="preload" href="/vendor/fontawesome/webfonts/fa-solid-900.woff2?v=<%= (typeof assetVersion !== 'undefined' ? assetVersion : '1') %>" as="font" type="font/woff2" crossorigin />
  <link rel="stylesheet" href="/vendor/fontawesome/css/all.min.css?v=<%= (typeof assetVersion !== 'undefined' ? assetVersion : '1') %>" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" integrity="sha512-iecdLmaskl7CVkqkXNQ/ZH/XLlvWZOJyj7Yy7tcenmpD1ypASozpmT/E0iPtmFIB46ZmdtAc9eNBvH0H/ZpiBw==" crossorigin="anonymous" referrerpolicy="no-referrer" />

  <link rel="stylesheet" href="/home.css?v=<%= assetVersion %>" />

  <meta name="description" content="<%= (seo && seo.description) ? seo.description : '' %>" />
  <meta name="keywords" content="<%= (seo && seo.keywords) ? seo.keywords : '' %>" />
  <link rel="canonical" href="<%= (seo && seo.canonical) ? seo.canonical : '' %>" />
  <link rel="alternate" hreflang="en" href="<%= (seo && seo.hreflangEn) ? seo.hreflangEn : '' %>" />
  <link rel="alternate" hreflang="az" href="<%= (seo && seo.hreflangAz) ? seo.hreflangAz : '' %>" />
  <link rel="alternate" hreflang="tr" href="<%= (seo && seo.hreflangTr) ? seo.hreflangTr : '' %>" />
  <link rel="alternate" hreflang="x-default" href="<%= (seo && seo.hreflangXDefault) ? seo.hreflangXDefault : '' %>" />
  <meta property="og:title" content="<%= (seo && seo.ogTitle) ? seo.ogTitle : '' %>" />
  <meta property="og:description" content="<%= (seo && seo.ogDescription) ? seo.ogDescription : '' %>" />
  <meta property="og:url" content="<%= (seo && seo.ogUrl) ? seo.ogUrl : '' %>" />
  <meta property="og:type" content="website" />
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content="<%= (seo && seo.twitterTitle) ? seo.twitterTitle : '' %>" />
  <meta name="twitter:description" content="<%= (seo && seo.twitterDescription) ? seo.twitterDescription : '' %>" />
  <% if (seo && seo.jsonLd) { %>
  <script nonce="<%= nonce %>" type="application/ld+json"><%- seo.jsonLd %></script>
  <% } %>
</head>

<body class="ovx home-page updates-page">

  <!-- Skip to content for accessibility -->
  <a href="#mainContent" class="m-skip-link" data-i18n="skip_to_content">Skip to content</a>

  <!-- Ambient background glow -->
  <div id="cursorGlow" aria-hidden="true"></div>

  <% if (siteSettings && siteSettings.announcement_enabled === '1' && (siteSettings.announcement_text_az || siteSettings.announcement_text_tr || siteSettings.announcement_text_en)) { %>
    <div id="siteAnnouncement" class="site-announcement" data-az="<%= siteSettings.announcement_text_az || '' %>" data-tr="<%= siteSettings.announcement_text_tr || '' %>" data-en="<%= siteSettings.announcement_text_en || '' %>">
      <div class="shell">
        <i class="fa-solid fa-bullhorn"></i>
        <span id="siteAnnouncementText"><%= siteSettings.announcement_text_az || siteSettings.announcement_text_tr || siteSettings.announcement_text_en %></span>
      </div>
    </div>
  <% } %>

  <%- include('partials/home-navbar') %>

  <main class="m-page-shell m-page-shell--top" id="mainContent">
    <div class="shell" style="max-width: 900px; width: 100%;">

      <!-- Header / Hero Section -->
      <section class="m-content-hero" aria-labelledby="updatesPageHeading">
        <div class="m-hero-eyebrow mb-3" style="display:inline-flex; align-items:center; gap:8px; margin-bottom: 18px;">
          <span class="m-live-dot" aria-hidden="true"></span>
          <span data-i18n="hero_badge">Ovlink - Next-Gen Link Management</span>
        </div>
        <h1 id="updatesPageHeading" data-i18n="updates_page_title">Yeniliklər</h1>
        <p data-i18n="updates_page_intro">
          Ovlink üçün son ictimai yenilikləri burada görəcəksiniz.
        </p>
      </section>

      <!-- Scope Notice Card -->
      <aside class="m-card-monolith mb-5" style="padding: 20px 24px; margin-bottom: 40px; border-left: 3px solid var(--c-white); display: flex; flex-direction: row; align-items: center; gap: 16px;">
        <div style="font-size: 20px; color: var(--c-white); flex-shrink: 0;" aria-hidden="true">
          <i class="fa-solid fa-bullseye"></i>
        </div>
        <div>
          <div style="font-size: 14px; font-weight: 700; color: var(--c-white); margin-bottom: 4px;" data-i18n="updates_scope_title">Bu səhifənin məqsədi</div>
          <div style="font-size: 13px; color: var(--c-muted); line-height: 1.5;" data-i18n="updates_scope_desc">Burada yalnız istifadəçiyə təsir edən yenilikləri paylaşırıq. Daxili texniki dəyişikliklər bu siyahıya əlavə edilmir.</div>
        </div>
      </aside>

      <!-- Monolith Timeline -->
      <div class="m-timeline">

        <!-- Entry: Monolith Dashboard Refinements -->
        <article class="m-timeline-item">
          <div class="m-timeline-node" aria-hidden="true"><div class="m-timeline-node-inner"></div></div>
          <div class="m-timeline-card">
            <div class="m-timeline-header">
              <h2 class="m-timeline-title">
                <i class="fa-solid fa-sliders" style="font-size: 14px; color: var(--c-white);" aria-hidden="true"></i>
                <span data-i18n="updates_release_20260917_dash_title">Monolith Dashboard Təkmilləşdirmələri</span>
              </h2>
              <span class="m-timeline-date" data-i18n="updates_release_20260917_dash_badge">17.09.2026</span>
            </div>
            <p class="m-timeline-desc" data-i18n="updates_release_20260917_dash_desc">İdarə paneli dizaynı Monolith standartlarına tam uyğunlaşdırıldı, seçim sahələri, əməliyyat düymələri və mətn düzülüşləri təkmilləşdirildi.</p>
            <ul class="m-timeline-list">
              <li data-i18n="updates_release_20260917_dash_item1">Qaranlıq Rejim Seçim Sahələri: Bütün seçim və çeşidləmə menyuları xüsusi ox indikatoru və qaranlıq kətan üslubu ilə təmin edildi.</li>
              <li data-i18n="updates_release_20260917_dash_item2">Görünən və Rahat Düymələr: Cədvəldəki redaktə, etiket və kopyalama düymələrinin kontrastı artırıldı, aralarındakı məsafə optimallaşdırıldı.</li>
              <li data-i18n="updates_release_20260917_dash_item3">Dəqiq Başlıq və Alətlər Paneli: Səhifə alt başlığı düzəldildi, toplu silmə və ixrac düymələrinin ikon və yazı sabitliyi qorundu.</li>
            </ul>
          </div>
        </article>

        <!-- Entry: Monolith Link Limit & Gateway Error Views Redesign -->
        <article class="m-timeline-item">
          <div class="m-timeline-node" aria-hidden="true"><div class="m-timeline-node-inner"></div></div>
          <div class="m-timeline-card">
            <div class="m-timeline-header">
              <h2 class="m-timeline-title">
                <i class="fa-solid fa-gauge-high" style="font-size: 14px; color: var(--c-white);" aria-hidden="true"></i>
                <span data-i18n="updates_release_20260917_limits_title">Monolith Link Limiti və Xəta Səhifələri Redizaynı</span>
              </h2>
              <span class="m-timeline-date" data-i18n="updates_release_20260917_limits_badge">17.09.2026</span>
            </div>
            <p class="m-timeline-desc" data-i18n="updates_release_20260917_limits_desc">Maksimum klik limitinə çatan qısa keçidlərin xəbərdarlıq ekranı və bütün sistem xəta səhifələri Monolith dizaynına tam uyğunlaşdırıldı, Pro tələbi aradan qaldırıldı və qlobal naviqasiya inteqrasiya edildi.</p>
            <ul class="m-timeline-list">
              <li data-i18n="updates_release_20260917_limits_item1">Pulsuz İstifadəçi Limiti Aydınlığı: Fərdi yönləndirmə limiti bütün istifadəçilər üçün 100% pulsuz xüsusiyyət kimi düzəldildi, çaşdırıcı Pro ödəniş tələbi və düymələri tam çıxarıldı.</li>
              <li data-i18n="updates_release_20260917_limits_item2">Monolith Universal Header və Footer: Loqo, işlək çoxdilli menyu (AZ/TR/EN), autentifikasiya qapısı və hüquqi alt menyu bütün xəta səhifələrinə inteqrasiya olundu.</li>
              <li data-i18n="updates_release_20260917_limits_item3">Tam Lokallaşdırma və İnteraktivlik: Diaqnostika göstəriciləri tam i18n tərcümələri ilə təmin edildi, hədd aşımı ölçən dinamik SVG animasiyası və ambient kursor aktivləşdirildi.</li>
            </ul>
          </div>
        </article>

        <!-- Entry: Monolith Account Navigation Hub -->
        <article class="m-timeline-item">
          <div class="m-timeline-node" aria-hidden="true"><div class="m-timeline-node-inner"></div></div>
          <div class="m-timeline-card">
            <div class="m-timeline-header">
              <h2 class="m-timeline-title">
                <i class="fa-solid fa-circle-user" style="font-size: 14px; color: var(--c-white);" aria-hidden="true"></i>
                <span data-i18n="updates_release_20260917_acc_title">Monolith Hesab Naviqasiya Mərkəzi və Açılan Menyu</span>
              </h2>
              <span class="m-timeline-date" data-i18n="updates_release_20260917_acc_badge">17.09.2026</span>
            </div>
            <p class="m-timeline-desc" data-i18n="updates_release_20260917_acc_desc">Tək istifadəçi ikonu əvəzinə fırlanan ox indikatorlu, toxunuşa həssas Monolith hesab düyməsi və İdarə Paneli, İş Sahələri, Hesab Parametrləri və Bildirişlərə birbaşa çıxış verən zəngin naviqasiya mərkəzi istifadəyə verildi.</p>
            <ul class="m-timeline-list">
              <li data-i18n="updates_release_20260917_acc_item1">İntuitiv Hesab Həbi: Təbii hesab ikonu, lokallaşdırılmış ad və 180 dərəcə dönən ox ilə təchiz olunmuş vahid Monolith düyməsi.</li>
              <li data-i18n="updates_release_20260917_acc_item2">Zəngin Açılan Naviqasiya: İstifadəçi e-poçtu və PRO/FREE statusu, İdarə Paneli, İş Sahələri, Hesab Parametrləri və Bildiriş mərkəzinə rahat keçidlər.</li>
              <li data-i18n="updates_release_20260917_acc_item3">Tam Hadisə Sabitliyi: Bütün səhifələrdə toqquşan klik dinləyiciləri aradan qaldırıldı, menyu etibarlı açılma və kənara kliklə yumşaq bağlanma mexanizmi ilə təmin edildi.</li>
            </ul>
          </div>
        </article>

        <!-- Entry 0: Universal Navbar & Language Switcher Reliability -->
        <article class="m-timeline-item">
          <div class="m-timeline-node" aria-hidden="true"><div class="m-timeline-node-inner"></div></div>
          <div class="m-timeline-card">
            <div class="m-timeline-header">
              <h2 class="m-timeline-title">
                <i class="fa-solid fa-language" style="font-size: 14px; color: var(--c-white);" aria-hidden="true"></i>
                <span data-i18n="updates_release_20260917_lang_title">Universal Naviqasiya və Dil Dəyişdirici Sabitliyi</span>
              </h2>
              <span class="m-timeline-date" data-i18n="updates_release_20260917_lang_badge">17.09.2026</span>
            </div>
            <p class="m-timeline-desc" data-i18n="updates_release_20260917_lang_desc">Ana səhifə və bütün köməkçi səhifələrdə dil seçimi menyusunun açılma dayanıqlığı təmin edildi, hadisə toqquşmaları aradan qaldırıldı və real vaxt tərcümə sinxronizasiyası gücləndirildi.</p>
            <ul class="m-timeline-list">
              <li data-i18n="updates_release_20260917_lang_item1">Birtoxunuşlu Açılma Sabitliyi: Dil və istifadəçi menyularında təkrarlanan hadisə dinləyiciləri ləğv edildi, z-index qatı gücləndirildi və klik toqquşmaları tamamilə həll edildi.</li>
              <li data-i18n="updates_release_20260917_lang_item2">Dərhal Canlı Dil Dəyişimi: AZ, TR və EN dilləri arasında keçid zamanı interfeys ikonları və mürəkkəb elementlər pozulmadan tam səliqə ilə yenilənir.</li>
              <li data-i18n="updates_release_20260917_lang_item3">Mobil Menyu Uyğunluğu: Mobil görünüşdə dil menyusunun yuxarıya doğru asan açılması və kənara kliklə bağlanan universal menyu idarəçisi.</li>
            </ul>
          </div>
        </article>

        <!-- Entry 0: Monolith Email Templates & Offline PWA HUD -->
        <article class="m-timeline-item">
          <div class="m-timeline-node" aria-hidden="true"><div class="m-timeline-node-inner"></div></div>
          <div class="m-timeline-card">
            <div class="m-timeline-header">
              <h2 class="m-timeline-title">
                <i class="fa-solid fa-envelope-open-text" style="font-size: 14px; color: var(--c-white);" aria-hidden="true"></i>
                <span data-i18n="updates_release_20260917_emails_title">Monolith E-poçt Şablonları və Oflayn PWA HUD</span>
              </h2>
              <span class="m-timeline-date" data-i18n="updates_release_20260917_emails_badge">17.09.2026</span>
            </div>
            <p class="m-timeline-desc" data-i18n="updates_release_20260917_emails_desc">Bütün tranzaksiya e-poçtları (təsdiqləmə kodları, şifrə sıfırlama, təhlükəsizlik bildirişləri və dəvətlər) Monolith qaranlıq kətanına keçirildi, oflayn PWA ekranı kibernetik HUD ilə yeniləndi.</p>
            <ul class="m-timeline-list">
              <li data-i18n="updates_release_20260917_emails_item1">Zifiri Qaranlıq Tranzaksiya E-poçtları: #0a0a0a kətan, #111111 kart strukturu, JetBrains Mono 6 rəqəmli monospace kod bloku və bütün e-poçt müştəriləri ilə tam uyğunluq.</li>
              <li data-i18n="updates_release_20260917_emails_item2">Kibernetik Oflayn PWA HUD: İnternet kəsildikdə animasiyalı radar/antenna SVG diaqramı, oflayn status bildirişi və əlaqə bərpa olunduqda avtomatik səhifə yenilənməsi.</li>
              <li data-i18n="updates_release_20260917_emails_item3">Təhlükəsizlik və Çoxdilli Uyğunluq: Giriş cihazı telemetriyası, IP məxfilik qorunması və AZ/TR/EN dillərində tam sinxronizasiya.</li>
            </ul>
          </div>
        </article>

        <!-- Entry 0: Admin Console Monolith Redesign & System Cleanup -->
        <article class="m-timeline-item">
          <div class="m-timeline-node" aria-hidden="true"><div class="m-timeline-node-inner"></div></div>
          <div class="m-timeline-card">
            <div class="m-timeline-header">
              <h2 class="m-timeline-title">
                <i class="fa-solid fa-terminal" style="font-size: 14px; color: var(--c-white);" aria-hidden="true"></i>
                <span data-i18n="updates_release_20260917_admin_title">Admin Konsolu Monolith Redizaynı və Sistem Təmizliyi</span>
              </h2>
              <span class="m-timeline-date" data-i18n="updates_release_20260917_admin_badge">17.09.2026</span>
            </div>
            <p class="m-timeline-desc" data-i18n="updates_release_20260917_admin_desc">Bütün idarəetmə konsolu (/admin/*), giriş səhifələri və audit jurnalları yüksək kontrastlı pitch-black Monolith dizaynına keçirildi, artıq partial fayllar təmizləndi.</p>
            <ul class="m-timeline-list">
              <li data-i18n="updates_release_20260917_admin_item1">Pitch-black Cyber Konsol: 17 admin alt səhifəsi, zifiri qaranlıq kətan (#0a0a0a), kart səthləri (#111111), hairline haşiyələr və Inter/JetBrains Mono şriftləri.</li>
              <li data-i18n="updates_release_20260917_admin_item2">Ambient Kursor və Giriş Təhlükəsizliyi: Giriş və 2FA ekranlarında #cursorGlow animasiyası, gücləndirilmiş audit jurnalları və yenilənmiş loqo.</li>
              <li data-i18n="updates_release_20260917_admin_item3">Kod Bazası Optimallaşdırması: Köhnəlmiş və təkrar partial faylların (public-navbar, public-footer, cookie-banner) tam silinməsi və arxitektura təmizlənməsi.</li>
            </ul>
          </div>
        </article>

        <!-- Entry 0: Dashboard Redesign & Bootstrap-Free Modals -->
        <article class="m-timeline-item">
          <div class="m-timeline-node" aria-hidden="true"><div class="m-timeline-node-inner"></div></div>
          <div class="m-timeline-card">
            <div class="m-timeline-header">
              <h2 class="m-timeline-title">
                <i class="fa-solid fa-chart-line" style="font-size: 14px; color: var(--c-white);" aria-hidden="true"></i>
                <span data-i18n="updates_release_20260917_dash_title">Monolith Dashboard və 100% Bootstrap-Free Modal Redizaynı</span>
              </h2>
              <span class="m-timeline-date" data-i18n="updates_release_20260917_dash_badge">17.09.2026</span>
            </div>
            <p class="m-timeline-desc" data-i18n="updates_release_20260917_dash_desc">İstifadəçi idarə paneli (/dashboard) sıfırdan Monolith Bento arxitekturasına keçirildi və bütün modal pəncərələr 100% Bootstrap-dan azad vanilla mühərriklə yeniləndi.</p>
            <ul class="m-timeline-list">
              <li data-i18n="updates_release_20260917_dash_item1">Bento Dashboard və İntellektual İdarə Paneli: Link sayı, şikayət telemetriyası və hesab vəziyyəti üçün Bento grid, ani axtarış, filtr və sıralama idarəetməsi.</li>
              <li data-i18n="updates_release_20260917_dash_item2">100% Bootstrap-Free Modal Mühərriki: Workspaces, Profil, Qovluq/Teq və Toplu Link idxalı dialoqları sıfır xarici asılılıqlı, sürətli və qaranlıq Monolith modallarla əvəzləndi.</li>
              <li data-i18n="updates_release_20260917_dash_item3">Monoxrom Estetika və İnteraktivlik: Pitch-black kətan, hairline sərhədlər, ambient kursor (#cursorGlow) və mobil responsiv cədvəl təcrübəsi.</li>
            </ul>
          </div>
        </article>

        <!-- Entry 1: Monolith Trio -->
        <article class="m-timeline-item">
          <div class="m-timeline-node" aria-hidden="true"><div class="m-timeline-node-inner"></div></div>
          <div class="m-timeline-card">
            <div class="m-timeline-header">
              <h2 class="m-timeline-title">
                <i class="fa-solid fa-layer-group" style="font-size: 14px; color: var(--c-white);" aria-hidden="true"></i>
                <span data-i18n="updates_release_20260916_monolith_trio_title">Monolith Redizaynı: Bot Qapısı, Bildiriş Mərkəzi və 404 Səhifəsi</span>
              </h2>
              <span class="m-timeline-date" data-i18n="updates_release_20260916_monolith_trio_badge">16.09.2026</span>
            </div>
            <p class="m-timeline-desc" data-i18n="updates_release_20260916_monolith_trio_desc">Bot bağlantısı, bildiriş mərkəzi və 404 xəta səhifələri Monolith dizayn sisteminə uyğun olaraq sıfırdan yenidən quruldu.</p>
            <ul class="m-timeline-list">
              <li data-i18n="updates_release_20260916_monolith_trio_item1">Telegram &amp; Discord Bot Qapısı: Tək toxunuşla qoşulma kodu kopyalama, təmiz mərkəzləşdirilmiş qaranlıq kart və addım-addım doğrulama.</li>
              <li data-i18n="updates_release_20260916_monolith_trio_item2">Bildiriş Mərkəzi: Hamısını oxundu/oxunmadı etmə və silmə əməliyyatları üçün Monolith idarə paneli və işıqlı oxunmamış bildiriş nöqtəsi.</li>
              <li data-i18n="updates_release_20260916_monolith_trio_item3">Minimalist 404 Səhifəsi: Yüksək təsirli monoxrom tipoqrafiya, sürətli bərpa düymələri və təmiz naviqasiya strukturu.</li>
            </ul>
          </div>
        </article>

        <!-- Entry 2: Auth Gate Redesign -->
        <article class="m-timeline-item">
          <div class="m-timeline-node" aria-hidden="true"><div class="m-timeline-node-inner"></div></div>
          <div class="m-timeline-card">
            <div class="m-timeline-header">
              <h2 class="m-timeline-title">
                <i class="fa-solid fa-lock" style="font-size: 14px; color: var(--c-white);" aria-hidden="true"></i>
                <span data-i18n="updates_release_20260916_authgate_title">Monolith Şifrə Sıfırlama və Keçid Qapısı Redizaynı</span>
              </h2>
              <span class="m-timeline-date" data-i18n="updates_release_20260916_authgate_badge">16.09.2026</span>
            </div>
