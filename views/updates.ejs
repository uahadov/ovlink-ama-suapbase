<!doctype html>
<html lang="<%= (seo && seo.lang) ? seo.lang : 'en' %>">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="csrf-token" content="<%= csrfToken %>">
  <title><%= (seo && seo.title) ? seo.title : 'Ovlink' %></title>
  <link rel="icon" href="/logo.ico" />
  <link rel="manifest" href="/site.webmanifest" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap" media="all" id="gf-css" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" media="all" id="fa-css" />
  <script nonce="<%= nonce %>">
    document.getElementById("gf-css").media = "all";
    document.getElementById("fa-css").media = "all";
  </script>
  <noscript>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
  </noscript>
  
  <link rel="stylesheet" href="/style.css?v=<%= assetVersion %>" />
  <meta name="description" content="<%= (seo && seo.description) ? seo.description : '' %>" />
  <meta name="keywords" content="<%= (seo && seo.keywords) ? seo.keywords : '' %>" />
  <link rel="canonical" href="<%= (seo && seo.canonical) ? seo.canonical : '' %>" />
  <link rel="alternate" hreflang="en" href="<%= (seo && seo.hreflangEn) ? seo.hreflangEn : '' %>" />
  <link rel="alternate" hreflang="az" href="<%= (seo && seo.hreflangAz) ? seo.hreflangAz : '' %>" />
  <link rel="alternate" hreflang="tr" href="<%= (seo && seo.hreflangTr) ? seo.hreflangTr : '' %>" />
  <link rel="alternate" hreflang="x-default" href="<%= (seo && seo.hreflangXDefault) ? seo.hreflangXDefault : '' %>" />
  <meta property="og:title" content="<%= (seo && seo.ogTitle) ? seo.ogTitle : '' %>" />
  <meta property="og:description" content="<%= (seo && seo.ogDescription) ? seo.ogDescription : '' %>" />
  <meta property="og:url" content="<%= (seo && seo.ogUrl) ? seo.ogUrl : '' %>" />
  <meta property="og:type" content="website" />
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content="<%= (seo && seo.twitterTitle) ? seo.twitterTitle : '' %>" />
  <meta name="twitter:description" content="<%= (seo && seo.twitterDescription) ? seo.twitterDescription : '' %>" />
  <% if (seo && seo.jsonLd) { %>
  <script nonce="<%= nonce %>" type="application/ld+json"><%- seo.jsonLd %></script>
  <% } %>
</head>

<body class="home-page policy-page updates-page animated-gradient-bg">

  <% if (siteSettings && siteSettings.announcement_enabled === '1' && (siteSettings.announcement_text_az || siteSettings.announcement_text_tr || siteSettings.announcement_text_en)) { %>
    <div id="siteAnnouncement" class="site-announcement" data-az="<%= siteSettings.announcement_text_az || '' %>" data-tr="<%= siteSettings.announcement_text_tr || '' %>" data-en="<%= siteSettings.announcement_text_en || '' %>">
      <div class="container">
        <i class="fa-solid fa-bullhorn"></i>
        <span id="siteAnnouncementText"><%= siteSettings.announcement_text_az || siteSettings.announcement_text_tr || siteSettings.announcement_text_en %></span>
      </div>
    </div>
  <% } %>

  <div id="particlesContainer" class="particles-container"></div>

  <%- include('partials/public-navbar') %>

  <main class="policy-main">
    <section class="container">
      <div class="policy-shell">
        <div class="policy-head">
          <div class="badge hero-chip rounded-pill px-3 py-2 mb-3 shadow-sm fw-semibold">
            <i class="fa-solid fa-rocket me-1"></i><span data-i18n="hero_badge">Ovlink - Next-Gen Link Management</span>
          </div>
          <h1 class="policy-title" data-i18n="updates_page_title">Yeniliklər</h1>
          <p class="hero-subtitle" data-i18n="updates_page_intro">Ovlink üçün son ictimai yenilikləri burada görəcəksiniz.</p>
        </div>

        <div class="policy-list updates-list">
          <article class="policy-card update-card">
            <div class="update-head">
              <h3><i class="fa-solid fa-shield-virus me-2 text-primary"></i><span data-i18n="updates_release_20260820_safety_title">Real-Time Asinxron Təhlükəsizlik Skaneri, Karantin və 7 Günlük Skan</span></h3>
              <span class="update-pill" data-i18n="updates_release_20260820_safety_badge">20.08.2026</span>
            </div>
            <p data-i18n="updates_release_20260820_safety_desc">0ms istifadəçi gecikməsi ilə asinxron təhlükəsizlik analizi, zərərli linklərin karantinə alınması və həftəlik arxa plan təhlükəsizlik süpürməsi tətbiq edildi.</p>
            <ul>
              <li data-i18n="updates_release_20260820_safety_item1">0ms Gecikmə: Link dərhal yaradılır, təhlükəsizlik və phishing analizi arxa planda asinxron işləyir.</li>
              <li data-i18n="updates_release_20260820_safety_item2">Edit Skanı: Qısa linkin hədəf ünvanı redaktə edildikdə yeni URL dərhal təhlükəsizlik süzgəcindən keçirilir.</li>
              <li data-i18n="updates_release_20260820_safety_item3">Karantin & Bildiriş: Zərərli linklər avtomatik karantinə alınır və istifadəçiyə daxili bildirişlə xəbərdarlıq göndərilir.</li>
              <li data-i18n="updates_release_20260820_safety_item4">7 Günlük Dövri Skan: Bütün aktiv linklər həftədə bir dəfə gecə saatlarında sistemə yük salmadan təkrar skan edilir.</li>
            </ul>
          </article>

          <article class="policy-card update-card">
            <div class="update-head">
              <h3><i class="fa-solid fa-building-shield me-2 text-primary"></i><span data-i18n="updates_release_20260818_sso_title">Enterprise SSO Təhlükəsizlik Hardening və Domain Discovery</span></h3>
              <span class="update-pill" data-i18n="updates_release_20260818_sso_badge">18.08.2026</span>
            </div>
            <p data-i18n="updates_release_20260818_sso_desc">Enterprise SAML 2.0 SSO sistemi ən yüksək təhlükəsizlik standartları və rahat giriş interfeysi ilə yeniləndi.</p>
            <ul>
              <li data-i18n="updates_release_20260818_sso_item1">Giriş səhifəsində avtomatik korporativ domen aşkarlaması (Domain Discovery) və "SSO ilə Giriş" seçimi.</li>
              <li data-i18n="updates_release_20260818_sso_item2">Anti-Replay Attack qoruması (Assertion ID keşləmə) və HMAC-SHA256 imzalı RelayState təhlükəsizliyi.</li>
              <li data-i18n="updates_release_20260818_sso_item3">Kriptoqrafik SHA-256 məcburiyyəti, saat toleransı (±3 dəqiqə) və Session Fixation profilaktikası.</li>
            </ul>
          </article>

          <article class="policy-card update-card">
            <div class="update-head">
              <h3><i class="fa-solid fa-bullhorn me-2 text-primary"></i><span data-i18n="updates_release_20260818_adv_title">Genişləndirilmiş UTM Şablonları, Çoxdilli Dəstək və A/B Test Təkmilləşdirmələri</span></h3>
              <span class="update-pill" data-i18n="updates_release_20260818_adv_badge">18.08.2026</span>
            </div>
            <p data-i18n="updates_release_20260818_adv_desc">Ətraflı link tənzimləmələri, UTM şablonları və PRO xüsusiyyətləri üçün böyük yenilənmə təqdim edildi.</p>
            <ul>
              <li data-i18n="updates_release_20260818_adv_item1">Populyar UTM şablonları (Google Ads, Meta, TikTok, Email və s.) və xüsusi şablon yadda saxlama.</li>
              <li data-i18n="updates_release_20260818_adv_item2">Ətraflı tənzimləmələr tabları və bütün inputlar üçün tam 3 dilli (AZ, TR, EN) interfeys dəstəyi.</li>
              <li data-i18n="updates_release_20260818_adv_item3">A/B Test və Cihaz Hədəfləməsi üçün PRO yoxlaması və dəqiq yönləndirmə axını.</li>
            </ul>
          </article>

          <article class="policy-card update-card">
            <div class="update-head">
              <h3><i class="fa-solid fa-users me-2 text-primary"></i><span data-i18n="updates_release_20260816_ws_title">Workspace və SAML SSO (Pro)</span></h3>
              <span class="update-pill" data-i18n="updates_release_20260816_ws_badge">16.08.2026</span>
            </div>
            <p data-i18n="updates_release_20260816_ws_desc">Pro abunələri üçün komanda workspace-ləri və korporativ SSO dəstəyi əlavə edildi.</p>
            <ul>
              <li data-i18n="updates_release_20260816_ws_item1">Pro istifadəçilər workspace yaradıb komanda yoldaşlarını dəvət edə bilər (üzv/admin rolları).</li>
              <li data-i18n="updates_release_20260816_ws_item2">Workspace üzvləri eyni hesab üzərindən birgə link yaradır; dashboard-da workspace seçici var.</li>
              <li data-i18n="updates_release_20260816_ws_item3">Okta və digər SAML 2.0 IdP-lər üçün SSO (metadata XML əsaslı) konfiqurasiyası.</li>
              <li data-i18n="updates_release_20260816_ws_item4">Pro abunəliyi bitərsə workspace oxuma rejiminə keçir; yönləndirmələr dayanmır.</li>
            </ul>
          </article>
          <article class="policy-card update-card">
            <div class="update-head">
              <h3><i class="fa-solid fa-shield-halved me-2 text-primary"></i><span data-i18n="updates_release_20260816_sec_title">Təhlükəsizlik və Abunəlik İdarəetməsi</span></h3>
              <span class="update-pill" data-i18n="updates_release_20260816_sec_badge">16.08.2026</span>
            </div>
            <p data-i18n="updates_release_20260816_sec_desc">Hesab təhlükəsizliyi və abunəlik idarəetməsi üçün yeni imkanlar əlavə edildi.</p>
            <ul>
              <li data-i18n="updates_release_20260816_sec_item1">İki Faktorlu Autentifikasiya (2FA): Authenticator tətbiqi ilə hesabınızı ikinci qılınc ilə qoruyun (/account).</li>
              <li data-i18n="updates_release_20260816_sec_item2">E-poçt Dəyişdirmə: Artıq hesab e-poçtunuzu təsdiq kodu ilə dəyişə bilərsiniz.</li>
              <li data-i18n="updates_release_20260816_sec_item3">Abunəlik Kartı: Plan, bitmə tarixi və idarəetmə düyməsi profil səhifəsində.</li>
              <li data-i18n="updates_release_20260816_sec_item4">Ödəniş bildirişləri: Ləğv və ödəniş problemlərində dərhal bildiriş alırsınız.</li>
              <li data-i18n="updates_release_20260816_sec_item5">Abunəlik idarəetmə düyməsi yalnız Polar abunəliyi olan hesablarda göstərilir; admin tərəfindən verilən Pro-da aydın qeyd görünür.</li>
            </ul>
          </article>

          <article class="policy-card update-card">
            <div class="update-head">
              <h3><i class="fa-solid fa-credit-card me-2 text-primary"></i><span data-i18n="updates_release_20260815_polar_title">Polar.sh ilə Avtomatlaşdırılmış Pro Ödəniş Sistemi</span></h3>
              <span class="update-pill" data-i18n="updates_release_20260815_polar_badge">15.08.2026</span>
            </div>
            <p data-i18n="updates_release_20260815_polar_desc">Ovlink Pro üçün qlobal kredit kartı, Apple Pay və avtomatlaşdırılmış abunəlik sistemi aktivləşdirildi.</p>
            <ul>
              <li data-i18n="updates_release_20260815_polar_item1">Polar.sh inteqrasiyası: İstifadəçilər qlobal səviyyədə kartla birbaşa Pro plana keçə bilər.</li>
              <li data-i18n="updates_release_20260815_polar_item2">3 Günlük Pulsuz Sınaq: Yeni istifadəçilər Pro funksiyaları 3 gün sınaqdan keçirə bilər.</li>
              <li data-i18n="updates_release_20260815_polar_item3">Real-vaxt Webhook: Ödəniş tamamlandığı an istifadəçi hesabı saniyələr içində avtomatik Pro-ya yüksəldilir.</li>
              <li data-i18n="updates_release_20260815_polar_item4">Ödəniş Təsdiq Səhifəsi: Uğurlu ödənişdən sonra istifadəçi aydın /pro təsdiq səhifəsinə yönləndirilir.</li>
              <li data-i18n="updates_release_20260815_polar_item5">Abunəlik İdarəetməsi: /pro səhifəsindən bir kliklə abunəliyi ləğv et, yenilə və kart məlumatını idarə et.</li>
            </ul>
          </article>

          <article class="policy-card update-card">
            <div class="update-head">
              <h3><i class="fa-brands fa-telegram me-2 text-primary"></i><span data-i18n="updates_release_20260814_bot_pwa_title">Telegram Bot 2.0 & PWA Dəstəyi</span></h3>
              <span class="update-pill" data-i18n="updates_release_20260814_bot_pwa_badge">14.08.2026</span>
            </div>
            <p data-i18n="updates_release_20260814_bot_pwa_desc">Telegram botu və veb tətbiq üçün genişləndirilmiş yeni funksionallıqlar təqdim edildi.</p>
            <ul>
              <li data-i18n="updates_release_20260814_bot_pwa_item1">QR Kod dəstəyi: Qısaldılan linklər üçün Telegram üzərindən birbaşa tək kliklə QR Kod generasiyası.</li>
              <li data-i18n="updates_release_20260814_bot_pwa_item2">Toplu Link Qısaltma: Eyni anda bir neçə linki mesaja göndərərək tək cavabda qısaltma imkanı.</li>
              <li data-i18n="updates_release_20260814_bot_pwa_item3">PWA & Təhlükəsizlik: Veb sayt mobil tətbiq (PWA) kimi quraşdırıla bilir və zərərli phishing linklərinə qarşı qorunur.</li>
            </ul>
          </article>

          <article class="policy-card update-card">
            <div class="update-head">
              <h3><i class="fa-solid fa-clock me-2"></i><span data-i18n="updates_release_20260321_expiry_title">Link bitmə vaxtı düzəlişi</span></h3>
              <span class="update-pill" data-i18n="updates_release_20260321_expiry_badge">21.03.2026</span>
            </div>
            <p data-i18n="updates_release_20260321_expiry_desc">Bitmə vaxtı həm tarix, həm saat səviyyəsində yenidən işlənib və timezone fərqlərinə qarşı sabitləndirilib.</p>
            <ul>
              <li data-i18n="updates_release_20260321_expiry_item1">`expires_at` yoxlaması serverdə daha sərt aparılır: keçmiş tarix/saat qəbul edilmir.</li>
              <li data-i18n="updates_release_20260321_expiry_item2">İstifadəçi formundan gələn tarix browser lokal vaxtından ISO formata çevrilir ki, vaxt sürüşməsi olmasın.</li>
              <li data-i18n="updates_release_20260321_expiry_item3">Yönləndirmə zamanı bitmiş linklər dərhal bloklanır və səhifə düzgün status göstərir.</li>
            </ul>
          </article>

          <article class="policy-card update-card">
            <div class="update-head">
              <h3><i class="fa-solid fa-gauge-high me-2"></i><span data-i18n="updates_release_20260321_api_usage_title">Pro API rate-limit dashboard</span></h3>
              <span class="update-pill" data-i18n="updates_release_20260321_api_usage_badge">21.03.2026</span>
            </div>
            <p data-i18n="updates_release_20260321_api_usage_desc">Pro panelinə API istifadə paneli əlavə edildi.</p>
            <ul>
              <li data-i18n="updates_release_20260321_api_usage_item1">Read/write limitləri, cari pəncərə istifadəsi və qalan kota göstərilir.</li>
              <li data-i18n="updates_release_20260321_api_usage_item2">Son 24 saat üzrə xəta tipləri və HTTP status bölgüsü ayrıca görünür.</li>
            </ul>
          </article>

          <article class="policy-card update-card">
            <div class="update-head">
              <h3><i class="fa-solid fa-chart-line me-2"></i><span data-i18n="updates_release_20260321_api_usage_fix_title">API limit göstəricisi düzəlişi</span></h3>
              <span class="update-pill" data-i18n="updates_release_20260321_api_usage_fix_badge">21.03.2026</span>
            </div>
            <p data-i18n="updates_release_20260321_api_usage_fix_desc">API ilə link yaradıldıqdan sonra paneldə limit istifadəsi daha stabil yenilənir.</p>
            <ul>
              <li data-i18n="updates_release_20260321_api_usage_fix_item1">API usage log cədvəli yoxdursa avtomatik yaradılır və istifadə yazısı düşür.</li>
              <li data-i18n="updates_release_20260321_api_usage_fix_item2">Pro panel `overview` cavabı cache-dən deyil, hər sorğuda canlı datadan götürülür.</li>
            </ul>
          </article>

          <article class="policy-card update-card">
            <div class="update-head">
              <h3><i class="fa-brands fa-telegram me-2"></i><span data-i18n="updates_release_20260321_telegram_title">Pro satın alma Telegram axını</span></h3>
              <span class="update-pill" data-i18n="updates_release_20260321_telegram_badge">21.03.2026</span>
            </div>
            <p data-i18n="updates_release_20260321_telegram_desc">`Satın al` düyməsi daha stabil Telegram keçidi ilə yenilənib.</p>
            <ul>
              <li data-i18n="updates_release_20260321_telegram_item1">`Satın al` düyməsi birbaşa Telegram profilinə yönləndirir.</li>
              <li data-i18n="updates_release_20260321_telegram_item2">Avtomatik mesaj və clipboard axını çıxarıldı.</li>
            </ul>
          </article>

          <article class="policy-card update-card">
            <div class="update-head">
              <h3><i class="fa-solid fa-shield-halved me-2"></i><span data-i18n="updates_release_20260321_admin_logs_title">Admin log dəqiqliyi</span></h3>
              <span class="update-pill" data-i18n="updates_release_20260321_admin_logs_badge">21.03.2026</span>
            </div>
            <p data-i18n="updates_release_20260321_admin_logs_desc">Admin auth və audit loglarında IP/ölkə məlumatı daha düzgün göstərilir.</p>
            <ul>
              <li data-i18n="updates_release_20260321_admin_logs_item1">Proxy və lokal şəbəkə halları üçün IP/ölkə çıxarımı sərtləşdirildi.</li>
              <li data-i18n="updates_release_20260321_admin_logs_item2">Auth log cədvəlinə ölkə sütunu əlavə edildi və audit görünüşündə ölkə fallback-i düzəldildi.</li>
            </ul>
          </article>

          <article class="policy-card update-card">
            <div class="update-head">
              <h3><i class="fa-solid fa-sitemap me-2"></i><span data-i18n="updates_release_20260321_sitemap_title">Sitemap genişləndirildi</span></h3>
              <span class="update-pill" data-i18n="updates_release_20260321_sitemap_badge">21.03.2026</span>
            </div>
            <p data-i18n="updates_release_20260321_sitemap_desc">Sitemap və robots siyahısı public/indexlənə bilən səhifələrin hamısı ilə sinxronlaşdırıldı.</p>
            <ul>
              <li data-i18n="updates_release_20260321_sitemap_item1">`/how-it-works` daxil olmaqla bütün əsas public səhifələr sitemap-ə əlavə edildi.</li>
              <li data-i18n="updates_release_20260321_sitemap_item2">`server.js` fallback sitemap generatoru və `public/sitemap.xml` eyni siyahı ilə işləyir.</li>
            </ul>
          </article>

          <article class="policy-card update-card">
            <div class="update-head">
              <h3><i class="fa-solid fa-window-restore me-2"></i><span data-i18n="updates_release_20260321_layout_title">Header, footer və Pro banner uyğunluğu</span></h3>
              <span class="update-pill" data-i18n="updates_release_20260321_layout_badge">21.03.2026</span>
            </div>
            <p data-i18n="updates_release_20260321_layout_desc">Public səhifələrdə Pro keçidləri və footer elementləri vahid hala gətirildi.</p>
            <ul>
              <li data-i18n="updates_release_20260321_layout_item1">Headerdə Pro linki fərqli navbar quruluşlarında da stabil görünür.</li>
              <li data-i18n="updates_release_20260321_layout_item2">Sağ-alt Pro banneri public səhifələrdə eyni qayda ilə göstərilir.</li>
              <li data-i18n="updates_release_20260321_layout_item3">Footer linkləri yenilənib və səhifələr arası uyğunluq artırılıb.</li>
            </ul>
          </article>

          <article class="policy-card update-card">
            <div class="update-head">
              <h3><i class="fa-solid fa-chart-column me-2"></i><span data-i18n="updates_release_20260321_stats_title">Link statistika görünüşü sadələşdirildi</span></h3>
              <span class="update-pill" data-i18n="updates_release_20260321_stats_badge">21.03.2026</span>
            </div>
            <p data-i18n="updates_release_20260321_stats_desc">`Zaman üzrə kliklər` qrafiki daha anlaşılır formata keçirildi.</p>
            <ul>
