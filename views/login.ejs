<!doctype html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="csrf-token" content="<%= csrfToken %>">
  <title data-i18n="login_title">Giriş - URL Qısaltma</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=<%= assetVersion %>" />
  <link rel="icon" href="/logo.ico" />
  <link rel="manifest" href="/site.webmanifest" />

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="preload" href="/vendor/fontawesome/webfonts/fa-solid-900.woff2?v=<%= assetVersion %>" as="font" type="font/woff2" crossorigin />
  <link rel="stylesheet" href="/vendor/fontawesome/css/all.min.css?v=<%= assetVersion %>" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" integrity="sha512-iecdLmaskl7CVkqkXNQ/ZH/XLlvWZOJyj7Yy7tcenmpD1ypASozpmT/E0iPtmFIB46ZmdtAc9eNBvH0H/ZpiBw==" crossorigin="anonymous" referrerpolicy="no-referrer" />

  <link rel="stylesheet" href="/home.css?v=<%= assetVersion %>" />
  <meta name="description" content="Ovlink-ə daxil olun. Linklərinizi idarə edin, statistikaları izləyin və daha çoxuna çatın." />
  <meta name="keywords" content="<%= (seo && seo.keywords) ? seo.keywords : '' %>" />
</head>

<body class="ovx home-page auth-page">

  <!-- Skip to content for accessibility -->
  <a href="#mainContent" class="m-skip-link" data-i18n="skip_to_content">Skip to content</a>

  <!-- Ambient background glow -->
  <div id="cursorGlow" aria-hidden="true"></div>

  <% if (siteSettings && siteSettings.announcement_enabled === '1' && (siteSettings.announcement_text_az || siteSettings.announcement_text_tr || siteSettings.announcement_text_en)) { %>
    <div id="siteAnnouncement" class="site-announcement" data-az="<%= siteSettings.announcement_text_az || '' %>" data-tr="<%= siteSettings.announcement_text_tr || '' %>" data-en="<%= siteSettings.announcement_text_en || '' %>">
      <div class="shell">
        <i class="fa-solid fa-bullhorn" aria-hidden="true"></i>
        <span id="siteAnnouncementText"><%= siteSettings.announcement_text_az || siteSettings.announcement_text_tr || siteSettings.announcement_text_en %></span>
      </div>
    </div>
  <% } %>

  <%- include('partials/home-navbar') %>

  <main class="m-auth-shell" id="mainContent">
    <div class="m-auth-container">
      <div class="m-auth-head">
        <div class="m-auth-eyebrow">
          <span data-i18n="hero_badge">Ovlink - Next-Gen Link Management</span>
        </div>
        <h1 class="m-auth-title" data-i18n="login_title">Xoş Gəldiniz</h1>
        <p class="m-auth-sub" data-i18n="login_subtitle">Hesabınıza daxil olun</p>
      </div>

      <div class="m-auth-card">
        <div class="m-auth-glyph" aria-hidden="true">
          <i class="fa-solid fa-user-lock"></i>
        </div>

        <form id="loginForm" novalidate>
          <div class="m-auth-field">
            <label for="email" class="m-auth-label" data-i18n="login_email">E-poçt Ünvanı</label>
            <div class="m-auth-input-wrap">
              <i class="fa-solid fa-envelope m-auth-input-icon" aria-hidden="true"></i>
              <input type="email" class="m-auth-input" id="email" required placeholder="numune@email.com" data-i18n-placeholder="login_email_placeholder" autocomplete="email">
            </div>
          </div>

          <div class="m-auth-field">
            <div class="m-auth-label">
              <span data-i18n="login_pass">Şifrə</span>
              <a href="/forgot-password" class="m-auth-forgot" data-i18n="forgot_password_link">Şifrəni unutmusunuz?</a>
            </div>
            <div class="m-auth-input-wrap">
              <i class="fa-solid fa-lock m-auth-input-icon" aria-hidden="true"></i>
              <input type="password" class="m-auth-input" id="password" required placeholder="••••••••" autocomplete="current-password">
            </div>
          </div>

          <div class="m-auth-field d-none" id="twofaGroup" style="display: none;">
            <label for="twofaCode" class="m-auth-label" data-i18n="login_2fa_code">2FA Kodu</label>
            <div class="m-auth-input-wrap">
              <i class="fa-solid fa-shield-halved m-auth-input-icon" aria-hidden="true"></i>
              <input type="text" inputmode="numeric" pattern="\d{6}" maxlength="6" class="m-auth-input m-auth-code-input" id="twofaCode" placeholder="123456" autocomplete="one-time-code">
            </div>
          </div>

          <button type="submit" id="loginSubmitBtn" class="m-cta m-cta--white m-auth-submit">
            <span data-i18n="login_btn">Giriş</span> <i class="fa-solid fa-arrow-right ms-2" aria-hidden="true"></i>
          </button>
        </form>

        <div class="m-auth-divider"><span data-i18n="auth_or">və ya</span></div>

        <a href="/auth/google" class="m-auth-oauth-btn">
          <i class="fa-brands fa-google" aria-hidden="true"></i>
          <span data-i18n="login_google">Google ilə giriş</span>
        </a>

        <button type="button" id="toggleSsoBtn" class="m-auth-oauth-btn" style="margin-top: 10px;">
          <i class="fa-solid fa-building-shield" aria-hidden="true"></i>
          <span data-i18n="login_sso_btn">Korporativ SSO ilə Giriş</span>
        </button>

        <div id="ssoSection" class="m-auth-sso-drawer d-none" style="display: none;">
          <div class="m-auth-sso-top">
            <span class="m-auth-sso-title" data-i18n="login_sso_modal_title">
              <i class="fa-solid fa-key" aria-hidden="true"></i> Korporativ SSO Girişi
            </span>
            <button type="button" id="closeSsoBtn" class="m-auth-sso-close" aria-label="Close SSO">
              <i class="fa-solid fa-xmark" aria-hidden="true"></i>
            </button>
          </div>
          <p class="m-auth-sso-hint" data-i18n="login_sso_hint">Şirkət e-poçtunuzu və ya Workspace ID-ni daxil edin:</p>
          <div class="m-auth-input-wrap" style="margin-bottom: 12px;">
            <i class="fa-solid fa-building m-auth-input-icon" aria-hidden="true"></i>
            <input type="text" class="m-auth-input" id="ssoTargetInput" placeholder="ad@sirket.com və ya workspace ID" data-i18n-placeholder="login_sso_email_ph">
          </div>
          <button type="button" id="submitSsoBtn" class="m-cta m-cta--white m-cta--sm" style="width: 100%; justify-content: center;">
            <span data-i18n="login_sso_continue_btn">SSO ilə Davam Et</span> <i class="fa-solid fa-arrow-right ms-1" aria-hidden="true"></i>
          </button>
          <div id="ssoStatusMsg" class="m-auth-msg text-danger d-none" style="display: none;"></div>
        </div>

        <p id="loginMessage" class="m-auth-msg auth-message"></p>

        <div class="m-auth-footer">
          <div class="m-auth-footer-text">
            <span data-i18n="no_account">Hesabınız yoxdur?</span>
            <a href="/register" data-i18n="register_link">Qeydiyyatdan keçin</a>
          </div>
          <a href="/" class="m-cta m-cta--outline m-cta--sm m-auth-back-btn">
            <i class="fa-solid fa-house" aria-hidden="true"></i>
            <span data-i18n="nav_home">Ana Səhifə</span>
          </a>
        </div>
      </div>
    </div>
  </main>

  <%- include('partials/home-footer') %>

  <script nonce="<%= nonce %>" src="/lang.js?v=<%= assetVersion %>"></script>
  <script nonce="<%= nonce %>" src="/script.js?v=<%= assetVersion %>"></script>
  <script nonce="<%= nonce %>">
    (function () {
      /* ─── Navbar dropdowns & mobile menu are managed by partials/home-navbar ─── */

      /* ─── Button ripple effect ─── */
      document.querySelectorAll('.m-cta, .m-btn-solid, .m-auth-oauth-btn').forEach(function(btn) {
        btn.addEventListener('click', function(e) {
          var r = btn.getBoundingClientRect();
          var rip = document.createElement('span');
          rip.className = 'm-ripple';
          rip.style.left = (e.clientX - r.left) + 'px';
          rip.style.top  = (e.clientY - r.top) + 'px';
          btn.appendChild(rip);
          setTimeout(function() { rip.remove(); }, 600);
        });
      });

      /* ─── Ambient Glow Mouse Tracking ─── */
      var glow = document.getElementById('cursorGlow');
      if (glow && window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
        document.addEventListener('mousemove', function(e) {
          glow.style.left = e.clientX + 'px';
          glow.style.top = e.clientY + 'px';
        }, { passive: true });
      }
    })();

    /* ─── URL Parameters & Error Display ─── */
    const loginMessageEl = document.getElementById('loginMessage');
    const params = new URLSearchParams(window.location.search);
    const errorKey = params.get('error');
    const ssoParam = params.get('sso');
    const errorMsgParam = params.get('message');
    const t = (key, fallback) => {
      try {
        const lang = (typeof currentLang !== 'undefined') ? currentLang : 'az';
        return (typeof translations === 'object' && translations[lang] && translations[lang][key]) || fallback;
      } catch {
        return fallback;
      }
    };
    if (loginMessageEl) {
      let msgText = '';
      if (ssoParam === 'replay') msgText = t('error_sso_replay', 'Bu giriş sessiyası artıq istifadə olunub. Zəhmət olmasa yenidən daxil olun.');
      else if (ssoParam === 'error') msgText = t('error_sso_failed', 'SSO girişi uğursuz oldu. Zəhmət olmasa təşkilat administratoru ilə əlaqə saxlayın.');
      else if (errorKey === 'google_unavailable') msgText = t('google_unavailable', 'Google giriş hazırda istifadə edilə bilmir.');
      else if (errorKey === 'google_failed') msgText = t('google_failed', 'Google ilə giriş alınmadı.');
      else if (errorKey === 'google_unverified') msgText = t('google_unverified', 'Google hesabının e-poçtu təsdiqlənməyib.');
      else if (errorKey === 'ban' && errorMsgParam) msgText = decodeURIComponent(errorMsgParam);
      if (msgText) {
        loginMessageEl.className = "m-auth-msg text-danger";
        loginMessageEl.textContent = msgText;
      }
    }

    /* ─── SSO Panel Toggling & Domain Routing ─── */
    const toggleSsoBtn = document.getElementById('toggleSsoBtn');
    const ssoSection = document.getElementById('ssoSection');
    const closeSsoBtn = document.getElementById('closeSsoBtn');
    const submitSsoBtn = document.getElementById('submitSsoBtn');
    const ssoTargetInput = document.getElementById('ssoTargetInput');
    const ssoStatusMsg = document.getElementById('ssoStatusMsg');

    if (toggleSsoBtn && ssoSection) {
      toggleSsoBtn.addEventListener('click', () => {
        const isHidden = ssoSection.style.display === 'none' || ssoSection.classList.contains('d-none');
        if (isHidden) {
          ssoSection.style.display = 'block';
          ssoSection.classList.remove('d-none');
          ssoSection.classList.add('open');
          ssoTargetInput.focus();
        } else {
          ssoSection.style.display = 'none';
          ssoSection.classList.add('d-none');
          ssoSection.classList.remove('open');
          if (ssoStatusMsg) {
            ssoStatusMsg.style.display = 'none';
            ssoStatusMsg.classList.add('d-none');
          }
        }
      });
    }

    if (closeSsoBtn && ssoSection) {
      closeSsoBtn.addEventListener('click', () => {
        ssoSection.style.display = 'none';
        ssoSection.classList.add('d-none');
        ssoSection.classList.remove('open');
        if (ssoStatusMsg) {
          ssoStatusMsg.style.display = 'none';
          ssoStatusMsg.classList.add('d-none');
        }
      });
    }

    if (submitSsoBtn && ssoTargetInput) {
      submitSsoBtn.addEventListener('click', async () => {
        const target = ssoTargetInput.value.trim();
        const activeLang = (typeof currentLang !== 'undefined') ? currentLang : 'az';
        if (!target) {
          if (ssoStatusMsg) {
            ssoStatusMsg.className = "m-auth-msg text-danger";
            ssoStatusMsg.textContent = t('login_sso_hint', 'Şirkət e-poçtunuzu və ya Workspace ID-ni daxil edin');
            ssoStatusMsg.style.display = 'block';
            ssoStatusMsg.classList.remove('d-none');
          }
          return;
        }

        if (ssoStatusMsg) {
          ssoStatusMsg.className = "m-auth-msg text-muted";
          ssoStatusMsg.textContent = activeLang === 'az' ? "Yoxlanılır..." : (activeLang === 'en' ? "Checking..." : "Kontrol ediliyor...");
          ssoStatusMsg.style.display = 'block';
          ssoStatusMsg.classList.remove('d-none');
        }

        try {
          if (!getCsrfToken()) {
            await refreshCsrfToken();
          }
          const res = await postJsonWithCsrf('/api/auth/realm-lookup', { email: target, lang: activeLang });
          const data = await res.json().catch(() => ({}));

          if (data && data.ssoAvailable && data.ssoLoginUrl) {
            if (ssoStatusMsg) {
              ssoStatusMsg.className = "m-auth-msg text-success";
              ssoStatusMsg.textContent = (activeLang === 'az' ? "SSO portalına yönləndirilirsiniz: " : (activeLang === 'en' ? "Redirecting to SSO: " : "SSO portalına yönlendiriliyorsunuz: ")) + (data.workspaceName || '');
            }
            setTimeout(() => {
              window.location.href = data.ssoLoginUrl;
            }, 500);
          } else {
            if (ssoStatusMsg) {
              ssoStatusMsg.className = "m-auth-msg text-danger";
              ssoStatusMsg.textContent = t('error_sso_not_found', 'Bu e-poçt domeni və ya workspace üçün aktiv SSO tapılmadı.');
            }
          }
        } catch (err) {
          if (ssoStatusMsg) {
            ssoStatusMsg.className = "m-auth-msg text-danger";
            ssoStatusMsg.textContent = t('error_sso_failed', 'SSO girişi uğursuz oldu.');
          }
        }
      });

      ssoTargetInput.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
          e.preventDefault();
          submitSsoBtn.click();
        }
      });
    }

    /* ─── Form Submission & 2FA Flow ─── */
    document.getElementById('loginForm').addEventListener('submit', async (e) => {
      e.preventDefault();
      const email = document.getElementById('email').value;
      const password = document.getElementById('password').value;
      const msg = document.getElementById('loginMessage');
      const activeLang = (typeof currentLang !== 'undefined') ? currentLang : 'az';
      if (!msg) return;

      msg.className = "m-auth-msg text-muted";
      msg.textContent = activeLang === 'az' ? "İşlənilir..." : (activeLang === 'en' ? "Processing..." : "İşleniyor...");

      try {
        if (!getCsrfToken()) {
          await refreshCsrfToken();
        }
        const twofaGroup = document.getElementById('twofaGroup');
        const twofaCodeEl = document.getElementById('twofaCode');
        const isTwoFaActive = twofaGroup && (twofaGroup.style.display !== 'none' && !twofaGroup.classList.contains('d-none'));

        if (isTwoFaActive) {
          // Second step: verify the TOTP code
          const res = await postJsonWithCsrf('/api/verify-2fa', { code: twofaCodeEl.value.trim(), lang: activeLang });
          const data = await res.json().catch(() => ({}));
          if (res.ok) {
            msg.className = "m-auth-msg text-success";
            msg.textContent = activeLang === 'az' ? "Giriş uğurludur! Yönləndirilirsiniz..." : (activeLang === 'en' ? "Login successful! Redirecting..." : "Giriş başarılı! Yönlendiriliyorsunuz...");
            setClientSession({ email: data.username, isAdmin: false });
            const nextParam = new URLSearchParams(window.location.search).get('next');
            const safeRedirect = (nextParam && nextParam.startsWith('/') && !nextParam.startsWith('//')) ? nextParam : '/';
            setTimeout(() => window.location.href = safeRedirect, 1000);
          } else {
            msg.className = "m-auth-msg text-danger";
            msg.textContent = data.error || (activeLang === 'az' ? "Kod yanlışdır." : (activeLang === 'en' ? "Invalid code." : "Kod hatalı."));
            twofaCodeEl.value = '';
            twofaCodeEl.focus();
          }
          return;
        }

        const res = await postJsonWithCsrf('/api/login', { email, password, lang: activeLang });
        const data = await res.json().catch(() => ({}));
        if (res.ok && data.twofaRequired) {
          twofaGroup.style.display = 'block';
          twofaGroup.classList.remove('d-none');
          msg.className = "m-auth-msg text-muted";
          msg.textContent = activeLang === 'az' ? "Authenticator tətbiqindəki 6 rəqəmli kodu daxil edin." : (activeLang === 'en' ? "Enter the 6-digit code from your authenticator app." : "Authenticator uygulamasındaki 6 haneli kodu girin.");
          twofaCodeEl.focus();
          return;
        }
        if (res.ok) {
          msg.className = "m-auth-msg text-success";
          msg.textContent = activeLang === 'az' ? "Giriş uğurludur! Yönləndirilirsiniz..." : (activeLang === 'en' ? "Login successful! Redirecting..." : "Giriş başarılı! Yönlendiriliyorsunuz...");
          setClientSession({ email: data.username, isAdmin: false });
          const nextParam = new URLSearchParams(window.location.search).get('next');
          const safeRedirect = (nextParam && nextParam.startsWith('/') && !nextParam.startsWith('//')) ? nextParam : '/';
          setTimeout(() => window.location.href = safeRedirect, 1000);
        } else {
          msg.className = "m-auth-msg text-danger";
          msg.textContent = data.error || (activeLang === 'az' ? "Giriş alınmadı." : (activeLang === 'en' ? "Login failed." : "Giriş başarısız."));
        }
      } catch (err) {
        msg.className = "m-auth-msg text-danger";
        msg.textContent = (activeLang === 'az' ? "Xəta baş verdi." : (activeLang === 'en' ? "An error occurred." : "Hata oluştu.")) + (err && err.message ? " " + err.message : "");
      }
    });
  </script>
</body>

</html>



