<!doctype html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="csrf-token" content="<%= csrfToken %>">
  <link rel="icon" href="/logo.ico" />
  <link rel="preconnect" href="https://cdn.jsdelivr.net">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
  <link rel="stylesheet" href="/style.css?v=<%= assetVersion %>" />
  <title data-i18n="login_title">Giriş - URL Qısaltma</title>
  <meta name="description" content="Ovlink-ə daxil olun. Linklərinizi idarə edin, statistikaları izləyin və daha çoxuna çatın." />
  <meta name="keywords" content="<%= (seo && seo.keywords) ? seo.keywords : '' %>" />
</head>

<body class="home-page auth-policy-page animated-gradient-bg">

  <% if (siteSettings && siteSettings.announcement_enabled === '1' && (siteSettings.announcement_text_az || siteSettings.announcement_text_tr || siteSettings.announcement_text_en)) { %>
    <div id="siteAnnouncement" class="site-announcement" data-az="<%= siteSettings.announcement_text_az || '' %>" data-tr="<%= siteSettings.announcement_text_tr || '' %>" data-en="<%= siteSettings.announcement_text_en || '' %>">
      <div class="container">
        <i class="fa-solid fa-bullhorn"></i>
        <span id="siteAnnouncementText"><%= siteSettings.announcement_text_az || siteSettings.announcement_text_tr || siteSettings.announcement_text_en %></span>
      </div>
    </div>
  <% } %>

  <%- include('partials/public-navbar') %>

    <main class="auth-main-shell">
    <section id="hero" class="d-flex align-items-center auth-hero">
      <div class="container">
        <div class="text-center auth-hero-head reveal">
          <div class="badge hero-chip rounded-pill px-3 py-2 mb-4 shadow-sm fw-semibold">
            <i class="fa-solid fa-link me-1"></i><span data-i18n="hero_badge">Ovlink - Next-Gen Link Management</span>
          </div>
          <h1 class="hero-title auth-display-title" data-i18n="login_title">Xoş Gəldiniz</h1>
          <p class="hero-subtitle auth-display-subtitle" data-i18n="login_subtitle">Hesabınıza daxil olun</p>
        </div>

        <div class="glass-card home-form-card auth-home-card reveal" style="transition-delay: 0.2s">
          <div class="auth-head-icon" aria-hidden="true">
            <i class="fa-solid fa-user-lock"></i>
          </div>

          <form id="loginForm" novalidate>
            <div class="mb-3 auth-field">
              <label for="email" class="form-label" data-i18n="login_email">E-poçt Ünvanı</label>
              <div class="input-group auth-input shadow-sm">
                <span class="input-group-text"><i class="fa-solid fa-envelope"></i></span>
                <input type="email" class="form-control form-control-animated" id="email" required placeholder="numune@email.com" data-i18n-placeholder="login_email_placeholder">
              </div>
            </div>

            <div class="mb-3 auth-field">
              <label for="password" class="form-label" data-i18n="login_pass">Şifrə</label>
              <div class="input-group auth-input shadow-sm">
                <span class="input-group-text"><i class="fa-solid fa-lock"></i></span>
                <input type="password" class="form-control form-control-animated" id="password" required placeholder="******">
              </div>
            </div>

            <div class="mb-3 auth-field d-none" id="twofaGroup">
              <label for="twofaCode" class="form-label" data-i18n="login_2fa_code">2FA Kodu</label>
              <div class="input-group auth-input shadow-sm">
                <span class="input-group-text"><i class="fa-solid fa-shield-halved"></i></span>
                <input type="text" inputmode="numeric" pattern="\d{6}" maxlength="6" class="form-control form-control-animated" id="twofaCode" placeholder="123456" autocomplete="one-time-code">
              </div>
            </div>

            <div class="text-end mb-3">
              <a href="/forgot-password" class="text-decoration-none small fw-semibold" data-i18n="forgot_password_link">Şifrəni unutmusunuz?</a>
            </div>

            <button type="submit" class="btn btn-primary btn-lg w-100 rounded-pill py-3 fw-bold shadow-lg home-primary-btn auth-submit-btn btn-animated btn-glow btn-shimmer btn-magnetic btn-stagger">
              <span data-i18n="login_btn">Giriş</span> <i class="fa-solid fa-arrow-right ms-2"></i>
            </button>
          </form>

          <div class="auth-divider"><span data-i18n="auth_or">vəya</span></div>

          <a href="/auth/google" class="btn w-100 rounded-pill fw-semibold py-3 auth-google-btn btn-animated btn-stagger">
            <i class="fa-brands fa-google me-2"></i><span data-i18n="login_google">Google ilə giriş</span>
          </a>

          <button type="button" id="toggleSsoBtn" class="btn w-100 rounded-pill fw-semibold py-3 auth-google-btn btn-animated btn-stagger mt-2" style="background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.15);">
            <i class="fa-solid fa-building-shield me-2 text-primary"></i><span data-i18n="login_sso_btn">Korporativ SSO ilə Giriş</span>
          </button>

          <div id="ssoSection" class="d-none mt-3 p-3 rounded-4" style="background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.1);">
            <div class="d-flex align-items-center justify-content-between mb-2">
              <span class="fw-semibold small" data-i18n="login_sso_modal_title"><i class="fa-solid fa-key me-1"></i> Korporativ SSO Girişi</span>
              <button type="button" id="closeSsoBtn" class="btn btn-sm btn-link text-muted p-0 text-decoration-none"><i class="fa-solid fa-xmark"></i></button>
            </div>
            <p class="small text-muted mb-2" data-i18n="login_sso_hint">Şirkət e-poçtunuzu və ya Workspace ID-ni daxil edin:</p>
            <div class="input-group auth-input shadow-sm mb-2">
              <span class="input-group-text"><i class="fa-solid fa-building"></i></span>
              <input type="text" class="form-control form-control-animated" id="ssoTargetInput" placeholder="ad@sirket.com və ya workspace ID" data-i18n-placeholder="login_sso_email_ph">
            </div>
            <button type="button" id="submitSsoBtn" class="btn btn-primary btn-sm w-100 rounded-pill py-2 fw-semibold">
              <span data-i18n="login_sso_continue_btn">SSO ilə Davam Et</span> <i class="fa-solid fa-arrow-right ms-1"></i>
            </button>
            <div id="ssoStatusMsg" class="small text-danger text-center mt-2 d-none"></div>
          </div>

          <p id="loginMessage" class="text-center small mt-3 mb-0 auth-message"></p>

          <p class="auth-links mb-0 reveal" style="transition-delay: 0.4s">
            <span data-i18n="no_account">Hesabınız yoxdur?</span>
            <a href="/register" data-i18n="register_link">Qeydiyyatdan keçin</a>
          </p>

          <div class="policy-back">
            <a href="/" class="btn home-outline-btn rounded-pill btn-animated" data-i18n="nav_home">Ana Səhifə</a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <script nonce="<%= nonce %>">
    const loginMessageEl = document.getElementById('loginMessage');
    const params = new URLSearchParams(window.location.search);
    const errorKey = params.get('error');
    const ssoParam = params.get('sso');
    const errorMsgParam = params.get('message');
    const t = (key, fallback) => {
      try {
        return (typeof translations === 'object' && translations[currentLang] && translations[currentLang][key]) || fallback;
      } catch {
        return fallback;
      }
    };
    if (loginMessageEl) {
      let msgText = '';
      if (ssoParam === 'replay') msgText = t('error_sso_replay', 'Bu giriş sessiyası artıq istifadə olunub. Zəhmət olmasa yenidən daxil olun.');
      else if (ssoParam === 'error') msgText = t('error_sso_failed', 'SSO girişi uğursuz oldu. Zəhmət olmasa təşkilat administratoru ilə əlaqə saxlayın.');
      else if (errorKey === 'google_unavailable') msgText = t('google_unavailable', 'Google giriş hazırda istifadə edilə bilmir.');
      else if (errorKey === 'google_failed') msgText = t('google_failed', 'Google ilə giriş alınmadı.');
      else if (errorKey === 'google_unverified') msgText = t('google_unverified', 'Google hesabının e-poçtu təsdiqlənməyib.');
      else if (errorKey === 'ban' && errorMsgParam) msgText = decodeURIComponent(errorMsgParam);
      if (msgText) {
        loginMessageEl.className = "text-center text-danger small";
        loginMessageEl.textContent = msgText;
      }
    }

    // SSO panel toggling & domain routing
    const toggleSsoBtn = document.getElementById('toggleSsoBtn');
    const ssoSection = document.getElementById('ssoSection');
    const closeSsoBtn = document.getElementById('closeSsoBtn');
    const submitSsoBtn = document.getElementById('submitSsoBtn');
    const ssoTargetInput = document.getElementById('ssoTargetInput');
    const ssoStatusMsg = document.getElementById('ssoStatusMsg');

    if (toggleSsoBtn && ssoSection) {
      toggleSsoBtn.addEventListener('click', () => {
        ssoSection.classList.toggle('d-none');
        if (!ssoSection.classList.contains('d-none')) {
          ssoTargetInput.focus();
        }
      });
    }

    if (closeSsoBtn && ssoSection) {
      closeSsoBtn.addEventListener('click', () => {
        ssoSection.classList.add('d-none');
        if (ssoStatusMsg) ssoStatusMsg.classList.add('d-none');
      });
    }

    if (submitSsoBtn && ssoTargetInput) {
      submitSsoBtn.addEventListener('click', async () => {
        const target = ssoTargetInput.value.trim();
        if (!target) {
          if (ssoStatusMsg) {
            ssoStatusMsg.className = "small text-danger text-center mt-2";
            ssoStatusMsg.textContent = t('login_sso_hint', 'Şirkət e-poçtunuzu və ya Workspace ID-ni daxil edin');
            ssoStatusMsg.classList.remove('d-none');
          }
          return;
        }

        if (ssoStatusMsg) {
          ssoStatusMsg.className = "small text-muted text-center mt-2";
          ssoStatusMsg.textContent = currentLang === 'az' ? "Yoxlanılır..." : (currentLang === 'en' ? "Checking..." : "Kontrol ediliyor...");
          ssoStatusMsg.classList.remove('d-none');
        }

        try {
          if (!getCsrfToken()) {
            await refreshCsrfToken();
          }
          const res = await postJsonWithCsrf('/api/auth/realm-lookup', { email: target, lang: currentLang });
          const data = await res.json().catch(() => ({}));

          if (data && data.ssoAvailable && data.ssoLoginUrl) {
            if (ssoStatusMsg) {
              ssoStatusMsg.className = "small text-success text-center mt-2";
              ssoStatusMsg.textContent = (currentLang === 'az' ? "SSO portalına yönləndirilirsiniz: " : (currentLang === 'en' ? "Redirecting to SSO: " : "SSO portalına yönlendiriliyorsunuz: ")) + (data.workspaceName || '');
            }
            setTimeout(() => {
              window.location.href = data.ssoLoginUrl;
            }, 500);
          } else {
            if (ssoStatusMsg) {
              ssoStatusMsg.className = "small text-danger text-center mt-2";
              ssoStatusMsg.textContent = t('error_sso_not_found', 'Bu e-poçt domeni və ya workspace üçün aktiv SSO tapılmadı.');
            }
          }
        } catch (err) {
          if (ssoStatusMsg) {
            ssoStatusMsg.className = "small text-danger text-center mt-2";
            ssoStatusMsg.textContent = t('error_sso_failed', 'SSO girişi uğursuz oldu.');
          }
        }
      });

      ssoTargetInput.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
          e.preventDefault();
          submitSsoBtn.click();
        }
      });
    }

    document.getElementById('loginForm').addEventListener('submit', async (e) => {
      e.preventDefault();
      const email = document.getElementById('email').value;
      const password = document.getElementById('password').value;
      const msg = document.getElementById('loginMessage');
      if (!msg) return;

      msg.className = "text-center text-muted small";
      msg.textContent = currentLang === 'az' ? "İşlənilir..." : (currentLang === 'en' ? "Processing..." : "İşleniyor...");

      try {
        if (!getCsrfToken()) {
          await refreshCsrfToken();
        }
        const twofaGroup = document.getElementById('twofaGroup');
        const twofaCodeEl = document.getElementById('twofaCode');
        if (twofaGroup && !twofaGroup.classList.contains('d-none')) {
          // Second step: verify the TOTP code.
          const res = await postJsonWithCsrf('/api/verify-2fa', { code: twofaCodeEl.value.trim(), lang: currentLang });
          const data = await res.json().catch(() => ({}));
          if (res.ok) {
            msg.className = "text-center text-success small";
            msg.textContent = currentLang === 'az' ? "Giriş uğurludur! Yönləndirilirsiniz..." : (currentLang === 'en' ? "Login successful! Redirecting..." : "Giriş başarılı! Yönlendiriliyorsunuz...");
            setClientSession({ email: data.username, isAdmin: false });
            setTimeout(() => window.location.href = '/', 1000);
          } else {
            msg.className = "text-center text-danger small";
            msg.textContent = data.error || (currentLang === 'az' ? "Kod yanlışdır." : (currentLang === 'en' ? "Invalid code." : "Kod hatalı."));
            twofaCodeEl.value = '';
            twofaCodeEl.focus();
          }
          return;
        }
        const res = await postJsonWithCsrf('/api/login', { email, password, lang: currentLang });
        const data = await res.json().catch(() => ({}));
        if (res.ok && data.twofaRequired) {
          twofaGroup.classList.remove('d-none');
          msg.className = "text-center text-muted small";
          msg.textContent = currentLang === 'az' ? "Authenticator tətbiqindəki 6 rəqəmli kodu daxil edin." : (currentLang === 'en' ? "Enter the 6-digit code from your authenticator app." : "Authenticator uygulamasındaki 6 haneli kodu girin.");
          twofaCodeEl.focus();
          return;
        }
        if (res.ok) {
          msg.className = "text-center text-success small";
          msg.textContent = currentLang === 'az' ? "Giriş uğurludur! Yönləndirilirsiniz..." : (currentLang === 'en' ? "Login successful! Redirecting..." : "Giriş başarılı! Yönlendiriliyorsunuz...");
          setClientSession({ email: data.username, isAdmin: false });
          setTimeout(() => window.location.href = '/', 1000);
        } else {
          msg.className = "text-center text-danger small";
          msg.textContent = data.error || (currentLang === 'az' ? "Giriş alınmadı." : (currentLang === 'en' ? "Login failed." : "Giriş başarısız."));
        }
      } catch (err) {
        msg.className = "text-center text-danger small";
        msg.textContent = (currentLang === 'az' ? "Xəta baş verdi." : (currentLang === 'en' ? "An error occurred." : "Hata oluştu.")) + (err && err.message ? " " + err.message : "");
      }
    });
  </script>

  <%- include('partials/public-footer', { footerClass: 'site-footer' }) %>

  <script nonce="<%= nonce %>" src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script nonce="<%= nonce %>" src="/lang.js?v=<%= assetVersion %>"></script>
  <script nonce="<%= nonce %>" src="/script.js?v=<%= assetVersion %>"></script>
</body>

</html>



