<!doctype html>
<html lang="<%= (seo && seo.lang) ? seo.lang : 'az' %>" dir="<%= (typeof dir !== 'undefined' && dir) ? dir : 'ltr' %>">
<head>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=<%= (typeof assetVersion !== 'undefined' ? assetVersion : '1') %>" />
  <link rel="icon" href="/favicon.ico?v=<%= (typeof assetVersion !== 'undefined' ? assetVersion : '1') %>" />
  <link rel="apple-touch-icon" href="/logo.png?v=<%= (typeof assetVersion !== 'undefined' ? assetVersion : '1') %>" />
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="csrf-token" content="<%= csrfToken %>" />
  <title><%= (seo && seo.title) ? seo.title : 'Ovlink — Agentlik Səviyyəsində Link və Hesabat İdarəçiliyi' %></title>

  <link rel="manifest" href="/site.webmanifest" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/vendor/fontawesome/css/all.min.css?v=<%= (typeof assetVersion !== 'undefined' ? assetVersion : '1') %>" />
  <link rel="stylesheet" href="/home.css?v=<%= assetVersion %>" />

  <meta name="description" content="<%= (seo && seo.description) ? seo.description : 'Agentliklər və bizneslər üçün özəl domenli qısa linklər, dinamik QR kodlar, bot filtri və canlı müştəri hesabat portalları.' %>" />
  <meta name="keywords" content="<%= (seo && seo.keywords) ? seo.keywords : '' %>" />
  <link rel="canonical" href="<%= (seo && seo.canonical) ? seo.canonical : '' %>" />
  <link rel="alternate" hreflang="en" href="<%= (seo && seo.hreflangEn) ? seo.hreflangEn : '' %>" />
  <link rel="alternate" hreflang="az" href="<%= (seo && seo.hreflangAz) ? seo.hreflangAz : '' %>" />
  <link rel="alternate" hreflang="tr" href="<%= (seo && seo.hreflangTr) ? seo.hreflangTr : '' %>" />
  <link rel="alternate" hreflang="x-default" href="<%= (seo && seo.hreflangXDefault) ? seo.hreflangXDefault : '' %>" />

  <style nonce="<%= (typeof nonce !== 'undefined' ? nonce : '') %>">
    /* === Monolith 07 — Exact Asymmetric Hero + Sticky 3D Scrollytelling === */
    body.ov-m07s {
      background: #0a0a0a !important;
      color: #f4f4f5 !important;
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif !important;
    }
    /* Note: Do NOT put overflow-x:hidden on body/html — it breaks position:sticky! Use clip instead. */
    html, body.ov-m07s {
      overflow-x: clip !important;
    }

    /* TALL STICKY 3D SCROLL TRACK (300vh = 3 full scroll chapters locked in viewport) */
    .s3d-track {
      position: relative;
      height: 300vh;
    }
    .s3d-sticky {
      position: sticky;
      top: 0;
      height: 100vh;
      display: flex;
      align-items: center;
      overflow: hidden;
    }
    .s3d-shell {
      width: 100%;
      max-width: 1140px;
      margin: 0 auto;
      padding: 64px 28px 24px;
      display: grid;
      grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.15fr);
      gap: 56px;
      align-items: center;
    }

    /* LEFT COLUMN: Exact Concept 07 Typography + Chapter Cross-fade */
    .s3d-left {
      position: relative;
      z-index: 5;
    }
    .s3d-chapters {
      position: relative;
      min-height: 250px;
    }
    .s3d-chapter {
      position: absolute;
      inset: 0;
      display: flex;
      flex-direction: column;
      justify-content: center;
      opacity: 0;
      transform: translateY(20px);
      pointer-events: none;
      transition: opacity 0.35s ease, transform 0.4s cubic-bezier(0.22, 1, 0.36, 1);
    }
    .s3d-chapter.is-active {
      position: relative;
      opacity: 1;
      transform: translateY(0);
      pointer-events: auto;
    }
    body.ov-m07s .m-hero-h1,
    .s3d-h2 {
      font-size: clamp(34px, 4.4vw, 54px) !important;
      font-weight: 700 !important;
      line-height: 1.08 !important;
      letter-spacing: -0.032em !important;
      color: #ffffff !important;
      margin: 0 0 18px !important;
      text-align: left !important;
      text-wrap: balance;
    }
    .s3d-desc {
      font-size: 16px;
      line-height: 1.62;
      color: #a1a1aa;
      max-width: 42ch;
      margin: 0 0 28px;
    }
    .s3d-cta-row {
      display: flex;
      align-items: center;
      gap: 14px;
      flex-wrap: wrap;
    }
    .s3d-pill-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      height: 44px;
      padding: 0 24px;
      border-radius: 999px;
      background: #ffffff;
      color: #0a0a0a !important;
      font-size: 14px;
      font-weight: 600;
      text-decoration: none;
      transition: background 0.15s ease, transform 0.15s ease;
    }
    .s3d-pill-btn:hover { background: #e4e4e7; transform: translateY(-1px); }
    .s3d-pill-ghost {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      height: 44px;
      padding: 0 20px;
      border-radius: 999px;
      border: 1px solid rgba(255, 255, 255, 0.16);
      color: #d4d4d8 !important;
      font-size: 14px;
      font-weight: 500;
      text-decoration: none;
      transition: border-color 0.15s ease, color 0.15s ease;
    }
    .s3d-pill-ghost:hover { border-color: rgba(255, 255, 255, 0.45); color: #ffffff !important; }

    /* Minimal scroll progress dots (bottom-left) */
    .s3d-progress {
      display: flex;
      align-items: center;
      gap: 10px;
      margin-top: 34px;
      font-size: 12px;
      color: #71717a;
    }
    .s3d-dots {
      display: flex;
      gap: 6px;
    }
    .s3d-dot {
      width: 24px;
      height: 3px;
      border-radius: 2px;
      background: rgba(255, 255, 255, 0.14);
      transition: background 0.25s ease, width 0.25s ease;
    }
    .s3d-dot.is-active {
      width: 40px;
      background: #ffffff;
    }

    /* RIGHT COLUMN: 3D PERSPECTIVE STACKED MONOLITH CARDS (Exact Concept 07 Visual!) */
    .s3d-stage {
      position: relative;
      height: 430px;
      perspective: 1600px;
      perspective-origin: 50% 50%;
      transform-style: preserve-3d;
    }
    .s3d-card {
      position: absolute;
      inset: 0;
      border-radius: 18px;
      border: 1px solid rgba(255, 255, 255, 0.13);
      background: #141416;
      box-shadow: 0 32px 80px rgba(0, 0, 0, 0.78), 0 1px 0 rgba(255, 255, 255, 0.06) inset;
      padding: 28px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      transform-style: preserve-3d;
      will-change: transform, opacity;
      backface-visibility: hidden;
    }
    .s3d-card-top {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
    }
    .s3d-card-ico {
      width: 32px;
      height: 32px;
      border-radius: 8px;
      background: rgba(255, 255, 255, 0.08);
      border: 1px solid rgba(255, 255, 255, 0.12);
      display: flex;
      align-items: center;
      justify-content: center;
      color: #ffffff;
      font-size: 13px;
    }
    .s3d-card-tag {
      font-size: 11.5px;
      font-weight: 500;
      color: #71717a;
      letter-spacing: 0.04em;
      text-transform: uppercase;
    }
    .s3d-card-title {
      font-size: 24px;
      font-weight: 700;
      letter-spacing: -0.025em;
      color: #ffffff;
      line-height: 1.2;
      margin: 16px 0 6px;
    }
    .s3d-card-sub {
      font-size: 13px;
      color: #a1a1aa;
      margin: 0 0 18px;
    }
    .s3d-card-grid {
      display: grid;
      grid-template-columns: 1.25fr 1fr;
      gap: 14px;
      flex: 1;
    }
    .s3d-mini-box {
      border-radius: 12px;
      border: 1px solid rgba(255, 255, 255, 0.08);
      background: #0e0e10;
      padding: 14px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }
    .s3d-mini-lbl {
      font-size: 11px;
      color: #71717a;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      margin-bottom: 8px;
    }
    .s3d-mini-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 8px 0;
      border-bottom: 1px solid rgba(255, 255, 255, 0.06);
      font-size: 12.5px;
      color: #e4e4e7;
    }
    .s3d-mini-row:last-child { border-bottom: none; padding-bottom: 0; }
    .s3d-mini-row span { color: #71717a; font-size: 12px; }

    /* BELOW STICKY STAGE: Sleek Live URL Tester + Final Close */
    .s3d-below {
      border-top: 1px solid rgba(255, 255, 255, 0.08);
      padding: 80px 28px;
      background: #0a0a0a;
    }
    .s3d-below-shell {
      max-width: 760px;
      margin: 0 auto;
    }
    .s3d-below-head {
      margin-bottom: 22px;
    }
    .s3d-below-head h2 {
      font-size: 24px;
      font-weight: 700;
      letter-spacing: -0.025em;
      color: #ffffff;
      margin: 0 0 6px;
    }
    .s3d-below-head p {
      font-size: 14.5px;
      color: #a1a1aa;
      margin: 0;
    }
    body.ov-m07s .m-composer {
      border-radius: 12px !important;
      border: 1px solid rgba(255, 255, 255, 0.14) !important;
      background: #111113 !important;
      padding: 10px 12px !important;
      box-shadow: none !important;
    }

    @media (max-width: 920px) {
      .s3d-track { height: auto; }
      .s3d-sticky { position: static; height: auto; padding: 100px 0 48px; }
      .s3d-shell { grid-template-columns: 1fr; gap: 36px; padding: 0 20px; }
      .s3d-chapter { position: relative !important; opacity: 1 !important; transform: none !important; pointer-events: auto !important; margin-bottom: 24px; }
      .s3d-chapter:not(:first-child) { display: none; }
      .s3d-stage { height: 390px; }
      .s3d-progress { display: none; }
    }
  </style>
</head>
<body class="ovx home-page ov-m07s">

  <a href="#mainContent" class="m-skip-link" data-i18n="skip_to_content">Skip to content</a>

  <% if (siteSettings && siteSettings.announcement_enabled === '1' && (siteSettings.announcement_text_az || siteSettings.announcement_text_tr || siteSettings.announcement_text_en)) { %>
    <div id="siteAnnouncement" class="m-ribbon" data-az="<%= siteSettings.announcement_text_az || '' %>" data-tr="<%= siteSettings.announcement_text_tr || '' %>" data-en="<%= siteSettings.announcement_text_en || '' %>">
      <i class="fa-solid fa-bullhorn" aria-hidden="true"></i>
      <span id="siteAnnouncementText"><%= siteSettings.announcement_text_az || siteSettings.announcement_text_tr || siteSettings.announcement_text_en %></span>
    </div>
  <% } %>

  <%- include('partials/home-navbar') %>

  <main id="mainContent">

    <!-- STICKY 3D SCROLLYTELLING STAGE (EXACT CONCEPT 07 + TRUE 3D SCROLL) -->
    <section class="s3d-track" id="s3dTrack" aria-labelledby="heroTitle">
      <div class="s3d-sticky">
        <div class="s3d-shell">

          <!-- LEFT: 3 Scroll-Linked Chapters (Starts on exact Concept 07) -->
          <div class="s3d-left">
            <div class="s3d-chapters">
              <div class="s3d-chapter is-active" data-s3d-ch="0">
                <h1 class="m-hero-h1" id="heroTitle">
                  Agentlik səviyyəsində link və hesabat idarəçiliyi.
                </h1>
                <p class="s3d-desc" data-i18n="hero_sub">
                  Brendli qısa linklər, dinamik QR kodlar, bot filtri və müştəriyə tək linklə verilən canlı hesabat portalları — tək monoxrom paneldə.
                </p>
                <div class="s3d-cta-row">
                  <a class="s3d-pill-btn" href="/register?intent=trial" data-i18n="hero_cta_trial">14 gün pulsuz başla</a>
                  <a class="s3d-pill-ghost" href="/contact?intent=demo" data-i18n="hero_cta_demo">Demo istə</a>
                </div>
              </div>

              <div class="s3d-chapter" data-s3d-ch="1">
                <h2 class="s3d-h2">Özəl domen və dinamik QR kodlar.</h2>
                <p class="s3d-desc">
                  Hər müştəri üçün öz domenini qoşun, çapdan sonra hədəfi dəyişən QR kodlar yaradın. Ödəniş dayansa belə mövcud linklər reklamsız işləyir.
                </p>
                <div class="s3d-cta-row">
                  <a class="s3d-pill-btn" href="/register?intent=trial">14 gün pulsuz başla</a>
                  <a class="s3d-pill-ghost" href="/pricing">Qiymətlərə bax</a>
                </div>
              </div>

              <div class="s3d-chapter" data-s3d-ch="2">
                <h2 class="s3d-h2">Bot-suz statistika və A4 PDF hesabat.</h2>
                <p class="s3d-desc">
                  Saxta bot klikləri avtomatik ayrılır. Ayın 1-i CSV ilə 1:1 eyni rəqəmli A4 PDF və canlı müştəri portalı avtomatik hazır olur.
                </p>
                <div class="s3d-cta-row">
                  <a class="s3d-pill-btn" href="/register?intent=trial">İndi sına</a>
                  <a class="s3d-pill-ghost" href="#liveShortener">Link qısaldıb yoxla ↓</a>
                </div>
              </div>
            </div>

            <div class="s3d-progress" aria-hidden="true">
              <div class="s3d-dots">
                <span class="s3d-dot is-active" data-s3d-dot="0"></span>
                <span class="s3d-dot" data-s3d-dot="1"></span>
                <span class="s3d-dot" data-s3d-dot="2"></span>
              </div>
              <span id="s3dScrollHint">Aşağı sürüşdürün</span>
            </div>
          </div>

          <!-- RIGHT: 3D STACKED MONOLITH CARDS (Matches Concept 07 + Peels & Rotates in 3D on Scroll) -->
          <div class="s3d-stage" id="s3dStage" aria-label="Ovlink 3D Məhsul Kartları">

            <!-- Card 3 (Back layer — A4 PDF & Bot Filter) -->
            <article class="s3d-card" id="s3dCard2" style="z-index: 1;">
              <div class="s3d-card-top">
                <div class="s3d-card-ico"><i class="fa-solid fa-file-pdf" aria-hidden="true"></i></div>
                <span class="s3d-card-tag">03 · Avtomatik Hesabat</span>
              </div>
              <div>
                <div class="s3d-card-title">A4 PDF &amp; Bot Filtri</div>
                <p class="s3d-card-sub">CSV ilə 1:1 eyni rəqəmlər · Skanerlər və botlar avtomatik təmizlənir</p>
              </div>
              <div class="s3d-card-grid">
                <div class="s3d-mini-box">
                  <div class="s3d-mini-lbl">Aylıq Göndəriş</div>
                  <div class="s3d-mini-row"><strong>PDF Hesabat</strong><span>Hər ayın 1-i</span></div>
                  <div class="s3d-mini-row"><strong>CSV Uyğunluğu</strong><span>1:1 dəqiq</span></div>
                  <div class="s3d-mini-row"><strong>Bot Filtri</strong><span>Aktiv</span></div>
                </div>
                <div class="s3d-mini-box" style="align-items:center;justify-content:center;text-align:center;">
                  <svg viewBox="0 0 80 80" width="76" height="76" aria-hidden="true">
                    <circle cx="40" cy="40" r="30" fill="none" stroke="rgba(255,255,255,0.1)" stroke-width="7"/>
                    <circle cx="40" cy="40" r="30" fill="none" stroke="#ffffff" stroke-width="7" stroke-dasharray="176 189" stroke-linecap="round" transform="rotate(-90 40 40)"/>
                  </svg>
                  <div style="font-size:12px;color:#a1a1aa;margin-top:8px;">Təmiz insan trafiki</div>
                </div>
              </div>
            </article>

            <!-- Card 2 (Middle layer — Custom Domain & Dynamic QR) -->
            <article class="s3d-card" id="s3dCard1" style="z-index: 2;">
              <div class="s3d-card-top">
                <div class="s3d-card-ico"><i class="fa-solid fa-qrcode" aria-hidden="true"></i></div>
                <span class="s3d-card-tag">02 · Brend &amp; QR</span>
              </div>
              <div>
                <div class="s3d-card-title">Özəl Domen &amp; Dinamik QR</div>
                <p class="s3d-card-sub">Çapdan sonra hədəfi dəyişin · Avtomatik SSL &amp; DNS yoxlaması</p>
              </div>
              <div class="s3d-card-grid">
                <div class="s3d-mini-box">
                  <div class="s3d-mini-lbl">Aktiv Domenlər</div>
                  <div class="s3d-mini-row"><strong>go.brend.az</strong><span>TLS Aktiv</span></div>
                  <div class="s3d-mini-row"><strong>qr.agentlik.az</strong><span>TLS Aktiv</span></div>
                  <div class="s3d-mini-row"><strong>UTM Şablonları</strong><span>Hazır</span></div>
                </div>
                <div class="s3d-mini-box" style="align-items:center;justify-content:center;">
                  <i class="fa-solid fa-qrcode" style="font-size:64px;color:#ffffff;opacity:0.9;" aria-hidden="true"></i>
                  <div style="font-size:11.5px;color:#a1a1aa;margin-top:10px;">SVG / 2048px PNG</div>
                </div>
              </div>
            </article>

            <!-- Card 1 (Front layer — Exact Concept 07 Client Report Dashboard!) -->
            <article class="s3d-card" id="s3dCard0" style="z-index: 3;">
              <div class="s3d-card-top">
                <div class="s3d-card-ico"><i class="fa-solid fa-file-lines" aria-hidden="true"></i></div>
                <span class="s3d-card-tag">01 · Canlı Portal</span>
              </div>
              <div>
                <div class="s3d-card-title">Müştəri Hesabat Portalı</div>
                <p class="s3d-card-sub">White-label · Yalnız baxış · İstənilən vaxt ləğv edilən link</p>
              </div>
              <div class="s3d-card-grid">
                <div class="s3d-mini-box">
                  <div class="s3d-mini-lbl">Klik Dinamikası</div>
                  <svg viewBox="0 0 220 96" width="100%" height="96" role="img" aria-label="Klik qrafiki">
                    <defs>
                      <linearGradient id="s3dGrad" x1="0" y1="0" x2="0" y2="1">
                        <stop offset="0%" stop-color="#ffffff" stop-opacity="0.22"/>
                        <stop offset="100%" stop-color="#ffffff" stop-opacity="0"/>
                      </linearGradient>
                    </defs>
                    <path d="M0,84 C32,74 52,58 84,64 C118,70 140,36 172,42 C192,46 205,22 220,14 L220,96 L0,96 Z" fill="url(#s3dGrad)"/>
                    <path d="M0,84 C32,74 52,58 84,64 C118,70 140,36 172,42 C192,46 205,22 220,14" fill="none" stroke="#ffffff" stroke-width="2"/>
                  </svg>
                </div>
                <div class="s3d-mini-box">
                  <div class="s3d-mini-lbl">Kanal Bölgüsü</div>
                  <div style="display:flex;align-items:center;justify-content:center;margin:6px 0;">
                    <svg viewBox="0 0 64 64" width="58" height="58" aria-hidden="true">
                      <circle cx="32" cy="32" r="24" fill="none" stroke="rgba(255,255,255,0.12)" stroke-width="6"/>
                      <circle cx="32" cy="32" r="24" fill="none" stroke="#ffffff" stroke-width="6" stroke-dasharray="105 151" stroke-linecap="round" transform="rotate(-90 32 32)"/>
                    </svg>
                  </div>
                  <div class="s3d-mini-row"><span>Instagram / QR</span><strong>Canlı</strong></div>
                </div>
              </div>
            </article>

          </div>
        </div>
      </div>
    </section>

    <!-- LIVE LINK TESTER SECTION -->
    <section class="s3d-below" id="liveShortener" aria-labelledby="featuresTitle">
      <div class="s3d-below-shell">
        <div class="s3d-below-head">
          <h2 id="featuresTitle" data-i18n="feat_title">İndi 1 link qısaldıb yoxlayın</h2>
          <p data-i18n="feat_sub">Qeydiyyatsız test edin — özəl domen, QR və canlı müştəri portalları üçün 14 gün pulsuz sınağa başlayın.</p>
        </div>

        <div class="m-composer">
          <form id="shortenForm" action="javascript:void(0);">
            <div class="m-composer-row">
              <span class="m-composer-icon"><i class="fa-solid fa-link" aria-hidden="true"></i></span>
              <input class="m-composer-input" type="url" id="originalUrl" name="originalUrl"
                placeholder="https://saytiniz.az/kampaniya"
                data-i18n="input_placeholder"
                data-i18n-aria="aria_long_url"
                autocomplete="off" spellcheck="false" required aria-label="Long URL to shorten" />
              <button type="submit" class="m-composer-submit" id="shortenSubmitBtn" aria-label="Shorten" data-i18n-aria="shorten_btn" title="Shorten" data-i18n-title="shorten_btn">
                <span data-i18n="shorten_btn">Qısalt</span>
                <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
              </button>
            </div>

            <div class="m-composer-meta">
              <span id="composerGuestHint">
                <span>Tam B2B imkanlar üçün</span>
                <a href="/register?intent=trial">pulsuz hesab açın</a> · <a href="/pricing">Qiymətlər ($7/ay-dan)</a>
              </span>
              <span class="m-ws-wrap" id="homeWorkspaceTopWrapper" hidden>
                <button type="button" class="m-ws-btn" id="homeWorkspaceDropdownBtn" aria-haspopup="true" aria-expanded="false" aria-controls="homeWorkspaceDropdownMenu">
                  <i class="fa-regular fa-user" id="homeWorkspaceBtnIcon" aria-hidden="true"></i>
                  <span id="homeWorkspaceBtnText" data-i18n="workspace_personal">Personal</span>
                  <i class="fa-solid fa-chevron-down" style="font-size:9px;opacity:.5;" aria-hidden="true"></i>
                </button>
                <div class="m-ws-panel" id="homeWorkspaceDropdownMenu" role="menu"></div>
              </span>
            </div>

            <button type="button" class="m-adv-toggle" id="advancedToggleBtn" aria-expanded="false" aria-controls="advancedPanel">
              <i class="fa-solid fa-sliders" aria-hidden="true"></i>
