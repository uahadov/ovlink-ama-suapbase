  <script nonce="<%= nonce %>" defer src="/home.js?v=<%= assetVersion %>"></script>
  <script nonce="<%= nonce %>">
    (function () {
      /* 60fps GPU-accelerated 3D scroll engine (respects prefers-reduced-motion) */
      var reduced = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      var stageWrap = document.getElementById('m07StageWrap');
      var stage = document.getElementById('m07Stage');
      var floatCard = document.getElementById('m07FloatCard');
      var cards = Array.prototype.slice.call(document.querySelectorAll('[data-scroll-card]'));
      var ticking = false;

      function clamp(v, min, max) { return Math.max(min, Math.min(max, v)); }

      function update3D() {
        ticking = false;
        if (reduced) return;
        var vh = window.innerHeight || 800;

        if (stageWrap && stage) {
          var rect = stageWrap.getBoundingClientRect();
          /* Progress 0 -> 1 as stage enters from bottom to center */
          var p = clamp((vh - rect.top) / (vh * 0.72), 0, 1);
          var rotX = (1 - p) * 20;
          var scale = 0.93 + p * 0.07;
          var ty = (1 - p) * 28;
          stage.style.transform = 'rotateX(' + rotX.toFixed(2) + 'deg) scale(' + scale.toFixed(4) + ') translateY(' + ty.toFixed(1) + 'px)';
          if (floatCard && window.innerWidth > 900) {
            var fy = (1 - p) * 34 - p * 10;
            var fRot = (1 - p) * -6;
            floatCard.style.transform = 'translateZ(48px) translateY(' + fy.toFixed(1) + 'px) rotateY(' + fRot.toFixed(2) + 'deg)';
          }
        }

        cards.forEach(function (card, idx) {
          var r = card.getBoundingClientRect();
          var cp = clamp((vh - r.top - idx * 24) / (vh * 0.45), 0, 1);
          var cRot = (1 - cp) * 12;
          var cY = (1 - cp) * 26;
          card.style.transform = 'rotateX(' + cRot.toFixed(2) + 'deg) translateY(' + cY.toFixed(1) + 'px)';
          card.style.opacity = (0.35 + cp * 0.65).toFixed(3);
        });
      }

      function onScroll() {
        if (!ticking) {
          ticking = true;
          window.requestAnimationFrame(update3D);
        }
      }

      if (!reduced) {
        window.addEventListener('scroll', onScroll, { passive: true });
        window.addEventListener('resize', onScroll, { passive: true });
        update3D();
      }

      /* Advanced composer toggle & tabs */
      var advBtn = document.getElementById('advancedToggleBtn');
      var advPanel = document.getElementById('advancedPanel');
      var advChev = document.getElementById('advancedChevron');
      if (advBtn && advPanel) {
        advBtn.addEventListener('click', function () {
          var open = advPanel.classList.toggle('open');
          advBtn.setAttribute('aria-expanded', open ? 'true' : 'false');
          if (advChev) advChev.style.transform = open ? 'rotate(180deg)' : '';
        });
      }
      document.querySelectorAll('.m-adv-tab').forEach(function (tab) {
        tab.addEventListener('click', function () {
          var target = tab.getAttribute('data-tab');
          document.querySelectorAll('.m-adv-tab').forEach(function (t) {
            t.classList.toggle('active', t === tab);
            t.setAttribute('aria-selected', t === tab ? 'true' : 'false');
          });
          document.querySelectorAll('.m-adv-tab-content').forEach(function (c) {
            c.classList.toggle('active', c.id === target);
          });
        });
      });
    })();
  </script>
</body>
