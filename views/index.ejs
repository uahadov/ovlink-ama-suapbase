<!doctype html>
<html lang="<%= (seo && seo.lang) ? seo.lang : 'en' %>">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="csrf-token" content="<%= csrfToken %>">
  <meta name="yandex-verification" content="71461f9fd9f723bc" />
  <link rel="icon" href="/logo.ico" />
  <link rel="manifest" href="/site.webmanifest" />
  <title><%= (seo && seo.title) ? seo.title : 'Ovlink' %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="preconnect" href="https://cdn.jsdelivr.net">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
  <!-- Özel CSS -->
  <link rel="stylesheet" href="/style.css?v=<%= assetVersion %>" />
  <meta name="description" content="<%= (seo && seo.description) ? seo.description : '' %>" />
  <meta name="keywords" content="<%= (seo && seo.keywords) ? seo.keywords : '' %>" />
  <meta name="geo.region" content="AZ" />
  <meta name="geo.placename" content="Baku" />
  <meta name="geo.position" content="40.4093;49.8671" />
  <meta name="ICBM" content="40.4093, 49.8671" />
  <link rel="canonical" href="<%= (seo && seo.canonical) ? seo.canonical : '' %>" />
  <link rel="alternate" hreflang="en" href="<%= (seo && seo.hreflangEn) ? seo.hreflangEn : '' %>" />
  <link rel="alternate" hreflang="az" href="<%= (seo && seo.hreflangAz) ? seo.hreflangAz : '' %>" />
  <link rel="alternate" hreflang="tr" href="<%= (seo && seo.hreflangTr) ? seo.hreflangTr : '' %>" />
  <link rel="alternate" hreflang="x-default" href="<%= (seo && seo.hreflangXDefault) ? seo.hreflangXDefault : '' %>" />
  <meta property="og:title" content="<%= (seo && seo.ogTitle) ? seo.ogTitle : '' %>" />
  <meta property="og:description" content="<%= (seo && seo.ogDescription) ? seo.ogDescription : '' %>" />
  <meta property="og:url" content="<%= (seo && seo.ogUrl) ? seo.ogUrl : '' %>" />
  <meta property="og:type" content="website" />
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content="<%= (seo && seo.twitterTitle) ? seo.twitterTitle : '' %>" />
  <meta name="twitter:description" content="<%= (seo && seo.twitterDescription) ? seo.twitterDescription : '' %>" />
  <% if (seo && seo.jsonLd) { %>
  <script nonce="<%= nonce %>" type="application/ld+json"><%- seo.jsonLd %></script>
  <% } %>
</head>

<body class="home-page animated-gradient-bg">

  <div class="particles-container" id="particlesContainer"></div>

  <% if (siteSettings && siteSettings.announcement_enabled === '1' && (siteSettings.announcement_text_az || siteSettings.announcement_text_tr || siteSettings.announcement_text_en)) { %>
    <div id="siteAnnouncement" class="site-announcement" data-az="<%= siteSettings.announcement_text_az || '' %>" data-tr="<%= siteSettings.announcement_text_tr || '' %>" data-en="<%= siteSettings.announcement_text_en || '' %>">
      <div class="container">
        <i class="fa-solid fa-bullhorn"></i>
        <span id="siteAnnouncementText"><%= siteSettings.announcement_text_az || siteSettings.announcement_text_tr || siteSettings.announcement_text_en %></span>
      </div>
    </div>
  <% } %>

  <!-- Navbar -->
  <%- include('partials/public-navbar') %>


  <main>
    <!-- Hero Section -->
    <section id="hero" class="d-flex align-items-center">
      <div class="container">
        <div class="row justify-content-center">
          <div class="col-lg-8 text-center">
            <div class="badge hero-chip hero-badge rounded-pill px-3 py-2 mb-4 shadow-sm fw-semibold">
              <i class="fa-solid fa-link me-1"></i><span data-i18n="hero_badge">Ovlink - Next-Gen Link Management</span>
            </div>
            <h1 class="hero-title mb-4">
              <span class="hero-title-word hero-title-accent" data-i18n="hero_title_line2">Linklərinizi</span>
              <span class="hero-title-word" data-i18n="hero_title_line1">Qısaldın və İdarə Edin</span>
            </h1>
            <p class="hero-subtitle mb-5 px-lg-5" data-i18n="hero_subtitle">
              Smarter links, better results. Sign up for free and track your statistics with our advanced analytics dashboard.
            </p>
            <div class="glass-card home-form-card shadow-lg text-start mx-auto hero-form">
              <form id="shortenForm">
                <div class="mb-3 d-none" id="homeWorkspaceTopWrapper">
                  <button class="btn btn-sm btn-light border dropdown-toggle rounded-pill fw-medium px-3 shadow-none" type="button" id="homeWorkspaceDropdownBtn" data-bs-toggle="dropdown" aria-expanded="false">
                    <i class="fa-solid fa-user text-muted me-1" id="homeWorkspaceBtnIcon"></i>
                    <span id="homeWorkspaceBtnText">Şəxsi hesab</span>
                  </button>
                  <ul class="dropdown-menu shadow-sm border-0" id="homeWorkspaceDropdownMenu" style="font-size: 0.9rem; border-radius: 12px;">
                    <!-- Populated via JS -->
                  </ul>
                </div>

                <div class="input-group input-group-lg mb-4 shadow-sm">
                  <span class="input-group-text bg-white border-end-0 text-muted"><i class="fa-solid fa-link"></i></span>
                  <input type="url" id="originalUrl" class="form-control border-start-0"
                    placeholder="Uzun linki bura yapışdırın..." data-i18n="input_placeholder" required
                    aria-label="Uzun Link URL" />
                </div>

                <div class="row g-3 mb-4">
                  <div class="col-md-6">
                    <div class="input-group shadow-sm">
                      <span class="input-group-text bg-white border-end-0 text-muted"><i
                          class="fa-solid fa-at"></i></span>
                      <input type="text" id="customAlias" class="form-control border-start-0"
                        data-i18n="alias_placeholder" placeholder="Xüsusi ad" aria-label="Özel Link Adı" />
                    </div>
                  </div>
                  <div class="col-md-6">
                    <div class="input-group shadow-sm">
                      <span class="input-group-text bg-white border-end-0 text-muted"><i
                          class="fa-solid fa-lock"></i></span>
                      <input type="password" id="linkPassword" class="form-control border-start-0"
                        data-i18n="pass_placeholder" placeholder="Şifrə" aria-label="Link Şifrəsi" />
                    </div>
                  </div>
                </div>

                <div class="accordion mb-4" id="advancedSettingsAccordion">
                  <div class="accordion-item border-0 bg-transparent">
                    <h2 class="accordion-header">
                      <button class="accordion-button advanced-toggle collapsed bg-white shadow-sm py-2 px-4 small"
                        type="button" data-bs-toggle="collapse" data-bs-target="#collapseAdvanced" aria-expanded="false"
                        aria-controls="collapseAdvanced">
                        <i class="fa-solid fa-sliders me-2"></i> <span data-i18n="advanced_settings">Advanced Settings</span>
                      </button>
                    </h2>
                    <div id="collapseAdvanced" class="accordion-collapse collapse"
                      data-bs-parent="#advancedSettingsAccordion">
                      <div class="accordion-body mt-3 p-0">
                        <div class="card border-0 shadow-sm rounded-4 bg-light bg-opacity-50 overflow-hidden">
                          
                          <!-- Tabs Nav -->
                          <ul class="nav nav-tabs nav-fill bg-white border-bottom" id="advancedTabs" role="tablist">
                            <li class="nav-item" role="presentation">
                              <button class="nav-link active fw-semibold py-3 border-0 text-dark" id="general-tab" data-bs-toggle="tab" data-bs-target="#general-pane" type="button" role="tab" aria-controls="general-pane" aria-selected="true" data-i18n="adv_tab_general">Genel</button>
                            </li>
                            <li class="nav-item" role="presentation">
                              <button class="nav-link fw-semibold py-3 border-0 text-muted" id="utm-tab" data-bs-toggle="tab" data-bs-target="#utm-pane" type="button" role="tab" aria-controls="utm-pane" aria-selected="false" data-i18n="adv_tab_utm">UTM</button>
                            </li>
                            <li class="nav-item" role="presentation">
                              <button class="nav-link fw-semibold py-3 border-0 text-muted" id="abtest-tab" data-bs-toggle="tab" data-bs-target="#abtest-pane" type="button" role="tab" aria-controls="abtest-pane" aria-selected="false" data-i18n="adv_tab_ab">A/B Test</button>
                            </li>
                            <li class="nav-item" role="presentation">
                              <button class="nav-link fw-semibold py-3 border-0 text-muted" id="device-tab" data-bs-toggle="tab" data-bs-target="#device-pane" type="button" role="tab" aria-controls="device-pane" aria-selected="false" data-i18n="adv_tab_device">Cihaz</button>
                            </li>
                          </ul>
                          
                          <!-- Tabs Content -->
                          <div class="tab-content p-4" id="advancedTabsContent">
                            
                            <!-- General Tab -->
                            <div class="tab-pane fade show active" id="general-pane" role="tabpanel" aria-labelledby="general-tab" tabindex="0">
                              <div class="row g-3">
                                <div class="col-md-6 mb-3">
                                  <label for="expiresAt" class="form-label small fw-bold text-muted"
                                    data-i18n="expiry_date">Son İstifadə Tarihi</label>
                                  <input type="datetime-local" id="expiresAt" class="form-control">
                                </div>
                                <div class="col-md-6 mb-3">
                                  <label for="maxClicks" class="form-label small fw-bold text-muted"
                                    data-i18n="max_clicks">Limit</label>
                                  <input type="number" id="maxClicks" class="form-control" placeholder="100"
                                    aria-label="Maksimum Klik Sayı">
                                </div>
                                <div class="col-md-12">
                                  <label for="customDomainSelect" class="form-label small fw-bold text-muted"
                                    data-i18n="shorten_domain_label">Qısa link domeni</label>
                                  <select id="customDomainSelect" class="form-select">
                                    <option value="" data-i18n="shorten_domain_default">Default (ovlink.sbs)</option>
                                  </select>
                                  <div class="d-flex justify-content-between align-items-center mt-2">
                                    <div class="form-text custom-domain-hint mb-0" data-i18n="shorten_domain_hint">Aktiv etdiyiniz domenlər burada görünür.</div>
                                    <a href="/account#customDomainSection" class="small fw-semibold text-decoration-none custom-domain-manage-link" data-i18n="shorten_domain_manage_link">Xüsusi domen əlavə et</a>
                                  </div>
                                </div>
                              </div>
                            </div>
                            
                            <!-- UTM Tab -->
                            <div class="tab-pane fade" id="utm-pane" role="tabpanel" aria-labelledby="utm-tab" tabindex="0">
                              <div class="d-flex justify-content-between align-items-center mb-3">
                                <h6 class="fw-bold mb-0 text-primary"><i class="fa-solid fa-bullhorn me-2"></i><span data-i18n="adv_utm_params_title">UTM Parameters</span></h6>
                                <div class="d-flex gap-2">
                                  <select id="utmTemplateSelect" class="form-select form-select-sm" style="width: auto;">
                                    <option value="" data-i18n="adv_utm_template_select">Şablon Seç</option>
                                  </select>
                                  <button type="button" id="saveUtmTemplateBtn" class="btn btn-sm btn-outline-primary" data-bs-toggle="tooltip" data-i18n-title="adv_utm_save_tooltip" title="Mevcut UTM ayarlarını kaydet"><i class="fa-solid fa-floppy-disk"></i></button>
                                </div>
                              </div>
                              <div class="row g-3">
                                <div class="col-md-12">
                                  <label for="utmSource" class="form-label small fw-semibold text-muted" data-i18n="adv_utm_source">Source (Kaynak)</label>
                                  <input type="text" id="utmSource" class="form-control" data-i18n-placeholder="adv_utm_source_ph" placeholder="örn. instagram">
                                </div>
                                <div class="col-md-6">
                                  <label for="utmMedium" class="form-label small fw-semibold text-muted" data-i18n="adv_utm_medium">Medium (Araç)</label>
                                  <input type="text" id="utmMedium" class="form-control" data-i18n-placeholder="adv_utm_medium_ph" placeholder="örn. social">
                                </div>
                                <div class="col-md-6">
                                  <label for="utmCampaign" class="form-label small fw-semibold text-muted" data-i18n="adv_utm_campaign">Campaign (Kampanya)</label>
                                  <input type="text" id="utmCampaign" class="form-control" data-i18n-placeholder="adv_utm_campaign_ph" placeholder="örn. yaz_indirimi">
                                </div>
                              </div>
                            </div>
                            
                            <!-- A/B Test Tab -->
                            <div class="tab-pane fade" id="abtest-pane" role="tabpanel" aria-labelledby="abtest-tab" tabindex="0">
                              <h6 class="fw-bold mb-3 d-flex align-items-center text-primary">
                                <i class="fa-solid fa-shuffle me-2"></i>
                                <span class="me-2" data-i18n="adv_ab_title">A/B Testi (Link Rotatör)</span>
                                <span class="badge bg-warning text-dark px-2 py-1 rounded-pill" style="font-size: 0.65rem;" data-i18n="pro_badge"><i class="fa-solid fa-crown me-1"></i>PRO</span>
                              </h6>
                              <div class="row g-3">
                                <div class="col-12">
                                  <label for="originalB" class="form-label small fw-semibold text-muted" data-i18n="adv_ab_url_b">Hedef URL B (İkinci Link)</label>
                                  <input type="url" id="originalB" class="form-control" data-i18n-placeholder="adv_ab_url_b_ph" placeholder="https://...">
                                </div>
                                <div class="col-12">
                                  <label for="abSplitPercent" class="form-label small fw-semibold text-muted" data-i18n="adv_ab_split">Link A Trafiği (%)</label>
                                  <div class="input-group">
                                    <input type="number" id="abSplitPercent" class="form-control" placeholder="50" min="0" max="100" value="50">
                                    <span class="input-group-text">%</span>
                                  </div>
                                  <div class="form-text small" data-i18n="adv_ab_hint">Kalan trafik Link B'ye gider.</div>
                                </div>
                              </div>
                            </div>
                            
                            <!-- Device Targeting Tab -->
                            <div class="tab-pane fade" id="device-pane" role="tabpanel" aria-labelledby="device-tab" tabindex="0">
                              <h6 class="fw-bold mb-3 d-flex align-items-center text-primary">
                                <i class="fa-solid fa-mobile-screen-button me-2"></i>
                                <span class="me-2" data-i18n="adv_device_title">Cihaz Hedefleme</span>
                                <span class="badge bg-warning text-dark px-2 py-1 rounded-pill" style="font-size: 0.65rem;" data-i18n="pro_badge"><i class="fa-solid fa-crown me-1"></i>PRO</span>
                              </h6>
                              <div class="row g-3">
                                <div class="col-12">
                                  <label for="iosUrl" class="form-label small fw-semibold text-muted" data-i18n="adv_device_ios"><i class="fa-brands fa-apple me-1"></i>iOS Yönlendirme</label>
                                  <input type="url" id="iosUrl" class="form-control" data-i18n-placeholder="adv_device_ios_ph" placeholder="https://apps.apple.com/...">
                                </div>
                                <div class="col-12">
                                  <label for="androidUrl" class="form-label small fw-semibold text-muted" data-i18n="adv_device_android"><i class="fa-brands fa-android me-1 text-success"></i>Android Yönlendirme</label>
                                  <input type="url" id="androidUrl" class="form-control" data-i18n-placeholder="adv_device_android_ph" placeholder="https://play.google.com/...">
                                </div>
                              </div>
                            </div>

                          </div>
                          <!-- End Tabs Content -->
                          
                        </div>
                      </div>
                    </div>
                  </div>
                </div>

                <div id="shortenFeedback" class="alert d-none py-2 mb-3 small fw-bold text-center rounded-pill"
                  role="alert"></div>

                <button type="submit" class="btn btn-primary btn-lg w-100 rounded-pill py-3 fw-bold shadow-lg home-primary-btn btn-animated btn-glow btn-shimmer btn-magnetic btn-stagger">
                  <span data-i18n="shorten_btn">Shorten & Create QR</span><i class="fa-solid fa-qrcode ms-2"></i>
                </button>
              </form>

              <div id="result" class="result mt-4 pt-4 border-top text-center" style="display: none;">
                <h5 class="fw-bold mb-3"><i class="fa-solid fa-circle-check text-success me-2"></i> <span
                    data-i18n="generated_title">Linkiniz Hazırdır!</span></h5>
                <div class="bg-light p-3 rounded-4 mb-3 border">
                  <a id="shortUrl" href="#" target="_blank" rel="noopener"
                    class="h5 mb-0 text-primary fw-bold text-decoration-none d-block text-truncate"></a>
                </div>
                <div class="d-flex gap-3 justify-content-center">
                  <button id="copyShortBtn" type="button" class="btn btn-dark rounded-pill px-4 btn-sm btn-animated btn-magnetic btn-stagger"
                    aria-label="Kısa Linki Kopyala">
                    <i class="fa-solid fa-copy me-2"></i> <span data-i18n="copy_btn">Kopyala</span>
                  </button>
                  <button id="sendToQrBtn" type="button" class="btn btn-outline-primary rounded-pill px-4 btn-sm btn-animated btn-magnetic btn-stagger">
                    <i class="fa-solid fa-qrcode me-2"></i> <span data-i18n="send_qr_btn">QR-ə Göndər</span>
                  </button>
                </div>
                <p id="shortenHint" class="mt-3 mb-0 small text-muted fst-italic"></p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="toolsSection" class="py-5">
      <div class="container">
        <div class="row g-4 justify-content-center">
          <div class="col-lg-6">
            <div id="qrSection" class="glass-card tool-card shadow-sm p-4 border-0 h-100 reveal-left">
              <div class="tool-card-icon tool-card-icon--cyan mb-3"><i class="fa-solid fa-qrcode"></i></div>
              <h3 class="fw-bold mb-4" data-i18n="qr_customize">Customize QR Code</h3>
              <form id="qrForm" class="d-flex flex-column gap-3">
                <div class="input-group">
                  <span class="input-group-text bg-white border-end-0 text-info"><i class="fa-solid fa-link"></i></span>
                  <input type="text" id="qrShortLink" class="form-control border-start-0"
                    placeholder="Short link (e.g., abc123)" data-i18n="qr_alias_placeholder" required
                    aria-label="QR short link" />
                </div>

                <div class="row g-2 text-start">
                  <div class="col-6">
                    <label for="colorDark" class="form-label small fw-bold text-muted mb-1" data-i18n="qr_fg_color">QR Color</label>
                    <input type="color" class="form-control form-control-color w-100 rounded-pill border-0 shadow-sm"
                      id="colorDark" value="#000000">
                  </div>
                  <div class="col-6">
                    <label for="colorLight" class="form-label small fw-bold text-muted mb-1"
                      data-i18n="qr_bg_color">Background Color</label>
                    <input type="color" class="form-control form-control-color w-100 rounded-pill border-0 shadow-sm"
                      id="colorLight" value="#ffffff">
                  </div>
                </div>

                <div id="qrFeedback" class="alert d-none py-2 mb-3 small fw-bold text-center rounded-pill" role="alert"></div>

                <button type="submit" class="btn btn-info btn-lg w-100 rounded-pill fw-bold text-white shadow-sm mt-2 tool-btn tool-btn-cyan btn-animated btn-stagger tool-btn-hover-spin">
                  <i class="fa-solid fa-qrcode me-2"></i> <span data-i18n="qr_customize">Customize QR</span>
                </button>
              </form>
              <div id="qrResult" class="mt-4 text-center hidden p-3 bg-white rounded-4 border shadow-sm">
                <img id="qrImage" src="" alt="QR code" class="img-fluid rounded" style="max-width: 200px;" width="200" height="200" loading="lazy" decoding="async" />
                <div id="qrDownloadHint" class="mt-2 small text-muted" data-i18n="qr_download_hint">Download your QR as PNG.</div>
                <button type="button" id="qrDownloadBtn" class="btn btn-info btn-sm rounded-pill fw-bold text-white shadow-sm mt-3 tool-btn tool-btn-cyan d-none qr-download-btn btn-animated btn-stagger">
                  <i class="fa-solid fa-download me-2"></i><span data-i18n="qr_download_btn">Download QR</span>
                </button>
              </div>
            </div>
          </div>

          <div class="col-lg-6">
            <div id="reportSection" class="glass-card tool-card shadow-sm p-4 border-0 h-100 reveal-right">
              <div class="tool-card-icon tool-card-icon--rose mb-3"><i class="fa-solid fa-flag"></i></div>
              <h3 class="fw-bold mb-4" data-i18n="report_title">Report Link</h3>
              <form id="reportForm" class="d-flex flex-column gap-3">
                <div class="input-group">
                  <span class="input-group-text bg-white border-end-0 text-warning"><i class="fa-solid fa-flag"></i></span>
                  <input type="text" id="reportLink" class="form-control border-start-0" placeholder="Short link to report"
                    data-i18n="report_placeholder" required aria-label="Report short link" />
                </div>
                <textarea id="reportReason" class="form-control rounded-4 shadow-sm"
                  placeholder="Reason for reporting..." data-i18n="report_reason" rows="3"
                  aria-label="Report reason"></textarea>
                <button type="submit" class="btn btn-warning btn-lg w-100 rounded-pill fw-bold text-white shadow-sm tool-btn tool-btn-rose btn-animated btn-stagger tool-btn-hover-spin">
                  <i class="fa-solid fa-paper-plane me-2"></i> <span data-i18n="report_btn">Submit Report</span>
                </button>
              </form>
              <p id="reportMessage" class="text-center mt-3 small fw-bold"></p>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

    <section class="py-5 home-why-section">
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-lg-10">
        <h2 class="fw-bold text-center mb-4" data-i18n="home_long_title">Niyə Ovlink?</h2>
        <p class="lead mb-3 home-why-lead" data-i18n="home_why_teaser_p1">Ovlink etibarlı və idarəolunan qısa linklər istəyənlər üçün hazırlanıb. Platforma legitim paylaşım üçün nəzərdə tutulub və təhlükəsizlik/siyasət qaydalarını pozan linkləri məhdudlaşdıra bilər.</p>
        <p class="mb-4 home-why-text" data-i18n="home_why_teaser_p2">Linklərinizi qısaldın, şifrələyin, bitmə müddəti təyin edin və statistikanı real vaxtda izləyin.</p>
        <div class="text-center">
          <a href="/why-ovlink" class="btn btn-outline-primary rounded-pill px-4 home-outline-btn btn-animated btn-stagger" data-i18n="home_why_cta">Read full story</a>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="py-5 home-feature-section">
  <div class="container">
    <div class="row justify-content-center mb-4">
      <div class="col-lg-10 text-center">
        <h2 class="fw-bold mb-2 home-feature-title" data-i18n="home_value_title">How it works & Why it's safe</h2>
      </div>
    </div>
    <div class="row g-4">
      <div class="col-md-6 col-xl-3">
