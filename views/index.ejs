<!doctype html>
<html lang="<%= (seo && seo.lang) ? seo.lang : 'az' %>" dir="<%= (typeof dir !== 'undefined' && dir) ? dir : 'ltr' %>">
<head>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=<%= (typeof assetVersion !== 'undefined' ? assetVersion : '1') %>" />
  <link rel="icon" href="/favicon.ico?v=<%= (typeof assetVersion !== 'undefined' ? assetVersion : '1') %>" />
  <link rel="apple-touch-icon" href="/logo.png?v=<%= (typeof assetVersion !== 'undefined' ? assetVersion : '1') %>" />
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="csrf-token" content="<%= csrfToken %>" />
  <title><%= (seo && seo.title) ? seo.title : 'Ovlink — B2B Kampaniya Linkləri, Dinamik QR və Müştəri Portalları' %></title>

  <link rel="manifest" href="/site.webmanifest" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/vendor/fontawesome/css/all.min.css?v=<%= (typeof assetVersion !== 'undefined' ? assetVersion : '1') %>" />
  <link rel="stylesheet" href="/home.css?v=<%= assetVersion %>" />

  <meta name="description" content="<%= (seo && seo.description) ? seo.description : 'Agentliklər və marketinq komandaları üçün özəl domenli qısa linklər, dinamik QR kodlar, bot filtri və canlı müştəri hesabat portalları.' %>" />
  <meta name="keywords" content="<%= (seo && seo.keywords) ? seo.keywords : '' %>" />
  <link rel="canonical" href="<%= (seo && seo.canonical) ? seo.canonical : '' %>" />
  <link rel="alternate" hreflang="en" href="<%= (seo && seo.hreflangEn) ? seo.hreflangEn : '' %>" />
  <link rel="alternate" hreflang="az" href="<%= (seo && seo.hreflangAz) ? seo.hreflangAz : '' %>" />
  <link rel="alternate" hreflang="tr" href="<%= (seo && seo.hreflangTr) ? seo.hreflangTr : '' %>" />
  <link rel="alternate" hreflang="x-default" href="<%= (seo && seo.hreflangXDefault) ? seo.hreflangXDefault : '' %>" />

  <style nonce="<%= (typeof nonce !== 'undefined' ? nonce : '') %>">
    body.ov-b2b-home {
      background: #09090b !important;
      color: #f4f4f5 !important;
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif !important;
    }

    /* Subtle Vercel/Linear top atmospheric light */
    .ov-hero-wrap {
      position: relative;
      padding: 120px 24px 72px;
      overflow: hidden;
      background:
        radial-gradient(60% 45% at 50% 0%, rgba(96, 165, 250, 0.14) 0%, rgba(16, 185, 129, 0.05) 45%, rgba(9, 9, 11, 0) 100%);
    }
    .ov-shell {
      max-width: 1120px;
      margin: 0 auto;
    }
    .ov-hero-center {
      text-align: center;
      max-width: 780px;
      margin: 0 auto;
    }
    .ov-pill {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 6px 14px;
      border-radius: 999px;
      border: 1px solid rgba(255, 255, 255, 0.12);
      background: rgba(255, 255, 255, 0.04);
      font-size: 12.5px;
      font-weight: 500;
      color: rgba(255, 255, 255, 0.82);
      margin-bottom: 24px;
      text-decoration: none;
    }
    .ov-pill-dot {
      width: 7px;
      height: 7px;
      border-radius: 999px;
      background: #4ade80;
      box-shadow: 0 0 10px rgba(74, 222, 128, 0.7);
    }
    .ov-b2b-home .m-hero-h1 {
      font-size: clamp(38px, 5.6vw, 66px) !important;
      font-weight: 800 !important;
      line-height: 1.06 !important;
      letter-spacing: -0.038em !important;
      color: #ffffff !important;
      margin: 0 0 20px !important;
      text-wrap: balance;
    }
    .ov-b2b-home .m-hero-h1 em {
      font-style: normal !important;
      background: linear-gradient(90deg, #ffffff 0%, #93c5fd 55%, #6ee7b7 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }
    .ov-hero-sub {
      font-size: clamp(16px, 1.8vw, 19px);
      line-height: 1.6;
      color: rgba(255, 255, 255, 0.66);
      max-width: 620px;
      margin: 0 auto 30px;
    }
    .ov-hero-ctas {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 12px;
      flex-wrap: wrap;
      margin-bottom: 34px;
    }
    .ov-btn-primary {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      height: 44px;
      padding: 0 22px;
      border-radius: 10px;
      background: #ffffff;
      color: #09090b !important;
      font-size: 14.5px;
      font-weight: 600;
      text-decoration: none;
      transition: transform 0.15s ease, background 0.15s ease;
    }
    .ov-btn-primary:hover {
      background: #e4e4e7;
      transform: translateY(-1px);
    }
    .ov-btn-secondary {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      height: 44px;
      padding: 0 22px;
      border-radius: 10px;
      border: 1px solid rgba(255, 255, 255, 0.16);
      background: rgba(255, 255, 255, 0.04);
      color: #ffffff !important;
      font-size: 14.5px;
      font-weight: 500;
      text-decoration: none;
      transition: border-color 0.15s ease, background 0.15s ease;
    }
    .ov-btn-secondary:hover {
      border-color: rgba(255, 255, 255, 0.32);
      background: rgba(255, 255, 255, 0.08);
    }

    /* Sleek inline live URL tester */
    .ov-inline-tester {
      max-width: 640px;
      margin: 0 auto 52px;
      text-align: left;
    }
    .ov-inline-tester .m-composer {
      border-radius: 14px !important;
      border: 1px solid rgba(255, 255, 255, 0.12) !important;
      background: rgba(24, 24, 27, 0.78) !important;
      padding: 10px 12px !important;
      box-shadow: 0 18px 50px rgba(0, 0, 0, 0.45);
    }
    .ov-inline-tester .m-composer-meta {
      margin-top: 8px;
      font-size: 12.5px;
      color: rgba(255, 255, 255, 0.5);
    }

    /* Dub.co / Linear Signature Product Window */
    .ov-showcase {
      border-radius: 18px;
      border: 1px solid rgba(255, 255, 255, 0.12);
      background: linear-gradient(180deg, rgba(24, 24, 27, 0.92) 0%, rgba(12, 12, 14, 0.96) 100%);
      box-shadow: 0 32px 90px rgba(0, 0, 0, 0.65), 0 0 0 1px rgba(255, 255, 255, 0.04) inset;
      overflow: hidden;
    }
    .ov-sc-topbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      padding: 12px 18px;
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
      background: rgba(255, 255, 255, 0.02);
      flex-wrap: wrap;
    }
    .ov-sc-dots {
      display: flex;
      align-items: center;
      gap: 7px;
    }
    .ov-sc-dots span {
      width: 10px;
      height: 10px;
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.16);
    }
    .ov-sc-url {
      font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
      font-size: 12px;
      color: rgba(255, 255, 255, 0.62);
      padding: 4px 12px;
      border-radius: 7px;
      background: rgba(255, 255, 255, 0.04);
      border: 1px solid rgba(255, 255, 255, 0.07);
    }
    .ov-sc-badges {
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .ov-sc-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 4px 10px;
      border-radius: 999px;
      font-size: 11.5px;
      font-weight: 600;
      background: rgba(74, 222, 128, 0.1);
      border: 1px solid rgba(74, 222, 128, 0.25);
      color: #4ade80;
    }
    .ov-sc-body {
      display: grid;
      grid-template-columns: 1.35fr 1fr;
      gap: 0;
    }
    .ov-sc-links {
      padding: 22px;
      border-right: 1px solid rgba(255, 255, 255, 0.07);
      display: flex;
      flex-direction: column;
      gap: 12px;
    }
    .ov-sc-section-lbl {
      font-size: 11.5px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: rgba(255, 255, 255, 0.42);
      margin-bottom: 2px;
    }
    .ov-sc-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      padding: 13px 15px;
      border-radius: 12px;
      border: 1px solid rgba(255, 255, 255, 0.08);
      background: rgba(255, 255, 255, 0.025);
    }
    .ov-sc-row-left {
      display: flex;
      align-items: center;
      gap: 12px;
      min-width: 0;
    }
    .ov-sc-ico {
      width: 34px;
      height: 34px;
      border-radius: 9px;
      background: rgba(96, 165, 250, 0.12);
      border: 1px solid rgba(96, 165, 250, 0.22);
      color: #60a5fa;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 14px;
      flex-shrink: 0;
    }
    .ov-sc-ico--green {
      background: rgba(74, 222, 128, 0.1);
      border-color: rgba(74, 222, 128, 0.22);
      color: #4ade80;
    }
    .ov-sc-short {
      font-size: 14px;
      font-weight: 600;
      color: #ffffff;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .ov-sc-dest {
      font-size: 12px;
      color: rgba(255, 255, 255, 0.48);
      margin-top: 2px;
    }
    .ov-sc-stat {
      text-align: right;
      flex-shrink: 0;
    }
    .ov-sc-stat strong {
      display: block;
      font-size: 13.5px;
      color: #ffffff;
      font-weight: 700;
    }
    .ov-sc-stat span {
      font-size: 11.5px;
      color: #4ade80;
    }

    .ov-sc-chart {
      padding: 22px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      gap: 14px;
    }
    .ov-sc-kpis {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 10px;
    }
    .ov-sc-kpi {
      padding: 12px 14px;
      border-radius: 11px;
      border: 1px solid rgba(255, 255, 255, 0.08);
      background: rgba(255, 255, 255, 0.02);
    }
    .ov-sc-kpi small {
      display: block;
      font-size: 11.5px;
      color: rgba(255, 255, 255, 0.5);
      margin-bottom: 4px;
    }
    .ov-sc-kpi strong {
      font-size: 20px;
      font-weight: 800;
      color: #ffffff;
      letter-spacing: -0.02em;
    }
    .ov-sc-kpi strong.ok { color: #4ade80; }

    /* Sections */
    .ov-sec {
      padding: 84px 24px;
      border-top: 1px solid rgba(255, 255, 255, 0.07);
    }
    .ov-sec-head {
      max-width: 620px;
      margin-bottom: 44px;
    }
    .ov-sec-kicker {
      font-size: 12px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: #60a5fa;
      margin: 0 0 10px;
    }
    .ov-sec-h2 {
      font-size: clamp(26px, 3.2vw, 38px);
      font-weight: 800;
      letter-spacing: -0.03em;
      line-height: 1.15;
      color: #ffffff;
      margin: 0 0 12px;
    }
    .ov-sec-sub {
      font-size: 15.5px;
      line-height: 1.6;
      color: rgba(255, 255, 255, 0.62);
      margin: 0;
    }

    /* 2x2 Architectural Pillars */
    .ov-pillars {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 18px;
    }
    .ov-pillar {
      padding: 28px;
      border-radius: 16px;
      border: 1px solid rgba(255, 255, 255, 0.09);
      background: rgba(255, 255, 255, 0.02);
      transition: border-color 0.2s ease;
    }
    .ov-pillar:hover {
      border-color: rgba(255, 255, 255, 0.2);
    }
    .ov-pillar-ico {
      width: 40px;
      height: 40px;
      border-radius: 10px;
      border: 1px solid rgba(255, 255, 255, 0.12);
      background: rgba(255, 255, 255, 0.04);
      display: flex;
      align-items: center;
      justify-content: center;
      color: #ffffff;
      font-size: 16px;
      margin-bottom: 18px;
    }
    .ov-pillar h3 {
      font-size: 18px;
      font-weight: 700;
      color: #ffffff;
      margin: 0 0 8px;
    }
    .ov-pillar p {
      font-size: 14.5px;
      line-height: 1.6;
      color: rgba(255, 255, 255, 0.64);
      margin: 0;
    }

    /* 3 Use-Case Columns */
    .ov-cases {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 18px;
    }
    .ov-case {
      padding: 26px 24px;
      border-radius: 14px;
      border: 1px solid rgba(255, 255, 255, 0.08);
      background: rgba(255, 255, 255, 0.018);
    }
    .ov-case h3 {
      font-size: 17px;
      font-weight: 700;
      color: #ffffff;
      margin: 0 0 8px;
    }
    .ov-case p {
      font-size: 14px;
      line-height: 1.58;
      color: rgba(255, 255, 255, 0.62);
      margin: 0 0 14px;
    }
    .ov-case-tag {
      font-size: 12px;
      color: #4ade80;
      font-weight: 500;
    }

    /* Final CTA Band */
    .ov-final-cta {
      text-align: center;
      padding: 64px 28px;
      border-radius: 20px;
      border: 1px solid rgba(255, 255, 255, 0.12);
      background: radial-gradient(70% 100% at 50% 0%, rgba(96, 165, 250, 0.12) 0%, rgba(255, 255, 255, 0.02) 100%);
    }
    .ov-final-cta h2 {
      font-size: clamp(26px, 3.6vw, 40px);
      font-weight: 800;
      letter-spacing: -0.03em;
      color: #ffffff;
      margin: 0 0 12px;
    }
    .ov-final-cta p {
      font-size: 15.5px;
      color: rgba(255, 255, 255, 0.65);
      margin: 0 0 28px;
    }

    @media (max-width: 900px) {
      .ov-sc-body, .ov-pillars, .ov-cases { grid-template-columns: 1fr; }
      .ov-sc-links { border-right: none; border-bottom: 1px solid rgba(255, 255, 255, 0.07); }
    }
  </style>
</head>
<body class="ovx home-page ov-b2b-home">

  <a href="#mainContent" class="m-skip-link" data-i18n="skip_to_content">Skip to content</a>

  <% if (siteSettings && siteSettings.announcement_enabled === '1' && (siteSettings.announcement_text_az || siteSettings.announcement_text_tr || siteSettings.announcement_text_en)) { %>
    <div id="siteAnnouncement" class="m-ribbon" data-az="<%= siteSettings.announcement_text_az || '' %>" data-tr="<%= siteSettings.announcement_text_tr || '' %>" data-en="<%= siteSettings.announcement_text_en || '' %>">
      <i class="fa-solid fa-bullhorn" aria-hidden="true"></i>
      <span id="siteAnnouncementText"><%= siteSettings.announcement_text_az || siteSettings.announcement_text_tr || siteSettings.announcement_text_en %></span>
    </div>
  <% } %>

  <%- include('partials/home-navbar') %>

  <main id="mainContent">

    <!-- HERO + LIVE B2B WORKSPACE SHOWCASE -->
    <section class="ov-hero-wrap" aria-labelledby="heroTitle">
      <div class="ov-shell">
        <div class="ov-hero-center">
          <a href="/pricing" class="ov-pill">
            <span class="ov-pill-dot" aria-hidden="true"></span>
            <span>Agentliklər və brendlər üçün B2B link analitikası</span>
          </a>

          <h1 class="m-hero-h1" id="heroTitle">
            Kampaniya linklərini <em>canlı müştəri hesabatına çevir.</em>
          </h1>

          <p class="ov-hero-sub" data-i18n="hero_sub">
            Öz brend domeninizlə qısa linklər, çapdan sonra dəyişən dinamik QR kodlar, bot filtri və müştəriyə tək linklə verilən canlı hesabat portalları.
          </p>

          <div class="ov-hero-ctas">
            <a class="ov-btn-primary" href="/register?intent=trial" data-i18n="hero_cta_trial">14 gün pulsuz başla</a>
            <a class="ov-btn-secondary" href="/contact?intent=demo" data-i18n="hero_cta_demo">Demo istə</a>
          </div>
        </div>

        <!-- Compact 1-Line Live Link Tester (all existing composer & UTM hooks preserved) -->
        <div class="ov-inline-tester">
          <div class="m-composer">
            <form id="shortenForm" action="javascript:void(0);">
              <div class="m-composer-row">
                <span class="m-composer-icon"><i class="fa-solid fa-link" aria-hidden="true"></i></span>
                <input class="m-composer-input" type="url" id="originalUrl" name="originalUrl"
                  placeholder="https://brendiniz.az/kampaniya — indi yoxlayın"
                  data-i18n="input_placeholder"
                  data-i18n-aria="aria_long_url"
                  autocomplete="off" spellcheck="false" required aria-label="Long URL to shorten" />
                <button type="submit" class="m-composer-submit" id="shortenSubmitBtn" aria-label="Shorten" data-i18n-aria="shorten_btn" title="Shorten" data-i18n-title="shorten_btn">
                  <span data-i18n="shorten_btn">Qısalt</span>
                  <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
                </button>
              </div>

              <div class="m-composer-meta">
                <span id="composerGuestHint">
                  <span>Qeydiyyatsız anında test edin ·</span>
                  <a href="/register?intent=trial">14 gün tam sınaq</a>
                </span>
                <span class="m-ws-wrap" id="homeWorkspaceTopWrapper" hidden>
                  <button type="button" class="m-ws-btn" id="homeWorkspaceDropdownBtn" aria-haspopup="true" aria-expanded="false" aria-controls="homeWorkspaceDropdownMenu">
                    <i class="fa-regular fa-user" id="homeWorkspaceBtnIcon" aria-hidden="true"></i>
                    <span id="homeWorkspaceBtnText" data-i18n="workspace_personal">Personal</span>
                    <i class="fa-solid fa-chevron-down" style="font-size:9px;opacity:.5;" aria-hidden="true"></i>
                  </button>
                  <div class="m-ws-panel" id="homeWorkspaceDropdownMenu" role="menu"></div>
                </span>
              </div>

              <button type="button" class="m-adv-toggle" id="advancedToggleBtn" aria-expanded="false" aria-controls="advancedPanel">
                <i class="fa-solid fa-sliders" aria-hidden="true"></i>
                <span data-i18n="advanced_settings">UTM və əlavə seçimlər</span>
                <i class="fa-solid fa-chevron-down m-adv-chevron" id="advancedChevron" aria-hidden="true"></i>
              </button>

              <div class="m-adv-panel" id="advancedPanel">
                <div class="m-adv-tabs" role="tablist">
                  <button type="button" class="m-adv-tab active" data-tab="tab-genel" role="tab" aria-selected="true" aria-controls="tab-genel"><span data-i18n="adv_tab_general">Ümumi</span></button>
                  <button type="button" class="m-adv-tab" data-tab="tab-utm" role="tab" aria-selected="false" aria-controls="tab-utm"><span data-i18n="adv_tab_utm">UTM</span></button>
                  <button type="button" class="m-adv-tab" data-tab="tab-cihaz" role="tab" aria-selected="false" aria-controls="tab-cihaz"><span data-i18n="adv_tab_device">Cihaz</span></button>
                  <button type="button" class="m-adv-tab" data-tab="tab-ab" role="tab" aria-selected="false" aria-controls="tab-ab"><span data-i18n="adv_tab_ab">A/B Test</span></button>
                </div>

                <div class="m-adv-tab-content active" id="tab-genel" role="tabpanel">
                  <div class="m-adv-grid">
                    <div class="m-adv-field">
                      <label class="m-adv-label" for="customAlias"><span data-i18n="alias_label">Xüsusi alias</span></label>
                      <input class="m-adv-input" type="text" id="customAlias" name="customLink" placeholder="yaz-2026" autocomplete="off" aria-label="Custom alias" />
                    </div>
                    <div class="m-adv-field">
                      <label class="m-adv-label" for="linkPassword"><span data-i18n="pass_label">Şifrə</span></label>
                      <input class="m-adv-input" type="password" id="linkPassword" name="linkPassword" placeholder="••••••••" autocomplete="new-password" aria-label="Link password" />
                    </div>
                    <div class="m-adv-field">
                      <label class="m-adv-label" for="expiresAt"><span data-i18n="expiry_date">Bitmə tarixi</span></label>
                      <input class="m-adv-input" type="datetime-local" id="expiresAt" name="expiresAt" aria-label="Expiration date" />
                    </div>
                    <div class="m-adv-field">
                      <label class="m-adv-label" for="maxClicks"><span data-i18n="max_clicks">Maksimum klik</span></label>
                      <input class="m-adv-input" type="number" id="maxClicks" name="maxClicks" min="1" placeholder="1000" aria-label="Max clicks" />
                    </div>
                    <div class="m-adv-field m-adv-field--full">
                      <label class="m-adv-label" for="customDomainSelect"><span data-i18n="shorten_domain_label">Domen</span></label>
                      <select class="m-adv-input" id="customDomainSelect">
                        <option value="" data-i18n="shorten_domain_default">Standart (ovlink.sbs)</option>
                      </select>
                    </div>
                  </div>
                </div>

                <div class="m-adv-tab-content" id="tab-utm" role="tabpanel">
                  <div class="m-adv-grid">
                    <div class="m-adv-field m-adv-field--full">
                      <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;">
                        <div class="m-adv-field" style="flex:1;">
                          <label class="m-adv-label" for="utmTemplateSelect"><span data-i18n="adv_utm_params_title">UTM Şablonu</span></label>
                          <select class="m-adv-input" id="utmTemplateSelect" aria-label="UTM template"></select>
                        </div>
                        <button type="button" class="m-adv-save" id="saveUtmTemplateBtn" aria-label="Save UTM template">
                          <i class="fa-regular fa-floppy-disk" aria-hidden="true"></i>
                          <span data-i18n="adv_utm_save">Yadda saxla</span>
                        </button>
                      </div>
                    </div>
                    <div class="m-adv-field">
                      <label class="m-adv-label" for="utmSource"><span data-i18n="adv_utm_source">Source</span></label>
