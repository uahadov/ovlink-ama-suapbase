<!doctype html>
<html lang="<%= (seo && seo.lang) ? seo.lang : 'en' %>">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="csrf-token" content="<%= csrfToken %>">
  <meta name="yandex-verification" content="71461f9fd9f723bc" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=<%= assetVersion %>" />
  <link rel="icon" href="/logo.ico" />
  <link rel="manifest" href="/site.webmanifest" />
  <title><%= (seo && seo.title) ? seo.title : 'Ovlink' %></title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="preload" href="/vendor/fontawesome/webfonts/fa-solid-900.woff2?v=<%= assetVersion %>" as="font" type="font/woff2" crossorigin />
  <link rel="stylesheet" href="/vendor/fontawesome/css/all.min.css?v=<%= assetVersion %>" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" integrity="sha512-iecdLmaskl7CVkqkXNQ/ZH/XLlvWZOJyj7Yy7tcenmpD1ypASozpmT/E0iPtmFIB46ZmdtAc9eNBvH0H/ZpiBw==" crossorigin="anonymous" referrerpolicy="no-referrer" />

  <link rel="stylesheet" href="/home.css?v=<%= assetVersion %>" />

  <meta name="description" content="<%= (seo && seo.description) ? seo.description : '' %>" />
  <meta name="keywords" content="<%= (seo && seo.keywords) ? seo.keywords : '' %>" />
  <meta name="geo.region" content="AZ" />
  <meta name="geo.placename" content="Baku" />
  <meta name="geo.position" content="40.4093;49.8671" />
  <link rel="canonical" href="<%= (seo && seo.canonical) ? seo.canonical : '' %>" />
  <link rel="alternate" hreflang="en" href="<%= (seo && seo.hreflangEn) ? seo.hreflangEn : '' %>" />
  <link rel="alternate" hreflang="az" href="<%= (seo && seo.hreflangAz) ? seo.hreflangAz : '' %>" />
  <link rel="alternate" hreflang="tr" href="<%= (seo && seo.hreflangTr) ? seo.hreflangTr : '' %>" />
  <link rel="alternate" hreflang="x-default" href="<%= (seo && seo.hreflangXDefault) ? seo.hreflangXDefault : '' %>" />
  <meta property="og:title" content="<%= (seo && seo.ogTitle) ? seo.ogTitle : '' %>" />
  <meta property="og:description" content="<%= (seo && seo.ogDescription) ? seo.ogDescription : '' %>" />
  <meta property="og:url" content="<%= (seo && seo.ogUrl) ? seo.ogUrl : '' %>" />
  <meta property="og:type" content="website" />
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content="<%= (seo && seo.twitterTitle) ? seo.twitterTitle : '' %>" />
  <meta name="twitter:description" content="<%= (seo && seo.twitterDescription) ? seo.twitterDescription : '' %>" />
  <% if (seo && seo.jsonLd) { %>
  <script nonce="<%= nonce %>" type="application/ld+json"><%- seo.jsonLd %></script>
  <% } %>
</head>

<body class="ovx home-page">

  <!-- Skip to content for accessibility -->
  <a href="#mainContent" class="m-skip-link" data-i18n="skip_to_content">Skip to content</a>

  <!-- ===== CUSTOM CURSOR ===== -->
  <div id="mCursorArrow" aria-hidden="true">
    <svg width="30" height="30" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M4.5 3.5L27 13.5L16.5 17.5L12 28.5L4.5 3.5Z" fill="#0a0a0a" stroke="#ffffff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  </div>
  <div id="mCursorRing" aria-hidden="true"></div>

  <!-- ===== SCROLL PROGRESS ===== -->
  <div id="mScrollBar" aria-hidden="true"><div id="mScrollBar-fill"></div></div>

  <!-- ===== CURSOR GLOW ===== -->
  <div id="cursorGlow" aria-hidden="true"></div>

  <!-- ===== ANNOUNCEMENT ===== -->
  <% if (siteSettings && siteSettings.announcement_enabled === '1' && (siteSettings.announcement_text_az || siteSettings.announcement_text_tr || siteSettings.announcement_text_en)) { %>
    <div id="siteAnnouncement" class="m-ribbon" role="region" aria-label="Announcement"
      data-az="<%= siteSettings.announcement_text_az || '' %>"
      data-tr="<%= siteSettings.announcement_text_tr || '' %>"
      data-en="<%= siteSettings.announcement_text_en || '' %>">
      <i class="fa-solid fa-bullhorn" aria-hidden="true"></i>
      <span id="siteAnnouncementText"><%= siteSettings.announcement_text_az || siteSettings.announcement_text_tr || siteSettings.announcement_text_en %></span>
    </div>
  <% } %>

  <!-- ===== NAVBAR ===== -->
  <%- include('partials/home-navbar') %>

  <main id="mainContent">

    <!-- ============================================================
         HERO
    ============================================================ -->
    <section class="m-hero" aria-labelledby="heroTitle">
      <p class="m-hero-eyebrow">
        <i class="fa-solid fa-bolt" aria-hidden="true"></i>
        <span data-i18n="hero_eyebrow">Faster links, smarter results</span>
      </p>
      <h1 class="m-hero-h1" id="heroTitle">
        <span data-i18n="hero_display_1">Shorten.</span>
        <em data-i18n="hero_display_2">Track. Share.</em>
      </h1>
      <p class="m-hero-sub" data-i18n="hero_sub">
        Every link, beautifully managed. Create short links with custom aliases, passwords, expiry and analytics — free.
      </p>

      <!-- Shortener Form -->
      <div class="m-composer-wrap">
        <div class="m-composer">
          <form id="shortenForm" action="javascript:void(0);">
            <div class="m-composer-row">
              <span class="m-composer-icon"><i class="fa-solid fa-link" aria-hidden="true"></i></span>
              <input class="m-composer-input" type="url" id="originalUrl" name="originalUrl"
                placeholder="https://your-long-link.com/paste-here"
                data-i18n="input_placeholder"
                data-i18n-aria="aria_long_url"
                autocomplete="off" spellcheck="false" required aria-label="Long URL to shorten" />
              <button type="submit" class="m-composer-submit" id="shortenSubmitBtn" aria-label="Shorten" data-i18n-aria="shorten_btn" title="Shorten" data-i18n-title="shorten_btn">
                <span data-i18n="shorten_btn">Shorten</span>
                <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
              </button>
            </div>

            <!-- Meta row -->
            <div class="m-composer-meta">
              <span id="composerGuestHint">
                <span data-i18n="composer_guest">Guests can create 2 links per day.</span>
                &nbsp;<a href="/register" data-i18n="composer_guest_cta">Create free account</a>
              </span>
              <span class="m-ws-wrap" id="homeWorkspaceTopWrapper" hidden>
                <button type="button" class="m-ws-btn" id="homeWorkspaceDropdownBtn"
                  aria-haspopup="true" aria-expanded="false" aria-controls="homeWorkspaceDropdownMenu">
                  <i class="fa-regular fa-user" id="homeWorkspaceBtnIcon" aria-hidden="true"></i>
                  <span id="homeWorkspaceBtnText" data-i18n="workspace_personal">Personal</span>
                  <i class="fa-solid fa-chevron-down" style="font-size:9px;opacity:.5;" aria-hidden="true"></i>
                </button>
                <div class="m-ws-panel" id="homeWorkspaceDropdownMenu" role="menu"></div>
              </span>
            </div>

            <!-- Advanced toggle -->
            <button type="button" class="m-adv-toggle" id="advancedToggleBtn"
              aria-expanded="false" aria-controls="advancedPanel">
              <i class="fa-solid fa-sliders" aria-hidden="true"></i>
              <span data-i18n="advanced_settings">Advanced settings</span>
              <i class="fa-solid fa-chevron-down m-adv-chevron" id="advancedChevron" aria-hidden="true"></i>
            </button>

            <div class="m-adv-panel" id="advancedPanel">
              <div class="m-adv-tabs" role="tablist">
                <button type="button" class="m-adv-tab active" data-tab="tab-genel" role="tab" aria-selected="true" aria-controls="tab-genel"><span data-i18n="adv_tab_general">General</span></button>
                <button type="button" class="m-adv-tab" data-tab="tab-utm" role="tab" aria-selected="false" aria-controls="tab-utm"><span data-i18n="adv_tab_utm">UTM</span> <i class="fa-solid fa-bullhorn" style="font-size:10px; margin-left:3px; opacity:0.5;"></i></button>
                <button type="button" class="m-adv-tab" data-tab="tab-cihaz" role="tab" aria-selected="false" aria-controls="tab-cihaz"><span data-i18n="adv_tab_device">Device</span></button>
                <button type="button" class="m-adv-tab" data-tab="tab-ab" role="tab" aria-selected="false" aria-controls="tab-ab"><span data-i18n="adv_tab_ab">A/B Test</span> <span class="m-pro-tag" style="margin-left:4px;">PRO</span></button>
              </div>

              <!-- TAB 1: Genel -->
              <div class="m-adv-tab-content active" id="tab-genel" role="tabpanel">
                <div class="m-adv-grid">
                  <div class="m-adv-field">
                    <label class="m-adv-label" for="customAlias"><span data-i18n="alias_label">Custom alias</span></label>
                    <input class="m-adv-input" type="text" id="customAlias" name="customLink"
                      placeholder="my-link" data-i18n="alias_placeholder" data-i18n-aria="aria_custom_alias" autocomplete="off" aria-label="Custom alias" />
                  </div>
                  <div class="m-adv-field">
                    <label class="m-adv-label" for="linkPassword"><span data-i18n="pass_label">Password</span></label>
                    <input class="m-adv-input" type="password" id="linkPassword" name="linkPassword"
                      placeholder="••••••••" data-i18n="pass_placeholder" data-i18n-aria="aria_link_pass" autocomplete="new-password" aria-label="Link password" />
                  </div>
                  <div class="m-adv-field">
                    <label class="m-adv-label" for="expiresAt"><span data-i18n="expiry_date">Expiration date</span></label>
                    <input class="m-adv-input" type="datetime-local" id="expiresAt" name="expiresAt" data-i18n-aria="aria_expiry_date" aria-label="Expiration date" />
                  </div>
                  <div class="m-adv-field">
                    <label class="m-adv-label" for="maxClicks"><span data-i18n="max_clicks">Maximum clicks</span></label>
                    <input class="m-adv-input" type="number" id="maxClicks" name="maxClicks"
                      min="1" placeholder="100" data-i18n-aria="aria_max_clicks" aria-label="Max clicks" />
                  </div>
                  <div class="m-adv-field m-adv-field--full">
                    <label class="m-adv-label" for="customDomainSelect"><span data-i18n="shorten_domain_label">Short link domain</span></label>
                    <select class="m-adv-input" id="customDomainSelect">
                      <option value="" data-i18n="shorten_domain_default">Default (ovlink.sbs)</option>
                    </select>
                    <p class="m-adv-hint">
                      <span data-i18n="shorten_domain_hint">Your active domains appear here.</span>
                      &nbsp;<a href="/account#customDomainSection" data-i18n="shorten_domain_manage_link">Add custom domain</a>
                    </p>
                  </div>
                </div>
              </div>

              <!-- TAB 2: UTM -->
              <div class="m-adv-tab-content" id="tab-utm" role="tabpanel">
                <div class="m-adv-grid">
                  <div class="m-adv-field m-adv-field--full">
                    <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;">
                      <div class="m-adv-field" style="flex:1;">
                        <label class="m-adv-label" for="utmTemplateSelect">
                          <span data-i18n="adv_utm_params_title">UTM Parameters</span>
                        </label>
                        <select class="m-adv-input" id="utmTemplateSelect" data-i18n-aria="aria_utm_template" aria-label="UTM template"></select>
                      </div>
                      <button type="button" class="m-adv-save" id="saveUtmTemplateBtn"
                        title="Save current UTM settings" data-i18n-title="adv_utm_save_tooltip" data-i18n-aria="aria_save_utm" aria-label="Save UTM template">
                        <i class="fa-regular fa-floppy-disk" aria-hidden="true"></i>
                        <span data-i18n="adv_utm_save">Save</span>
                      </button>
                    </div>
                  </div>
                  <div class="m-adv-field">
                    <label class="m-adv-label" for="utmSource"><span data-i18n="adv_utm_source">Source</span></label>
                    <input class="m-adv-input" type="text" id="utmSource" placeholder="e.g. instagram" data-i18n-placeholder="adv_utm_source_ph" data-i18n-aria="adv_utm_source" aria-label="UTM source" />
                  </div>
                  <div class="m-adv-field">
                    <label class="m-adv-label" for="utmMedium"><span data-i18n="adv_utm_medium">Medium</span></label>
                    <input class="m-adv-input" type="text" id="utmMedium" placeholder="e.g. social" data-i18n-placeholder="adv_utm_medium_ph" data-i18n-aria="adv_utm_medium" aria-label="UTM medium" />
                  </div>
                  <div class="m-adv-field m-adv-field--full">
                    <label class="m-adv-label" for="utmCampaign"><span data-i18n="adv_utm_campaign">Campaign</span></label>
                    <input class="m-adv-input" type="text" id="utmCampaign" placeholder="e.g. summer_sale" data-i18n-placeholder="adv_utm_campaign_ph" data-i18n-aria="adv_utm_campaign" aria-label="UTM campaign" />
                  </div>
                </div>
              </div>

              <!-- TAB 3: Device -->
              <div class="m-adv-tab-content" id="tab-cihaz" role="tabpanel">
                <div class="m-adv-grid">
                  <div class="m-adv-field m-adv-field--full">
                    <label class="m-adv-label" for="iosUrl">
                      <i class="fa-brands fa-apple" aria-hidden="true" style="margin-right:4px;"></i>
                      <span data-i18n="adv_device_ios">iOS Redirect</span>
                    </label>
                    <input class="m-adv-input" type="url" id="iosUrl" placeholder="https://apps.apple.com/…" data-i18n-placeholder="adv_device_ios_ph" data-i18n-aria="aria_ios_redirect" aria-label="iOS redirect URL" />
                  </div>
                  <div class="m-adv-field m-adv-field--full">
                    <label class="m-adv-label" for="androidUrl">
                      <i class="fa-brands fa-android" aria-hidden="true" style="margin-right:4px;"></i>
                      <span data-i18n="adv_device_android">Android Redirect</span>
                    </label>
                    <input class="m-adv-input" type="url" id="androidUrl" placeholder="https://play.google.com/…" data-i18n-placeholder="adv_device_android_ph" data-i18n-aria="aria_android_redirect" aria-label="Android redirect URL" />
                  </div>
                </div>
              </div>

              <!-- TAB 4: A/B -->
              <div class="m-adv-tab-content" id="tab-ab" role="tabpanel">
                <div class="m-adv-grid">
                  <div class="m-adv-field m-adv-field--full">
                    <label class="m-adv-label" for="originalB">
                      <span data-i18n="adv_ab_title">A/B Testing (Target B)</span>
                    </label>
                    <input class="m-adv-input" type="url" id="originalB" placeholder="https://… (URL B)" data-i18n-placeholder="adv_ab_url_b_ph" data-i18n-aria="aria_target_b" aria-label="Target URL B" />
                    <div style="display:flex;align-items:center;gap:10px;margin-top:12px;">
                      <span class="m-adv-label" data-i18n="adv_ab_split" style="white-space:nowrap;">Link A traffic (%)</span>
                      <input class="m-adv-input" type="number" id="abSplitPercent" min="0" max="100" value="50" style="width:80px;" data-i18n-aria="aria_split_percent" aria-label="Link A traffic percent" />
                    </div>
                    <p class="m-adv-hint" data-i18n="adv_ab_hint" style="margin-top:6px;font-size:11.5px;color:var(--c-muted);">Remaining traffic goes to Link B.</p>
                  </div>
                </div>
              </div>
            </div>

            <div id="shortenFeedback" class="m-status" role="alert"></div>
          </form>

          <!-- Result -->
          <div id="result" class="m-result" style="display:none;">
            <p class="m-result-title">
              <i class="fa-solid fa-circle-check" aria-hidden="true"></i>
              <span data-i18n="generated_title">Your link is ready!</span>
            </p>
            <a id="shortUrl" class="m-result-url" href="#" target="_blank" rel="noopener"></a>
            <div class="m-result-actions">
              <button id="copyShortBtn" type="button" class="m-cta m-cta--white m-cta--sm">
                <i class="fa-regular fa-copy" aria-hidden="true"></i>
                <span data-i18n="copy_btn">Copy</span>
              </button>
              <button id="sendToQrBtn" type="button" class="m-cta m-cta--outline m-cta--sm">
                <i class="fa-solid fa-qrcode" aria-hidden="true"></i>
                <span data-i18n="send_qr_btn">Send to QR</span>
              </button>
            </div>
            <p id="shortenHint" class="m-status" style="margin-top:10px;font-size:12.5px;"></p>
          </div>
        </div>

        <p class="m-trust-row">
          <i class="fa-solid fa-shield-halved" aria-hidden="true"></i>
          <span data-i18n="composer_trust">Every destination is scanned for safety — malicious links are blocked automatically.</span>
        </p>
      </div>
    </section>

    <!-- ============================================================
         FEATURES — BENTO GRID
    ============================================================ -->
    <section class="m-section" aria-labelledby="featuresTitle">
      <div class="shell-wide m-section-inner">
        <div class="m-reveal">
          <p class="m-kicker" data-i18n="feat_kicker">Features</p>
          <h2 class="m-section-h2" id="featuresTitle" data-i18n="feat_title">Everything a link needs.</h2>
          <p class="m-section-sub" data-i18n="feat_sub">From a one-second shortener to enterprise-grade controls — designed to disappear so your links do the work.</p>
        </div>

        <div style="height:48px;"></div>

        <div class="m-bento">
          <!-- Card 1 -->
          <article class="m-bento-card m-reveal m-reveal-d1">
            <span class="m-bento-num">01</span>
            <div class="m-bento-glyph"><i class="fa-solid fa-bolt" aria-hidden="true"></i></div>
            <h3 class="m-bento-card-h" data-i18n="feat_instant_title">Instant shortening</h3>
            <p class="m-bento-card-p" data-i18n="feat_instant_text">Paste your URL and get a short code instantly — no account required to start.</p>
          </article>

          <!-- Card 2 -->
          <article class="m-bento-card m-reveal m-reveal-d2">
            <span class="m-bento-num">02</span>
            <div class="m-bento-glyph"><i class="fa-solid fa-chart-column" aria-hidden="true"></i></div>
            <h3 class="m-bento-card-h" data-i18n="feat_analytics_title">Privacy-first analytics</h3>
            <p class="m-bento-card-p" data-i18n="feat_analytics_text">Only essential stats — real-time clicks, referrers and devices. Nothing more.</p>
          </article>

          <!-- Card 3 -->
          <article class="m-bento-card m-reveal m-reveal-d3">
            <span class="m-bento-num">03</span>
            <div class="m-bento-glyph"><i class="fa-solid fa-shield-halved" aria-hidden="true"></i></div>
            <h3 class="m-bento-card-h" data-i18n="feat_safety_title">Safety built-in</h3>
            <p class="m-bento-card-p" data-i18n="feat_safety_text">Real-time threat scans, weekly re-scans and community reports keep the platform clean.</p>
          </article>

          <!-- Card 4 — wide, dark, analytics mockup -->
          <article class="m-bento-card m-bento-card--wide m-reveal">
            <span class="m-bento-num">04</span>
            <div class="m-bento-vis" aria-hidden="true">
              <div class="m-bento-vis-row">
                <span>https://ovlink.sbs/<strong>launch</strong></span>
                <span data-i18n="feat_vis_clicks">12,408 clicks</span>
              </div>
              <div class="m-bento-vis-row">
                <span data-i18n="feat_vis_regions">Top region</span>
                <strong>🇦🇿 41%</strong>
              </div>
              <div class="m-bento-vis-row">
                <span data-i18n="feat_vis_devices">Devices</span>
                <strong>iOS 52% · Android 33%</strong>
              </div>
              <div class="m-bar-track"><div class="m-bar-fill" data-bar="78"></div></div>
            </div>
            <div class="m-bento-glyph"><i class="fa-solid fa-chart-line" aria-hidden="true"></i></div>
            <h3 class="m-bento-card-h" data-i18n="feat_dashboard_title">A dashboard that keeps up</h3>
            <p class="m-bento-card-p" data-i18n="feat_dashboard_text">Live click streams, workspaces for teams, tags and folders — all in real time.</p>
            <a class="m-bento-card-link" href="/login" data-i18n="feat_dashboard_link">
              Open your dashboard <i class="fa-solid fa-arrow-right" aria-hidden="true" style="font-size:10px;"></i>
            </a>
          </article>

          <!-- Card 5 -->
          <article class="m-bento-card m-reveal m-reveal-d1">
            <span class="m-bento-num">05</span>
            <div class="m-bento-glyph"><i class="fa-solid fa-globe" aria-hidden="true"></i></div>
            <h3 class="m-bento-card-h" data-i18n="feat_domains_title">Custom domains</h3>
            <p class="m-bento-card-p" data-i18n="feat_domains_text">Bring your own domain and keep your brand in every link you share.</p>
          </article>

          <!-- Card 6 — full width 3-column workspace visual with split content -->
          <article class="m-bento-card m-bento-card--full m-reveal m-reveal-d2">
            <span class="m-bento-num">06</span>
            <div class="m-ws-card-split">
              <div class="m-ws-card-info">
                <div class="m-bento-glyph"><i class="fa-solid fa-users" aria-hidden="true"></i></div>
                <h3 class="m-bento-card-h" data-i18n="feat_workspaces_title">Workspaces</h3>
                <p class="m-bento-card-p" data-i18n="feat_workspaces_text">Collaborate with your team. Separate links, stats and settings per workspace — everything scoped and clean.</p>
                <a class="m-bento-card-link" href="/workspaces" data-i18n="feat_workspaces_link">
                  Manage workspaces <i class="fa-solid fa-arrow-right" aria-hidden="true" style="font-size:10px;"></i>
                </a>
              </div>
              <div class="m-ws-mock" aria-hidden="true">
                <div class="m-ws-mock-row">
                  <div class="m-ws-mock-avatar">U</div>
                  <span class="m-ws-mock-name">Ulvi Ahadov</span>
                  <span class="m-ws-mock-role" data-i18n="ws_role_owner">Owner</span>
                </div>
                <div class="m-ws-mock-row">
                  <div class="m-ws-mock-avatar m-ws-mock-avatar--green">A</div>
                  <span class="m-ws-mock-name">Anar Rzayev</span>
                  <span class="m-ws-mock-role" data-i18n="ws_role_editor">Editor</span>
                </div>
                <div class="m-ws-mock-row">
                  <div class="m-ws-mock-avatar m-ws-mock-avatar--blue">S</div>
                  <span class="m-ws-mock-name">Sara Aliyeva</span>
                  <span class="m-ws-mock-role" data-i18n="ws_role_viewer">Viewer</span>
                </div>
                <div class="m-ws-mock-footer">
                  <span data-i18n="feat_ws_stat">3 members · 2 workspaces</span>
                  <span data-i18n="feat_ws_invite">Invite member →</span>
                </div>
              </div>
            </div>
          </article>
        </div>
      </div>
    </section>

    <!-- ============================================================
         HOW IT WORKS
    ============================================================ -->
    <section class="m-section" style="background:var(--c-surface);" aria-labelledby="howTitle">
      <div class="shell m-section-inner">
        <div class="m-reveal">
          <p class="m-kicker" data-i18n="how_kicker">How it works</p>
          <h2 class="m-section-h2" id="howTitle" data-i18n="how_title">Three steps. That's it.</h2>
        </div>

        <div class="m-steps">
          <div class="m-step m-reveal">
            <div class="m-step-num">01</div>
            <h3 class="m-step-h" data-i18n="how_step1_title">Paste your link</h3>
            <p class="m-step-p" data-i18n="how_step1_text">Drop any long URL into the composer — no signup needed for your first links.</p>
          </div>
          <div class="m-step m-reveal m-reveal-d1">
            <div class="m-step-num">02</div>
            <h3 class="m-step-h" data-i18n="how_step2_title">Customize it</h3>
            <p class="m-step-p" data-i18n="how_step2_text">Choose an alias, set a password, add UTM parameters or target by device.</p>
          </div>
          <div class="m-step m-reveal m-reveal-d2">
            <div class="m-step-num">03</div>
            <h3 class="m-step-h" data-i18n="how_step3_title">Share &amp; track</h3>
            <p class="m-step-p" data-i18n="how_step3_text">Share it anywhere. Watch clicks arrive in real time on your dashboard.</p>
          </div>
        </div>

        <div class="m-steps-cta m-reveal">
          <a class="m-cta m-cta--white" href="/register" data-i18n="how_cta">Create free account</a>
          <a class="m-link" href="/how-it-works" data-i18n="how_link">
            More about the flow <i class="fa-solid fa-arrow-right" style="font-size:11px;" aria-hidden="true"></i>
          </a>
        </div>
      </div>
    </section>

    <!-- ============================================================
         STATS BAND
    ============================================================ -->
    <section class="m-section" style="padding:0;" aria-label="Platform statistics" data-i18n-aria="aria_stats">
      <div class="shell-wide m-section-inner" style="padding:0;">
        <div class="m-stats">
          <div class="m-stat m-reveal">
            <div class="m-stat-val" data-counter="120">0</div>
            <div class="m-stat-label" data-i18n="stat_ms">ms to shorten</div>
          </div>
          <div class="m-stat m-reveal m-reveal-d1">
            <div class="m-stat-val" data-counter="99">0</div>
            <div class="m-stat-label" data-i18n="stat_uptime">% uptime target</div>
          </div>
          <div class="m-stat m-reveal m-reveal-d2">
            <div class="m-stat-val" data-counter="3">0</div>
            <div class="m-stat-label" data-i18n="stat_langs">interface languages</div>
          </div>
          <div class="m-stat m-reveal m-reveal-d3">
            <div class="m-stat-val" data-counter="24">0</div>
            <div class="m-stat-label" data-i18n="stat_watch">h/day safety watch</div>
          </div>
        </div>
      </div>
    </section>

    <!-- ============================================================
         TOOLS DUO — QR & REPORT
    ============================================================ -->
    <section class="m-section" aria-labelledby="toolsTitle">
      <div class="shell-wide m-section-inner">
        <div class="m-reveal" style="text-align:center;margin-bottom:0;">
          <p class="m-kicker" data-i18n="tools_kicker">Tools</p>
          <h2 class="m-section-h2" id="toolsTitle" data-i18n="tools_title" style="margin:0 auto 0;">Two more ways to work.</h2>
        </div>

        <div class="m-duo">
          <!-- QR -->
          <article class="m-duo-card m-reveal" id="qrSection">
            <div class="m-duo-head">
              <div class="m-duo-glyph"><i class="fa-solid fa-qrcode" aria-hidden="true"></i></div>
              <h3 class="m-duo-h" data-i18n="qr_customize">Customize QR Code</h3>
            </div>
            <p class="m-duo-p" data-i18n="qr_sub">Turn any short link into a branded QR code with your own colors.</p>
            <form id="qrForm" action="javascript:void(0);" novalidate>
              <div class="m-adv-field" style="margin-bottom:12px;">
                <label class="m-adv-label" for="qrShortLink"><span data-i18n="qr_alias_label">Short link</span></label>
                <input class="m-adv-input" type="text" id="qrShortLink" placeholder="abc123" data-i18n="qr_alias_placeholder" data-i18n-aria="aria_qr_link" required aria-label="QR short link" />
              </div>
              <!-- Color Fields (Eskisi kimi sadə) -->
              <div class="m-color-row">
                <div class="m-color-field">
                  <label class="m-adv-label" for="colorDark" data-i18n="qr_fg_color">QR Color</label>
                  <div class="m-color-trigger" id="triggerDark" role="button" tabindex="0" aria-label="QR Color" aria-haspopup="dialog" aria-expanded="false">
                    <span class="m-color-swatch-box" id="swatchDark" style="background:#000000;"></span>
                    <span class="m-color-hex-val" id="textValDark">#000000</span>
                  </div>
                  <input type="hidden" id="colorDark" value="#000000" />
                </div>
                <div class="m-color-field">
                  <label class="m-adv-label" for="colorLight" data-i18n="qr_bg_color">Background</label>
                  <div class="m-color-trigger" id="triggerLight" role="button" tabindex="0" aria-label="Background Color" aria-haspopup="dialog" aria-expanded="false">
                    <span class="m-color-swatch-box" id="swatchLight" style="background:#ffffff;"></span>
                    <span class="m-color-hex-val" id="textValLight">#FFFFFF</span>
                  </div>
                  <input type="hidden" id="colorLight" value="#ffffff" />
                </div>

                <!-- Custom Monolith Color Picker (aligned with DESIGN.md & user's screenshot) -->
                <div id="monolithColorPicker" class="m-cp-popover pos-left" hidden role="dialog" aria-label="Color Picker">
                  <!-- 2D Saturation/Brightness Gradient Canvas -->
                  <div class="m-cp-sat-box" id="cpSatBox">
                    <div class="m-cp-sat-white"></div>
                    <div class="m-cp-sat-black"></div>
                    <div class="m-cp-sat-pointer" id="cpSatPointer" style="left: 0%; top: 100%;"></div>
                  </div>

                  <!-- Controls Row: Eyedropper, Preview Circle, Hue Slider -->
                  <div class="m-cp-controls-row">
                    <button type="button" class="m-cp-eyedropper-btn" id="cpEyedropper" title="Pick color" aria-label="Pick color from screen">
                      <i class="fa-solid fa-eye-dropper" aria-hidden="true"></i>
                    </button>
                    <div class="m-cp-preview-circle" id="cpPreviewCircle" style="background: #000000;"></div>
                    <div class="m-cp-hue-slider" id="cpHueSlider">
                      <div class="m-cp-hue-thumb" id="cpHueThumb" style="left: 0%;"></div>
                    </div>
                  </div>

                  <!-- Inputs Row: RGB / HEX with switcher -->
                  <div class="m-cp-inputs-row">
                    <!-- RGB Mode -->
                    <div class="m-cp-mode-rgb" id="cpModeRgb">
                      <div class="m-cp-input-col">
                        <input type="number" min="0" max="255" id="cpInputR" class="m-cp-input" value="0" aria-label="Red" />
                        <span class="m-cp-label">R</span>
                      </div>
                      <div class="m-cp-input-col">
                        <input type="number" min="0" max="255" id="cpInputG" class="m-cp-input" value="0" aria-label="Green" />
                        <span class="m-cp-label">G</span>
                      </div>
                      <div class="m-cp-input-col">
                        <input type="number" min="0" max="255" id="cpInputB" class="m-cp-input" value="0" aria-label="Blue" />
                        <span class="m-cp-label">B</span>
                      </div>
                    </div>

                    <!-- HEX Mode -->
                    <div class="m-cp-mode-hex" id="cpModeHex" style="display:none;">
                      <div class="m-cp-input-col">
                        <input type="text" id="cpInputHex" class="m-cp-input m-cp-input--hex" maxlength="7" value="#000000" spellcheck="false" autocomplete="off" aria-label="Hex color" />
                        <span class="m-cp-label">HEX</span>
                      </div>
                    </div>

                    <!-- Switcher Button -->
                    <button type="button" class="m-cp-switcher-btn" id="cpSwitcherBtn" title="Switch RGB / HEX" aria-label="Switch between RGB and HEX">
                      <i class="fa-solid fa-up-down" aria-hidden="true"></i>
                    </button>
                  </div>
                </div>
              </div>
              <button type="submit" class="m-cta m-cta--white m-cta--sm" style="width:100%;justify-content:center;">
                <i class="fa-solid fa-wand-magic-sparkles" aria-hidden="true"></i>
                <span data-i18n="qr_generate_btn">Generate QR</span>
              </button>
            </form>
            <div id="qrFeedback" class="m-status" role="alert"></div>
            <div id="qrResult" class="m-qr-output" style="display:none;">
              <img id="qrImage" src="" alt="QR code" data-i18n-alt="aria_qr_code_alt" width="160" height="160" loading="lazy" decoding="async" />
              <p class="m-status" style="font-size:12.5px;" data-i18n="qr_download_hint">Download your QR as PNG.</p>
              <button type="button" id="qrDownloadBtn" class="m-cta m-cta--outline m-cta--sm">
                <i class="fa-solid fa-download" aria-hidden="true"></i>
                <span data-i18n="qr_download_btn">Download QR</span>
              </button>
            </div>
          </article>

          <!-- Report -->
          <article class="m-duo-card m-reveal m-reveal-d1" id="reportSection">
            <div class="m-duo-head">
              <div class="m-duo-glyph m-duo-glyph--red"><i class="fa-solid fa-flag" aria-hidden="true"></i></div>
              <h3 class="m-duo-h" data-i18n="report_title">Report Link</h3>
            </div>
            <p class="m-duo-p" data-i18n="report_sub">Found a link that violates the rules? Tell us — moderation acts fast.</p>
            <form id="reportForm" action="javascript:void(0);" novalidate>
              <div class="m-adv-field" style="margin-bottom:12px;">
                <label class="m-adv-label" for="reportLink"><span data-i18n="report_link_label">Short link to report</span></label>
                <input class="m-adv-input" type="text" id="reportLink" placeholder="abc123" data-i18n-placeholder="report_link_placeholder" data-i18n-aria="aria_report_link" required aria-label="Report short link" />
              </div>
              <div class="m-adv-field" style="margin-bottom:16px;">
                <label class="m-adv-label" for="reportReason"><span data-i18n="report_reason_label">Reason</span></label>
                <textarea class="m-adv-input" id="reportReason" rows="3"
                  placeholder="Reason for reporting…" data-i18n="report_reason" data-i18n-aria="aria_report_reason" aria-label="Report reason"></textarea>
              </div>
              <button type="submit" class="m-cta m-cta--white m-cta--sm" style="width:100%;justify-content:center;">
                <i class="fa-solid fa-paper-plane" aria-hidden="true"></i>
                <span data-i18n="report_btn">Submit Report</span>
              </button>
            </form>
            <p id="reportLoginHint" class="m-adv-hint" style="text-align:center;margin-top:10px;font-size:12px;opacity:0.75;" data-i18n="report_login_hint">You must be logged in to submit a report.</p>
            <p id="reportMessage" class="m-report-msg" role="status"></p>
          </article>
        </div>
      </div>
    </section>

  </main>

  <%- include('partials/home-footer') %>

  <script nonce="<%= nonce %>" defer src="/lang-home.js?v=<%= assetVersion %>"></script>
  <script nonce="<%= nonce %>" defer src="/home.js?v=<%= assetVersion %>"></script>

  <!-- Motion & interactions -->
  <script nonce="<%= nonce %>">
  (function(){
    var isMobile = !matchMedia('(hover:hover)').matches;

    /* ─── 1. Custom Cursor ─── */
    var arrow = document.getElementById('mCursorArrow');
    var ring  = document.getElementById('mCursorRing');
    if (arrow && ring && !isMobile) {
      document.body.classList.add('has-custom-cursor');
      var mx = -100, my = -100, rx = -100, ry = -100;
      var rafId = null;
      function loop(){
        rx += (mx - rx) * 0.15;
        ry += (my - ry) * 0.15;
        ring.style.transform = 'translate(' + rx + 'px,' + ry + 'px) translate(-50%,-50%)';
        if (Math.abs(mx - rx) > 0.1 || Math.abs(my - ry) > 0.1) {
          rafId = requestAnimationFrame(loop);
        } else {
          rx = mx;
          ry = my;
          ring.style.transform = 'translate(' + rx + 'px,' + ry + 'px) translate(-50%,-50%)';
          rafId = null;
        }
      }
      function updatePos(e){
        mx = e.clientX; my = e.clientY;
        arrow.style.transform = 'translate(' + mx + 'px,' + my + 'px)';
        if (!rafId) {
          rafId = requestAnimationFrame(loop);
        }
      }
      window.addEventListener('mousemove', updatePos, {passive:true});
      window.addEventListener('pointermove', updatePos, {passive:true});
      document.addEventListener('mouseover', function(e){
        var interactive = e.target && e.target.closest && e.target.closest('a,button,input,textarea,select,label,[role="button"],.m-cp-sat-box,.m-cp-hue-slider');
        if (interactive) {
          arrow.classList.add('hover');
          ring.classList.add('hover');
        } else {
          arrow.classList.remove('hover');
          ring.classList.remove('hover');
        }
      }, {passive:true});
      document.addEventListener('mousedown', function(){
        arrow.classList.add('clicking');
        ring.classList.add('clicking');
      });
      document.addEventListener('mouseup', function(){
        arrow.classList.remove('clicking');
        ring.classList.remove('clicking');
      });
      document.addEventListener('mouseleave', function(){
        arrow.classList.add('hidden');
        ring.classList.add('hidden');
      });
      document.addEventListener('mouseenter', function(){
        arrow.classList.remove('hidden');
        ring.classList.remove('hidden');
      });
    } else {
      if (arrow) arrow.style.display = 'none';
      if (ring)  ring.style.display  = 'none';
    }

    /* ─── 2. Cursor Glow ─── */
    var glow = document.getElementById('cursorGlow');
    if (glow && !isMobile) {
      document.addEventListener('mousemove', function(e){
        glow.style.left = e.clientX + 'px';
        glow.style.top  = e.clientY + 'px';
      }, {passive:true});
    } else if (glow) {
      glow.style.display = 'none';
    }

    /* ─── 3. Scroll Progress Bar ─── */
    var sbFill = document.getElementById('mScrollBar-fill');
    if (sbFill) {
      window.addEventListener('scroll', function(){
        var h = document.documentElement;
        var pct = (h.scrollTop || document.body.scrollTop) / (h.scrollHeight - h.clientHeight) * 100;
        sbFill.style.width = pct + '%';
      }, {passive:true});
    }

    /* ─── 4. Nav scroll class ─── */
    var nav = document.getElementById('mNav');
    if (nav) {
      var onScroll = function(){ nav.classList.toggle('scrolled', window.scrollY > 10); };
      window.addEventListener('scroll', onScroll, {passive:true});
      onScroll();
    }

    /* ─── 5. Scroll Reveal ─── */
    if ('IntersectionObserver' in window) {
      var io = new IntersectionObserver(function(entries){
        entries.forEach(function(e){
          if (e.isIntersecting){ e.target.classList.add('visible'); io.unobserve(e.target); }
        });
      }, {threshold:0.12});
      document.querySelectorAll('.m-reveal').forEach(function(el){ io.observe(el); });
    } else {
      document.querySelectorAll('.m-reveal').forEach(function(el){ el.classList.add('visible'); });
    }

    /* ─── 6. Bar Fill ─── */
    var barIO = new IntersectionObserver(function(entries){
      entries.forEach(function(e){
        if (e.isIntersecting){
          var fill = e.target;
          setTimeout(function(){ fill.style.width = (fill.dataset.bar || '0') + '%'; }, 200);
          barIO.unobserve(fill);
        }
      });
    }, {threshold:0.1});
    document.querySelectorAll('.m-bar-fill').forEach(function(el){ barIO.observe(el); });

    /* ─── 7. Counter Animation ─── */
    function animCounter(el) {
      var target = parseInt(el.dataset.counter, 10);
      var start = null;
      el.classList.add('counted');
      (function step(ts){
        if (!start) start = ts;
        var p = Math.min((ts - start) / 1200, 1);
        var ease = 1 - Math.pow(1 - p, 3);
        el.textContent = Math.round(ease * target);
        if (p < 1) requestAnimationFrame(step);
      })(performance.now());
    }
    var cIO = new IntersectionObserver(function(entries){
      entries.forEach(function(e){ if (e.isIntersecting){ animCounter(e.target); cIO.unobserve(e.target); } });
    }, {threshold:0.3});
    document.querySelectorAll('[data-counter]').forEach(function(el){ cIO.observe(el); });

    /* ─── 8. Advanced Toggle ─── */
    var advBtn = document.getElementById('advancedToggleBtn');
    var advPanel = document.getElementById('advancedPanel');
    var advChev = document.getElementById('advancedChevron');
    if (advBtn && advPanel) {
      advBtn.addEventListener('click', function(){
        var open = advPanel.classList.toggle('open');
        advBtn.setAttribute('aria-expanded', open ? 'true' : 'false');
        if (advChev) advChev.style.transform = open ? 'rotate(180deg)' : '';
      });
    }

    /* ─── Navbar dropdowns & mobile menu are managed by partials/home-navbar ─── */

    /* ─── 10. Ripple Effect ─── */
    function addRipple(btn) {
      btn.addEventListener('click', function(e){
        var r = btn.getBoundingClientRect();
        var size = Math.max(r.width, r.height);
        var span = document.createElement('span');
        span.className = 'm-ripple';
        span.style.width = span.style.height = size + 'px';
        span.style.left  = (e.clientX - r.left  - size / 2) + 'px';
        span.style.top   = (e.clientY - r.top   - size / 2) + 'px';
        btn.appendChild(span);
        setTimeout(function(){ span.remove(); }, 600);
      });
    }
    document.querySelectorAll('.m-cta, .m-composer-submit, .m-btn-solid').forEach(addRipple);

    /* ─── 11. Card 3D Tilt ─── */
    if (!isMobile) {
      document.querySelectorAll('.m-bento-card, .m-duo-card').forEach(function(card){
        card.addEventListener('mousemove', function(e){
          var r = card.getBoundingClientRect();
          var cx = r.left + r.width  / 2;
          var cy = r.top  + r.height / 2;
          var dx = (e.clientX - cx) / (r.width  / 2);
          var dy = (e.clientY - cy) / (r.height / 2);
          card.style.transform = 'perspective(900px) rotateY(' + (dx * 4) + 'deg) rotateX(' + (-dy * 4) + 'deg) scale(1.01)';
        });
        card.addEventListener('mouseleave', function(){
          card.style.transform = 'perspective(900px) rotateY(0) rotateX(0) scale(1)';
          card.style.transition = 'transform 0.5s var(--ease)';
          setTimeout(function(){ card.style.transition = ''; }, 500);
        });
      });
    }

    /* ─── 12. Magnetic Buttons ─── */
    if (!isMobile) {
      document.querySelectorAll('.m-btn-solid, .m-cta--white').forEach(function(btn){
        btn.addEventListener('mousemove', function(e){
          var r = btn.getBoundingClientRect();
          var dx = (e.clientX - (r.left + r.width  / 2)) * 0.3;
          var dy = (e.clientY - (r.top  + r.height / 2)) * 0.3;
          btn.style.transform = 'translate(' + dx + 'px,' + dy + 'px)';
        });
        btn.addEventListener('mouseleave', function(){
          btn.style.transform = '';
        });
      });
    }

    /* ─── 13. Announcement Ribbon i18n ─── */
    var ribbon = document.getElementById('siteAnnouncement');
    if (ribbon) {
      var savedLang = (function(){ try { return localStorage.getItem('lang') || 'az'; } catch(_){ return 'az'; } })();
      var t = ribbon.dataset[savedLang] || ribbon.dataset.az || ribbon.dataset.tr || ribbon.dataset.en;
      var ael = document.getElementById('siteAnnouncementText');
      if (ael && t) ael.textContent = t;
      document.body.classList.add('has-ribbon');
    }

    /* ─── 14. Hero composer — input typing animation ─── */
    var compInput = document.getElementById('originalUrl');
    if (compInput) {
      compInput.addEventListener('focus', function(){
        compInput.style.transition = 'color 0.3s';
      });
    }

    /* ─── 15. Stats section — live tick animation ─── */
    var statVals = document.querySelectorAll('.m-stat-val');
    statVals.forEach(function(el){
      el.addEventListener('animationend', function(){
        el.classList.remove('counted');
      });
    });

    /* ─── 16. Workspace mock row hover glow ─── */
    document.querySelectorAll('.m-ws-mock-row').forEach(function(row){
      row.addEventListener('mouseenter', function(){
        row.style.background = 'rgba(255,255,255,0.03)';
        row.style.transition = 'background 0.2s';
      });
      row.addEventListener('mouseleave', function(){
        row.style.background = '';
      });
    });

    /* ─── 17. Bento card num counter animate on reveal ─── */
    var numDur  = isMobile ? 0.2 : 0.5;
    var numStep = isMobile ? 0.04 : 0.08;
    document.querySelectorAll('.m-bento-num').forEach(function(num, i){
      num.style.opacity = '0';
      num.style.transition = 'opacity ' + numDur + 's ' + (0.1 + i * numStep) + 's';
      var numIO = new IntersectionObserver(function(entries){
        entries.forEach(function(e){
          if (e.isIntersecting){ num.style.opacity = '1'; numIO.unobserve(num); }
        });
      }, {threshold:0.1});
      numIO.observe(num);
    });

    /* ─── 18. Eyebrow pill — random stagger on hover ─── */
    var eyebrow = document.querySelector('.m-hero-eyebrow');
    if (eyebrow) {
      eyebrow.addEventListener('mouseenter', function(){
        eyebrow.style.transform = 'scale(1.04)';
        eyebrow.style.transition = 'transform 0.3s var(--ease)';
        eyebrow.style.borderColor = 'rgba(255,255,255,0.2)';
      });
      eyebrow.addEventListener('mouseleave', function(){
        eyebrow.style.transform = '';
        eyebrow.style.borderColor = '';
      });
    }

    /* ─── 19. Step circles — sequential entrance ─── */
    var stepDur = isMobile ? 0.3 : 0.5;
    var stepStagger = isMobile ? 0.08 : 0.15;
    document.querySelectorAll('.m-step-num').forEach(function(el, i){
      el.style.opacity = '0';
      el.style.transform = 'scale(0.6)';
      el.style.transition = 'opacity ' + stepDur + 's ' + (i * stepStagger) + 's var(--ease), transform ' + stepDur + 's ' + (i * stepStagger) + 's var(--ease)';
      var sIO = new IntersectionObserver(function(entries){
        entries.forEach(function(e){
          if (e.isIntersecting){
            el.style.opacity = '1';
            el.style.transform = 'scale(1)';
            sIO.unobserve(el);
          }
        });
      }, {threshold:0.2});
      sIO.observe(el);
    });

    /* ─── 20. Advanced Tabs ─── */
    var advTabs = document.querySelectorAll('.m-adv-tab');
    var advContents = document.querySelectorAll('.m-adv-tab-content');
    advTabs.forEach(function(tab) {
      tab.addEventListener('click', function(e) {
        e.preventDefault();
        advTabs.forEach(function(t) {
          t.classList.remove('active');
          t.setAttribute('aria-selected', 'false');
        });
        advContents.forEach(function(c) { c.classList.remove('active'); });
        tab.classList.add('active');
        tab.setAttribute('aria-selected', 'true');
        var target = document.getElementById(tab.getAttribute('data-tab'));
        if (target) target.classList.add('active');
      });
    });

  })();
  </script>
</body>
</html>
