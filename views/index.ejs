<!doctype html>
<html lang="<%= (seo && seo.lang) ? seo.lang : 'az' %>" dir="<%= (typeof dir !== 'undefined' && dir) ? dir : 'ltr' %>">
<head>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=<%= (typeof assetVersion !== 'undefined' ? assetVersion : '1') %>" />
  <link rel="icon" href="/favicon.ico?v=<%= (typeof assetVersion !== 'undefined' ? assetVersion : '1') %>" />
  <link rel="apple-touch-icon" href="/logo.png?v=<%= (typeof assetVersion !== 'undefined' ? assetVersion : '1') %>" />
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="csrf-token" content="<%= csrfToken %>" />
  <title><%= (seo && seo.title) ? seo.title : 'Ovlink — B2B Link İdarəçiliyi, Dinamik QR və Müştəri Portalları' %></title>

  <link rel="manifest" href="/site.webmanifest" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/vendor/fontawesome/css/all.min.css?v=<%= (typeof assetVersion !== 'undefined' ? assetVersion : '1') %>" />
  <link rel="stylesheet" href="/home.css?v=<%= assetVersion %>" />

  <meta name="description" content="<%= (seo && seo.description) ? seo.description : 'Agentliklər və marketinq komandaları üçün özəl domenli qısa linklər, dinamik QR kodlar, bot filtri və canlı müştəri hesabat portalları.' %>" />
  <meta name="keywords" content="<%= (seo && seo.keywords) ? seo.keywords : '' %>" />
  <link rel="canonical" href="<%= (seo && seo.canonical) ? seo.canonical : '' %>" />
  <link rel="alternate" hreflang="en" href="<%= (seo && seo.hreflangEn) ? seo.hreflangEn : '' %>" />
  <link rel="alternate" hreflang="az" href="<%= (seo && seo.hreflangAz) ? seo.hreflangAz : '' %>" />
  <link rel="alternate" hreflang="tr" href="<%= (seo && seo.hreflangTr) ? seo.hreflangTr : '' %>" />
  <link rel="alternate" hreflang="x-default" href="<%= (seo && seo.hreflangXDefault) ? seo.hreflangXDefault : '' %>" />

  <style nonce="<%= (typeof nonce !== 'undefined' ? nonce : '') %>">
    /* === Crisp Light-Mode B2B Editorial System (Dub.co / Stripe Restraint) === */
    body.ov-light-home {
      background: #ffffff !important;
      color: #0f172a !important;
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif !important;
      color-scheme: light !important;
    }

    /* Cohesive Light Navbar on Homepage */
    body.ov-light-home .m-nav {
      background: rgba(255, 255, 255, 0.92) !important;
      backdrop-filter: blur(14px) !important;
      border-bottom: 1px solid #e2e8f0 !important;
    }
    body.ov-light-home .m-nav a,
    body.ov-light-home .m-nav .m-lang-btn,
    body.ov-light-home .m-nav .m-btn-ghost,
    body.ov-light-home .m-nav .m-user-btn,
    body.ov-light-home .m-nav .m-burger {
      color: #0f172a !important;
    }
    body.ov-light-home .m-nav .m-nav-links a {
      color: #475569 !important;
    }
    body.ov-light-home .m-nav .m-nav-links a:hover {
      color: #0f172a !important;
    }
    body.ov-light-home .m-nav .m-btn-solid {
      background: #0f172a !important;
      color: #ffffff !important;
      border-color: #0f172a !important;
    }
    body.ov-light-home .m-nav .m-btn-ghost {
      border-color: #e2e8f0 !important;
      background: #ffffff !important;
    }
    body.ov-light-home .m-nav .m-lang-btn {
      border-color: #e2e8f0 !important;
      background: #f8fafc !important;
    }
    body.ov-light-home .m-lang-menu,
    body.ov-light-home .m-user-menu {
      background: #ffffff !important;
      border: 1px solid #e2e8f0 !important;
      box-shadow: 0 12px 32px rgba(15, 23, 42, 0.1) !important;
    }
    body.ov-light-home .m-lang-item,
    body.ov-light-home .m-user-item {
      color: #0f172a !important;
    }
    body.ov-light-home .m-lang-item:hover,
    body.ov-light-home .m-user-item:hover {
      background: #f1f5f9 !important;
    }

    /* Cohesive Light Footer on Homepage */
    body.ov-light-home .m-footer {
      background: #f8fafc !important;
      border-top: 1px solid #e2e8f0 !important;
      color: #475569 !important;
    }
    body.ov-light-home .m-footer-col-title,
    body.ov-light-home .m-footer-copy strong {
      color: #0f172a !important;
    }
    body.ov-light-home .m-footer a {
      color: #475569 !important;
    }
    body.ov-light-home .m-footer a:hover {
      color: #0f172a !important;
    }
    body.ov-light-home .m-cookie {
      background: #ffffff !important;
      border: 1px solid #cbd5e1 !important;
      color: #0f172a !important;
      box-shadow: 0 12px 36px rgba(15, 23, 42, 0.14) !important;
    }
    body.ov-light-home .m-cookie .m-cta--white {
      background: #0f172a !important;
      color: #ffffff !important;
    }
    body.ov-light-home .m-cookie .m-cta--outline {
      background: #ffffff !important;
      color: #0f172a !important;
      border-color: #cbd5e1 !important;
    }

    /* Architectural subtle grid hero */
    .ov-l-hero {
      padding: 124px 24px 72px;
      background-color: #ffffff;
      background-image:
        linear-gradient(to right, #f1f5f9 1px, transparent 1px),
        linear-gradient(to bottom, #f1f5f9 1px, transparent 1px);
      background-size: 64px 64px;
      border-bottom: 1px solid #e2e8f0;
    }
    .ov-l-shell {
      max-width: 1080px;
      margin: 0 auto;
    }
    .ov-l-hero-inner {
      text-align: center;
      max-width: 740px;
      margin: 0 auto;
    }
    .ov-l-kicker {
      display: inline-block;
      font-size: 12.5px;
      font-weight: 600;
      color: #1d4ed8;
      background: #eff6ff;
      border: 1px solid #dbeafe;
      padding: 5px 12px;
      border-radius: 999px;
      margin-bottom: 20px;
    }
    body.ov-light-home .m-hero-h1 {
      font-size: clamp(36px, 5.2vw, 58px) !important;
      font-weight: 800 !important;
      line-height: 1.08 !important;
      letter-spacing: -0.035em !important;
      color: #0f172a !important;
      margin: 0 0 18px !important;
      text-wrap: balance;
    }
    .ov-l-sub {
      font-size: clamp(16.5px, 1.8vw, 19px);
      line-height: 1.6;
      color: #475569;
      max-width: 580px;
      margin: 0 auto 28px;
    }
    .ov-l-ctas {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 12px;
      flex-wrap: wrap;
      margin-bottom: 44px;
    }
    .ov-l-btn-dark {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      height: 44px;
      padding: 0 22px;
      border-radius: 9px;
      background: #0f172a;
      color: #ffffff !important;
      font-size: 14.5px;
      font-weight: 600;
      text-decoration: none;
      transition: background 0.15s ease;
    }
    .ov-l-btn-dark:hover { background: #1e293b; }
    .ov-l-btn-light {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      height: 44px;
      padding: 0 22px;
      border-radius: 9px;
      background: #ffffff;
      border: 1px solid #cbd5e1;
      color: #0f172a !important;
      font-size: 14.5px;
      font-weight: 600;
      text-decoration: none;
      transition: border-color 0.15s ease, background 0.15s ease;
    }
    .ov-l-btn-light:hover { border-color: #94a3b8; background: #f8fafc; }

    /* Interactive 3-Tab Product Showcase (Clean White SaaS Frame) */
    .ov-l-stage {
      background: #ffffff;
      border: 1px solid #e2e8f0;
      border-radius: 16px;
      box-shadow: 0 20px 50px rgba(15, 23, 42, 0.08);
      overflow: hidden;
      text-align: left;
    }
    .ov-l-tabs {
      display: flex;
      gap: 4px;
      padding: 10px 14px;
      background: #f8fafc;
      border-bottom: 1px solid #e2e8f0;
      overflow-x: auto;
    }
    .ov-l-tab {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 8px 14px;
      border-radius: 8px;
      border: 1px solid transparent;
      background: transparent;
      color: #475569;
      font-size: 13.5px;
      font-weight: 600;
      cursor: pointer;
      white-space: nowrap;
      font-family: inherit;
    }
    .ov-l-tab:hover { color: #0f172a; background: rgba(15, 23, 42, 0.04); }
    .ov-l-tab.is-active {
      background: #ffffff;
      color: #0f172a;
      border-color: #e2e8f0;
      box-shadow: 0 1px 3px rgba(15, 23, 42, 0.06);
    }
    .ov-l-tab i { color: #2563eb; font-size: 13px; }
    .ov-l-panel { display: none; padding: 28px; }
    .ov-l-panel.is-active { display: block; }

    /* Light Composer inside Tab 1 */
    body.ov-light-home .m-composer {
      background: #f8fafc !important;
      border: 1px solid #cbd5e1 !important;
      border-radius: 12px !important;
      padding: 12px !important;
      box-shadow: none !important;
    }
    body.ov-light-home .m-composer-input {
      color: #0f172a !important;
      background: transparent !important;
    }
    body.ov-light-home .m-composer-input::placeholder { color: #94a3b8 !important; }
    body.ov-light-home .m-composer-icon { color: #64748b !important; }
    body.ov-light-home .m-composer-submit {
      background: #0f172a !important;
      color: #ffffff !important;
    }
    body.ov-light-home .m-composer-meta,
    body.ov-light-home .m-adv-toggle {
      color: #64748b !important;
    }
    body.ov-light-home .m-composer-meta a { color: #1d4ed8 !important; font-weight: 600; }
    body.ov-light-home .m-adv-panel {
      background: #ffffff !important;
      border: 1px solid #e2e8f0 !important;
      border-radius: 10px !important;
      padding: 14px !important;
      margin-top: 10px !important;
    }
    body.ov-light-home .m-adv-label { color: #334155 !important; }
    body.ov-light-home .m-adv-input {
      background: #ffffff !important;
      border: 1px solid #cbd5e1 !important;
      color: #0f172a !important;
    }
    body.ov-light-home .m-adv-tab { color: #475569 !important; }
    body.ov-light-home .m-adv-tab.active {
      background: #0f172a !important;
      color: #ffffff !important;
    }
    body.ov-light-home .m-result {
      background: #f0fdf4 !important;
      border: 1px solid #bbf7d0 !important;
      color: #0f172a !important;
    }
    body.ov-light-home .m-result-url { color: #1d4ed8 !important; }

    /* Sample rows inside Showcase Tabs */
    .ov-demo-rows {
      display: grid;
      gap: 10px;
      margin-top: 18px;
    }
    .ov-demo-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 14px;
      padding: 14px 16px;
      border-radius: 10px;
      border: 1px solid #e2e8f0;
      background: #ffffff;
      flex-wrap: wrap;
    }
    .ov-demo-short {
      font-size: 14.5px;
      font-weight: 700;
      color: #0f172a;
    }
    .ov-demo-dest {
      font-size: 12.5px;
      color: #64748b;
      margin-top: 2px;
    }
    .ov-demo-metric {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      font-size: 13px;
      font-weight: 600;
      color: #0f172a;
      background: #f8fafc;
      border: 1px solid #e2e8f0;
      padding: 5px 11px;
      border-radius: 8px;
    }
    .ov-demo-metric.ok {
      color: #15803d;
      background: #f0fdf4;
      border-color: #bbf7d0;
    }

    /* Clean Content Sections */
    .ov-l-sec {
      padding: 84px 24px;
      border-bottom: 1px solid #e2e8f0;
      background: #ffffff;
    }
    .ov-l-sec--tint {
      background: #f8fafc;
    }
    .ov-l-sec-head {
      max-width: 620px;
      margin-bottom: 44px;
    }
    .ov-l-sec-head h2 {
      font-size: clamp(26px, 3.2vw, 36px);
      font-weight: 800;
      letter-spacing: -0.03em;
      line-height: 1.15;
      color: #0f172a;
      margin: 0 0 10px;
    }
    .ov-l-sec-head p {
      font-size: 16px;
      line-height: 1.6;
      color: #475569;
      margin: 0;
    }

    /* 3-Column Feature Grid (Clean Flat White Cards) */
    .ov-l-grid-3 {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 20px;
    }
    .ov-l-card {
      padding: 26px;
      border-radius: 14px;
      border: 1px solid #e2e8f0;
      background: #ffffff;
    }
    .ov-l-card-ico {
      width: 38px;
      height: 38px;
      border-radius: 9px;
      background: #eff6ff;
      color: #1d4ed8;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 15px;
      margin-bottom: 16px;
    }
    .ov-l-card h3 {
      font-size: 17px;
      font-weight: 700;
      color: #0f172a;
      margin: 0 0 8px;
    }
    .ov-l-card p {
      font-size: 14.5px;
      line-height: 1.6;
      color: #475569;
      margin: 0;
    }

    /* 3-Step Horizontal Workflow */
    .ov-l-steps {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 28px;
    }
    .ov-l-step-num {
      font-size: 12.5px;
      font-weight: 700;
      color: #1d4ed8;
      margin-bottom: 8px;
    }
    .ov-l-steps h3 {
      font-size: 17px;
      font-weight: 700;
      color: #0f172a;
      margin: 0 0 8px;
    }
    .ov-l-steps p {
      font-size: 14.5px;
      line-height: 1.6;
      color: #475569;
      margin: 0;
    }

    /* Final CTA Band */
    .ov-l-final {
      padding: 76px 24px;
      text-align: center;
      background: #ffffff;
    }
    .ov-l-final h2 {
      font-size: clamp(26px, 3.4vw, 38px);
      font-weight: 800;
      letter-spacing: -0.03em;
      color: #0f172a;
      margin: 0 0 10px;
    }
    .ov-l-final p {
      font-size: 16px;
      color: #475569;
      margin: 0 0 28px;
    }

    @media (max-width: 860px) {
      .ov-l-grid-3, .ov-l-steps { grid-template-columns: 1fr; }
      .ov-l-panel { padding: 18px; }
    }
  </style>
</head>
<body class="ovx home-page ov-light-home">

  <a href="#mainContent" class="m-skip-link" data-i18n="skip_to_content">Skip to content</a>

  <% if (siteSettings && siteSettings.announcement_enabled === '1' && (siteSettings.announcement_text_az || siteSettings.announcement_text_tr || siteSettings.announcement_text_en)) { %>
    <div id="siteAnnouncement" class="m-ribbon" data-az="<%= siteSettings.announcement_text_az || '' %>" data-tr="<%= siteSettings.announcement_text_tr || '' %>" data-en="<%= siteSettings.announcement_text_en || '' %>">
      <i class="fa-solid fa-bullhorn" aria-hidden="true"></i>
      <span id="siteAnnouncementText"><%= siteSettings.announcement_text_az || siteSettings.announcement_text_tr || siteSettings.announcement_text_en %></span>
    </div>
  <% } %>

  <%- include('partials/home-navbar') %>

  <main id="mainContent">

    <!-- 1. CRISP LIGHT HERO + INTERACTIVE 3-TAB PRODUCT FRAME -->
    <section class="ov-l-hero" aria-labelledby="heroTitle">
      <div class="ov-l-shell">
        <div class="ov-l-hero-inner">
          <span class="ov-l-kicker">Agentliklər və marketinq komandaları üçün</span>
          <h1 class="m-hero-h1" id="heroTitle">
            Brendli linklər, dinamik QR və canlı müştəri hesabatları.
          </h1>
          <p class="ov-l-sub" data-i18n="hero_sub">
            Kampaniyalarınızı öz domeninizlə paylaşın, bot kliklərini avtomatik təmizləyin və müştərilərinizə Excel əvəzinə canlı hesabat linki verin.
          </p>
          <div class="ov-l-ctas">
            <a class="ov-l-btn-dark" href="/register?intent=trial" data-i18n="hero_cta_trial">14 gün pulsuz başla</a>
            <a class="ov-l-btn-light" href="/contact?intent=demo" data-i18n="hero_cta_demo">Demo istə</a>
          </div>
        </div>

        <!-- Interactive 3-Tab Real Product Frame -->
        <div class="ov-l-stage">
          <div class="ov-l-tabs" role="tablist" aria-label="Ovlink imkanları">
            <button type="button" class="ov-l-tab is-active" data-stage-tab="st-links" role="tab" aria-selected="true">
              <i class="fa-solid fa-link" aria-hidden="true"></i>
              <span>1. Qısa Link &amp; UTM</span>
            </button>
            <button type="button" class="ov-l-tab" data-stage-tab="st-qr" role="tab" aria-selected="false">
              <i class="fa-solid fa-qrcode" aria-hidden="true"></i>
              <span>2. Dinamik QR Kodlar</span>
            </button>
            <button type="button" class="ov-l-tab" data-stage-tab="st-portal" role="tab" aria-selected="false">
              <i class="fa-solid fa-file-lines" aria-hidden="true"></i>
              <span>3. Canlı Müştəri Portalı</span>
            </button>
          </div>

          <!-- TAB 1: Live Shortener + Branded Link Example -->
          <div class="ov-l-panel is-active" id="st-links" role="tabpanel">
            <div class="m-composer">
              <form id="shortenForm" action="javascript:void(0);">
                <div class="m-composer-row">
                  <span class="m-composer-icon"><i class="fa-solid fa-link" aria-hidden="true"></i></span>
                  <input class="m-composer-input" type="url" id="originalUrl" name="originalUrl"
                    placeholder="https://saytiniz.az/kampaniya — indi qısaldıb yoxlayın"
                    data-i18n="input_placeholder"
                    data-i18n-aria="aria_long_url"
                    autocomplete="off" spellcheck="false" required aria-label="Long URL to shorten" />
                  <button type="submit" class="m-composer-submit" id="shortenSubmitBtn" aria-label="Shorten" data-i18n-aria="shorten_btn" title="Shorten" data-i18n-title="shorten_btn">
                    <span data-i18n="shorten_btn">Qısalt</span>
                    <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
                  </button>
                </div>

                <div class="m-composer-meta">
                  <span id="composerGuestHint">
                    <span>Qeydiyyatsız sınaq ·</span>
                    <a href="/register?intent=trial">Özəl domen və analitika üçün pulsuz hesab aç</a>
                  </span>
                  <span class="m-ws-wrap" id="homeWorkspaceTopWrapper" hidden>
                    <button type="button" class="m-ws-btn" id="homeWorkspaceDropdownBtn" aria-haspopup="true" aria-expanded="false" aria-controls="homeWorkspaceDropdownMenu">
                      <i class="fa-regular fa-user" id="homeWorkspaceBtnIcon" aria-hidden="true"></i>
                      <span id="homeWorkspaceBtnText" data-i18n="workspace_personal">Personal</span>
                      <i class="fa-solid fa-chevron-down" style="font-size:9px;opacity:.5;" aria-hidden="true"></i>
                    </button>
                    <div class="m-ws-panel" id="homeWorkspaceDropdownMenu" role="menu"></div>
                  </span>
                </div>

                <button type="button" class="m-adv-toggle" id="advancedToggleBtn" aria-expanded="false" aria-controls="advancedPanel">
                  <i class="fa-solid fa-sliders" aria-hidden="true"></i>
                  <span data-i18n="advanced_settings">UTM və əlavə seçimlər</span>
                  <i class="fa-solid fa-chevron-down m-adv-chevron" id="advancedChevron" aria-hidden="true"></i>
                </button>

                <div class="m-adv-panel" id="advancedPanel">
                  <div class="m-adv-tabs" role="tablist">
                    <button type="button" class="m-adv-tab active" data-tab="tab-genel" role="tab" aria-selected="true" aria-controls="tab-genel"><span data-i18n="adv_tab_general">Ümumi</span></button>
                    <button type="button" class="m-adv-tab" data-tab="tab-utm" role="tab" aria-selected="false" aria-controls="tab-utm"><span data-i18n="adv_tab_utm">UTM</span></button>
                    <button type="button" class="m-adv-tab" data-tab="tab-cihaz" role="tab" aria-selected="false" aria-controls="tab-cihaz"><span data-i18n="adv_tab_device">Cihaz</span></button>
                    <button type="button" class="m-adv-tab" data-tab="tab-ab" role="tab" aria-selected="false" aria-controls="tab-ab"><span data-i18n="adv_tab_ab">A/B Test</span></button>
                  </div>

                  <div class="m-adv-tab-content active" id="tab-genel" role="tabpanel">
                    <div class="m-adv-grid">
                      <div class="m-adv-field">
                        <label class="m-adv-label" for="customAlias"><span data-i18n="alias_label">Xüsusi alias</span></label>
                        <input class="m-adv-input" type="text" id="customAlias" name="customLink" placeholder="yaz-2026" autocomplete="off" aria-label="Custom alias" />
                      </div>
                      <div class="m-adv-field">
                        <label class="m-adv-label" for="linkPassword"><span data-i18n="pass_label">Şifrə</span></label>
                        <input class="m-adv-input" type="password" id="linkPassword" name="linkPassword" placeholder="••••••••" autocomplete="new-password" aria-label="Link password" />
                      </div>
                      <div class="m-adv-field">
                        <label class="m-adv-label" for="expiresAt"><span data-i18n="expiry_date">Bitmə tarixi</span></label>
                        <input class="m-adv-input" type="datetime-local" id="expiresAt" name="expiresAt" aria-label="Expiration date" />
                      </div>
                      <div class="m-adv-field">
                        <label class="m-adv-label" for="maxClicks"><span data-i18n="max_clicks">Maksimum klik</span></label>
                        <input class="m-adv-input" type="number" id="maxClicks" name="maxClicks" min="1" placeholder="1000" aria-label="Max clicks" />
                      </div>
