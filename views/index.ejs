<!doctype html>
<html lang="<%= (seo && seo.lang) ? seo.lang : 'az' %>" dir="<%= (typeof dir !== 'undefined' && dir) ? dir : 'ltr' %>">
<head>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=<%= (typeof assetVersion !== 'undefined' ? assetVersion : '1') %>" />
  <link rel="icon" href="/favicon.ico?v=<%= (typeof assetVersion !== 'undefined' ? assetVersion : '1') %>" />
  <link rel="apple-touch-icon" href="/logo.png?v=<%= (typeof assetVersion !== 'undefined' ? assetVersion : '1') %>" />
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="csrf-token" content="<%= csrfToken %>" />
  <title><%= (seo && seo.title) ? seo.title : 'Ovlink — Linklər, Dinamik QR və Müştəri Hesabatları' %></title>

  <link rel="manifest" href="/site.webmanifest" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/vendor/fontawesome/css/all.min.css?v=<%= (typeof assetVersion !== 'undefined' ? assetVersion : '1') %>" />
  <link rel="stylesheet" href="/home.css?v=<%= assetVersion %>" />

  <meta name="description" content="<%= (seo && seo.description) ? seo.description : 'Agentliklər və bizneslər üçün özəl domenli qısa linklər, dinamik QR kodlar, bot filtri və canlı müştəri hesabatları.' %>" />
  <meta name="keywords" content="<%= (seo && seo.keywords) ? seo.keywords : '' %>" />
  <link rel="canonical" href="<%= (seo && seo.canonical) ? seo.canonical : '' %>" />
  <link rel="alternate" hreflang="en" href="<%= (seo && seo.hreflangEn) ? seo.hreflangEn : '' %>" />
  <link rel="alternate" hreflang="az" href="<%= (seo && seo.hreflangAz) ? seo.hreflangAz : '' %>" />
  <link rel="alternate" hreflang="tr" href="<%= (seo && seo.hreflangTr) ? seo.hreflangTr : '' %>" />
  <link rel="alternate" hreflang="x-default" href="<%= (seo && seo.hreflangXDefault) ? seo.hreflangXDefault : '' %>" />

  <style nonce="<%= (typeof nonce !== 'undefined' ? nonce : '') %>">
    body.ov-clean-home {
      background: #0a0a0a !important;
      color: #f4f4f5 !important;
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif !important;
    }

    .ov-wrap {
      max-width: 880px;
      margin: 0 auto;
      padding: 0 24px;
    }

    /* Calm, left-aligned editorial Hero — zero gradients, zero glow, zero eyebrow clutter */
    .ov-hero {
      padding: 132px 0 72px;
    }
    .ov-clean-home .m-hero-h1 {
      font-size: clamp(34px, 4.8vw, 54px) !important;
      font-weight: 700 !important;
      line-height: 1.12 !important;
      letter-spacing: -0.03em !important;
      color: #ffffff !important;
      margin: 0 0 20px !important;
      max-width: 18ch;
      text-align: left !important;
    }
    .ov-hero-lead {
      font-size: clamp(16.5px, 1.7vw, 18.5px);
      line-height: 1.65;
      color: #a1a1aa;
      max-width: 56ch;
      margin: 0 0 32px;
    }
    .ov-actions {
      display: flex;
      align-items: center;
      gap: 20px;
      flex-wrap: wrap;
      margin-bottom: 56px;
    }
    .ov-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      height: 44px;
      padding: 0 22px;
      border-radius: 8px;
      background: #ffffff;
      color: #0a0a0a !important;
      font-size: 14.5px;
      font-weight: 600;
      text-decoration: none;
      transition: background 0.15s ease;
    }
    .ov-btn:hover {
      background: #e4e4e7;
    }
    .ov-text-link {
      font-size: 14.5px;
      font-weight: 500;
      color: #d4d4d8 !important;
      text-decoration: none;
      border-bottom: 1px solid #3f3f46;
      padding-bottom: 2px;
      transition: color 0.15s ease, border-color 0.15s ease;
    }
    .ov-text-link:hover {
      color: #ffffff !important;
      border-color: #ffffff;
    }

    /* Flat, honest URL composer — zero glow, zero shadow */
    .ov-tester-label {
      font-size: 13px;
      font-weight: 500;
      color: #71717a;
      margin: 0 0 10px;
    }
    .ov-clean-home .m-composer {
      border-radius: 10px !important;
      border: 1px solid #27272a !important;
      background: #111113 !important;
      padding: 10px 12px !important;
      box-shadow: none !important;
    }
    .ov-clean-home .m-composer-meta {
      margin-top: 10px;
      font-size: 12.5px;
      color: #71717a;
    }
    .ov-clean-home .m-composer-meta a {
      color: #d4d4d8;
    }

    /* Clean hairline rows — ZERO boxes, ZERO icons-in-squares, ZERO card clutter */
    .ov-list-sec {
      padding: 64px 0;
      border-top: 1px solid #1f1f23;
    }
    .ov-sec-title {
      font-size: 13px;
      font-weight: 600;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      color: #71717a;
      margin: 0 0 28px;
    }
    .ov-rows {
      display: flex;
      flex-direction: column;
    }
    .ov-row {
      display: grid;
      grid-template-columns: 240px 1fr;
      gap: 24px;
      padding: 24px 0;
      border-top: 1px solid #1f1f23;
      align-items: baseline;
    }
    .ov-row:first-child {
      border-top: none;
      padding-top: 0;
    }
    .ov-row h2 {
      font-size: 16.5px;
      font-weight: 600;
      color: #ffffff;
      margin: 0;
      line-height: 1.4;
    }
    .ov-row p {
      font-size: 15px;
      line-height: 1.65;
      color: #a1a1aa;
      margin: 0;
    }

    /* Quiet closing CTA */
    .ov-close {
      padding: 64px 0 88px;
      border-top: 1px solid #1f1f23;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 24px;
      flex-wrap: wrap;
    }
    .ov-close h2 {
      font-size: clamp(22px, 2.6vw, 28px);
      font-weight: 700;
      letter-spacing: -0.025em;
      color: #ffffff;
      margin: 0 0 6px;
    }
    .ov-close p {
      font-size: 14.5px;
      color: #a1a1aa;
      margin: 0;
    }
    .ov-close-actions {
      display: flex;
      align-items: center;
      gap: 18px;
      flex-wrap: wrap;
    }

    @media (max-width: 720px) {
      .ov-hero { padding: 104px 0 56px; }
      .ov-row { grid-template-columns: 1fr; gap: 8px; }
    }
  </style>
</head>
<body class="ovx home-page ov-clean-home">

  <a href="#mainContent" class="m-skip-link" data-i18n="skip_to_content">Skip to content</a>

  <% if (siteSettings && siteSettings.announcement_enabled === '1' && (siteSettings.announcement_text_az || siteSettings.announcement_text_tr || siteSettings.announcement_text_en)) { %>
    <div id="siteAnnouncement" class="m-ribbon" data-az="<%= siteSettings.announcement_text_az || '' %>" data-tr="<%= siteSettings.announcement_text_tr || '' %>" data-en="<%= siteSettings.announcement_text_en || '' %>">
      <i class="fa-solid fa-bullhorn" aria-hidden="true"></i>
      <span id="siteAnnouncementText"><%= siteSettings.announcement_text_az || siteSettings.announcement_text_tr || siteSettings.announcement_text_en %></span>
    </div>
  <% } %>

  <%- include('partials/home-navbar') %>

  <main id="mainContent">
    <div class="ov-wrap">

      <!-- 1. HERO -->
      <section class="ov-hero" aria-labelledby="heroTitle">
        <h1 class="m-hero-h1" id="heroTitle">
          Kampaniya linkləri, dinamik QR və müştəri hesabatları.
        </h1>
        <p class="ov-hero-lead" data-i18n="hero_sub">
          Agentliklər və bizneslər üçün sadə link idarəçiliyi. Bot klikləri avtomatik təmizlənir, müştəriniz isə nəticəni canlı hesabat linki və ya A4 PDF kimi görür.
        </p>

        <div class="ov-actions">
          <a class="ov-btn" href="/register?intent=trial" data-i18n="hero_cta_trial">14 gün pulsuz başla</a>
          <a class="ov-text-link" href="/contact?intent=demo" data-i18n="hero_cta_demo">Demo istə</a>
          <a class="ov-text-link" href="/pricing">Qiymətlər ($7/ay-dan)</a>
        </div>

        <p class="ov-tester-label">İndi sına — qeydiyyatsız 1 link qısalt</p>
        <div class="m-composer">
          <form id="shortenForm" action="javascript:void(0);">
            <div class="m-composer-row">
              <span class="m-composer-icon"><i class="fa-solid fa-link" aria-hidden="true"></i></span>
              <input class="m-composer-input" type="url" id="originalUrl" name="originalUrl"
                placeholder="https://saytiniz.az/kampaniya"
                data-i18n="input_placeholder"
                data-i18n-aria="aria_long_url"
                autocomplete="off" spellcheck="false" required aria-label="Long URL to shorten" />
              <button type="submit" class="m-composer-submit" id="shortenSubmitBtn" aria-label="Shorten" data-i18n-aria="shorten_btn" title="Shorten" data-i18n-title="shorten_btn">
                <span data-i18n="shorten_btn">Qısalt</span>
                <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
              </button>
            </div>

            <div class="m-composer-meta">
              <span id="composerGuestHint">
                <span>Özəl domen, QR və hesabatlar üçün</span>
                <a href="/register?intent=trial">pulsuz hesab açın</a>.
              </span>
              <span class="m-ws-wrap" id="homeWorkspaceTopWrapper" hidden>
                <button type="button" class="m-ws-btn" id="homeWorkspaceDropdownBtn" aria-haspopup="true" aria-expanded="false" aria-controls="homeWorkspaceDropdownMenu">
                  <i class="fa-regular fa-user" id="homeWorkspaceBtnIcon" aria-hidden="true"></i>
                  <span id="homeWorkspaceBtnText" data-i18n="workspace_personal">Personal</span>
                  <i class="fa-solid fa-chevron-down" style="font-size:9px;opacity:.5;" aria-hidden="true"></i>
                </button>
                <div class="m-ws-panel" id="homeWorkspaceDropdownMenu" role="menu"></div>
              </span>
            </div>

            <button type="button" class="m-adv-toggle" id="advancedToggleBtn" aria-expanded="false" aria-controls="advancedPanel">
              <i class="fa-solid fa-sliders" aria-hidden="true"></i>
              <span data-i18n="advanced_settings">Əlavə seçimlər (UTM, alias)</span>
              <i class="fa-solid fa-chevron-down m-adv-chevron" id="advancedChevron" aria-hidden="true"></i>
            </button>

            <div class="m-adv-panel" id="advancedPanel">
              <div class="m-adv-tabs" role="tablist">
                <button type="button" class="m-adv-tab active" data-tab="tab-genel" role="tab" aria-selected="true" aria-controls="tab-genel"><span data-i18n="adv_tab_general">Ümumi</span></button>
                <button type="button" class="m-adv-tab" data-tab="tab-utm" role="tab" aria-selected="false" aria-controls="tab-utm"><span data-i18n="adv_tab_utm">UTM</span></button>
                <button type="button" class="m-adv-tab" data-tab="tab-cihaz" role="tab" aria-selected="false" aria-controls="tab-cihaz"><span data-i18n="adv_tab_device">Cihaz</span></button>
                <button type="button" class="m-adv-tab" data-tab="tab-ab" role="tab" aria-selected="false" aria-controls="tab-ab"><span data-i18n="adv_tab_ab">A/B Test</span></button>
              </div>

              <div class="m-adv-tab-content active" id="tab-genel" role="tabpanel">
                <div class="m-adv-grid">
                  <div class="m-adv-field">
                    <label class="m-adv-label" for="customAlias"><span data-i18n="alias_label">Xüsusi alias</span></label>
                    <input class="m-adv-input" type="text" id="customAlias" name="customLink" placeholder="yaz-2026" autocomplete="off" aria-label="Custom alias" />
                  </div>
                  <div class="m-adv-field">
                    <label class="m-adv-label" for="linkPassword"><span data-i18n="pass_label">Şifrə</span></label>
                    <input class="m-adv-input" type="password" id="linkPassword" name="linkPassword" placeholder="••••••••" autocomplete="new-password" aria-label="Link password" />
                  </div>
                  <div class="m-adv-field">
                    <label class="m-adv-label" for="expiresAt"><span data-i18n="expiry_date">Bitmə tarixi</span></label>
                    <input class="m-adv-input" type="datetime-local" id="expiresAt" name="expiresAt" aria-label="Expiration date" />
                  </div>
                  <div class="m-adv-field">
                    <label class="m-adv-label" for="maxClicks"><span data-i18n="max_clicks">Maksimum klik</span></label>
                    <input class="m-adv-input" type="number" id="maxClicks" name="maxClicks" min="1" placeholder="1000" aria-label="Max clicks" />
                  </div>
                  <div class="m-adv-field m-adv-field--full">
                    <label class="m-adv-label" for="customDomainSelect"><span data-i18n="shorten_domain_label">Domen</span></label>
                    <select class="m-adv-input" id="customDomainSelect">
                      <option value="" data-i18n="shorten_domain_default">Standart (ovlink.sbs)</option>
                    </select>
                  </div>
                </div>
              </div>

              <div class="m-adv-tab-content" id="tab-utm" role="tabpanel">
                <div class="m-adv-grid">
                  <div class="m-adv-field m-adv-field--full">
                    <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;">
                      <div class="m-adv-field" style="flex:1;">
                        <label class="m-adv-label" for="utmTemplateSelect"><span data-i18n="adv_utm_params_title">UTM Şablonu</span></label>
                        <select class="m-adv-input" id="utmTemplateSelect" aria-label="UTM template"></select>
                      </div>
                      <button type="button" class="m-adv-save" id="saveUtmTemplateBtn" aria-label="Save UTM template">
                        <i class="fa-regular fa-floppy-disk" aria-hidden="true"></i>
                        <span data-i18n="adv_utm_save">Yadda saxla</span>
                      </button>
                    </div>
                  </div>
                  <div class="m-adv-field">
                    <label class="m-adv-label" for="utmSource"><span data-i18n="adv_utm_source">Source</span></label>
                    <input class="m-adv-input" type="text" id="utmSource" placeholder="instagram" aria-label="UTM source" />
                  </div>
                  <div class="m-adv-field">
                    <label class="m-adv-label" for="utmMedium"><span data-i18n="adv_utm_medium">Medium</span></label>
                    <input class="m-adv-input" type="text" id="utmMedium" placeholder="social" aria-label="UTM medium" />
                  </div>
                  <div class="m-adv-field m-adv-field--full">
                    <label class="m-adv-label" for="utmCampaign"><span data-i18n="adv_utm_campaign">Campaign</span></label>
                    <input class="m-adv-input" type="text" id="utmCampaign" placeholder="yaz_2026" aria-label="UTM campaign" />
                  </div>
                  <div class="m-adv-field">
                    <label class="m-adv-label" for="utmTerm"><span data-i18n="adv_utm_term">Term</span></label>
                    <input class="m-adv-input" type="text" id="utmTerm" placeholder="sale" aria-label="UTM term" />
                  </div>
                  <div class="m-adv-field">
                    <label class="m-adv-label" for="utmContent"><span data-i18n="adv_utm_content">Content</span></label>
                    <input class="m-adv-input" type="text" id="utmContent" placeholder="reels_1" aria-label="UTM content" />
                  </div>
                </div>
              </div>

              <div class="m-adv-tab-content" id="tab-cihaz" role="tabpanel">
                <div class="m-adv-grid">
                  <div class="m-adv-field m-adv-field--full">
                    <label class="m-adv-label" for="iosUrl">iOS Redirect</label>
                    <input class="m-adv-input" type="url" id="iosUrl" placeholder="https://apps.apple.com/..." aria-label="iOS redirect URL" />
                  </div>
                  <div class="m-adv-field m-adv-field--full">
                    <label class="m-adv-label" for="androidUrl">Android Redirect</label>
                    <input class="m-adv-input" type="url" id="androidUrl" placeholder="https://play.google.com/..." aria-label="Android redirect URL" />
                  </div>
                </div>
              </div>

              <div class="m-adv-tab-content" id="tab-ab" role="tabpanel">
                <div class="m-adv-grid">
                  <div class="m-adv-field m-adv-field--full">
                    <label class="m-adv-label" for="originalB">A/B Testing (URL B)</label>
                    <input class="m-adv-input" type="url" id="originalB" placeholder="https://..." aria-label="Target URL B" />
                    <div style="display:flex;align-items:center;gap:10px;margin-top:10px;">
                      <span class="m-adv-label" style="white-space:nowrap;">Link A (%)</span>
                      <input class="m-adv-input" type="number" id="abSplitPercent" min="0" max="100" value="50" style="width:80px;" aria-label="Link A traffic percent" />
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <div id="shortenFeedback" class="m-status" role="alert"></div>
          </form>

          <div id="result" class="m-result" style="display:none;">
            <p class="m-result-title">
              <i class="fa-solid fa-circle-check" aria-hidden="true"></i>
              <span data-i18n="generated_title">Linkiniz hazırdır</span>
            </p>
            <a id="shortUrl" class="m-result-url" href="#" target="_blank" rel="noopener"></a>
            <div class="m-result-actions">
              <button id="copyShortBtn" type="button" class="m-cta m-cta--white m-cta--sm">
                <i class="fa-regular fa-copy" aria-hidden="true"></i>
                <span data-i18n="copy_btn">Kopyala</span>
              </button>
            </div>
            <p id="shortenHint" class="m-status" style="margin-top:10px;font-size:12.5px;"></p>
          </div>
        </div>
      </section>

      <!-- 2. THREE CALM, HONEST CAPABILITIES (NO BOXES, NO GLOWS) -->
      <section class="ov-list-sec" aria-labelledby="featuresTitle">
        <p class="ov-sec-title" id="featuresTitle">Nəyi həll edir</p>
        <div class="ov-rows">
          <div class="ov-row">
            <h2>Özəl domen və dinamik QR</h2>
            <p>Müştərinizin öz domeni ilə qısa linklər və çapdan sonra hədəfi dəyişdirilə bilən QR kodlar yaradın. Ödəniş dayansa belə mövcud linklər reklamsız işləməyə davam edir.</p>
          </div>
          <div class="ov-row">
            <h2>Bot-suz təmiz statistika</h2>
            <p>Avtomatik filtr bot və skaner kliklərini ayırır. Hər kampaniya üzrə real insan kliklərini, cihazları, şəhərləri və UTM mənbələrini dəqiq görürsünüz.</p>
          </div>
          <div class="ov-row">
            <h2>Canlı müştəri portalı və A4 PDF</h2>
            <p>Ay sonu Excel yığmaq əvəzinə müştəriyə istənilən vaxt ləğv edilə bilən canlı hesabat linki verin və ya avtomatik aylıq A4 PDF göndərin.</p>
          </div>
          <div class="ov-row">
            <h2>Komanda və iş sahələri</h2>
            <p>Hər müştəri üçün ayrıca iş sahəsi, komanda rolları, əməliyyat jurnalı, Webhook və GA4 bağlantısı bir paneldə toplanır.</p>
          </div>
        </div>
      </section>

      <!-- 3. QUIET CLOSING -->
      <section class="ov-close" aria-label="Başla">
        <div>
          <h2>2 dəqiqəyə yoxlayın.</h2>
          <p>14 gün pulsuz sınaq · Kart tələb olunmur · İstənilən vaxt ləğv et.</p>
        </div>
        <div class="ov-close-actions">
          <a class="ov-btn" href="/register?intent=trial">14 gün pulsuz başla</a>
          <a class="ov-text-link" href="/pricing">Qiymətlərə bax</a>
        </div>
      </section>

    </div>
  </main>

  <%- include('partials/home-footer') %>

  <script nonce="<%= nonce %>" defer src="/lang-home.js?v=<%= assetVersion %>"></script>
  <script nonce="<%= nonce %>" defer src="/home.js?v=<%= assetVersion %>"></script>
  <script nonce="<%= nonce %>">
    (function () {
      var nav = document.getElementById('mNav');
      if (nav) {
        var onScroll = function () { nav.classList.toggle('scrolled', window.scrollY > 24); };
        window.addEventListener('scroll', onScroll, { passive: true });
        onScroll();
      }
      var advBtn = document.getElementById('advancedToggleBtn');
      var advPanel = document.getElementById('advancedPanel');
      var advChev = document.getElementById('advancedChevron');
      if (advBtn && advPanel) {
        advBtn.addEventListener('click', function () {
          var open = advPanel.classList.toggle('open');
          advBtn.setAttribute('aria-expanded', open ? 'true' : 'false');
          if (advChev) advChev.style.transform = open ? 'rotate(180deg)' : '';
        });
      }
      document.querySelectorAll('.m-adv-tab').forEach(function (tab) {
        tab.addEventListener('click', function () {
          var target = tab.getAttribute('data-tab');
          document.querySelectorAll('.m-adv-tab').forEach(function (t) {
            t.classList.toggle('active', t === tab);
            t.setAttribute('aria-selected', t === tab ? 'true' : 'false');
          });
          document.querySelectorAll('.m-adv-tab-content').forEach(function (c) {
            c.classList.toggle('active', c.id === target);
          });
        });
      });
    })();
  </script>
</body>
</html>
