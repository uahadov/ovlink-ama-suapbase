  <script nonce="<%= nonce %>" defer src="/lang-home.js?v=<%= assetVersion %>"></script>
  <script nonce="<%= nonce %>" defer src="/home.js?v=<%= assetVersion %>"></script>
  <script nonce="<%= nonce %>">
    (function () {
      /* === TRUE STICKY 3D SCROLLYTELLING ENGINE ===
         Scroll 0.0 -> 0.5: Card 0 peels/rotates away in 3D, Card 1 glides forward to front
         Scroll 0.5 -> 1.0: Card 1 peels/rotates away in 3D, Card 2 glides forward to front */
      var track = document.getElementById('s3dTrack');
      var cards = [
        document.getElementById('s3dCard0'),
        document.getElementById('s3dCard1'),
        document.getElementById('s3dCard2')
      ];
      var chapters = Array.prototype.slice.call(document.querySelectorAll('[data-s3d-ch]'));
      var dots = Array.prototype.slice.call(document.querySelectorAll('[data-s3d-dot]'));
      var hint = document.getElementById('s3dScrollHint');
      var reduced = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      var ticking = false;

      function clamp(v, a, b) { return Math.max(a, Math.min(b, v)); }

      function renderStack() {
        ticking = false;
        if (!track || !cards[0]) return;
        var mobile = window.innerWidth <= 920;
        var rect = track.getBoundingClientRect();
        var scrollable = Math.max(1, track.offsetHeight - window.innerHeight);
        var p = mobile || reduced ? 0 : clamp(-rect.top / scrollable, 0, 1);

        /* Continuous stage index: 0 -> 2 */
        var stagePos = p * 2;
        var activeIdx = stagePos < 0.5 ? 0 : (stagePos < 1.5 ? 1 : 2);

        chapters.forEach(function (ch, idx) {
          ch.classList.toggle('is-active', idx === activeIdx);
        });
        dots.forEach(function (d, idx) {
          d.classList.toggle('is-active', idx === activeIdx);
        });
        if (hint) {
          hint.textContent = activeIdx === 2 ? 'Link qısaldıb yoxlayın ↓' : 'Aşağı sürüşdürün';
        }

        cards.forEach(function (card, idx) {
          if (!card) return;
          /* diff = 0 when this card is front & center; >0 when behind; <0 when peeling away */
          var diff = idx - stagePos;

          if (diff >= 0) {
            /* Card sits at front (0) or stacked neatly behind in 3D depth (exact Concept 07 fan!) */
            var tx = diff * 22;
            var ty = diff * -16;
            var tz = diff * -90;
            var rotY = -6 - diff * 5;
            var rotX = 3 + diff * 2;
            var scale = 1 - diff * 0.055;
            var op = clamp(1 - diff * 0.22, 0.35, 1);
            card.style.transform = 'translate3d(' + tx.toFixed(1) + 'px,' + ty.toFixed(1) + 'px,' + tz.toFixed(1) + 'px) rotateY(' + rotY.toFixed(2) + 'deg) rotateX(' + rotX.toFixed(2) + 'deg) scale(' + scale.toFixed(4) + ')';
            card.style.opacity = op.toFixed(3);
            card.style.zIndex = String(10 - idx);
          } else {
            /* Card peels up, forward & rotates out cleanly in 3D space */
            var out = clamp(-diff, 0, 1);
            var txOut = out * -90;
            var tyOut = out * -140;
            var tzOut = out * 160;
            var rotYOut = -6 + out * 26;
            var rotXOut = 3 + out * 18;
            var opOut = clamp(1 - out * 1.45, 0, 1);
            card.style.transform = 'translate3d(' + txOut.toFixed(1) + 'px,' + tyOut.toFixed(1) + 'px,' + tzOut.toFixed(1) + 'px) rotateY(' + rotYOut.toFixed(2) + 'deg) rotateX(' + rotXOut.toFixed(2) + 'deg)';
            card.style.opacity = opOut.toFixed(3);
            card.style.zIndex = String(20 - idx);
          }
        });
      }

      function onScroll() {
        if (!ticking) {
          ticking = true;
          window.requestAnimationFrame(renderStack);
        }
      }

      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll, { passive: true });
      renderStack();

      /* Advanced composer toggle & tabs */
      var advBtn = document.getElementById('advancedToggleBtn');
      var advPanel = document.getElementById('advancedPanel');
      var advChev = document.getElementById('advancedChevron');
      if (advBtn && advPanel) {
        advBtn.addEventListener('click', function () {
          var open = advPanel.classList.toggle('open');
          advBtn.setAttribute('aria-expanded', open ? 'true' : 'false');
          if (advChev) advChev.style.transform = open ? 'rotate(180deg)' : '';
        });
      }
      document.querySelectorAll('.m-adv-tab').forEach(function (tab) {
        tab.addEventListener('click', function () {
          var target = tab.getAttribute('data-tab');
          document.querySelectorAll('.m-adv-tab').forEach(function (t) {
            t.classList.toggle('active', t === tab);
            t.setAttribute('aria-selected', t === tab ? 'true' : 'false');
          });
          document.querySelectorAll('.m-adv-tab-content').forEach(function (c) {
            c.classList.toggle('active', c.id === target);
          });
        });
      });
    })();
  </script>
</body>
</html>
