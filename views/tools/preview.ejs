<!DOCTYPE html>
<html lang="en">
<head>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=<%= (typeof assetVersion !== 'undefined' ? assetVersion : '1') %>" />
  <link rel="icon" href="/favicon.ico?v=<%= (typeof assetVersion !== 'undefined' ? assetVersion : '1') %>" />
  <link rel="apple-touch-icon" href="/logo.png?v=<%= (typeof assetVersion !== 'undefined' ? assetVersion : '1') %>" />

  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="csrf-token" content="<%= (typeof csrfToken !== 'undefined') ? csrfToken : '' %>">
  <title data-i18n="preview_tool_title"><%= title %></title>
  
  <link rel="manifest" href="/site.webmanifest">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="preload" href="/vendor/fontawesome/webfonts/fa-solid-900.woff2?v=<%= (typeof assetVersion !== 'undefined' ? assetVersion : '1') %>" as="font" type="font/woff2" crossorigin />
  <link rel="stylesheet" href="/vendor/fontawesome/css/all.min.css?v=<%= (typeof assetVersion !== 'undefined' ? assetVersion : '1') %>" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" integrity="sha512-iecdLmaskl7CVkqkXNQ/ZH/XLlvWZOJyj7Yy7tcenmpD1ypASozpmT/E0iPtmFIB46ZmdtAc9eNBvH0H/ZpiBw==" crossorigin="anonymous" referrerpolicy="no-referrer" />
  
  <link rel="stylesheet" href="/home.css?v=<%= (typeof assetVersion !== 'undefined') ? assetVersion : '1' %>">
</head>
<body class="ovx home-page">

  <!-- Ambient Cursor Glow -->
  <div id="cursorGlow" aria-hidden="true"></div>

  <!-- Universal Monolith Navbar -->
  <%- include('../partials/home-navbar') %>

  <main class="m-page-shell" style="padding-top: 48px; padding-bottom: 96px;">
    <div class="shell" style="max-width: 860px;">

      <!-- Studio Hero Header -->
      <div class="m-tool-hero">
        <div class="m-gateway-badge m-gateway-badge--amber" style="margin-bottom: 16px;">
          <span class="m-live-dot" style="background: #60a5fa;" aria-hidden="true"></span>
          <span>OPENGRAPH SOCIAL STUDIO</span>
        </div>
        <h1 data-i18n="preview_tool_title">OpenGraph Sosial Önbaxış & AI Studiyası</h1>
        <p data-i18n="preview_tool_desc">Keçidinizin Twitter/X, LinkedIn, Facebook və Discord platformalarında necə görünəcəyini canlı yoxlayın və AI ilə klik dərəcəsini artıran başlıqlar tərtib edin.</p>
      </div>

      <!-- URL Composer Input Card -->
      <div class="m-preview-composer">
        <i class="fa-solid fa-link" style="color: var(--c-faint); margin-left: 10px; font-size: 15px;"></i>
        <input type="url" id="urlInput" class="m-preview-composer-input" placeholder="Keçid linkini daxil edin (məs: https://saytiniz.com/meqale)..." data-i18n="preview_input_placeholder" required />
        <button type="button" id="fetchPreviewBtn" class="m-btn m-btn-solid" style="display:inline-flex; align-items:center; gap:8px; padding: 10px 22px; border-radius: 10px; font-weight: 700; white-space: nowrap;">
          <i class="fa-solid fa-magnifying-glass"></i>
          <span data-i18n="preview_generate_btn">Önbaxışı Göstər</span>
        </button>
      </div>

      <!-- Loading Spinner -->
      <div class="m-tool-loader" id="loader"></div>

      <!-- Platform Switcher Navigation -->
      <div class="m-platform-nav" id="platformSwitcher" style="display: none;">
        <button type="button" class="m-platform-tab active" data-platform="twitter">
          <i class="fa-brands fa-x-twitter"></i> <span data-i18n="preview_platform_twitter">Twitter / X</span>
        </button>
        <button type="button" class="m-platform-tab" data-platform="linkedin">
          <i class="fa-brands fa-linkedin"></i> <span data-i18n="preview_platform_linkedin">LinkedIn</span>
        </button>
        <button type="button" class="m-platform-tab" data-platform="facebook">
          <i class="fa-brands fa-facebook"></i> <span data-i18n="preview_platform_fb">Facebook</span>
        </button>
        <button type="button" class="m-platform-tab" data-platform="discord">
          <i class="fa-brands fa-discord"></i> <span data-i18n="preview_platform_discord">Discord</span>
        </button>
      </div>

      <!-- Social Preview Card Rendering Wrapper -->
      <div class="m-preview-card-wrap" id="previewWrap" style="display: none;">
        <div class="m-preview-card" id="previewCard">
          <div class="m-preview-img-container">
            <img src="" alt="Preview Image" class="preview-image" id="pImage">
          </div>
          <div class="m-preview-content-box">
            <div class="m-preview-host-domain" id="pDomain">example.com</div>
            <h3 class="m-preview-headline" id="pTitle">Başlıq burada görünəcək</h3>
            <p class="m-preview-summary" id="pDesc">Təsvir burada görünəcək</p>
          </div>
        </div>
      </div>

      <!-- AI Headline Optimizer Studio Panel -->
      <div class="m-ai-studio-panel" id="aiBox" style="display: none;">
        <div class="m-ai-studio-top">
          <div class="m-ai-studio-title">
            <i class="fa-solid fa-wand-magic-sparkles" style="color: #60a5fa;"></i>
            <span data-i18n="preview_ai_title">Süni İntellekt Başlıq Optimizatoru</span>
          </div>
          <button type="button" class="m-btn m-btn-solid" id="aiBtn" style="padding: 8px 18px; font-size: 13px; font-weight: 700; border-radius: 8px;" data-i18n="preview_ai_btn">
            3 Perspektiv Tərtib Et
          </button>
        </div>
        <div id="aiVariants" class="ai-variants"></div>
      </div>

      <!-- Call to Action Card -->
      <div class="m-card cta-box" id="ctaBox" style="display: none; text-align: center; padding: 40px 24px; border-radius: 18px; background: var(--c-surface); border: 1px solid var(--c-border);">
        <h2 style="font-size: 22px; font-weight: 800; color: var(--c-white); margin-bottom: 8px;" data-i18n="preview_cta_title">Təmiz link izlənməsi və fərdi domenlər istəyirsiniz?</h2>
        <p style="color: var(--c-muted); font-size: 14.5px; max-width: 520px; margin: 0 auto 24px auto;" data-i18n="preview_cta_desc">Ovlink ilə bu linki dərhal qısaldın və real vaxt rejimində qlobal klik statistikasına sahib olun.</p>
        <a href="/" class="m-btn m-btn-solid" id="shortenBtn" style="display:inline-flex; align-items:center; gap:8px; padding: 12px 28px; border-radius: 999px; text-decoration:none;">
          <i class="fa-solid fa-scissors"></i>
          <span data-i18n="preview_cta_btn">Ovlink ilə İndi Qısaldın</span>
        </a>
      </div>

    </div>
  </main>

  <!-- Universal Monolith Footer -->
  <%- include('../partials/home-footer') %>

  <script <% if (typeof nonce !== 'undefined' && nonce) { %>nonce="<%= nonce %>"<% } %> src="/lang.js?v=<%= (typeof assetVersion !== 'undefined') ? assetVersion : '1' %>"></script>
  <script <% if (typeof nonce !== 'undefined' && nonce) { %>nonce="<%= nonce %>"<% } %> src="/home.js?v=<%= (typeof assetVersion !== 'undefined') ? assetVersion : '1' %>"></script>
  <script <% if (typeof nonce !== 'undefined' && nonce) { %>nonce="<%= nonce %>"<% } %> src="/script.js?v=<%= (typeof assetVersion !== 'undefined') ? assetVersion : '1' %>"></script>

  <script <% if (typeof nonce !== 'undefined' && nonce) { %>nonce="<%= nonce %>"<% } %>>
    let currentMetadata = null;
    let activePlatform = 'twitter';

    function setPlatform(platform, btn) {
      if (!platform) return;
      activePlatform = platform;
      document.querySelectorAll('.m-platform-tab').forEach(b => b.classList.remove('active'));
      if (btn) btn.classList.add('active');

      const cardWrap = document.getElementById('previewWrap');
      const imgContainer = document.querySelector('.m-preview-img-container');
      if (!cardWrap || !imgContainer) return;

      if (platform === 'linkedin') {
        cardWrap.style.borderRadius = '8px';
        cardWrap.style.borderLeft = '1px solid var(--c-border)';
        imgContainer.style.height = '340px';
      } else if (platform === 'facebook') {
        cardWrap.style.borderRadius = '0px';
        cardWrap.style.borderLeft = '1px solid var(--c-border)';
        imgContainer.style.height = '360px';
      } else if (platform === 'discord') {
        cardWrap.style.borderRadius = '4px';
        cardWrap.style.borderLeft = '4px solid #5865f2';
        imgContainer.style.height = '300px';
      } else {
        cardWrap.style.borderRadius = '18px';
        cardWrap.style.borderLeft = '1px solid var(--c-border)';
        imgContainer.style.height = 'clamp(220px, 32vw, 360px)';
      }
    }

    async function fetchPreview() {
      const input = document.getElementById('urlInput');
      const rawUrl = input ? input.value.trim() : '';
      if (!rawUrl) {
        alert('Zəhmət olmasa düzgün URL daxil edin');
        return;
      }

      const formattedUrl = rawUrl.startsWith('http://') || rawUrl.startsWith('https://') ? rawUrl : 'https://' + rawUrl;
      input.value = formattedUrl;

      const loader = document.getElementById('loader');
      const platformSwitcher = document.getElementById('platformSwitcher');
      const previewWrap = document.getElementById('previewWrap');
      const aiBox = document.getElementById('aiBox');
      const ctaBox = document.getElementById('ctaBox');
      const aiVariants = document.getElementById('aiVariants');

      if (loader) loader.style.display = 'block';
      if (platformSwitcher) platformSwitcher.style.display = 'none';
      if (previewWrap) previewWrap.style.display = 'none';
      if (aiBox) aiBox.style.display = 'none';
      if (ctaBox) ctaBox.style.display = 'none';
      if (aiVariants) aiVariants.innerHTML = '';

      try {
        const res = await fetch('/api/tools/fetch-metadata', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ url: formattedUrl })
        });
        const data = await res.json();
        if (data.error) throw new Error(data.error);

        currentMetadata = data;
        const pImage = document.getElementById('pImage');
        const pTitle = document.getElementById('pTitle');
        const pDesc = document.getElementById('pDesc');
        const pDomain = document.getElementById('pDomain');
        const shortenBtn = document.getElementById('shortenBtn');

        if (pImage) {
          pImage.onerror = () => {
            pImage.src = 'https://via.placeholder.com/800x400?text=No+OpenGraph+Image+Found';
          };
          pImage.src = data.image || 'https://via.placeholder.com/800x400?text=No+OpenGraph+Image+Found';
        }
        if (pTitle) pTitle.innerText = data.title || 'No Title Found';
        if (pDesc) pDesc.innerText = data.description || 'No Description Found';
        if (pDomain) pDomain.innerText = data.domain || '';
        if (shortenBtn) shortenBtn.href = '/?url=' + encodeURIComponent(formattedUrl);

        if (loader) loader.style.display = 'none';
        if (platformSwitcher) platformSwitcher.style.display = 'flex';
        if (previewWrap) previewWrap.style.display = 'block';
        if (aiBox) aiBox.style.display = 'block';
        if (ctaBox) ctaBox.style.display = 'block';
      } catch (err) {
        if (loader) loader.style.display = 'none';
        alert('Önbaxış əldə edilə bilmədi: ' + err.message);
      }
    }

    async function optimizeTitle() {
      if (!currentMetadata) return;
      const btn = document.getElementById('aiBtn');
      if (btn) {
        btn.innerText = 'Analiz edilir...';
        btn.disabled = true;
      }

      try {
        const res = await fetch('/api/tools/optimize-title', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ title: currentMetadata.title, description: currentMetadata.description })
        });
        const data = await res.json();

        const variants = data.variants || [{ label: 'Optimizasiya', text: data.optimizedTitle }];
        const container = document.getElementById('aiVariants');
        if (container) {
          container.innerHTML = '';
          variants.forEach((v, idx) => {
            const card = document.createElement('div');
            card.className = 'm-ai-variant-card' + (idx === 0 ? ' selected' : '');
            
            // Secure DOM construction preventing XSS
            const tagEl = document.createElement('div');
            tagEl.className = 'm-ai-variant-tag';
            tagEl.textContent = v.label || 'Optimizasiya';

            const textEl = document.createElement('div');
            textEl.className = 'm-ai-variant-text';
            textEl.textContent = v.text || '';

            card.appendChild(tagEl);
            card.appendChild(textEl);

            card.onclick = () => {
              document.querySelectorAll('.m-ai-variant-card').forEach(c => c.classList.remove('selected'));
              card.classList.add('selected');
              const pTitle = document.getElementById('pTitle');
              if (pTitle) pTitle.innerText = v.text || '';
            };
            container.appendChild(card);
          });
        }

        if (variants[0]) {
          const pTitle = document.getElementById('pTitle');
          if (pTitle) pTitle.innerText = variants[0].text;
        }
      } catch (err) {
        alert('Başlıq optimizasiyası zamanı xəta baş verdi: ' + err.message);
      } finally {
        if (btn) {
          btn.innerText = 'Yenidən Perspektiv Tərtib Et';
          btn.disabled = false;
        }
      }
    }

    // CSP-compliant event bindings
    document.addEventListener('DOMContentLoaded', () => {
      const fetchBtn = document.getElementById('fetchPreviewBtn');
      if (fetchBtn) {
        fetchBtn.addEventListener('click', fetchPreview);
      }

      const urlInput = document.getElementById('urlInput');
      if (urlInput) {
        urlInput.addEventListener('keydown', (e) => {
          if (e.key === 'Enter') {
            e.preventDefault();
            fetchPreview();
          }
        });
      }

      const aiBtn = document.getElementById('aiBtn');
      if (aiBtn) {
        aiBtn.addEventListener('click', optimizeTitle);
      }

      document.querySelectorAll('.m-platform-tab').forEach(btn => {
        btn.addEventListener('click', function() {
          setPlatform(this.getAttribute('data-platform'), this);
        });
      });
    });
  </script>
</body>
</html>