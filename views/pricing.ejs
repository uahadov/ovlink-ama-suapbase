<!doctype html>
<html lang="<%= (seo && seo.lang) ? seo.lang : 'en' %>">

<head>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=<%= (typeof assetVersion !== 'undefined' ? assetVersion : '1') %>" />
  <link rel="icon" href="/favicon.ico?v=<%= (typeof assetVersion !== 'undefined' ? assetVersion : '1') %>" />
  <link rel="apple-touch-icon" href="/logo.png?v=<%= (typeof assetVersion !== 'undefined' ? assetVersion : '1') %>" />
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="csrf-token" content="<%= csrfToken %>">
  <title><%= (seo && seo.title) ? seo.title : 'Ovlink Pro Pricing' %></title>
  
  <link rel="manifest" href="/site.webmanifest" />

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin>
  <link rel="preload" href="/vendor/fontawesome/webfonts/fa-solid-900.woff2?v=<%= (typeof assetVersion !== 'undefined' ? assetVersion : '1') %>" as="font" type="font/woff2" crossorigin />
  <link rel="stylesheet" href="/vendor/fontawesome/css/all.min.css?v=<%= (typeof assetVersion !== 'undefined' ? assetVersion : '1') %>" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" integrity="sha512-iecdLmaskl7CVkqkXNQ/ZH/XLlvWZOJyj7Yy7tcenmpD1ypASozpmT/E0iPtmFIB46ZmdtAc9eNBvH0H/ZpiBw==" crossorigin="anonymous" referrerpolicy="no-referrer" />

  <link rel="stylesheet" href="/home.css?v=<%= assetVersion %>" />

  <meta name="description" content="<%= (seo && seo.description) ? seo.description : '' %>" />
  <meta name="keywords" content="<%= (seo && seo.keywords) ? seo.keywords : '' %>" />
  <link rel="canonical" href="<%= (seo && seo.canonical) ? seo.canonical : '' %>" />
  <link rel="alternate" hreflang="en" href="<%= (seo && seo.hreflangEn) ? seo.hreflangEn : '' %>" />
  <link rel="alternate" hreflang="az" href="<%= (seo && seo.hreflangAz) ? seo.hreflangAz : '' %>" />
  <link rel="alternate" hreflang="tr" href="<%= (seo && seo.hreflangTr) ? seo.hreflangTr : '' %>" />
  <link rel="alternate" hreflang="x-default" href="<%= (seo && seo.hreflangXDefault) ? seo.hreflangXDefault : '' %>" />
</head>

<body class="ovx home-page pricing-page">

  <!-- Skip to content for accessibility -->
  <a href="#mainContent" class="m-skip-link" data-i18n="skip_to_content">Skip to content</a>

  <!-- Ambient background glow -->
  <div id="cursorGlow" aria-hidden="true"></div>

  <% if (siteSettings && siteSettings.announcement_enabled === '1' && (siteSettings.announcement_text_az || siteSettings.announcement_text_tr || siteSettings.announcement_text_en)) { %>
    <div id="siteAnnouncement" class="site-announcement" data-az="<%= siteSettings.announcement_text_az || '' %>" data-tr="<%= siteSettings.announcement_text_tr || '' %>" data-en="<%= siteSettings.announcement_text_en || '' %>">
      <div class="shell">
        <i class="fa-solid fa-bullhorn"></i>
        <span id="siteAnnouncementText"><%= siteSettings.announcement_text_az || siteSettings.announcement_text_tr || siteSettings.announcement_text_en %></span>
      </div>
    </div>
  <% } %>

  <%- include('partials/home-navbar') %>

  <main class="m-page-shell m-page-shell--top" id="mainContent">
    <div class="shell">

      <!-- Header Section -->
      <div class="text-center" style="margin-bottom: 56px;">
        <div class="m-hero-eyebrow mb-3" style="display:inline-flex; align-items:center; gap:8px; margin-bottom: 18px;">
          <i class="fa-solid fa-crown" style="font-size: 11px; color: var(--c-white);" aria-hidden="true"></i>
          <span data-i18n="pricing_badge">Ovlink Pro</span>
        </div>
        <h1 class="m-section-h2" data-i18n="pricing_title">Pro Plan Qiymətləri</h1>
        <p class="m-section-sub" style="max-width: 540px; margin: 12px auto 0;" data-i18n="pricing_intro">
          Free və Pro planları müqayisə edin və sizə uyğun variantı seçin.
        </p>
      </div>

      <!-- Pricing Cards Grid -->
      <div class="m-pricing-grid">

        <!-- Free Plan Card -->
        <article class="m-plan-card">
          <div class="m-plan-name" data-i18n="pricing_free_title">Free</div>
          <div class="m-plan-desc">Essential tools for individual short links and basic tracking.</div>
          
          <div class="m-plan-price-wrap">
            <span class="m-plan-price" data-i18n="pricing_free_price">$0 / ay</span>
          </div>

          <ul class="m-plan-features">
            <li><i class="fa-solid fa-check" aria-hidden="true"></i><span data-i18n="pricing_feature_free_1">Əsas link qısaltma</span></li>
            <li><i class="fa-solid fa-check" aria-hidden="true"></i><span data-i18n="pricing_feature_free_2">Dashboard və statistika</span></li>
            <li><i class="fa-solid fa-check" aria-hidden="true"></i><span data-i18n="pricing_feature_free_3">Şifrə, bitmə tarixi, klik limiti</span></li>
          </ul>

          <a href="<%= isLoggedIn ? '/dashboard' : '/register' %>" class="m-cta m-cta--outline m-plan-cta">
            <span data-i18n="<%= isLoggedIn ? 'nav_my_account' : 'nav_register' %>"><%= isLoggedIn ? 'Dashboard' : 'Sign up free' %></span>
          </a>
        </article>

        <!-- Pro Plan Card -->
        <article class="m-plan-card m-plan-card--pro">
          <span class="m-plan-badge" data-i18n="pricing_badge">PRO</span>
          <div class="m-plan-name" data-i18n="pricing_pro_title">Pro</div>
          <div class="m-plan-desc">Advanced scale, API integrations, webhooks, and team workspaces.</div>
          
          <div class="m-plan-price-wrap">
            <span class="m-plan-price" data-i18n="pricing_pro_price">$4.99 / ay</span>
          </div>

          <ul class="m-plan-features">
            <li><i class="fa-solid fa-check" aria-hidden="true"></i><span data-i18n="pricing_feature_pro_1">Bütün Free xüsusiyyətləri</span></li>
            <li><i class="fa-solid fa-check" aria-hidden="true"></i><span data-i18n="pricing_feature_pro_2">API key idarəetməsi</span></li>
            <li><i class="fa-solid fa-check" aria-hidden="true"></i><span data-i18n="pricing_feature_pro_3">Webhook axınları və retry logları</span></li>
            <li><i class="fa-solid fa-check" aria-hidden="true"></i><span data-i18n="pricing_feature_pro_4">Pro panel ilə inkişaf etmiş idarəetmə</span></li>
            <li><i class="fa-solid fa-check" aria-hidden="true"></i><span data-i18n="pricing_feature_pro_5">3 günlük pulsuz sınaq (Free Trial)</span></li>
          </ul>

          <p class="small text-center" style="font-size: 12.5px; color: var(--c-muted); margin-bottom: 16px;" data-i18n="pricing_manual_notice">
            3 gün pulsuz sınaqdan keçirin. İstədiyiniz an ləğv edə bilərsiniz.
          </p>

          <a id="pricingBuyBtn"
             href="<%= (typeof polarCheckoutUrl !== 'undefined' && polarCheckoutUrl) ? polarCheckoutUrl : 'https://buy.polar.sh/polar_cl_9QZbWPt4zCzplBGNFgy6xeZf9rxVICG62IIe03GpkNS' %>"
             class="m-cta m-cta--white m-plan-cta"
             data-is-logged-in="<%= isLoggedIn %>"
             data-checkout-url="<%= (typeof polarCheckoutUrl !== 'undefined' && polarCheckoutUrl) ? polarCheckoutUrl : 'https://buy.polar.sh/polar_cl_9QZbWPt4zCzplBGNFgy6xeZf9rxVICG62IIe03GpkNS' %>"
             data-i18n="pricing_buy_btn">İndi Pro-ya keç</a>
        </article>

      </div>

    </div>
  </main>

  <%- include('partials/home-footer') %>

  <script nonce="<%= nonce %>" src="/lang.js?v=<%= assetVersion %>"></script>
  <script nonce="<%= nonce %>" src="/script.js?v=<%= assetVersion %>"></script>
  <script nonce="<%= nonce %>">
    (function () {
      /* ─── Navbar dropdowns & mobile menu are managed by partials/home-navbar ─── */

      /* ─── Button ripple effect ─── */
      document.querySelectorAll('.m-cta, .m-btn-solid').forEach(function(btn) {
        btn.addEventListener('click', function(e) {
          var r = btn.getBoundingClientRect();
          var size = Math.max(r.width, r.height);
          var span = document.createElement('span');
          span.className = 'm-ripple';
          span.style.width = span.style.height = size + 'px';
          span.style.left  = (e.clientX - r.left  - size / 2) + 'px';
          span.style.top   = (e.clientY - r.top   - size / 2) + 'px';
          btn.appendChild(span);
          setTimeout(function(){ span.remove(); }, 600);
        });
      });
    })();
  </script>
</body>

</html>



