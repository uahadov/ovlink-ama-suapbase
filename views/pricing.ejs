<!doctype html>
<html lang="<%= (seo && seo.lang) ? seo.lang : 'az' %>" dir="<%= (typeof dir !== 'undefined' && dir) ? dir : 'ltr' %>">

<head>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=<%= (typeof assetVersion !== 'undefined' ? assetVersion : '1') %>" />
  <link rel="icon" href="/favicon.ico?v=<%= (typeof assetVersion !== 'undefined' ? assetVersion : '1') %>" />
  <link rel="apple-touch-icon" href="/logo.png?v=<%= (typeof assetVersion !== 'undefined' ? assetVersion : '1') %>" />
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="csrf-token" content="<%= csrfToken %>">
  <title><%= (seo && seo.title) ? seo.title : 'Ovlink — Qiymətlər' %></title>

  <link rel="manifest" href="/site.webmanifest" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="preload" href="/vendor/fontawesome/webfonts/fa-solid-900.woff2?v=<%= (typeof assetVersion !== 'undefined' ? assetVersion : '1') %>" as="font" type="font/woff2" crossorigin />
  <link rel="stylesheet" href="/vendor/fontawesome/css/all.min.css?v=<%= (typeof assetVersion !== 'undefined' ? assetVersion : '1') %>" />
  <link rel="stylesheet" href="/home.css?v=<%= assetVersion %>" />

  <meta name="description" content="<%= (seo && seo.description) ? seo.description : 'Ovlink B2B və agentlik qiymətləri — kampaniya linkləri, dinamik QR, bot filtri və müştəri portalları.' %>" />
  <meta name="keywords" content="<%= (seo && seo.keywords) ? seo.keywords : '' %>" />
  <link rel="canonical" href="<%= (seo && seo.canonical) ? seo.canonical : '' %>" />
  <link rel="alternate" hreflang="en" href="<%= (seo && seo.hreflangEn) ? seo.hreflangEn : '' %>" />
  <link rel="alternate" hreflang="az" href="<%= (seo && seo.hreflangAz) ? seo.hreflangAz : '' %>" />
  <link rel="alternate" hreflang="tr" href="<%= (seo && seo.hreflangTr) ? seo.hreflangTr : '' %>" />
  <link rel="alternate" hreflang="x-default" href="<%= (seo && seo.hreflangXDefault) ? seo.hreflangXDefault : '' %>" />

  <style>
    .ov-pricing-head {
      text-align: center;
      max-width: 640px;
      margin: 0 auto 48px;
    }
    .ov-pricing-head h1 {
      font-size: clamp(32px, 4.5vw, 48px);
      font-weight: 800;
      letter-spacing: -0.03em;
      margin: 0 0 12px;
      color: var(--c-white, #fff);
    }
    .ov-pricing-head p {
      font-size: 16px;
      line-height: 1.6;
      color: var(--c-muted, rgba(255,255,255,0.68));
      margin: 0;
    }
    .ov-free-pill {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      margin-top: 18px;
      padding: 7px 14px;
      border-radius: 999px;
      border: 1px solid rgba(255,255,255,0.14);
      background: rgba(255,255,255,0.04);
      font-size: 13px;
      color: rgba(255,255,255,0.8);
    }
    .ov-free-pill a {
      color: #fff;
      font-weight: 600;
      text-decoration: underline;
      text-underline-offset: 3px;
    }

    .ov-plans-grid {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 18px;
      align-items: stretch;
    }
    .ov-plan {
      position: relative;
      display: flex;
      flex-direction: column;
      padding: 28px 24px;
      border-radius: 16px;
      border: 1px solid rgba(255,255,255,0.1);
      background: rgba(255,255,255,0.025);
      transition: border-color 0.2s ease, transform 0.2s ease;
    }
    .ov-plan:hover {
      border-color: rgba(255,255,255,0.22);
      transform: translateY(-2px);
    }
    .ov-plan--featured {
      border-color: rgba(255,255,255,0.38);
      background: linear-gradient(180deg, rgba(255,255,255,0.07) 0%, rgba(255,255,255,0.02) 100%);
    }
    .ov-plan-tag {
      position: absolute;
      top: -11px;
      left: 24px;
      padding: 3px 10px;
      border-radius: 999px;
      background: #fff;
      color: #09090b;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.04em;
      text-transform: uppercase;
    }
    .ov-plan-title {
      font-size: 18px;
      font-weight: 700;
      color: #fff;
      margin: 0 0 6px;
    }
    .ov-plan-for {
      font-size: 13px;
      color: rgba(255,255,255,0.6);
      margin: 0 0 20px;
      min-height: 36px;
    }
    .ov-plan-price {
      display: flex;
      align-items: baseline;
      gap: 6px;
      margin-bottom: 4px;
    }
    .ov-plan-amount {
      font-size: 36px;
      font-weight: 800;
      letter-spacing: -0.03em;
      color: #fff;
      line-height: 1;
    }
    .ov-plan-period {
      font-size: 14px;
      color: rgba(255,255,255,0.55);
    }
    .ov-plan-azn {
      font-size: 12.5px;
      color: rgba(255,255,255,0.48);
      margin: 0 0 22px;
    }
    .ov-plan-list {
      list-style: none;
      padding: 0;
      margin: 0 0 26px;
      display: flex;
      flex-direction: column;
      gap: 10px;
      flex: 1;
    }
    .ov-plan-list li {
      display: flex;
      align-items: flex-start;
      gap: 9px;
      font-size: 13.5px;
      line-height: 1.45;
      color: rgba(255,255,255,0.84);
    }
    .ov-plan-list i {
      color: #4ade80;
      font-size: 12px;
      margin-top: 4px;
      flex-shrink: 0;
    }
    .ov-plan-btn {
      width: 100%;
      justify-content: center;
      text-align: center;
    }

    .ov-legal-note {
      max-width: 820px;
      margin: 28px auto 0;
      padding: 16px 20px;
      border-radius: 12px;
      border: 1px solid rgba(255,255,255,0.08);
      background: rgba(255,255,255,0.02);
      font-size: 12.5px;
      line-height: 1.6;
      color: rgba(255,255,255,0.62);
      text-align: center;
    }
    .ov-legal-note a {
      color: #93c5fd;
      text-decoration: underline;
    }

    .ov-demo-box {
      max-width: 680px;
      margin: 56px auto 0;
      padding: 32px 28px;
      border-radius: 16px;
      border: 1px solid rgba(255,255,255,0.1);
      background: rgba(255,255,255,0.02);
    }
    .ov-demo-box h2 {
      font-size: 22px;
      font-weight: 700;
      color: #fff;
      margin: 0 0 6px;
    }
    .ov-demo-box > p {
      font-size: 14px;
      color: rgba(255,255,255,0.65);
      margin: 0 0 20px;
    }
    .ov-demo-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
    }

    @media (max-width: 1060px) {
      .ov-plans-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    }
    @media (max-width: 620px) {
      .ov-plans-grid, .ov-demo-grid { grid-template-columns: 1fr; }
    }
  </style>
</head>

<body class="ovx home-page pricing-page">

  <a href="#mainContent" class="m-skip-link" data-i18n="skip_to_content">Skip to content</a>
  <div id="cursorGlow" aria-hidden="true"></div>

  <% if (siteSettings && siteSettings.announcement_enabled === '1' && (siteSettings.announcement_text_az || siteSettings.announcement_text_tr || siteSettings.announcement_text_en)) { %>
    <div id="siteAnnouncement" class="site-announcement" data-az="<%= siteSettings.announcement_text_az || '' %>" data-tr="<%= siteSettings.announcement_text_tr || '' %>" data-en="<%= siteSettings.announcement_text_en || '' %>">
      <div class="shell">
        <i class="fa-solid fa-bullhorn"></i>
        <span id="siteAnnouncementText"><%= siteSettings.announcement_text_az || siteSettings.announcement_text_tr || siteSettings.announcement_text_en %></span>
      </div>
    </div>
  <% } %>

  <%- include('partials/home-navbar') %>

  <main class="m-page-shell m-page-shell--top" id="mainContent">
    <div class="shell">

      <header class="ov-pricing-head">
        <h1>Sadə və şəffaf qiymətlər</h1>
        <p>14 gün pulsuz sınaq · İstənilən vaxt ləğv et · İllik ödənişdə 2 ay hədiyyə.</p>
        <div class="ov-free-pill">
          <span>Sadəcə fərdi test üçün?</span>
          <a href="<%= isLoggedIn ? '/dashboard' : '/register' %>"><%= isLoggedIn ? 'Panelə keç' : 'Pulsuz başla ($0)' %></a>
        </div>
      </header>

      <section class="ov-plans-grid" id="p40B2bPlans" aria-label="Ovlink Paketləri">

        <!-- Starter -->
        <article class="ov-plan">
          <h2 class="ov-plan-title">Starter</h2>
          <p class="ov-plan-for">Kiçik komandalar və yeni layihələr üçün</p>
          <div class="ov-plan-price">
            <span class="ov-plan-amount">$7</span>
            <span class="ov-plan-period">/ ay</span>
          </div>
          <p class="ov-plan-azn">təxminən 12 AZN / ay</p>
          <ul class="ov-plan-list">
            <li><i class="fa-solid fa-check" aria-hidden="true"></i><span>300K klik/ay + bot filtri</span></li>
            <li><i class="fa-solid fa-check" aria-hidden="true"></i><span>3 özəl domen · 3 nəfər</span></li>
            <li><i class="fa-solid fa-check" aria-hidden="true"></i><span>2 canlı müştəri portalı</span></li>
            <li><i class="fa-solid fa-check" aria-hidden="true"></i><span>30 A4 PDF hesabat / ay</span></li>
            <li><i class="fa-solid fa-check" aria-hidden="true"></i><span>API, Webhook və GA4</span></li>
          </ul>
          <a href="/register?intent=trial&plan=starter" class="m-cta m-cta--outline ov-plan-btn">14 gün pulsuz sına</a>
        </article>

        <!-- Business (Featured) -->
        <article class="ov-plan ov-plan--featured">
          <span class="ov-plan-tag">Ən Populyar</span>
          <h2 class="ov-plan-title">Business</h2>
          <p class="ov-plan-for">Böyüyən marketinq və SMM komandaları üçün</p>
          <div class="ov-plan-price">
            <span class="ov-plan-amount">$19</span>
            <span class="ov-plan-period">/ ay</span>
          </div>
          <p class="ov-plan-azn">təxminən 32 AZN / ay</p>
          <ul class="ov-plan-list">
            <li><i class="fa-solid fa-check" aria-hidden="true"></i><span>2M klik/ay + bot filtri</span></li>
            <li><i class="fa-solid fa-check" aria-hidden="true"></i><span>10 özəl domen · 10 nəfər</span></li>
            <li><i class="fa-solid fa-check" aria-hidden="true"></i><span>10 canlı müştəri portalı</span></li>
            <li><i class="fa-solid fa-check" aria-hidden="true"></i><span>250 planlı A4 PDF hesabat</span></li>
            <li><i class="fa-solid fa-check" aria-hidden="true"></i><span>A/B test, Konversiya API, MCP</span></li>
          </ul>
          <% if (typeof isProUser !== 'undefined' && isProUser) { %>
            <button id="proManageBtn" type="button" class="m-cta m-cta--outline ov-plan-btn" data-is-logged-in="<%= isLoggedIn %>">Abunəliyi idarə et</button>
          <% } else { %>
            <a id="pricingBuyBtn"
               href="<%= isLoggedIn ? ((typeof polarCheckoutUrl !== 'undefined' && polarCheckoutUrl) ? polarCheckoutUrl : '/register?intent=trial&plan=business') : '/register?intent=trial&plan=business' %>"
               class="m-cta m-cta--white ov-plan-btn"
               data-is-logged-in="<%= isLoggedIn %>"
               data-checkout-url="<%= (typeof polarCheckoutUrl !== 'undefined' && polarCheckoutUrl) ? polarCheckoutUrl : '' %>">14 gün pulsuz sına</a>
          <% } %>
        </article>

        <!-- Agency -->
        <article class="ov-plan">
          <h2 class="ov-plan-title">Agency</h2>
          <p class="ov-plan-for">Çoxmüştərili rəqəmsal agentliklər üçün</p>
          <div class="ov-plan-price">
            <span class="ov-plan-amount">$49</span>
            <span class="ov-plan-period">/ ay</span>
          </div>
          <p class="ov-plan-azn">təxminən 83 AZN / ay</p>
          <ul class="ov-plan-list">
            <li><i class="fa-solid fa-check" aria-hidden="true"></i><span>5M klik/ay + bot filtri</span></li>
            <li><i class="fa-solid fa-check" aria-hidden="true"></i><span>30 özəl domen · Limitsiz komanda</span></li>
            <li><i class="fa-solid fa-check" aria-hidden="true"></i><span>30 white-label müştəri portalı</span></li>
            <li><i class="fa-solid fa-check" aria-hidden="true"></i><span>500 planlı A4 PDF hesabat</span></li>
            <li><i class="fa-solid fa-check" aria-hidden="true"></i><span>Audit jurnalı və ağıllı xəbərdarlıqlar</span></li>
          </ul>
          <a href="/register?intent=trial&plan=agency" class="m-cta m-cta--outline ov-plan-btn">Agentlik sınağı</a>
        </article>

        <!-- Enterprise -->
        <article class="ov-plan">
          <h2 class="ov-plan-title">Enterprise</h2>
          <p class="ov-plan-for">Yüksək həcmli korporativ brendlər üçün</p>
          <div class="ov-plan-price">
            <span class="ov-plan-amount">$129</span>
            <span class="ov-plan-period">/ ay</span>
          </div>
          <p class="ov-plan-azn">təxminən 219 AZN / ay</p>
          <ul class="ov-plan-list">
            <li><i class="fa-solid fa-check" aria-hidden="true"></i><span>20M+ klik/ay · Xüsusi limit</span></li>
            <li><i class="fa-solid fa-check" aria-hidden="true"></i><span>100+ domen · Limitsiz komanda</span></li>
            <li><i class="fa-solid fa-check" aria-hidden="true"></i><span>250+ white-label portal</span></li>
            <li><i class="fa-solid fa-check" aria-hidden="true"></i><span>SAML SSO və xüsusi SLA (99.9%)</span></li>
            <li><i class="fa-solid fa-check" aria-hidden="true"></i><span>Birbaşa texniki dəstək</span></li>
          </ul>
          <a href="#p40DemoFormSection" class="m-cta m-cta--outline ov-plan-btn">Görüş təyin et</a>
        </article>

      </section>

      <p id="checkoutLegalDisclosure" class="ov-legal-note">
        Ödəniş və vergilər Polar.sh (Merchant of Record) tərəfindən icra olunur; abunəlik istənilən vaxt portaldan ləğv edilə bilər və mövcud linklər reklamsız işləməyə davam edir. Ödənişdən dərhal sonra xidmətin aktivləşməsinə razılıq verildiyi üçün 7 iş günlük səbəbsiz imtina hüququ tətbiq edilmir (AR Qanunu № 908-IIQ, Maddə 9.5.1). <a href="/legal/dpa">DPA</a> · <a href="/terms">Şərtlər</a>
      </p>

      <section id="p40DemoFormSection" class="ov-demo-box" aria-labelledby="p40BookHeading">
        <h2 id="p40BookHeading">Agentlik və ya Enterprise üçün canlı demo?</h2>
        <p>15 dəqiqəyə komandanız üçün nümunə müştəri portalını birlikdə quraq.</p>
        <form id="p40DemoForm" style="display:grid; gap:12px;">
          <input type="text" name="website_url" tabindex="-1" autocomplete="off" style="position:absolute;left:-9999px;width:1px;height:1px;" aria-hidden="true" />
          <div class="ov-demo-grid">
            <input type="text" name="name" required placeholder="Adınız" class="m-adv-input" aria-label="Adınız" />
            <input type="email" name="email" required placeholder="İş e-poçtu (name@agency.az)" class="m-adv-input" aria-label="E-poçt" />
          </div>
          <div class="ov-demo-grid">
            <input type="text" name="company" placeholder="Agentlik və ya şirkət adı" class="m-adv-input" aria-label="Şirkət" />
            <select name="plan_interest" class="m-adv-input" aria-label="Paket seçimi">
              <option value="starter">Starter ($7/ay)</option>
              <option value="business" selected>Business ($19/ay)</option>
              <option value="agency">Agency ($49/ay)</option>
              <option value="enterprise">Enterprise ($129/ay)</option>
            </select>
          </div>
          <label style="display:flex; align-items:flex-start; gap:8px; font-size:13px; color:rgba(255,255,255,0.75); cursor:pointer;">
            <input type="checkbox" name="consent_given" required style="margin-top:3px;" />
            <span>Demo görüşü üçün əlaqə məlumatımın emalına razıyam.</span>
          </label>
          <div style="display:flex; align-items:center; gap:14px; flex-wrap:wrap;">
            <button type="submit" class="m-cta m-cta--white" style="padding:10px 22px; font-size:13.5px;">Sorğu göndər</button>
            <span id="p40DemoStatus" role="status" style="font-size:13px; color:#4ade80;"></span>
          </div>
        </form>
      </section>

    </div>
  </main>

  <%- include('partials/home-footer') %>

  <script nonce="<%= nonce %>" src="/lang.js?v=<%= assetVersion %>"></script>
  <script nonce="<%= nonce %>" src="/script.js?v=<%= assetVersion %>"></script>
  <script nonce="<%= nonce %>">
    (function () {
      var form = document.getElementById('p40DemoForm');
      var statusEl = document.getElementById('p40DemoStatus');
      if (form) {
        form.addEventListener('submit', function (e) {
          e.preventDefault();
          var fd = new FormData(form);
          var csrf = (document.querySelector('meta[name="csrf-token"]') || {}).content || '';
          if (statusEl) statusEl.textContent = 'Göndərilir...';
          fetch('/api/public/demo-booking', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'x-csrf-token': csrf },
            body: JSON.stringify({
              website_url: fd.get('website_url') || '',
              name: fd.get('name') || '',
              email: fd.get('email') || '',
              company: fd.get('company') || '',
              plan_interest: fd.get('plan_interest') || 'business',
              consent_given: fd.get('consent_given') === 'on',
              source_cta: 'pricing_demo_form'
            })
          }).then(function (r) { return r.json().then(function (j) { return { ok: r.ok, data: j }; }); })
            .then(function (res) {
              if (res.ok && res.data && res.data.booking_ref) {
                if (statusEl) statusEl.textContent = 'Qəbul edildi! Kod: ' + res.data.booking_ref;
                form.reset();
              } else {
                if (statusEl) statusEl.textContent = 'Bütün tələb olunan xanaları doldurun.';
              }
            }).catch(function () {
              if (statusEl) statusEl.textContent = 'Şəbəkə xətası baş verdi.';
            });
        });
      }
    })();
  </script>
</body>

</html>
