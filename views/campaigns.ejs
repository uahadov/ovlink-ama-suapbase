<!DOCTYPE html>
<html lang="<%= (typeof defaultLang !== 'undefined' && defaultLang) ? defaultLang : 'az' %>" dir="<%= (typeof dir !== 'undefined' && dir) ? dir : 'ltr' %>">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="csrf-token" content="<%= csrfToken %>" />
  <meta name="robots" content="noindex,nofollow" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=<%= assetVersion %>" />
  <link rel="stylesheet" href="/home.css?v=<%= assetVersion %>" />
  <link rel="stylesheet" href="/vendor/fontawesome/css/all.min.css?v=<%= assetVersion %>" />
  <script nonce="<%= nonce %>" src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
  <script nonce="<%= nonce %>" src="/campaign-report.js?v=<%= assetVersion %>"></script>
  <title data-i18n="campaigns_title">Kampaniyalar — Ovlink</title>
  <style nonce="<%= nonce %>">
    .cp-page { min-height: 100vh; background: var(--c-bg, #0a0a0a); color: var(--c-text, #f3f4f6); padding: 32px 16px 72px; }
    .cp-shell { max-width: 1000px; margin: 0 auto; }
    .cp-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 16px; flex-wrap: wrap; margin-bottom: 8px; }
    .cp-title { font-size: 26px; font-weight: 800; letter-spacing: -0.03em; margin: 0; }
    .cp-sub { color: var(--c-muted, #a1a1aa); font-size: 13px; margin: 6px 0 22px; }
    .cp-card { border: 1px solid rgba(255,255,255,0.08); border-radius: 16px; background: rgba(255,255,255,0.02); padding: 16px; margin-bottom: 16px; }
    .cp-form { display: flex; gap: 10px; flex-wrap: wrap; align-items: center; }
    .cp-input { flex: 1 1 220px; min-width: 180px; background: #0f0f0f; border: 1px solid rgba(255,255,255,0.12); border-radius: 10px; color: inherit; padding: 11px 13px; font: inherit; font-size: 14px; }
    .cp-input:focus { outline: 2px solid rgba(255,255,255,0.22); outline-offset: 1px; }
    .cp-btn { border: 1px solid rgba(255,255,255,0.14); background: #ffffff; color: #0a0a0a; border-radius: 10px; padding: 11px 18px; font: inherit; font-size: 13px; font-weight: 700; cursor: pointer; }
    .cp-btn--ghost { background: transparent; color: inherit; }
    .cp-btn--danger { background: transparent; color: #f87171; border-color: rgba(248,113,113,0.4); }
    .cp-btn[disabled] { opacity: 0.55; cursor: not-allowed; }
    .cp-msg { font-size: 13px; margin-top: 10px; min-height: 18px; }
    .cp-msg--err { color: #f87171; }
    .cp-msg--ok { color: #34d399; }
    .cp-row { display: grid; grid-template-columns: 1.6fr repeat(4, minmax(72px, 0.7fr)) auto; gap: 10px; align-items: center; padding: 12px 4px; border-bottom: 1px solid rgba(255,255,255,0.06); }
    .cp-row:last-child { border-bottom: 0; }
    .cp-row--head { font-size: 11px; text-transform: uppercase; letter-spacing: 0.07em; color: var(--c-faint, #737373); border-bottom-color: rgba(255,255,255,0.1); }
    .cp-name { font-weight: 700; font-size: 14px; }
    .cp-slug { font-size: 11px; color: var(--c-faint, #737373); }
    .cp-num { font-variant-numeric: tabular-nums; font-size: 14px; }
    .cp-actions { display: flex; gap: 6px; justify-content: flex-end; }
    .cp-kpis { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 10px; margin-bottom: 16px; }
    .cp-kpi { border: 1px solid rgba(255,255,255,0.08); border-radius: 14px; padding: 14px; }
    .cp-kpi-k { display: block; font-size: 10px; text-transform: uppercase; letter-spacing: 0.08em; color: var(--c-faint, #737373); margin-bottom: 6px; }
    .cp-kpi-v { font-size: 22px; font-weight: 800; letter-spacing: -0.02em; }
    .cp-cols { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 14px; }
    .cp-chart { height: 220px; }
    .cp-item { display: flex; justify-content: space-between; gap: 10px; padding: 8px 0; border-bottom: 1px solid rgba(255,255,255,0.05); font-size: 13px; }
    .cp-item:last-child { border-bottom: 0; }
    .cp-sr-only { position:absolute; width:1px; height:1px; padding:0; margin:-1px; overflow:hidden; clip:rect(0,0,0,0); white-space:nowrap; border:0; }
    .cp-empty { color: var(--c-faint, #737373); font-size: 13px; }
    .cp-list-head { display:flex; align-items:center; justify-content:space-between; gap:12px; margin-bottom:14px; }
    .cp-list-head h2 { margin:0; font-size:15px; font-weight:700; }
    .cp-list-head p { margin:4px 0 0; font-size:12px; color:var(--c-muted); }
    .cp-empty-state { display:flex; flex-direction:column; justify-content:center; align-items:center; text-align:center; gap:9px; padding:36px 16px; border-radius:12px; border:1px dashed var(--c-border-hi); }
    .cp-empty-state i { font-size:23px; margin-bottom:4px; color:var(--c-text); }
    .cp-empty-state h3 { color:var(--c-text); font-size:16px; margin:0; }
    .cp-empty-state p { color:var(--c-muted); font-size:13px; margin:0 0 7px; max-width:360px; line-height:1.5; }
    .cp-btn:focus-visible { outline:2px solid var(--c-white); outline-offset:3px; }
    .cp-btn:hover:not([disabled]) { filter:brightness(0.9); }
    .cp-list-status { font-size:12px; color:var(--c-muted); min-height:18px; margin:0 0 12px; }
    .cp-list-status[data-state="error"] { color:#fca5a5; }
    @media (prefers-reduced-motion:reduce) { .cp-btn { transition:none; } }
    .cp-back { margin-bottom: 14px; }
    .cp-detail-actions { margin-bottom:14px; display:flex; flex-wrap:wrap; justify-content:space-between; gap:10px; align-items:center; }
    .cp-filter-inline { display:flex; align-items:center; gap:8px; font-size:12px; color:var(--c-muted); }
    .cp-filter-inline .cp-input { min-width:130px; flex:0 1 170px; padding:9px 10px; font-size:12px; }
    [hidden] { display: none !important; }
    .cp-head-actions { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; }
    .cw-steps { display: flex; gap: 6px; flex-wrap: wrap; margin: 12px 0; }
    .cw-step { font-size: 11px; padding: 5px 10px; border-radius: 999px; border: 1px solid rgba(255,255,255,0.12); color: var(--c-muted, #a1a1aa); }
    .cw-step--active { background: #ffffff; color: #0a0a0a; border-color: #ffffff; font-weight: 700; }
    .cw-step--done { border-color: rgba(52,211,153,0.45); color: #34d399; }
    .cw-chips { display: flex; gap: 8px; flex-wrap: wrap; }
    .cw-chip { border: 1px solid rgba(255,255,255,0.14); background: transparent; color: inherit; border-radius: 999px; padding: 7px 13px; font: inherit; font-size: 12px; cursor: pointer; text-transform: capitalize; }
    .cw-chip--on { background: #ffffff; color: #0a0a0a; border-color: #ffffff; font-weight: 700; }
    .cw-link-row { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; margin-bottom: 8px; }
    .cw-link-row select.cp-input { flex: 0 1 140px; min-width: 110px; }
    .cw-link-row input.cp-input { flex: 1 1 220px; min-width: 160px; }
    .cw-qr-toggle { display: inline-flex; align-items: center; gap: 6px; font-size: 12px; color: var(--c-muted, #a1a1aa); white-space: nowrap; }
    .cw-footer { display: flex; justify-content: space-between; align-items: center; gap: 10px; flex-wrap: wrap; margin-top: 14px; }
    .cw-autosave { font-size: 11px; color: var(--c-faint, #737373); }
    .cw-banner { display: flex; justify-content: space-between; align-items: center; gap: 10px; flex-wrap: wrap; border: 1px dashed rgba(255,255,255,0.22); border-radius: 12px; padding: 12px 14px; margin-bottom: 14px; font-size: 13px; }
    @media (max-width: 720px) {
      .cp-row { grid-template-columns: minmax(0, 1.5fr) minmax(36px, 0.6fr) minmax(36px, 0.6fr) auto; gap:6px; }
      .cp-row .cp-name,.cp-row .cp-slug { overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
      .cp-row .cp-actions .cp-btn { padding:7px 9px; min-width:30px; }
      .cp-row .cp-num { font-size:12px; }
      .cp-row > .cp-hide-sm { display: none; }
    }
  </style>
</head>
<body class="ovx">
  <a href="#mainContent" class="m-skip-link" data-i18n="skip_to_content">Skip to content</a>
  <%- include('partials/home-navbar') %>
  <%- include('partials/app-sidebar', { appNavActive: 'campaigns' }) %>
  <main class="cp-page" id="mainContent">
    <div class="cp-shell">
      <div class="cp-head">
        <div>
          <h1 class="cp-title" data-i18n="campaigns_title">Kampaniyalar</h1>
          <p class="cp-sub" data-i18n="campaigns_sub">Linkləri kampaniyalar üzrə qruplaşdırın və nəticəni bir ekranda görün.</p>
        </div>
        <div class="cp-head-actions">
          <button class="cp-btn" type="button" id="openWizardBtn">Kampaniya Wizard</button>
          <a class="cp-btn cp-btn--ghost" href="/dashboard" data-i18n="campaigns_back_dashboard">İdarə paneli</a>
        </div>
      </div>

      <div id="wizardResumeBanner" class="cw-banner" hidden role="status">
        <span id="cwResumeText">Yarımçıq kampaniya draft-ı tapıldı.</span>
        <div class="cp-head-actions">
          <button class="cp-btn" type="button" id="cwResumeBtn">Davam et</button>
          <button class="cp-btn cp-btn--ghost" type="button" id="cwDiscardBtn">Təmizlə</button>
        </div>
      </div>

      <section id="wizardSection" class="cp-card" hidden aria-label="Campaign Launch Wizard">
        <div class="cp-list-head">
          <div>
            <h2 id="cwTitle">Kampaniya Başlatma Wizard-ı</h2>
            <p id="cwSub">5 addımda səhvsiz kampaniya, UTM linklər və dinamik QR yaradın.</p>
          </div>
          <button class="cp-btn cp-btn--ghost" type="button" id="closeWizardBtn">Bağla</button>
        </div>
        <div id="cwSteps" class="cw-steps" aria-label="Wizard steps"></div>
        <p id="cwHint" class="cp-sub" style="margin:6px 0 12px;"></p>

        <div id="cwPanel1">
          <div class="cp-form">
            <input class="cp-input" id="cwName" type="text" maxlength="60" placeholder="Kampaniya adı (məs: Qış Kampaniyası)" />
            <input class="cp-input" id="cwGoal" type="text" maxlength="40" placeholder="Hədəf (məs: leads)" />
            <select class="cp-input" id="cwStatus" style="flex:0 1 130px;min-width:110px;">
              <option value="active">active</option>
              <option value="draft">draft</option>
            </select>
            <input class="cp-input" id="cwBudget" type="number" min="0" step="0.01" placeholder="Büdcə (opsional)" style="flex:0 1 150px;min-width:120px;" />
            <select class="cp-input" id="cwCurrency" style="flex:0 1 95px;min-width:85px;">
              <option value="AZN">AZN</option>
              <option value="USD">USD</option>
              <option value="EUR">EUR</option>
              <option value="TRY">TRY</option>
            </select>
          </div>
        </div>

        <div id="cwPanel2" hidden>
          <div id="cwChannelsBox" class="cw-chips"></div>
        </div>

        <div id="cwPanel3" hidden>
          <div id="cwLinksBox"></div>
          <button class="cp-btn cp-btn--ghost" type="button" id="cwAddLinkBtn">+ Link əlavə et</button>
        </div>

        <div id="cwPanel4" hidden>
          <div id="cwPreviewBox"></div>
        </div>

        <div id="cwPanel5" hidden>
          <div id="cwResultBox"></div>
        </div>

        <div class="cp-msg" id="cwMsg" role="alert"></div>
        <div class="cw-footer">
          <span class="cw-autosave" id="cwAutosave" aria-live="polite"></span>
          <div class="cp-head-actions">
            <button class="cp-btn cp-btn--ghost" type="button" id="cwPrevBtn" hidden>← Əvvəlki</button>
            <button class="cp-btn" type="button" id="cwNextBtn">Növbəti addım →</button>
          </div>
        </div>
      </section>

      <section class="cp-card" aria-label="New campaign">
        <form class="cp-form" id="createForm" autocomplete="off">
          <label for="campaignName" class="cp-sr-only" data-i18n="campaigns_name_label">Kampaniya adı</label>
          <input class="cp-input" id="campaignName" type="text" maxlength="60" required
                 placeholder="Kampaniya adı (məs: Yay Satışı)" data-i18n-placeholder="campaigns_name_placeholder" />
          <label for="campaignGoal" class="cp-sr-only" data-i18n="campaigns_goal_label">Konversiya hədəfi</label>
          <input class="cp-input" id="campaignGoal" type="text" maxlength="40"
                 placeholder="Konversiya hədəfi (məs: signup)" data-i18n-placeholder="campaigns_goal_placeholder" />
          <label for="campaignWorkspace" class="cp-sr-only" data-i18n="campaigns_workspace_label">Kampaniya sahəsi</label>
          <select class="cp-input" id="campaignWorkspace" style="flex:1 1 170px;min-width:150px;">
            <option value="" data-i18n="campaigns_personal_scope">Şəxsi kampaniya</option>
          </select>
          <button class="cp-btn" type="submit" id="createBtn" data-i18n="campaigns_create">Yarat</button>
        </form>
        <div class="cp-msg" id="createMsg" role="status"></div>
      </section>

      <section id="listSection" class="cp-card" aria-label="Campaigns">
        <div class="cp-list-head">
          <div><h2 data-i18n="campaigns_list_title">Kampaniyalarım</h2><p data-i18n="campaigns_period">Son 30 günün nəticələri</p></div>
          <button class="cp-btn cp-btn--ghost" id="campaignRefresh" type="button"><i class="fa-solid fa-rotate" aria-hidden="true"></i> <span data-i18n="campaigns_refresh">Yenilə</span></button>
        </div>
        <div id="campaignListStatus" class="cp-list-status" role="status" aria-live="polite"></div>
        <div class="cp-row cp-row--head">
          <span data-i18n="campaigns_col_name">Kampaniya</span>
          <span data-i18n="campaigns_col_links">Link</span>
          <span data-i18n="campaigns_col_clicks">Klik</span>
          <span class="cp-hide-sm" data-i18n="campaigns_col_uniques">Unikal</span>
          <span class="cp-hide-sm" data-i18n="campaigns_col_conversions">Konv.</span>
          <span></span>
        </div>
        <div id="campaignList"><div class="cp-empty" data-i18n="campaigns_loading">Kampaniyalar yüklənir…</div></div>
      </section>

      <section id="detailSection" class="cp-card" hidden aria-label="Campaign detail">
        <div class="cp-detail-actions">
          <button class="cp-btn cp-btn--ghost" type="button" id="backBtn" data-i18n="campaigns_back">← Geri</button>
          <label class="cp-filter-inline" for="campaignBotFilter">
            <span data-i18n="campaigns_bot_filter_label">Klik filtri</span>
            <select class="cp-input" id="campaignBotFilter">
              <option value="include" data-i18n="campaigns_all_clicks">Bütün kliklər</option>
              <option value="exclude" data-i18n="campaigns_human_clicks">Botlar xaric</option>
            </select>
          </label>
          <button class="cp-btn cp-btn--ghost" type="button" id="campaignExportCsv" disabled><i class="fa-solid fa-file-csv" aria-hidden="true"></i> <span data-i18n="campaigns_export_csv">CSV hesabatı endir</span></button>
        </div>
        <h2 class="cp-title" id="detailName" style="font-size:20px;margin-bottom:2px;">—</h2>
        <p class="cp-sub" id="detailMeta" style="margin-bottom:16px;"></p>
        <p class="cp-sub" id="detailFreshness" role="status" style="margin-top:0;"></p>

        <div class="cp-kpis">
          <div class="cp-kpi"><span class="cp-kpi-k" data-i18n="campaigns_kpi_clicks">Klik</span><span class="cp-kpi-v" id="kClicks">0</span></div>
          <div class="cp-kpi"><span class="cp-kpi-k" data-i18n="campaigns_kpi_uniques">Unikal</span><span class="cp-kpi-v" id="kUniques">0</span></div>
          <div class="cp-kpi"><span class="cp-kpi-k" data-i18n="campaigns_kpi_conversions">Konversiya</span><span class="cp-kpi-v" id="kConversions">0</span></div>
          <div class="cp-kpi"><span class="cp-kpi-k" data-i18n="campaigns_kpi_rate">Konversiya faizi</span><span class="cp-kpi-v" id="kRate">0%</span></div>
        </div>

        <!-- Campaign goals (target vs actual) -->
        <div class="cp-card" style="padding:12px;margin-bottom:14px;">
          <div style="display:flex;gap:10px;flex-wrap:wrap;align-items:flex-end;">
            <label style="display:flex;flex-direction:column;gap:6px;font-size:12px;">
              <span data-i18n="campaigns_goal_clicks">Klik hədəfi</span>
              <input class="cp-input" id="goalClicksInput" type="number" min="0" step="1" style="min-width:130px;" placeholder="1000">
            </label>
            <label style="display:flex;flex-direction:column;gap:6px;font-size:12px;">
              <span data-i18n="campaigns_goal_conversions">Konversiya hədəfi</span>
              <input class="cp-input" id="goalConversionsInput" type="number" min="0" step="1" style="min-width:130px;" placeholder="50">
            </label>
            <button class="cp-btn" type="button" id="goalSaveBtn" data-i18n="campaigns_goal_save">Hədəfi saxla</button>
            <span class="cp-msg" id="goalMsg" style="font-size:12.5px;"></span>
          </div>
          <div id="detailGoals" style="margin-top:12px;display:flex;flex-direction:column;gap:8px;"></div>
        </div>

        <div class="cp-card" style="padding:12px;">
          <div class="cp-chart"><canvas id="campaignChart"></canvas></div>
        </div>

        <div class="cp-cols">
          <div class="cp-card">
            <h3 class="cp-kpi-k" data-i18n="campaigns_top_links">Top linklər</h3>
            <div id="topLinks"><div class="cp-empty">—</div></div>
          </div>
          <div class="cp-card">
            <h3 class="cp-kpi-k" data-i18n="campaigns_sources">Mənbələr</h3>
            <div id="topSources"><div class="cp-empty">—</div></div>
          </div>
          <div class="cp-card">
            <h3 class="cp-kpi-k" data-i18n="campaigns_goals">Hədəflər</h3>
            <div id="topGoals"><div class="cp-empty">—</div></div>
          </div>
        </div>
      </section>
    </div>
  </main>

  <script nonce="<%= nonce %>" src="/campaigns-page.js?v=<%= assetVersion %>"></script>
  <script nonce="<%= nonce %>" src="/campaigns-wizard.js?v=<%= assetVersion %>"></script>
</body>
</html>
