<!doctype html>
<html lang="<%= (seo && seo.lang) ? seo.lang : 'en' %>">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="csrf-token" content="<%= csrfToken %>">
  <title><%= (seo && seo.title) ? seo.title : 'Ovlink' %></title>
  <link rel="icon" href="/logo.ico" />
  <link rel="manifest" href="/site.webmanifest" />
  <link rel="preload" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" as="style" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" media="print" id="bs-css" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap" media="print" id="gf-css" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" media="print" id="fa-css" />
  <script nonce="<%= nonce %>">
    var bs = document.getElementById("bs-css"); if (bs) bs.media = "all";
    var mc = document.getElementById("main-css"); if (mc) mc.media = "all";
    var gf = document.getElementById("gf-css"); if (gf) gf.media = "all";
    document.getElementById("fa-css").media = "all";
  </script>
  <noscript>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
  </noscript>
  
  <link rel="stylesheet" href="/style.css?v=<%= assetVersion %>" media="print" id="main-css" />
  <meta name="description" content="<%= (seo && seo.description) ? seo.description : '' %>" />
  <meta name="keywords" content="<%= (seo && seo.keywords) ? seo.keywords : '' %>" />
  <link rel="canonical" href="<%= (seo && seo.canonical) ? seo.canonical : '' %>" />
  <link rel="alternate" hreflang="en" href="<%= (seo && seo.hreflangEn) ? seo.hreflangEn : '' %>" />
  <link rel="alternate" hreflang="az" href="<%= (seo && seo.hreflangAz) ? seo.hreflangAz : '' %>" />
  <link rel="alternate" hreflang="tr" href="<%= (seo && seo.hreflangTr) ? seo.hreflangTr : '' %>" />
  <link rel="alternate" hreflang="x-default" href="<%= (seo && seo.hreflangXDefault) ? seo.hreflangXDefault : '' %>" />
  <meta property="og:title" content="<%= (seo && seo.ogTitle) ? seo.ogTitle : '' %>" />
  <meta property="og:description" content="<%= (seo && seo.ogDescription) ? seo.ogDescription : '' %>" />
  <meta property="og:url" content="<%= (seo && seo.ogUrl) ? seo.ogUrl : '' %>" />
  <meta property="og:type" content="website" />
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content="<%= (seo && seo.twitterTitle) ? seo.twitterTitle : '' %>" />
  <meta name="twitter:description" content="<%= (seo && seo.twitterDescription) ? seo.twitterDescription : '' %>" />
  <% if (seo && seo.jsonLd) { %>
  <script nonce="<%= nonce %>" type="application/ld+json"><%- seo.jsonLd %></script>
  <% } %>
</head>

<body class="home-page policy-page animated-gradient-bg">

  <% if (siteSettings && siteSettings.announcement_enabled === '1' && (siteSettings.announcement_text_az || siteSettings.announcement_text_tr || siteSettings.announcement_text_en)) { %>
    <div id="siteAnnouncement" class="site-announcement" data-az="<%= siteSettings.announcement_text_az || '' %>" data-tr="<%= siteSettings.announcement_text_tr || '' %>" data-en="<%= siteSettings.announcement_text_en || '' %>">
      <div class="container">
        <i class="fa-solid fa-bullhorn"></i>
        <span id="siteAnnouncementText"><%= siteSettings.announcement_text_az || siteSettings.announcement_text_tr || siteSettings.announcement_text_en %></span>
      </div>
    </div>
  <% } %>

  <div id="particlesContainer" class="particles-container"></div>

  <%- include('partials/public-navbar') %>

  <main class="policy-main">
    <section class="container">
      <div class="policy-shell">
        <div class="policy-head">
          <div class="badge hero-chip rounded-pill px-3 py-2 mb-3 shadow-sm fw-semibold">
            <i class="fa-solid fa-link me-1"></i><span data-i18n="hero_badge">Ovlink - Next-Gen Link Management</span>
          </div>
          <h1 class="policy-title" data-i18n="abuse_page_title">Abuse &amp; Safety</h1>
        </div>

        <div class="policy-list">
          <article class="policy-card">
            <h3 class="fw-bold"><i class="fa-solid fa-shield-halved me-2"></i><span data-i18n="abuse_position_title">Təhlükəsizlik mövqeyimiz</span></h3>
            <p data-i18n="abuse_position_text">Ovlink legitim link paylaşımı üçündür. Sui-istifadəyə icazə verilmir.</p>
          </article>

          <article class="policy-card">
            <h3 class="fw-bold"><i class="fa-solid fa-ban me-2"></i><span data-i18n="abuse_prohibited_title">Qadağan istifadələr</span></h3>
            <ul>
              <li data-i18n="abuse_prohibited_item1">Phishing və hesab ələ keçirmə cəhdləri</li>
              <li data-i18n="abuse_prohibited_item2">Zərərli proqram/ransomware yayımı</li>
              <li data-i18n="abuse_prohibited_item3">Fırıldaqçılıq kampaniyaları</li>
              <li data-i18n="abuse_prohibited_item4">Saxta şəxsiyyət və aldadıcı yönləndirmə</li>
              <li data-i18n="abuse_prohibited_item5">Qanunsuz məzmun yayımı</li>
              <li data-i18n="abuse_prohibited_item6">Spam və zərərli avtomatlaşdırma</li>
            </ul>
          </article>

          <article class="policy-card">
            <h3 class="fw-bold"><i class="fa-solid fa-flag me-2"></i><span data-i18n="abuse_report_title">Şikayət necə göndərilir</span></h3>
            <p data-i18n="abuse_report_text">Qısa link və səbəbi report axınında göndərin. Əlavə kontekst yoxlamanı sürətləndirir. Dəstək üçün /contact səhifəsindən də yaza bilərsiniz.</p>
          </article>

          <article class="policy-card">
            <h3 class="fw-bold"><i class="fa-solid fa-scale-balanced me-2"></i><span data-i18n="abuse_actions_title">Mümkün icra tədbirləri</span></h3>
            <ul>
              <li data-i18n="abuse_actions_item1">Müvəqqəti və ya daimi link deaktivasiyası</li>
              <li data-i18n="abuse_actions_item2">Hesab məhdudlaşdırılması/suspend</li>
              <li data-i18n="abuse_actions_item3">Zərurət olduqda domen səviyyəsində bloklama</li>
            </ul>
          </article>

          <article class="policy-card">
            <h3 class="fw-bold"><i class="fa-solid fa-robot me-2"></i><span data-i18n="abuse_system_title">Avtomatik Təhlükəsizlik Sistemləri</span></h3>
            <p data-i18n="abuse_system_text">Platformamız sui-istifadəni avtomatik aşkar etmək və qarşısını almaq üçün nəzərdə tutulmuşdur. Bir link 4 və ya daha çox şikayət (report) alarsa, sistem onu avtomatik olaraq 'təhlükəli' kimi işarələyir və zövq alıcılarını xəbərdarlıq səhifəsi ilə məlumatlandırır. Həmçinin qadağan olunmuş zərərli domenlərin linklərə əlavə edilməsi verilənlər bazası tərəfindən birbaşa bloklanır. Xidməti qorumaq üçün API və sistem üzrə sərt sorğu limitləri (rate limits) tətbiq olunur.</p>
          </article>

          <article class="policy-card">
            <h3 class="fw-bold"><i class="fa-solid fa-landmark me-2"></i><span data-i18n="abuse_lawful_title">Qanuni sorğular</span></h3>
            <p data-i18n="abuse_lawful_text">Qanuni əsaslı sorğulara cavab verilə bilər və yalnız qanunun tələb etdiyi minimum məlumat təqdim edilir.</p>
          </article>

          <article class="policy-card">
            <h3 class="fw-bold"><i class="fa-solid fa-user-shield me-2"></i><span data-i18n="abuse_tips_title">İstifadəçi təhlükəsizlik tövsiyələri</span></h3>
            <ul>
              <li data-i18n="abuse_tips_item1">Paylaşmadan əvvəl hədəfi yoxlayın.</li>
              <li data-i18n="abuse_tips_item2">Naməlum mənbələrə ehtiyatla yanaşın.</li>
              <li data-i18n="abuse_tips_item3">Şübhəli fəaliyyəti dərhal şikayət edin.</li>
            </ul>
          </article>
        </div>

        <div class="policy-back">
          <a href="/" class="btn home-outline-btn rounded-pill" data-i18n="nav_home">Ana Səhifə</a>
        </div>
      </div>
    </section>
  </main>

  <%- include('partials/public-footer', { footerClass: 'site-footer' }) %>

  <script nonce="<%= nonce %>" defer src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script nonce="<%= nonce %>" src="/lang.js?v=<%= assetVersion %>"></script>
  <script nonce="<%= nonce %>" src="/script.js?v=<%= assetVersion %>"></script>
</body>

</html>



