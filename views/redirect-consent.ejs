<!doctype html>
<html lang="en">
<head>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=<%= (typeof assetVersion !== 'undefined' ? assetVersion : '1') %>" />
  <link rel="icon" href="/favicon.ico?v=<%= (typeof assetVersion !== 'undefined' ? assetVersion : '1') %>" />
  <link rel="apple-touch-icon" href="/logo.png?v=<%= (typeof assetVersion !== 'undefined' ? assetVersion : '1') %>" />
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="csrf-token" content="<%= csrfToken %>">
  <title data-i18n="consent_gate_title">Redirect consent - Ovlink</title>
  
  <link rel="manifest" href="/site.webmanifest" />

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin>
  <link rel="preload" href="/vendor/fontawesome/webfonts/fa-solid-900.woff2?v=<%= (typeof assetVersion !== 'undefined' ? assetVersion : '1') %>" as="font" type="font/woff2" crossorigin />
  <link rel="stylesheet" href="/vendor/fontawesome/css/all.min.css?v=<%= (typeof assetVersion !== 'undefined' ? assetVersion : '1') %>" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" integrity="sha512-iecdLmaskl7CVkqkXNQ/ZH/XLlvWZOJyj7Yy7tcenmpD1ypASozpmT/E0iPtmFIB46ZmdtAc9eNBvH0H/ZpiBw==" crossorigin="anonymous" referrerpolicy="no-referrer" />

  <link rel="stylesheet" href="/home.css?v=<%= assetVersion %>" />
</head>

<body class="ovx home-page consent-page">

  <!-- Skip to content for accessibility -->
  <a href="#mainContent" class="m-skip-link" data-i18n="skip_to_content">Skip to content</a>

  <!-- Ambient background glow -->
  <div id="cursorGlow" aria-hidden="true"></div>

  <% if (siteSettings && siteSettings.announcement_enabled === '1' && (siteSettings.announcement_text_az || siteSettings.announcement_text_tr || siteSettings.announcement_text_en)) { %>
    <div id="siteAnnouncement" class="site-announcement" data-az="<%= siteSettings.announcement_text_az || '' %>" data-tr="<%= siteSettings.announcement_text_tr || '' %>" data-en="<%= siteSettings.announcement_text_en || '' %>">
      <div class="shell">
        <i class="fa-solid fa-bullhorn"></i>
        <span id="siteAnnouncementText"><%= siteSettings.announcement_text_az || siteSettings.announcement_text_tr || siteSettings.announcement_text_en %></span>
      </div>
    </div>
  <% } %>

  <%- include('partials/home-navbar') %>

  <main class="m-page-shell" id="mainContent">
    <div class="shell m-gateway-wrap">
      <div class="m-gateway-card">

        <% if (consentView === 'declined') { %>
          <div class="m-icon-glyph m-icon-glyph--warning" aria-hidden="true">
            <i class="fa-solid fa-shield-halved"></i>
          </div>

          <h1 class="m-gateway-title" data-i18n="consent_gate_declined_title">Consent required</h1>
          <p class="m-gateway-sub" data-i18n="consent_gate_declined_msg">You cannot continue because you did not accept the required policies.</p>

          <div class="m-target-chip">
            <span data-i18n="consent_gate_target">Target domain:</span>
            <strong><%= targetHost %></strong>
          </div>

          <div class="m-alert-box m-alert-box--warning" data-i18n="consent_gate_declined_msg">
            You cannot continue because you did not accept the required policies.
          </div>

          <div class="m-actions-row">
            <a href="/consent/redirect/<%= encodeURIComponent(shortCode) %>?next=<%= encodeURIComponent(nextAction) %>" class="m-cta m-cta--white">
              <i class="fa-solid fa-arrow-left" aria-hidden="true"></i>
              <span data-i18n="consent_gate_go_back">Go Back</span>
            </a>
            <a href="/" class="m-cta m-cta--outline">
              <i class="fa-solid fa-house" aria-hidden="true"></i>
              <span data-i18n="nav_home">Ana Səhifə</span>
            </a>
          </div>

        <% } else { %>
          <div class="m-icon-glyph" aria-hidden="true">
            <i class="fa-solid fa-shield-halved"></i>
          </div>

          <h1 class="m-gateway-title" data-i18n="consent_gate_title">Redirect consent</h1>
          <p class="m-gateway-sub" data-i18n="consent_gate_subtitle">Please review and choose before continuing.</p>

          <div class="m-target-chip">
            <span data-i18n="consent_gate_target">Target domain:</span>
            <strong><%= targetHost %></strong>
          </div>

          <div class="m-legal-note">
            <span data-i18n="consent_gate_legal_prefix">By continuing, you accept our</span>
            <a href="/privacy" data-i18n="privacy_policy">Privacy Policy</a>,
            <a href="/cookie-policy" data-i18n="cookie_policy">Cookie Policy</a>
            <span data-i18n="consent_gate_legal_and">and</span>
            <a href="/terms" data-i18n="terms_policy">Terms of Service</a>.
          </div>

          <div class="m-actions-row">
            <button type="button" id="consentContinueBtn" class="m-cta m-cta--white">
              <i class="fa-solid fa-check" aria-hidden="true"></i>
              <span data-i18n="consent_gate_yes">YES (Continue)</span>
            </button>

            <button type="button" id="consentDeclineBtn" class="m-cta m-cta--outline">
              <i class="fa-solid fa-xmark" aria-hidden="true"></i>
              <span data-i18n="consent_gate_no">NO (Decline)</span>
            </button>
          </div>
        <% } %>

      </div>
    </div>
  </main>

  <%- include('partials/home-footer') %>

  <script nonce="<%= nonce %>" src="/lang.js?v=<%= assetVersion %>"></script>
  <script nonce="<%= nonce %>" src="/script.js?v=<%= assetVersion %>"></script>
  <script nonce="<%= nonce %>">
    (function () {
      /* ─── Navbar dropdowns & mobile menu are managed by partials/home-navbar ─── */

      /* ─── Button ripple effect ─── */
      document.querySelectorAll('.m-cta, .m-btn-solid').forEach(function(btn) {
        btn.addEventListener('click', function(e) {
          var r = btn.getBoundingClientRect();
          var size = Math.max(r.width, r.height);
          var span = document.createElement('span');
          span.className = 'm-ripple';
          span.style.width = span.style.height = size + 'px';
          span.style.left  = (e.clientX - r.left  - size / 2) + 'px';
          span.style.top   = (e.clientY - r.top   - size / 2) + 'px';
          btn.appendChild(span);
          setTimeout(function(){ span.remove(); }, 600);
        });
      });

      /* ─── Redirect Consent Handling (Strict Safety Guard) ─── */
      var shortCode = '<%= shortCode %>';
      var consentUrl = '/consent/redirect/' + encodeURIComponent(shortCode);
      var csrfToken = '<%= csrfToken %>';
      var nextAction = '<%= nextAction %>';
      var continueBtn = document.getElementById('consentContinueBtn');
      var declineBtn = document.getElementById('consentDeclineBtn');

      function submitConsent(decision) {
        var body = new URLSearchParams();
        body.append('_csrf', csrfToken);
        body.append('next', nextAction);
        body.append('decision', decision);

        fetch(consentUrl, {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: body.toString(),
          redirect: 'manual'
        }).then(function (resp) {
          if (decision === 'no') {
            window.location.href = consentUrl + '?view=declined';
            return;
          }
          // Decision is 'continue'
          var targetPath = nextAction === 'proceed'
            ? '/proceed/' + encodeURIComponent(shortCode)
            : '/' + encodeURIComponent(shortCode);
          window.location.href = targetPath;
        }).catch(function () {
          // If network fails or fetch errors:
          // CRITICAL: NEVER navigate to destination on decline!
          if (decision === 'no') {
            window.location.href = consentUrl + '?view=declined';
          } else {
            window.location.href = '/' + encodeURIComponent(shortCode);
          }
        });
      }

      if (continueBtn) {
        continueBtn.addEventListener('click', function () {
          continueBtn.disabled = true;
          if (declineBtn) declineBtn.disabled = true;
          submitConsent('continue');
        });
      }

      if (declineBtn) {
        declineBtn.addEventListener('click', function () {
          declineBtn.disabled = true;
          if (continueBtn) continueBtn.disabled = true;
          submitConsent('no');
        });
      }
    })();
  </script>
</body>
</html>