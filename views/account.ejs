  <!-- 2FA & Email Change Logic (Preserved and Refined) -->
  <script nonce="<%= nonce %>">
    (function () {
      var msgEl = document.getElementById('securityMessage');
      if (!msgEl) return;
      var showMsg = function (text, ok) {
        msgEl.className = 'small mt-2 ' + (ok ? 'text-success' : 'text-danger');
        msgEl.textContent = text || '';
      };
      var tr = function (az, en, trText) {
        var lang = (typeof currentLang !== 'undefined' && currentLang) || 'az';
        return lang === 'az' ? az : (lang === 'en' ? en : trText);
      };

      // --- 2FA ---
      var statusEl = document.getElementById('twofaStatus');
      var setupBtn = document.getElementById('twofaSetupBtn');
      var setupWrap = document.getElementById('twofaSetupWrap');
      var disableWrap = document.getElementById('twofaDisableWrap');

      function render2faState(enabled) {
        if (!statusEl) return;
        statusEl.removeAttribute('data-i18n');
        if (enabled) {
          statusEl.textContent = tr('2FA aktivdir. ✅', '2FA is enabled. ✅', '2FA etkin. ✅');
          if (disableWrap) disableWrap.classList.remove('d-none');
          if (setupBtn) setupBtn.classList.add('d-none');
          if (setupWrap) setupWrap.classList.add('d-none');
        } else {
          statusEl.textContent = tr('2FA deaktivdir. Hesabınızı daha da qorumaq üçün aktivləşdirin.', '2FA is disabled. Enable it to protect your account further.', '2FA devre dışı. Hesabınızı daha da korumak için etkinleştirin.');
          if (setupBtn) setupBtn.classList.remove('d-none');
          if (disableWrap) disableWrap.classList.add('d-none');
        }
      }

      fetch('/api/me', { credentials: 'include' })
        .then(function (res) { return res.json(); })
        .then(function (data) { render2faState(!!(data && data.user && data.user.twofaEnabled)); })
        .catch(function () { render2faState(false); });

      if (setupBtn) {
        setupBtn.addEventListener('click', function () {
          if (typeof postJsonWithCsrf !== 'function') return;
          postJsonWithCsrf('/api/user/2fa/setup', {})
            .then(function (res) { return res.json(); })
            .then(function (data) {
              if (!data || !data.otpauthUrl) {
                showMsg((data && data.error) || tr('Xəta baş verdi.', 'An error occurred.', 'Hata oluştu.'), false);
                return;
              }
              var otpEl = document.getElementById('twofaOtpauth');
              if (otpEl) otpEl.textContent = data.otpauthUrl;
              var qrEl = document.getElementById('twofaQr');
              if (qrEl && data.qr) qrEl.src = data.qr;
              if (setupWrap) setupWrap.classList.remove('d-none');
              showMsg(tr('Tətbiqə skan edin və kodu daxil edin.', 'Scan with an authenticator app and enter the code.', 'Uygulamayla tarayın ve kodu girin.'), true);
            })
            .catch(function () { showMsg(tr('Xəta baş verdi.', 'An error occurred.', 'Hata oluştu.'), false); });
        });
      }

      var enableBtn = document.getElementById('twofaEnableBtn');
      if (enableBtn) {
        enableBtn.addEventListener('click', function () {
          var codeEl = document.getElementById('twofaEnableCode');
          if (!codeEl || typeof postJsonWithCsrf !== 'function') return;
          postJsonWithCsrf('/api/user/2fa/enable', { code: codeEl.value.trim() })
            .then(function (res) { return res.json().then(function (d) { return { ok: res.ok, d: d }; }); })
            .then(function (r) {
              if (r.ok) { render2faState(true); showMsg(r.d.message, true); }
              else showMsg(r.d.error, false);
            })
            .catch(function () { showMsg(tr('Xəta baş verdi.', 'An error occurred.', 'Hata oluştu.'), false); });
        });
      }

      var disableBtn = document.getElementById('twofaDisableBtn');
      if (disableBtn) {
        disableBtn.addEventListener('click', function () {
          var passEl = document.getElementById('twofaDisablePassword');
          var codeEl = document.getElementById('twofaDisableCode');
          if (!passEl || !codeEl || typeof postJsonWithCsrf !== 'function') return;
          postJsonWithCsrf('/api/user/2fa/disable', {
            password: passEl.value,
            code: codeEl.value.trim()
          })
            .then(function (res) { return res.json().then(function (d) { return { ok: res.ok, d: d }; }); })
            .then(function (r) {
              if (r.ok) { render2faState(false); showMsg(r.d.message, true); }
              else showMsg(r.d.error, false);
            })
            .catch(function () { showMsg(tr('Xəta baş verdi.', 'An error occurred.', 'Hata oluştu.'), false); });
        });
      }

      // --- Email change ---
      var emailChangeBtn = document.getElementById('emailChangeBtn');
      var emailConfirmWrap = document.getElementById('emailConfirmWrap');
      if (emailChangeBtn) {
        emailChangeBtn.addEventListener('click', function () {
          var newEmailEl = document.getElementById('newEmailInput');
          var passEl = document.getElementById('emailChangePassword');
          if (!newEmailEl || !passEl || typeof postJsonWithCsrf !== 'function') return;
          emailChangeBtn.disabled = true;
          postJsonWithCsrf('/api/user/email/change', {
            new_email: newEmailEl.value.trim(),
            current_password: passEl.value
          })
            .then(function (res) { return res.json().then(function (d) { return { ok: res.ok, d: d }; }); })
            .then(function (r) {
              emailChangeBtn.disabled = false;
              if (r.ok) {
                if (emailConfirmWrap) {
                  emailConfirmWrap.classList.remove('d-none');
                  emailConfirmWrap.style.display = 'flex';
                }
                showMsg(r.d.message, true);
              } else {
                showMsg(r.d.error, false);
              }
            })
            .catch(function () {
              emailChangeBtn.disabled = false;
              showMsg(tr('Xəta baş verdi.', 'An error occurred.', 'Hata oluştu.'), false);
            });
        });
      }

      var emailConfirmBtn = document.getElementById('emailConfirmBtn');
      if (emailConfirmBtn) {
        emailConfirmBtn.addEventListener('click', function () {
          var codeEl = document.getElementById('emailConfirmCode');
          if (!codeEl || typeof postJsonWithCsrf !== 'function') return;
          postJsonWithCsrf('/api/user/email/confirm', { code: codeEl.value.trim() })
            .then(function (res) { return res.json().then(function (d) { return { ok: res.ok, d: d }; }); })
            .then(function (r) {
              if (r.ok) {
                showMsg(r.d.message, true);
                if (emailConfirmWrap) emailConfirmWrap.classList.add('d-none');
                var profileEmail = document.getElementById('profileEmail');
                if (profileEmail && r.d.email) profileEmail.value = r.d.email;
              } else {
                showMsg(r.d.error, false);
              }
            })
            .catch(function () { showMsg(tr('Xəta baş verdi.', 'An error occurred.', 'Hata oluştu.'), false); });
        });
      }
    })();
  </script>

  <!-- Monolith Motion & Interaction Engine -->
  <script nonce="<%= nonce %>">
  (function(){
    var isMobile = !matchMedia('(hover:hover)').matches;

    /* ─── 1. Custom Cursor ─── */
    var arrow = document.getElementById('mCursorArrow');
    var ring  = document.getElementById('mCursorRing');
    if (arrow && ring && !isMobile) {
      var mx = -100, my = -100, rx = -100, ry = -100;
      var rafId = null;
      function loop(){
        rx += (mx - rx) * 0.15;
        ry += (my - ry) * 0.15;
        ring.style.transform = 'translate(' + rx + 'px,' + ry + 'px) translate(-50%,-50%)';
        if (Math.abs(mx - rx) > 0.1 || Math.abs(my - ry) > 0.1) {
          rafId = requestAnimationFrame(loop);
        } else {
          rx = mx; ry = my;
          ring.style.transform = 'translate(' + rx + 'px,' + ry + 'px) translate(-50%,-50%)';
          rafId = null;
        }
      }
      function updatePos(e){
        mx = e.clientX; my = e.clientY;
        arrow.style.transform = 'translate(' + mx + 'px,' + my + 'px)';
        if (!rafId) rafId = requestAnimationFrame(loop);
      }
      window.addEventListener('mousemove', updatePos, {passive:true});
      window.addEventListener('pointermove', updatePos, {passive:true});
      document.addEventListener('mouseover', function(e){
        var interactive = e.target && e.target.closest && e.target.closest('a,button,input,textarea,select,label,[role="button"],summary');
        if (interactive) {
          arrow.classList.add('hover');
          ring.classList.add('hover');
        } else {
          arrow.classList.remove('hover');
          ring.classList.remove('hover');
        }
      }, {passive:true});
      document.addEventListener('mousedown', function(){
        arrow.classList.add('clicking');
        ring.classList.add('clicking');
      });
      document.addEventListener('mouseup', function(){
        arrow.classList.remove('clicking');
        ring.classList.remove('clicking');
      });
      document.addEventListener('mouseleave', function(){
        arrow.classList.add('hidden');
        ring.classList.add('hidden');
      });
      document.addEventListener('mouseenter', function(){
        arrow.classList.remove('hidden');
        ring.classList.remove('hidden');
      });
    } else {
      if (arrow) arrow.style.display = 'none';
      if (ring)  ring.style.display  = 'none';
    }

    /* ─── 2. Cursor Glow ─── */
    var glow = document.getElementById('cursorGlow');
    if (glow && !isMobile) {
      document.addEventListener('mousemove', function(e){
        glow.style.left = e.clientX + 'px';
        glow.style.top  = e.clientY + 'px';
      }, {passive:true});
    } else if (glow) {
      glow.style.display = 'none';
    }

    /* ─── 3. Scroll Progress Bar ─── */
    var sbFill = document.getElementById('mScrollBar-fill');
    if (sbFill) {
      window.addEventListener('scroll', function(){
        var h = document.documentElement;
        var pct = (h.scrollTop || document.body.scrollTop) / (h.scrollHeight - h.clientHeight) * 100;
        sbFill.style.width = pct + '%';
      }, {passive:true});
    }

    /* ─── 4. Nav scroll class ─── */
    var nav = document.getElementById('mNav');
    if (nav) {
      var onScroll = function(){ nav.classList.toggle('scrolled', window.scrollY > 10); };
      window.addEventListener('scroll', onScroll, {passive:true});
      onScroll();
    }

    /* ─── 5. Ripple Effect ─── */
    function addRipple(btn) {
      btn.addEventListener('click', function(e){
        var r = btn.getBoundingClientRect();
        var size = Math.max(r.width, r.height);
        var span = document.createElement('span');
        span.className = 'm-ripple';
        span.style.width = span.style.height = size + 'px';
        span.style.left  = (e.clientX - r.left  - size / 2) + 'px';
        span.style.top   = (e.clientY - r.top   - size / 2) + 'px';
        btn.appendChild(span);
        setTimeout(function(){ span.remove(); }, 600);
      });
    }
    document.querySelectorAll('.m-cta, .m-btn-solid').forEach(addRipple);

    /* ─── 6. Mobile Menu & Dropdowns ─── */
    function setupDropdown(btnId, panelId) {
      var btn = document.getElementById(btnId);
      var panel = document.getElementById(panelId);
      if(!btn || !panel) return;
      btn.addEventListener('click', function(e) {
        e.stopPropagation();
        var isExpanded = btn.getAttribute('aria-expanded') === 'true';
        document.querySelectorAll('.m-lang-panel, .m-user-panel, .m-ws-panel').forEach(function(p) { p.classList.remove('open', 'is-open'); });
        document.querySelectorAll('.m-lang-btn, .m-user-btn, .m-ws-btn').forEach(function(b) { b.setAttribute('aria-expanded', 'false'); });
        if(!isExpanded) {
          panel.classList.add('open');
          btn.setAttribute('aria-expanded', 'true');
        }
      });
    }
    setupDropdown('langToggleBtn', 'ovxLangPanel');
    setupDropdown('langToggleBtnMobile', 'ovxLangPanelMobile');
    setupDropdown('navUserMenuBtn', 'ovxUserPanel');
    document.addEventListener('click', function() {
      document.querySelectorAll('.m-lang-panel, .m-user-panel, .m-ws-panel').forEach(function(p) { p.classList.remove('open', 'is-open'); });
      document.querySelectorAll('.m-lang-btn, .m-user-btn, .m-ws-btn').forEach(function(b) { b.setAttribute('aria-expanded', 'false'); });
    });

    var burger = document.getElementById('mBurger');
    var mobileMenu = document.getElementById('mMobileMenu');
    var mClose = document.getElementById('mMobileClose');
    function closeMobileMenu() {
      if (mobileMenu && mobileMenu.classList.contains('open')) {
        mobileMenu.classList.remove('open');
        document.body.style.overflow = '';
        if (burger) burger.setAttribute('aria-expanded', 'false');
      }
    }
    if (burger && mobileMenu) {
      burger.addEventListener('click', function(){
        mobileMenu.classList.add('open');
        document.body.style.overflow = 'hidden';
        burger.setAttribute('aria-expanded', 'true');
      });
    }
    if (mClose) mClose.addEventListener('click', closeMobileMenu);
    document.addEventListener('keydown', function(e){
      if (e.key === 'Escape') closeMobileMenu();
    });

    /* ─── 7. Announcement Ribbon i18n ─── */
    var ribbon = document.getElementById('siteAnnouncement');
    if (ribbon) {
      var savedLang = (function(){ try { return localStorage.getItem('lang') || 'az'; } catch(_){ return 'az'; } })();
      var t = ribbon.dataset[savedLang] || ribbon.dataset.az || ribbon.dataset.tr || ribbon.dataset.en;
      var ael = document.getElementById('siteAnnouncementText');
      if (ael && t) ael.textContent = t;
      document.body.classList.add('has-ribbon');
    }
  })();
  </script>
</body>

