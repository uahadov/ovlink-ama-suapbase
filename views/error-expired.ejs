<!doctype html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="csrf-token" content="<%= csrfToken %>">
  <title data-i18n="error_expired_title">Vaxtı Bitib</title>
  <link rel="icon" href="/logo.ico" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
  <link rel="stylesheet" href="/style.css?v=<%= assetVersion %>" media="print" id="main-css" />
</head>

<body class="bg-light d-flex flex-column min-vh-100">

  <% if (siteSettings && siteSettings.announcement_enabled === '1' && (siteSettings.announcement_text_az || siteSettings.announcement_text_tr || siteSettings.announcement_text_en)) { %>
    <div id="siteAnnouncement" class="site-announcement" data-az="<%= siteSettings.announcement_text_az || '' %>" data-tr="<%= siteSettings.announcement_text_tr || '' %>" data-en="<%= siteSettings.announcement_text_en || '' %>">
      <div class="container">
        <i class="fa-solid fa-bullhorn"></i>
        <span id="siteAnnouncementText"><%= siteSettings.announcement_text_az || siteSettings.announcement_text_tr || siteSettings.announcement_text_en %></span>
      </div>
    </div>
  <% } %>

  <main class="flex-grow-1 d-flex align-items-center justify-content-center py-5">
    <div class="container text-center">
      <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
          <div class="card border-0 shadow-lg p-5 rounded-5" style="background: rgba(255, 255, 255, 0.9); backdrop-filter: blur(10px);">
            <div class="mb-4">
              <i class="fa-solid fa-hourglass-end fa-4x text-secondary mb-3"></i>
              <h2 class="fw-bold" data-i18n="error_expired_title">Vaxtı Bitib</h2>
              <p class="text-muted mb-0" data-i18n="error_expired_msg">Bu linkin istifadə müddəti bitib.</p>
            </div>

            <a href="/" class="btn btn-primary rounded-pill px-4 mt-4">
              <i class="fa-solid fa-house me-2"></i> <span data-i18n="nav_home">Ana Səhifə</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </main>

  <%- include('partials/public-footer', { footerClass: 'site-footer mt-auto' }) %>

  <script nonce="<%= nonce %>" src="/lang.js?v=<%= assetVersion %>"></script>
  <script nonce="<%= nonce %>" src="/script.js?v=<%= assetVersion %>"></script>
</body>

</html>

