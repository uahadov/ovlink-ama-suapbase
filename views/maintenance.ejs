<!doctype html>
<html lang="en">

<head>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=<%= (typeof assetVersion !== 'undefined' ? assetVersion : '1') %>" />
  <link rel="icon" href="/favicon.ico?v=<%= (typeof assetVersion !== 'undefined' ? assetVersion : '1') %>" />
  <link rel="apple-touch-icon" href="/logo.png?v=<%= (typeof assetVersion !== 'undefined' ? assetVersion : '1') %>" />

  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="csrf-token" content="<%= (typeof csrfToken !== 'undefined') ? csrfToken : '' %>">
  <title data-i18n="maintenance_title">Planlaşdırılmış Texniki Xidmət - Ovlink</title>
  
  <link rel="manifest" href="/site.webmanifest" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="preload" href="/vendor/fontawesome/webfonts/fa-solid-900.woff2?v=<%= (typeof assetVersion !== 'undefined' ? assetVersion : '1') %>" as="font" type="font/woff2" crossorigin />
  <link rel="stylesheet" href="/vendor/fontawesome/css/all.min.css?v=<%= (typeof assetVersion !== 'undefined' ? assetVersion : '1') %>" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" integrity="sha512-iecdLmaskl7CVkqkXNQ/ZH/XLlvWZOJyj7Yy7tcenmpD1ypASozpmT/E0iPtmFIB46ZmdtAc9eNBvH0H/ZpiBw==" crossorigin="anonymous" referrerpolicy="no-referrer" />
  
  <link rel="stylesheet" href="/home.css?v=<%= (typeof assetVersion !== 'undefined') ? assetVersion : '1' %>" />
</head>

<body class="ovx home-page maintenance-page">

  <!-- Ambient Cursor Glow -->
  <div id="cursorGlow" aria-hidden="true"></div>

  <!-- Minimal Brand Header with Language Switcher -->
  <header class="m-minimal-nav">
    <a href="/" class="m-brand" aria-label="Ovlink Homepage" style="display:flex; align-items:center; gap:10px; text-decoration:none;">
      <img src="/home-logo.svg?v=<%= (typeof assetVersion !== 'undefined' ? assetVersion : '1') %>" alt="Ovlink" width="28" height="28" style="border-radius:6px;" data-fallback="/logo.webp">
      <span style="font-weight:700; font-size:16px; color:var(--c-white); letter-spacing:-0.02em;">Ovlink</span>
    </a>

    <!-- Language Dropdown -->
    <div class="m-nav-actions" style="display:flex; align-items:center; gap:8px;">
      <div class="m-lang-picker" style="position:relative;">
        <button id="langToggleBtn" type="button" class="m-btn m-btn-ghost" style="padding:6px 14px; font-size:12.5px; font-weight:700;" aria-label="Dil seçimi">
          AZ
        </button>
        <div id="langDropdown" class="m-lang-menu" style="display:none; position:absolute; right:0; top:calc(100% + 6px); background:#111; border:1px solid var(--c-border); border-radius:10px; padding:6px; z-index:100; min-width:90px; box-shadow:0 8px 24px rgba(0,0,0,0.6);">
          <button class="m-lang-opt lang-option" data-lang="az" type="button" style="display:block; width:100%; text-align:left; background:none; border:none; color:var(--c-white); padding:6px 10px; font-size:12px; border-radius:6px; cursor:pointer;">Azərbaycan</button>
          <button class="m-lang-opt lang-option" data-lang="tr" type="button" style="display:block; width:100%; text-align:left; background:none; border:none; color:var(--c-white); padding:6px 10px; font-size:12px; border-radius:6px; cursor:pointer;">Türkçe</button>
          <button class="m-lang-opt lang-option" data-lang="en" type="button" style="display:block; width:100%; text-align:left; background:none; border:none; color:var(--c-white); padding:6px 10px; font-size:12px; border-radius:6px; cursor:pointer;">English</button>
        </div>
      </div>
    </div>
  </header>

  <main class="m-page-shell" style="display:flex; align-items:center; justify-content:center; padding: 40px 16px 80px 16px;">
    <div class="shell" style="max-width: 620px; width: 100%;">

      <div class="m-gateway-card m-gateway-card--warning">

        <!-- Animated Meshed Gears & Core SVG -->
        <div class="m-gateway-svg-wrap" aria-hidden="true" style="width:110px; height:110px; margin-bottom:18px;">
          <svg width="110" height="110" viewBox="0 0 110 110" fill="none" xmlns="http://www.w3.org/2000/svg">
            <defs>
              <linearGradient id="gearAmberGrad" x1="0" y1="0" x2="110" y2="110" gradientUnits="userSpaceOnUse">
                <stop stop-color="#fbbf24"/>
                <stop offset="1" stop-color="#b45309"/>
              </linearGradient>
            </defs>

            <!-- Main Clockwise Planetary Gear -->
            <g class="m-anim-gear-cw" style="transform-origin: 48px 48px;">
              <circle cx="48" cy="48" r="32" stroke="rgba(251, 191, 36, 0.4)" stroke-width="3" fill="none" stroke-dasharray="8 6"/>
              <circle cx="48" cy="48" r="22" stroke="rgba(255, 255, 255, 0.15)" stroke-width="1.5" fill="#141414"/>
            </g>

            <!-- Counter-Clockwise Secondary Gear -->
            <g class="m-anim-gear-ccw" style="transform-origin: 84px 84px;">
              <circle cx="84" cy="84" r="18" stroke="rgba(251, 191, 36, 0.3)" stroke-width="2.5" fill="none" stroke-dasharray="6 4"/>
              <circle cx="84" cy="84" r="10" fill="#141414"/>
            </g>

            <!-- Pulsing CPU Power Core -->
            <g class="m-anim-core" style="transform-origin: 48px 48px;">
              <circle cx="48" cy="48" r="10" fill="url(#gearAmberGrad)"/>
              <circle cx="48" cy="48" r="4" fill="#ffffff"/>
            </g>
          </svg>
        </div>

        <!-- Status Badge -->
        <div>
          <div class="m-gateway-badge m-gateway-badge--amber">
            <span class="m-live-dot" style="background:#fbbf24;" aria-hidden="true"></span>
            <span data-i18n="maintenance_status">SİSTEM YENİLƏNMƏSİ DAVAM EDİR</span>
          </div>
        </div>

        <!-- Title & Subtitle -->
        <h1 class="m-gateway-title" data-i18n="maintenance_title">Planlaşdırılmış Texniki Xidmət</h1>
        <p class="m-gateway-desc" data-i18n="maintenance_msg">Platformamız infrastruktur yeniləmələri və təhlükəsizlik optimizasiyaları üçün müvəqqəti olaraq texniki xidmət rejimindədir.</p>

        <!-- Real-Time Operator Announcement Box -->
        <div class="m-gateway-diag-box" style="margin-bottom: 28px;">
          <div style="display:flex; align-items:center; gap:8px; margin-bottom:8px; color:var(--c-white); font-weight:700; font-size:13px;">
            <i class="fa-solid fa-bullhorn" style="color:#fbbf24;"></i>
            <span data-i18n="maintenance_info">Sistem Bildirişi</span>
          </div>
          <div style="font-size:13.5px; color:var(--c-muted); line-height:1.55;">
            <span id="maintenanceMessage" data-az="<%= typeof maintenanceMessageAz !== 'undefined' ? (maintenanceMessageAz || '') : '' %>" data-tr="<%= typeof maintenanceMessageTr !== 'undefined' ? (maintenanceMessageTr || '') : '' %>" data-en="<%= typeof maintenanceMessageEn !== 'undefined' ? (maintenanceMessageEn || '') : '' %>"></span>
          </div>
        </div>

        <!-- Action Row -->
        <div style="display:flex; justify-content:center; gap:12px; flex-wrap:wrap;">
          <button type="button" onclick="window.location.reload();" class="m-btn m-btn-solid" style="display:inline-flex; align-items:center; gap:8px; padding: 12px 24px; border-radius: 999px; cursor:pointer;">
            <i class="fa-solid fa-rotate-right"></i>
            <span data-i18n="maintenance_refresh">Yenilə</span>
          </button>
          <a href="/" class="m-btn m-btn-ghost" style="display:inline-flex; align-items:center; gap:8px; padding: 12px 22px; border-radius: 999px; text-decoration:none;">
            <i class="fa-solid fa-house"></i>
            <span data-i18n="maintenance_home">Ana Səhifə</span>
          </a>
        </div>

      </div>

    </div>
  </main>

  <footer style="text-align:center; padding:24px 16px; border-top:1px solid var(--c-border); color:var(--c-faint); font-size:12.5px;">
    <span>&copy; <%= new Date().getFullYear() %> Ovlink Edge Core. All rights reserved.</span>
  </footer>

  <script <% if (typeof nonce !== 'undefined' && nonce) { %>nonce="<%= nonce %>"<% } %> src="/lang.js?v=<%= (typeof assetVersion !== 'undefined') ? assetVersion : '1' %>"></script>
  <script <% if (typeof nonce !== 'undefined' && nonce) { %>nonce="<%= nonce %>"<% } %> src="/home.js?v=<%= (typeof assetVersion !== 'undefined') ? assetVersion : '1' %>"></script>
  <script <% if (typeof nonce !== 'undefined' && nonce) { %>nonce="<%= nonce %>"<% } %> src="/script.js?v=<%= (typeof assetVersion !== 'undefined') ? assetVersion : '1' %>"></script>
  <script <% if (typeof nonce !== 'undefined' && nonce) { %>nonce="<%= nonce %>"<% } %>>
    window.addEventListener('DOMContentLoaded', function () {
      if (typeof applyLanguage === 'function') {
        applyLanguage();
      }
      var msgEl = document.getElementById('maintenanceMessage');
      if (msgEl) {
        var az = msgEl.getAttribute('data-az') || '';
        var tr = msgEl.getAttribute('data-tr') || '';
        var en = msgEl.getAttribute('data-en') || '';
        var lang = (typeof currentLang === 'string') ? currentLang : 'az';
        var text = (lang === 'tr' ? (tr || az || en) : (lang === 'en' ? (en || az || tr) : (az || tr || en)));
        var fallback = (lang === 'tr' ? 'Bakım çalışması devam ediyor.' : (lang === 'en' ? 'Maintenance is in progress.' : 'Texniki xidmət davam edir.'));
        msgEl.textContent = text || fallback;
      }
    });
  </script>
</body>

</html>





