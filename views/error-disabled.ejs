<!doctype html>
<html lang="en">

<head>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=<%= (typeof assetVersion !== 'undefined' ? assetVersion : '1') %>" />
  <link rel="icon" href="/favicon.ico?v=<%= (typeof assetVersion !== 'undefined' ? assetVersion : '1') %>" />
  <link rel="apple-touch-icon" href="/logo.png?v=<%= (typeof assetVersion !== 'undefined' ? assetVersion : '1') %>" />

  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="csrf-token" content="<%= (typeof csrfToken !== 'undefined') ? csrfToken : '' %>">
  <title data-i18n="error_disabled_title">Link Deaktivdir - Ovlink</title>
  
  <link rel="manifest" href="/site.webmanifest" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="preload" href="/vendor/fontawesome/webfonts/fa-solid-900.woff2?v=<%= (typeof assetVersion !== 'undefined' ? assetVersion : '1') %>" as="font" type="font/woff2" crossorigin />
  <link rel="stylesheet" href="/vendor/fontawesome/css/all.min.css?v=<%= (typeof assetVersion !== 'undefined' ? assetVersion : '1') %>" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" integrity="sha512-iecdLmaskl7CVkqkXNQ/ZH/XLlvWZOJyj7Yy7tcenmpD1ypASozpmT/E0iPtmFIB46ZmdtAc9eNBvH0H/ZpiBw==" crossorigin="anonymous" referrerpolicy="no-referrer" />
  
  <link rel="stylesheet" href="/home.css?v=<%= (typeof assetVersion !== 'undefined') ? assetVersion : '1' %>" />
</head>

<body class="ovx home-page error-page">

  <!-- Skip to content for accessibility -->
  <a href="#mainContent" class="m-skip-link" data-i18n="skip_to_content">Skip to content</a>

  <!-- Ambient Cursor Glow -->
  <div id="mCursorArrow" class="m-cursor-arrow" aria-hidden="true"></div>
  <div id="mCursorRing" class="m-cursor-ring" aria-hidden="true"></div>
  <div id="cursorGlow" aria-hidden="true"></div>

  <% if (typeof siteSettings !== 'undefined' && siteSettings && siteSettings.announcement_enabled === '1' && (siteSettings.announcement_text_az || siteSettings.announcement_text_tr || siteSettings.announcement_text_en)) { %>
    <div id="siteAnnouncement" class="site-announcement" data-az="<%= siteSettings.announcement_text_az || '' %>" data-tr="<%= siteSettings.announcement_text_tr || '' %>" data-en="<%= siteSettings.announcement_text_en || '' %>">
      <div class="shell">
        <i class="fa-solid fa-bullhorn"></i>
        <span id="siteAnnouncementText"><%= siteSettings.announcement_text_az || siteSettings.announcement_text_tr || siteSettings.announcement_text_en %></span>
      </div>
    </div>
  <% } %>

  <%- include('partials/home-navbar') %>

  <main class="m-page-shell" id="mainContent" style="display:flex; align-items:center; justify-content:center; padding: 40px 16px 80px 16px;">
    <div class="shell" style="max-width: 620px; width: 100%;">

      <div class="m-gateway-card m-gateway-card--threat">

        <!-- Animated Severed Link SVG with Spark Jolt -->
        <div class="m-gateway-svg-wrap" aria-hidden="true">
          <svg width="96" height="96" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
            <circle cx="50" cy="50" r="44" stroke="rgba(239,68,68,0.2)" stroke-width="1.5" fill="none"/>
            <circle cx="50" cy="50" r="34" stroke="rgba(239,68,68,0.08)" stroke-width="1" fill="rgba(239,68,68,0.03)"/>
            
            <!-- Left Link Segment -->
            <path d="M 38 42 L 30 50 C 26 54 26 60 30 64 C 34 68 40 68 44 64 L 52 56" stroke="rgba(255,255,255,0.7)" stroke-width="3.5" stroke-linecap="round"/>
            <!-- Right Link Segment -->
            <path d="M 62 58 L 70 50 C 74 46 74 40 70 36 C 66 32 60 32 56 36 L 48 44" stroke="rgba(255,255,255,0.7)" stroke-width="3.5" stroke-linecap="round"/>
            
            <!-- Spark Jolt in the center gap -->
            <g class="m-anim-spark">
              <path d="M 50 36 L 47 47 L 53 53 L 50 64" stroke="#ef4444" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
              <circle cx="50" cy="50" r="14" fill="rgba(239,68,68,0.18)" filter="blur(3px)"/>
            </g>
          </svg>
        </div>

        <!-- Status Badge -->
        <div>
          <div class="m-gateway-badge m-gateway-badge--red">
            <span class="m-live-dot" style="background:#ef4444;" aria-hidden="true"></span>
            <span data-i18n="error_disabled_status">410 · LİNK DEAKTİVDİR</span>
          </div>
        </div>

        <!-- Title & Subtitle -->
        <h1 class="m-gateway-title" data-i18n="error_disabled_title">Link Deaktivdir</h1>
        <p class="m-gateway-desc" data-i18n="error_disabled_msg">Bu qısa keçid administrator və ya sistem təhlükəsizlik qaydaları tərəfindən deaktiv edilmişdir.</p>

        <!-- Optional Reason Diagnostic Box -->
        <% if (typeof reason === 'string' && reason.trim()) { %>
          <div class="m-gateway-diag-box" style="margin-bottom: 24px; text-align: left;">
            <div class="m-diag-row">
              <span class="m-diag-label" data-i18n="error_disabled_reason">Səbəb</span>
              <span class="m-diag-val" style="color: #f87171;"><%= reason %></span>
            </div>
          </div>
        <% } %>

        <!-- Action Row -->
        <div>
          <a href="/" class="m-btn m-btn-solid" style="display:inline-flex; align-items:center; gap:8px; padding: 12px 28px; border-radius: 999px; text-decoration:none;">
            <i class="fa-solid fa-house"></i>
            <span data-i18n="error_disabled_home">Ana Səhifəyə Qayıt</span>
          </a>
        </div>

      </div>

    </div>
  </main>

  <%- include('partials/home-footer') %>

  <script nonce="<%= (typeof nonce !== 'undefined' ? nonce : '') %>" src="/lang.js?v=<%= (typeof assetVersion !== 'undefined') ? assetVersion : '1' %>"></script>
  <script nonce="<%= (typeof nonce !== 'undefined' ? nonce : '') %>" src="/script.js?v=<%= (typeof assetVersion !== 'undefined') ? assetVersion : '1' %>"></script>
  <script nonce="<%= (typeof nonce !== 'undefined' ? nonce : '') %>">
    (function () {
      document.querySelectorAll('.m-cta, .m-btn-solid').forEach(function (btn) {
        btn.addEventListener('click', function (e) {
          var r = btn.getBoundingClientRect();
          var size = Math.max(r.width, r.height);
          var span = document.createElement('span');
          span.className = 'm-ripple';
          span.style.width = span.style.height = size + 'px';
          span.style.left = (e.clientX - r.left - size / 2) + 'px';
          span.style.top = (e.clientY - r.top - size / 2) + 'px';
          btn.appendChild(span);
          setTimeout(function () { span.remove(); }, 600);
        });
      });
    })();
  </script>
</body>

</html>

