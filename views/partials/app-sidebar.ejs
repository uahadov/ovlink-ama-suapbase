<%# Unified App Left Sidebar (Dub.co / Linear style) for logged-in workspace pages %>
<% const _active = (typeof appNavActive !== 'undefined' && appNavActive) ? appNavActive : ''; %>
<style nonce="<%= (typeof nonce !== 'undefined' ? nonce : '') %>">
  .ov-app-sidebar {
    display: none;
  }
  @media (min-width: 961px) {
    body.ov-has-sidebar .m-nav {
      display: none !important;
    }
    body.ov-has-sidebar main,
    body.ov-has-sidebar .m-footer {
      margin-left: 236px !important;
      width: calc(100% - 236px) !important;
      box-sizing: border-box !important;
    }
    body.ov-has-sidebar main {
      padding-top: 32px !important;
    }
    .ov-app-sidebar {
      position: fixed;
      top: 0;
      left: 0;
      bottom: 0;
      width: 236px;
      z-index: 900;
      display: flex;
      flex-direction: column;
      background: #0b0b0d;
      border-right: 1px solid rgba(255, 255, 255, 0.08);
      padding: 20px 14px 16px;
      box-sizing: border-box;
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
    }
    .ov-sb-brand {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 6px 10px 18px;
      margin-bottom: 10px;
      border-bottom: 1px solid rgba(255, 255, 255, 0.07);
      text-decoration: none;
      color: #ffffff;
    }
    .ov-sb-brand img {
      width: 26px;
      height: 26px;
      border-radius: 7px;
      display: block;
    }
    .ov-sb-brand-name {
      font-size: 16px;
      font-weight: 800;
      letter-spacing: -0.02em;
      color: #ffffff;
    }
    .ov-sb-group {
      display: flex;
      flex-direction: column;
      gap: 3px;
    }
    .ov-sb-label {
      font-size: 11px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: rgba(255, 255, 255, 0.36);
      padding: 12px 10px 6px;
    }
    .ov-sb-link {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 9px 11px;
      border-radius: 9px;
      font-size: 13.5px;
      font-weight: 500;
      color: rgba(255, 255, 255, 0.7);
      text-decoration: none;
      transition: background 0.15s ease, color 0.15s ease;
      border: 1px solid transparent;
      background: transparent;
      cursor: pointer;
      width: 100%;
      text-align: left;
      font-family: inherit;
    }
    .ov-sb-link i {
      width: 16px;
      text-align: center;
      font-size: 13.5px;
      opacity: 0.78;
    }
    .ov-sb-link:hover {
      background: rgba(255, 255, 255, 0.06);
      color: #ffffff;
    }
    .ov-sb-link.is-active {
      background: rgba(255, 255, 255, 0.1);
      border-color: rgba(255, 255, 255, 0.12);
      color: #ffffff;
      font-weight: 600;
    }
    .ov-sb-link.is-active i {
      opacity: 1;
      color: #60a5fa;
    }
    .ov-sb-spacer {
      flex: 1;
    }
    .ov-sb-foot {
      padding-top: 12px;
      border-top: 1px solid rgba(255, 255, 255, 0.07);
      display: flex;
      flex-direction: column;
      gap: 3px;
    }
    .ov-sb-link--danger:hover {
      background: rgba(239, 68, 68, 0.12);
      color: #fca5a5;
    }
  }
</style>

<aside class="ov-app-sidebar" aria-label="Ovlink tətbiq menyusu">
  <a href="/" class="ov-sb-brand">
    <img src="/home-logo.svg" alt="Ovlink" width="26" height="26" />
    <span class="ov-sb-brand-name">Ovlink</span>
  </a>

  <nav class="ov-sb-group" aria-label="Əsas bölmələr">
    <a href="/dashboard" class="ov-sb-link <%= _active === 'dashboard' ? 'is-active' : '' %>">
      <i class="fa-solid fa-link" aria-hidden="true"></i>
      <span>Linklər</span>
    </a>
    <a href="/dashboard#qrCodesSection" class="ov-sb-link">
      <i class="fa-solid fa-qrcode" aria-hidden="true"></i>
      <span>QR Kodlar</span>
    </a>
    <a href="/campaigns" class="ov-sb-link <%= _active === 'campaigns' ? 'is-active' : '' %>">
      <i class="fa-solid fa-bullhorn" aria-hidden="true"></i>
      <span>Kampaniyalar</span>
    </a>
    <a href="/workspaces" class="ov-sb-link <%= _active === 'workspaces' ? 'is-active' : '' %>">
      <i class="fa-solid fa-users" aria-hidden="true"></i>
      <span>İş Sahələri</span>
    </a>
  </nav>

  <div class="ov-sb-label">İdarəetmə</div>
  <nav class="ov-sb-group" aria-label="İdarəetmə bölmələri">
    <a href="/notifications" class="ov-sb-link <%= _active === 'notifications' ? 'is-active' : '' %>">
      <i class="fa-regular fa-bell" aria-hidden="true"></i>
      <span>Bildirişlər</span>
    </a>
    <a href="/account" class="ov-sb-link <%= _active === 'account' ? 'is-active' : '' %>">
      <i class="fa-solid fa-sliders" aria-hidden="true"></i>
      <span>Hesab &amp; Domenlər</span>
    </a>
    <a href="/pricing" class="ov-sb-link">
      <i class="fa-solid fa-layer-group" aria-hidden="true"></i>
      <span>Paketlər</span>
    </a>
  </nav>

  <div class="ov-sb-spacer"></div>

  <div class="ov-sb-foot">
    <button type="button" id="ovSidebarLogoutBtn" class="ov-sb-link ov-sb-link--danger">
      <i class="fa-solid fa-right-from-bracket" aria-hidden="true"></i>
      <span>Çıxış</span>
    </button>
  </div>
</aside>

<script nonce="<%= (typeof nonce !== 'undefined' ? nonce : '') %>">
  (function () {
    document.body.classList.add('ov-has-sidebar');
    var btn = document.getElementById('ovSidebarLogoutBtn');
    if (btn) {
      btn.addEventListener('click', function () {
        var navOut = document.getElementById('navLogoutBtn');
        if (navOut) { navOut.click(); return; }
        var csrf = (document.querySelector('meta[name="csrf-token"]') || {}).content || '';
        fetch('/api/user/logout', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'x-csrf-token': csrf }
        }).finally(function () { window.location.href = '/login'; });
      });
    }
  })();
</script>
