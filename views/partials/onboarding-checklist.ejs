<%
  const ob = (typeof onboarding !== 'undefined' && onboarding) ? onboarding : null;
  // The route computes visibility in src/lib/onboarding-state.js; the guard is
  // repeated here so a stale include can never render an empty panel.
  const showOnboarding = !!(ob && ob.visible);
  const steps = (ob && Array.isArray(ob.steps)) ? ob.steps : [];
  const completedSteps = steps.filter((step) => step.done).length;
  const progressPercent = steps.length ? Math.round(completedSteps * 100 / steps.length) : 0;
  const onboardLocale = (typeof uiLang !== 'undefined' && ['az', 'tr', 'en'].includes(uiLang)) ? uiLang : 'az';
  const onboardCopy = {
    az: { link: ['İlk linkinizi yaradın', 'Link yarat'], qr: ['QR kod hazırlayın', 'QR bölməsi'], click: ['İlk kliki izləyin', 'Statistika'] },
    tr: { link: ['İlk bağlantınızı oluşturun', 'Bağlantı oluştur'], qr: ['QR kod hazırlayın', 'QR bölümü'], click: ['İlk tıklamayı izleyin', 'İstatistikler'] },
    en: { link: ['Create your first link', 'Create link'], qr: ['Create a QR code', 'QR codes'], click: ['Track your first click', 'Statistics'] },
  };

%>
<% if (showOnboarding) { %>
<section class="m-bento-card u-mb-5" id="onboardingChecklist" aria-labelledby="onboardTitle">
  <div class="u-w-full">
    <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:12px;">
      <div>
        <h2 id="onboardTitle" style="margin:0 0 4px;font-size:16px;font-weight:700;color:#fff;" data-i18n="onboard_title">İlk addımlar</h2>
        <p class="u-text-sm" style="margin:0;color:var(--c-muted,#a3a3a3);" data-i18n="onboard_subtitle">Hesabınızı 3 addımda qurun.</p>
      </div>
      <button type="button" id="onboardDismissBtn"
        aria-label="Bağla" data-i18n-aria="onboard_dismiss"
        style="background:transparent;border:0;color:var(--c-muted,#a3a3a3);font-size:20px;line-height:1;cursor:pointer;padding:4px 8px;">
        <i class="fa-solid fa-xmark" aria-hidden="true"></i>
      </button>
    </div>
    <div class="m-onboard-progress-head">
      <span data-i18n="onboard_progress">Tamamlanma</span>
      <span><%= completedSteps %>/<%= steps.length %></span>
    </div>
    <div class="m-onboard-progress" role="progressbar" aria-label="Onboarding progress" data-i18n-aria="onboard_progress" aria-valuenow="<%= completedSteps %>" aria-valuemin="0" aria-valuemax="<%= steps.length %>">
      <span class="m-onboard-progress-fill" style="width:<%= progressPercent %>%"></span>
    </div>
    <ol class="m-onboard-steps">
      <% steps.forEach((step) => { %>
      <li class="m-onboard-step <%= step.done ? 'is-done' : '' %>">
        <i class="fa-solid <%= step.done ? 'fa-circle-check' : 'fa-circle' %>"
           style="color:<%= step.done ? '#22c55e' : '#52525b' %>;" aria-hidden="true"></i>
        <span class="u-text-sm" style="color:<%= step.done ? '#a3a3a3' : '#f5f5f5' %>;"
              data-i18n="<%= step.i18nKey %>"><%= (onboardCopy[onboardLocale][step.key] || ['',''])[0] %></span>
        <% if (!step.done) { %>
        <a class="m-onboard-step-link u-text-xs" href="<%= step.href %>" data-i18n="<%= step.ctaKey %>"><%= (onboardCopy[onboardLocale][step.key] || ['',''])[1] %></a>
        <% } %>
      </li>
      <% }); %>
    </ol>
  </div>
</section>
<script nonce="<%= (typeof nonce !== 'undefined' ? nonce : '') %>">
(function () {
  var btn = document.getElementById('onboardDismissBtn');
  var panel = document.getElementById('onboardingChecklist');
  if (!btn || !panel) return;
  btn.addEventListener('click', function () {
    panel.setAttribute('hidden', 'hidden');
    var meta = document.querySelector('meta[name="csrf-token"]');
    var token = meta ? meta.getAttribute('content') : '';
    fetch('/api/user/onboarding-dismiss', {
      method: 'POST',
      headers: { 'content-type': 'application/json', 'x-csrf-token': token },
      body: '{}'
    }).catch(function () {});
  });
})();
</script>
<% } %>
