<%- include('partials/layout-top', {
  title: 'Admin · Auth Logs',
  heading: 'Admin Authentication Logs',
  subtitle: 'Login attempts and outcomes',
  active: 'auth-logs',
  admin,
  csrfToken,
  topRightHtml: null,
}) %>

<div class="card">
  <% if (error) { %>
    <div class="alert alert--error"><%= error %></div>
    <div class="spacer"></div>
  <% } %>

  <% if (!rows || rows.length === 0) { %>
    <div class="alert">No admin auth logs yet.</div>
  <% } else { %>
    <div class="table-wrap">
      <table class="table">
        <thead>
          <tr>
            <th>Time</th>
            <th>Event</th>
            <th>Identifier</th>
            <th>IP</th>
            <th>Country</th>
            <th>User Agent</th>
          </tr>
        </thead>
        <tbody>
          <% rows.forEach((r) => { %>
            <tr>
              <td><%= r.created_at ? new Date(r.created_at).toLocaleString() : '-' %></td>
              <td><span class="kbd"><%= r.event_type %></span></td>
              <td><%= r.email_or_username || '' %></td>
              <td><%= r.ip_address || '' %></td>
              <td><%= r.country_display || '-' %></td>
              <td><div class="cell-url"><%= (r.user_agent || '').slice(0, 220) %></div></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>

<%- include('partials/layout-bottom') %>
