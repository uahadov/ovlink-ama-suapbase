<%- include('partials/layout-top', {
  title: 'Admin · Auth Logs',
  heading: 'Authentication Telemetry Logs',
  subtitle: 'Staff sign-in attempts, integrity audits, WebRTC IP leakage checks, and hardware fingerprints',
  active: 'auth-logs',
  admin,
  csrfToken,
  topRightHtml: null,
}) %>

<% if (error) { %>
  <div class="alert alert--danger" style="margin-bottom: 20px;">
    <i class="fa-solid fa-triangle-exclamation"></i>
    <span><%= error %></span>
  </div>
<% } %>

<div class="m-card" style="padding: 0; overflow: hidden;">
  <div class="m-dash-panel-header" style="padding: 20px 24px; border-bottom: 1px solid var(--c-border); margin-bottom: 0;">
    <h3 class="m-dash-panel-title">
      <i class="fa-solid fa-shield-halved" style="color: var(--c-muted);"></i>
      <span>Console Access Attempts</span>
    </h3>
    <span class="badge"><%= (rows && rows.length) || 0 %> Logged Attempts</span>
  </div>

  <% if (!rows || rows.length === 0) { %>
    <div style="text-align: center; padding: 48px 20px; color: var(--c-faint);">
      <div style="font-size: 14px;">No admin authentication logs recorded yet.</div>
    </div>
  <% } else { %>
    <div class="m-table-wrap" style="border: none; border-radius: 0;">
      <table class="m-table">
        <thead>
          <tr>
            <th>Timestamp</th>
            <th>Outcome</th>
            <th>Claimed Identity</th>
            <th>Network IP & WebRTC</th>
            <th>Geo Location</th>
            <th>Security Telemetry</th>
            <th>User Agent</th>
          </tr>
        </thead>
        <tbody>
          <% rows.forEach((r) => { %>
            <tr>
              <td style="white-space: nowrap; font-size: 12px; color: var(--c-muted); font-family: var(--font-mono);">
                <%= r.created_at ? new Date(r.created_at).toLocaleString() : '-' %>
              </td>
              <td>
                <span class="kbd"><%= r.event_type %></span>
              </td>
              <td>
                <span style="font-weight: 600; font-size: 12.5px; color: var(--c-white);"><%= r.email_or_username || 'Anonymous' %></span>
              </td>
              <td>
                <div style="font-family: var(--font-mono); font-size: 12px; color: var(--c-text);"><%= r.ip_address || '-' %></div>
                <% if (r.telemetry && r.telemetry.webrtcIps && r.telemetry.webrtcIps.length > 0) { %>
                  <div style="color: #fde68a; font-size: 10.5px; font-family: var(--font-mono); margin-top: 2px;">
                    <i class="fa-solid fa-triangle-exclamation" style="font-size: 9px;"></i> WebRTC: <%= r.telemetry.webrtcIps.join(', ') %>
                  </div>
                <% } %>
              </td>
              <td>
                <span style="font-size: 12px; color: var(--c-muted);"><%= r.country_display || 'Unknown' %></span>
              </td>
              <td>
                <% if (!r.telemetry) { %>
                  <span class="badge" style="font-size: 10px;">Legacy</span>
                <% } else if (r.telemetry.is_anomaly) { %>
                  <span class="pill pill--danger" style="font-size: 10px;">
                    <i class="fa-solid fa-triangle-exclamation" style="font-size: 8px;"></i> Anomaly
                  </span>
                  <div style="font-size: 10.5px; color: #fca5a5; margin-top: 2px;">
                    <%= (r.telemetry.anomaly_reasons || []).join(', ') || 'Bypassed checks' %>
                  </div>
                <% } else { %>
                  <span class="pill pill--ok" style="font-size: 10px;">
                    <i class="fa-solid fa-check" style="font-size: 8px;"></i> Verified
                  </span>
                  <% if (r.telemetry.canvasHash) { %>
                    <div style="color: var(--c-faint); font-size: 10px; font-family: var(--font-mono); margin-top: 2px;">
                      FP: <%= r.telemetry.canvasHash.slice(0, 12) %>...
                    </div>
                  <% } %>
                <% } %>
              </td>
              <td>
                <div class="cell-url" style="max-width: 180px; font-size: 11px; font-family: var(--font-mono);" title="<%= r.user_agent || '' %>"><%= (r.user_agent || '').slice(0, 100) %></div>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>

<%- include('partials/layout-bottom') %>
