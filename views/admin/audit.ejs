<%- include('partials/layout-top', {
  title: 'Admin · Activity Audit Trail',
  heading: 'Administrative Audit Trail',
  subtitle: 'Immutable record of staff actions, moderation decisions, security events, and payload metadata',
  active: 'audit',
  admin,
  csrfToken,
  topRightHtml: null,
}) %>

<div class="m-card" style="padding: 0; overflow: hidden;">
  <div class="m-dash-panel-header" style="padding: 20px 24px; border-bottom: 1px solid var(--c-border); margin-bottom: 0;">
    <h3 class="m-dash-panel-title">
      <i class="fa-solid fa-clipboard-check" style="color: var(--c-muted);"></i>
      <span>Audit Event Ledger</span>
    </h3>
    <span class="badge"><%= total || 0 %> Total Events</span>
  </div>

  <% if (!rows || rows.length === 0) { %>
    <div style="text-align: center; padding: 48px 20px; color: var(--c-faint);">
      <div style="font-size: 14px; font-weight: 500;">No audit records available.</div>
    </div>
  <% } else { %>
    <div class="m-table-wrap" style="border: none; border-radius: 0;">
      <table class="m-table">
        <thead>
          <tr>
            <th>Event Time</th>
            <th>Staff Actor</th>
            <th>Operation</th>
            <th>Target Entity</th>
            <th>Network IP / Geo</th>
            <th>Endpoint</th>
            <th style="min-width: 280px;">Activity Summary & Payload</th>
          </tr>
        </thead>
        <tbody>
          <% rows.forEach((r) => { %>
            <% 
              const meta = (() => { try { return JSON.parse(r.metadata_json || '{}'); } catch { return {}; } })();
              const cleanMeta = { ...meta };
              delete cleanMeta._telemetry;
              delete cleanMeta._telemetry_raw;
              delete cleanMeta.path;
              delete cleanMeta.method;
              delete cleanMeta.country;
            %>
            <tr>
              <td style="white-space: nowrap;">
                <div style="font-weight: 600; font-size: 12.5px; color: var(--c-white);"><%= r.created_at ? new Date(r.created_at).toLocaleDateString() : '-' %></div>
                <div style="color: var(--c-muted); font-size: 11px; font-family: var(--font-mono); margin-top: 2px;"><%= r.created_at ? new Date(r.created_at).toLocaleTimeString() : '' %></div>
              </td>
              <td>
                <span class="pill" style="font-size: 11.5px;"><i class="fa-solid fa-user-shield" style="font-size: 9px; margin-right: 4px;"></i><%= r.admin_email || 'System' %></span>
              </td>
              <td>
                <span class="kbd"><%= r.action %></span>
              </td>
              <td>
                <span class="badge"><%= r.target_type %></span>
                <% if (r.target_id) { %>
                  <div style="font-size: 11px; font-family: var(--font-mono); color: var(--c-faint); margin-top: 2px;"><%= r.target_id %></div>
                <% } %>
              </td>
              <td>
                <div style="font-weight: 500; font-family: var(--font-mono); font-size: 12px; color: var(--c-text);"><%= r.ip || '-' %></div>
                <div style="color: var(--c-muted); font-size: 11px;"><%= meta.country || r.country_display || 'Unknown' %></div>
              </td>
              <td>
                <span class="badge" style="font-weight: 700; font-size: 10px; <%= (meta.method === 'POST' || meta.method === 'DELETE') ? 'border-color: rgba(255,255,255,0.25); color: #fff;' : '' %>"><%= meta.method || 'GET' %></span>
                <div class="cell-url" style="max-width: 140px; font-size: 11px; margin-top: 3px; font-family: var(--font-mono);"><%= meta.path || '-' %></div>
              </td>

              <!-- Details & Payload Inspection -->
              <td>
                <div style="display: flex; flex-direction: column; gap: 6px;">
                  <div style="display: flex; gap: 6px; flex-wrap: wrap;">
                    <% if (cleanMeta.reason) { %>
                      <span class="pill pill--warn" style="font-size: 11px;">Reason: <%= cleanMeta.reason %></span>
                    <% } %>
                    <% if (cleanMeta.role) { %>
                      <span class="pill" style="font-size: 11px;">Role: <%= cleanMeta.role %></span>
                    <% } %>
                    <% if (cleanMeta.email) { %>
                      <span class="pill" style="font-size: 11px;">Email: <%= cleanMeta.email %></span>
                    <% } %>
                    <% if (cleanMeta.original) { %>
                      <span class="pill" style="font-size: 11px;" title="<%= cleanMeta.original %>">URL: <%= cleanMeta.original.slice(0, 24) %>...</span>
                    <% } %>
                    <% if (cleanMeta.until) { %>
                      <span class="pill pill--danger" style="font-size: 11px;">Until: <%= cleanMeta.until %></span>
                    <% } %>
                    <% if (cleanMeta.old_tier || cleanMeta.new_tier) { %>
                      <span class="pill pill--ok" style="font-size: 11px;"><%= cleanMeta.old_tier || 'free' %> ➔ <%= cleanMeta.new_tier || 'pro' %></span>
                    <% } %>
                  </div>

                  <!-- Collapsible JSON telemetry inspector -->
                  <% if (r.metadata_json && r.metadata_json.length > 2) { %>
                    <details style="margin-top: 4px;">
                      <summary style="font-size: 11px; color: var(--c-faint); cursor: pointer; user-select: none;">
                        <i class="fa-solid fa-code" style="font-size: 10px; margin-right: 4px;"></i>Raw Payload
                      </summary>
                      <div style="margin-top: 6px; padding: 10px 12px; background: var(--c-surface-2); border: 1px solid var(--c-border); border-radius: 8px;">
                        <pre style="margin: 0; font-family: var(--font-mono); font-size: 11px; color: var(--c-muted); max-height: 140px; overflow: auto;"><%= JSON.stringify(meta, null, 2) %></pre>
                      </div>
                    </details>
                  <% } %>
                </div>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>

    <% const totalPages = Math.max(1, Math.ceil((total || 0) / pageSize)); %>
    <div class="pagination-bar">
      <div>
        <span>Page <strong style="color: var(--c-white);"><%= page %></strong> of <strong style="color: var(--c-white);"><%= totalPages %></strong></span>
      </div>
      <div class="row" style="gap: 8px;">
        <% if (page > 1) { %>
          <a class="m-cta m-cta--outline m-cta--sm" href="/admin/audit?page=<%= page - 1 %>">Previous</a>
        <% } %>
        <% if (page < totalPages) { %>
          <a class="m-cta m-cta--outline m-cta--sm" href="/admin/audit?page=<%= page + 1 %>">Next</a>
        <% } %>
      </div>
    </div>
  <% } %>
</div>

<%- include('partials/layout-bottom') %>
