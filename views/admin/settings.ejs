<%- include('partials/layout-top', {
  title: 'Admin · Platform Settings',
  heading: 'Platform Settings',
  subtitle: 'Configure emergency maintenance mode, system states, and global announcement ribbons',
  active: 'settings',
  admin,
  csrfToken,
  topRightHtml: null,
}) %>

<% if (saved) { %>
  <div class="alert alert--ok" style="margin-bottom: 20px;">
    <i class="fa-solid fa-circle-check"></i>
    <span>Settings updated and persisted successfully.</span>
  </div>
<% } %>

<% if (error) { %>
  <div class="alert alert--danger" style="margin-bottom: 20px;">
    <i class="fa-solid fa-triangle-exclamation"></i>
    <span><%= error %></span>
  </div>
<% } %>

<form method="POST" action="/admin/settings">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

  <div class="grid-2" style="margin-bottom: 24px;">
    <!-- Maintenance Mode Card -->
    <div class="m-card">
      <div class="m-dash-panel-header" style="margin-bottom: 14px;">
        <h3 class="m-dash-panel-title">
          <i class="fa-solid fa-screwdriver-wrench" style="color: var(--c-muted);"></i>
          <span>Maintenance Mode Gate</span>
        </h3>
      </div>
      <p style="color: var(--c-muted); font-size: 13px; margin: 0 0 18px; line-height: 1.5;">
        When active, all public routes display a maintenance splash screen. Existing authenticated admin sessions retain console access.
      </p>

      <div class="field" style="margin-bottom: 14px;">
        <label for="maintenance_enabled" class="m-adv-label">Maintenance Gate Status</label>
        <select class="m-adv-select" id="maintenance_enabled" name="maintenance_enabled">
          <option value="0" <%= settings.maintenance_enabled === '1' ? '' : 'selected' %>>Disabled (Normal Platform Operations)</option>
          <option value="1" <%= settings.maintenance_enabled === '1' ? 'selected' : '' %>>Enabled (Emergency Lockdown Active)</option>
        </select>
      </div>

      <div class="field" style="margin-bottom: 12px;">
        <label for="maintenance_message_az" class="m-adv-label">Lockdown Message (Azerbaijani - AZ)</label>
        <textarea class="m-adv-input" id="maintenance_message_az" name="maintenance_message_az" placeholder="Planlaşdırılmış texniki qulluq gedir..." style="min-height: 70px;"><%= settings.maintenance_message_az || '' %></textarea>
      </div>

      <div class="field" style="margin-bottom: 12px;">
        <label for="maintenance_message_tr" class="m-adv-label">Lockdown Message (Turkish - TR)</label>
        <textarea class="m-adv-input" id="maintenance_message_tr" name="maintenance_message_tr" placeholder="Planlı bakım çalışması yapılmaktadır..." style="min-height: 70px;"><%= settings.maintenance_message_tr || '' %></textarea>
      </div>

      <div class="field">
        <label for="maintenance_message_en" class="m-adv-label">Lockdown Message (English - EN)</label>
        <textarea class="m-adv-input" id="maintenance_message_en" name="maintenance_message_en" placeholder="Scheduled system maintenance in progress..." style="min-height: 70px;"><%= settings.maintenance_message_en || '' %></textarea>
      </div>
    </div>

    <!-- Announcement Ribbon Card -->
    <div class="m-card">
      <div class="m-dash-panel-header" style="margin-bottom: 14px;">
        <h3 class="m-dash-panel-title">
          <i class="fa-solid fa-bullhorn" style="color: var(--c-muted);"></i>
          <span>Global Announcement Ribbon</span>
        </h3>
      </div>
      <p style="color: var(--c-muted); font-size: 13px; margin: 0 0 18px; line-height: 1.5;">
        Broadcast platform notices, system alerts, or feature announcements as a persistent top banner across all public pages.
      </p>

      <div class="field" style="margin-bottom: 14px;">
        <label for="announcement_enabled" class="m-adv-label">Ribbon Broadcast State</label>
        <select class="m-adv-select" id="announcement_enabled" name="announcement_enabled">
          <option value="0" <%= settings.announcement_enabled === '1' ? '' : 'selected' %>>Disabled (Hidden)</option>
          <option value="1" <%= settings.announcement_enabled === '1' ? 'selected' : '' %>>Active (Broadcasted on public views)</option>
        </select>
      </div>

      <div class="field" style="margin-bottom: 12px;">
        <label for="announcement_text_az" class="m-adv-label">Banner Copy (Azerbaijani - AZ)</label>
        <textarea class="m-adv-input" id="announcement_text_az" name="announcement_text_az" placeholder="Yeni funksiyalar istifadəyə verildi..." style="min-height: 70px;"><%= settings.announcement_text_az || '' %></textarea>
      </div>

      <div class="field" style="margin-bottom: 12px;">
        <label for="announcement_text_tr" class="m-adv-label">Banner Copy (Turkish - TR)</label>
        <textarea class="m-adv-input" id="announcement_text_tr" name="announcement_text_tr" placeholder="Yeni özellikler yayında..." style="min-height: 70px;"><%= settings.announcement_text_tr || '' %></textarea>
      </div>

      <div class="field">
        <label for="announcement_text_en" class="m-adv-label">Banner Copy (English - EN)</label>
        <textarea class="m-adv-input" id="announcement_text_en" name="announcement_text_en" placeholder="System upgrade completed successfully..." style="min-height: 70px;"><%= settings.announcement_text_en || '' %></textarea>
      </div>
    </div>
  </div>

  <div class="row">
    <button class="m-cta m-cta--white" type="submit">
      <i class="fa-solid fa-floppy-disk"></i>
      <span>Save Settings Configuration</span>
    </button>
  </div>
</form>

<%- include('partials/layout-bottom') %>