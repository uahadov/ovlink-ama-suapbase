<!doctype html>
<html lang="en">
  <head>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=<%= (typeof assetVersion !== 'undefined' ? assetVersion : '1') %>" />
  <link rel="icon" href="/favicon.ico?v=<%= (typeof assetVersion !== 'undefined' ? assetVersion : '1') %>" />
  <link rel="apple-touch-icon" href="/logo.png?v=<%= (typeof assetVersion !== 'undefined' ? assetVersion : '1') %>" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Admin Login · Ovlink Console</title>
    <meta name="robots" content="noindex,nofollow" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="preload" href="/vendor/fontawesome/webfonts/fa-solid-900.woff2?v=<%= (typeof assetVersion !== 'undefined' ? assetVersion : '1') %>" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="/vendor/fontawesome/css/all.min.css?v=<%= (typeof assetVersion !== 'undefined' ? assetVersion : '1') %>" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" integrity="sha512-iecdLmaskl7CVkqkXNQ/ZH/XLlvWZOJyj7Yy7tcenmpD1ypASozpmT/E0iPtmFIB46ZmdtAc9eNBvH0H/ZpiBw==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link rel="stylesheet" href="/home.css?v=<%= (typeof assetVersion !== 'undefined') ? assetVersion : '1' %>" />
    <link rel="stylesheet" href="/admin/admin.css?v=<%= (typeof assetVersion !== 'undefined') ? assetVersion : '1' %>" />
  </head>
  <body class="ovx home-page auth-page admin-login-page">
    <div id="cursorGlow" aria-hidden="true"></div>

    <main class="m-auth-shell" id="mainContent">
      <div class="m-auth-container">
        <div class="m-auth-head">
          <div class="m-auth-eyebrow admin-login-chip">
            <i class="fa-solid fa-shield-halved" style="color: var(--c-white);" aria-hidden="true"></i>
            <span>Ovlink · Admin Console</span>
          </div>
          <h1 class="m-auth-title admin-login-title">Console Sign In</h1>
          <p class="m-auth-sub admin-login-subtitle">Moderation, security telemetry & platform management</p>
        </div>

        <div class="m-auth-card admin-login-card">
          <div class="m-auth-glyph brand__logo admin-login-logo-wrap" aria-hidden="true">
            <img src="/home-logo.svg?v=<%= (typeof assetVersion !== 'undefined' ? assetVersion : '1') %>" alt="Ovlink" class="admin-login-logo" width="34" height="34" data-fallback="/logo.webp" />
          </div>

          <% if (typeof error === 'string' && error) { %>
            <div class="alert alert--danger" style="margin-bottom: 18px;">
              <i class="fa-solid fa-triangle-exclamation" style="margin-top: 2px;"></i>
              <span><%= error %></span>
            </div>
          <% } %>

          <div class="alert alert--warn" style="margin-bottom: 20px; font-size: 11.5px; line-height: 1.5;">
            <i class="fa-solid fa-fingerprint" style="margin-top: 2px;"></i>
            <div>
              <strong>Strict Telemetry Active:</strong> Hardware fingerprints, network headers, and security signatures are recorded to protect console boundaries.
            </div>
          </div>

          <form class="form" method="POST" action="/admin/login">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
            <input type="hidden" name="next" value="<%= next || '' %>" />

            <div class="m-auth-field">
              <label for="email" class="m-adv-label">Staff Email</label>
              <div class="m-auth-input-wrap">
                <i class="fa-solid fa-envelope m-auth-input-icon" aria-hidden="true"></i>
                <input class="m-auth-input" id="email" name="email" type="email" autocomplete="username" placeholder="admin@ovlink.sbs" autofocus required />
              </div>
            </div>

            <div class="m-auth-field">
              <label for="password" class="m-adv-label">Password</label>
              <div class="m-auth-input-wrap">
                <i class="fa-solid fa-lock m-auth-input-icon" aria-hidden="true"></i>
                <input class="m-auth-input" id="password" name="password" type="password" autocomplete="current-password" placeholder="••••••••••••" required />
              </div>
            </div>

            <button class="m-cta m-cta--white m-auth-submit" type="submit">
              <span>Sign in to Console</span>
              <i class="fa-solid fa-arrow-right" style="font-size: 11px;"></i>
            </button>
            <a class="m-cta m-cta--outline m-cta--sm" href="/" style="width: 100%; margin-top: 10px; justify-content: center;">
              <i class="fa-solid fa-arrow-left"></i>
              <span>Back to site</span>
            </a>
          </form>
        </div>
      </div>
    </main>

    <script nonce="<%= nonce %>" src="/admin/admin.js?v=<%= assetVersion %>" defer></script>
  </body>
</html>
