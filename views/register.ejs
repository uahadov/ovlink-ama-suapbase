<!doctype html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="csrf-token" content="<%= csrfToken %>">
  <link rel="icon" href="/logo.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  
  <link rel="preload" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" as="style" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" media="print" id="bs-css" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap" media="print" id="gf-css" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" media="print" id="fa-css" />
  <script nonce="<%= nonce %>">
    var bs = document.getElementById("bs-css"); if (bs) bs.media = "all";
    var gf = document.getElementById("gf-css"); if (gf) gf.media = "all";
    document.getElementById("fa-css").media = "all";
  </script>
  <noscript>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
  </noscript>
  
  <link rel="stylesheet" href="/style.css?v=<%= assetVersion %>" />
  <title data-i18n="register_title">Qeydiyyat - URL Qısaltma</title>
  <meta name="description" content="Ovlink-də qeydiyyatdan keçin. Pulsuz hesab yaradın, linklərinizi qısaldın və idarə etməyə başlayın." />
  <meta name="keywords" content="<%= (seo && seo.keywords) ? seo.keywords : '' %>" />
  <style nonce="<%= nonce %>">
    .step { display: none; }
    .step.active { display: block; animation: fadeIn 0.5s; }
    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(10px); }
      to { opacity: 1; transform: translateY(0); }
    }
  </style>
</head>

<body class="home-page auth-policy-page animated-gradient-bg">

  <% if (siteSettings && siteSettings.announcement_enabled === '1' && (siteSettings.announcement_text_az || siteSettings.announcement_text_tr || siteSettings.announcement_text_en)) { %>
    <div id="siteAnnouncement" class="site-announcement" data-az="<%= siteSettings.announcement_text_az || '' %>" data-tr="<%= siteSettings.announcement_text_tr || '' %>" data-en="<%= siteSettings.announcement_text_en || '' %>">
      <div class="container">
        <i class="fa-solid fa-bullhorn"></i>
        <span id="siteAnnouncementText"><%= siteSettings.announcement_text_az || siteSettings.announcement_text_tr || siteSettings.announcement_text_en %></span>
      </div>
    </div>
  <% } %>

  <%- include('partials/public-navbar') %>

    <main class="auth-main-shell">
    <section id="hero" class="d-flex align-items-center auth-hero">
      <div class="container">
        <div class="text-center auth-hero-head reveal">
          <div class="badge hero-chip rounded-pill px-3 py-2 mb-4 shadow-sm fw-semibold">
            <i class="fa-solid fa-link me-1"></i><span data-i18n="hero_badge">Ovlink - Next-Gen Link Management</span>
          </div>
          <h1 class="hero-title auth-display-title" data-i18n="register_title">Qeydiyyat</h1>
          <p class="hero-subtitle auth-display-subtitle" data-i18n="register_subtitle">Yeni hesab yaradın</p>
        </div>

        <div class="glass-card home-form-card auth-home-card reveal" style="transition-delay: 0.2s">
          <div class="auth-head-icon" aria-hidden="true">
            <i class="fa-solid fa-user-plus"></i>
          </div>

          <div id="step1" class="step active">
            <form id="registerForm" novalidate>
              <div class="mb-3 auth-field">
                <label for="email" class="form-label" data-i18n="login_email">E-poçt Ünvanı</label>
                <div class="input-group auth-input shadow-sm">
                  <span class="input-group-text"><i class="fa-solid fa-envelope"></i></span>
                  <input type="email" class="form-control form-control-animated" id="email" required placeholder="numune@email.com" data-i18n-placeholder="login_email_placeholder">
                </div>
              </div>

              <div class="mb-3 auth-field">
                <label for="password" class="form-label" data-i18n="login_pass">Şifrə</label>
                <div class="input-group auth-input shadow-sm">
                  <span class="input-group-text"><i class="fa-solid fa-lock"></i></span>
                  <input type="password" class="form-control form-control-animated" id="password" required placeholder="******">
                </div>
              </div>

              <button type="submit" class="btn btn-primary btn-lg w-100 rounded-pill py-3 fw-bold shadow-lg home-primary-btn auth-submit-btn btn-animated btn-glow btn-shimmer btn-magnetic btn-stagger">
                <span data-i18n="register_btn">Qeydiyyatdan Keç</span> <i class="fa-solid fa-user-plus ms-2"></i>
              </button>

              <div class="auth-divider"><span data-i18n="auth_or">vəya</span></div>

              <a href="/auth/google" class="btn w-100 rounded-pill fw-semibold py-3 auth-google-btn btn-animated btn-stagger">
                <i class="fa-brands fa-google me-2"></i><span data-i18n="register_google">Google ilə qeydiyyat</span>
              </a>
            </form>

            <p id="regMessage" class="text-center small mt-3 mb-0 auth-message"></p>
          </div>

          <div id="step2" class="step">
            <h2 class="h4 fw-bold mb-2 text-center" data-i18n="verify_title">Təsdiqləmə</h2>
            <p class="text-muted mb-3 text-center" data-i18n="verify_subtitle">E-poçt ünvanınıza gələn 6 rəqəmli kodu daxil edin.</p>

            <form id="verifyForm" novalidate>
              <div class="mb-3 auth-field">
                <label for="vCode" class="form-label" data-i18n="verify_code">Təsdiqləmə Kodu</label>
                <div class="input-group auth-input shadow-sm">
                  <span class="input-group-text"><i class="fa-solid fa-key"></i></span>
                  <input type="text" class="form-control form-control-animated" id="vCode" maxlength="6" required placeholder="123456" inputmode="numeric" autocomplete="one-time-code">
                </div>
              </div>

              <button type="submit" class="btn btn-primary btn-lg w-100 rounded-pill py-3 fw-bold shadow-lg home-primary-btn auth-submit-btn btn-animated btn-glow btn-shimmer btn-magnetic btn-stagger">
                <span data-i18n="verify_btn">Təsdiqlə</span> <i class="fa-solid fa-check-circle ms-2"></i>
              </button>

              <button type="button" id="resendCodeBtn" class="btn btn-outline-secondary btn-sm w-100 rounded-pill py-2 mt-2 fw-semibold">
                <i class="fa-solid fa-rotate me-2"></i><span data-i18n="resend_code">Kodu Yenidən Göndər</span>
              </button>
            </form>

            <p id="verifyMessage" class="text-center small mt-3 mb-0 auth-message"></p>
          </div>

          <p class="auth-links mb-0 reveal" style="transition-delay: 0.4s">
            <span data-i18n="have_account">Artıq hesabınız var?</span>
            <a href="/login" data-i18n="login_link">Giriş</a>
          </p>

          <div class="policy-back">
            <a href="/" class="btn home-outline-btn rounded-pill btn-animated" data-i18n="nav_home">Ana Səhifə</a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <script nonce="<%= nonce %>">
    let userEmail = "";

    document.getElementById('registerForm').addEventListener('submit', async (e) => {
      e.preventDefault();
      const email = document.getElementById('email').value;
      const password = document.getElementById('password').value;
      const msg = document.getElementById('regMessage');

      msg.textContent = currentLang === 'az' ? "İşlənilir..." : (currentLang === 'en' ? "Processing..." : "İşleniyor...");
      msg.className = "text-center text-muted small";

      try {
        if (!getCsrfToken()) {
          await refreshCsrfToken();
        }
        const res = await postJsonWithCsrf('/api/register', { email, password, lang: currentLang });
        const data = await res.json();

        if (res.ok) {
          userEmail = email;
          document.getElementById('step1').classList.remove('active');
          document.getElementById('step2').classList.add('active');
          setTimeout(() => document.getElementById('vCode')?.focus(), 50);
        } else {
          msg.className = "text-center text-danger small";
          msg.textContent = data.error;
        }
      } catch (err) {
        msg.textContent = currentLang === 'az' ? "Xəta baş verdi." : (currentLang === 'en' ? "An error occurred." : "Hata oluştu.");
      }
    });

    document.getElementById('verifyForm').addEventListener('submit', async (e) => {
      e.preventDefault();
      const code = document.getElementById('vCode').value;
      const msg = document.getElementById('verifyMessage');

      try {
        if (!getCsrfToken()) {
          await refreshCsrfToken();
        }
        const res = await postJsonWithCsrf('/api/verify-email', { email: userEmail, verificationCode: code, lang: currentLang });
        const data = await res.json();

        if (res.ok) {
          msg.className = "text-center text-success small";
          msg.textContent = data.message;
          setClientSession({ email: userEmail, isAdmin: false });
          setTimeout(() => {
            window.location.href = '/';
          }, 1500);
        } else {
          msg.className = "text-center text-danger small";
          msg.textContent = data.error;
        }
      } catch (err) {
        msg.textContent = currentLang === 'az' ? "Xəta baş verdi." : (currentLang === 'en' ? "An error occurred." : "Hata oluştu.");
      }
    });

    // Resend verification code handler
    document.getElementById('resendCodeBtn')?.addEventListener('click', async () => {
      const btn = document.getElementById('resendCodeBtn');
      const msg = document.getElementById('verifyMessage');
      
      if (!userEmail) {
        msg.className = "text-center text-danger small";
        msg.textContent = currentLang === 'az' ? "E-poçt ünvanı tapılmadı." : (currentLang === 'en' ? "Email address not found." : "E-posta adresi bulunamadı.");
        return;
      }

      const originalText = btn.innerHTML;
      btn.disabled = true;
      btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin me-2"></i>' + (currentLang === 'az' ? "Göndərilir..." : (currentLang === 'en' ? "Sending..." : "Gönderiliyor..."));
      msg.textContent = "";

      try {
        if (!getCsrfToken()) {
          await refreshCsrfToken();
        }
        const res = await postJsonWithCsrf('/api/resend-verification', { email: userEmail, lang: currentLang });
        const data = await res.json();

        if (res.ok) {
          msg.className = "text-center text-success small";
          msg.textContent = data.message || (currentLang === 'az' ? "Kod yenidən göndərildi." : (currentLang === 'en' ? "Code resent successfully." : "Kod başarıyla yeniden gönderildi."));
          
          // Disable resend button for 60 seconds
          let countdown = 60;
          const interval = setInterval(() => {
            countdown--;
            btn.innerHTML = '<i class="fa-solid fa-clock me-2"></i>' + countdown + 's';
            if (countdown <= 0) {
              clearInterval(interval);
              btn.disabled = false;
              btn.innerHTML = originalText;
            }
          }, 1000);
        } else {
          msg.className = "text-center text-danger small";
          msg.textContent = data.error;
          btn.disabled = false;
          btn.innerHTML = originalText;
        }
      } catch (err) {
        msg.className = "text-center text-danger small";
        msg.textContent = currentLang === 'az' ? "Xəta baş verdi." : (currentLang === 'en' ? "An error occurred." : "Hata oluştu.");
        btn.disabled = false;
        btn.innerHTML = originalText;
      }
    });
  </script>

  <%- include('partials/public-footer', { footerClass: 'site-footer' }) %>

  <script nonce="<%= nonce %>" defer src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script nonce="<%= nonce %>" src="/lang.js?v=<%= assetVersion %>"></script>
  <script nonce="<%= nonce %>" src="/script.js?v=<%= assetVersion %>"></script>
</body>

</html>



