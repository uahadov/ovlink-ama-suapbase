<!doctype html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="csrf-token" content="<%= csrfToken %>">
  <link rel="icon" href="/logo.ico" />
  <link rel="preconnect" href="https://cdn.jsdelivr.net">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" integrity="sha384-9ndCyUaIbzAi2FUVXJi0CjmCapSmO7SnpJef0486qhLnuZ2cdeRhO02iuK6FUUVM" crossorigin="anonymous" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" integrity="sha384-iw3OoTErCYJJB9mCa8LNS2hbsQ7M3C0EpIsO/H5+EGAkPGc6rk+V8i04oW/K5xq0" crossorigin="anonymous" />
  <link rel="stylesheet" href="/style.css?v=<%= assetVersion %>" />
  <title data-i18n="register_title">Qeydiyyat - URL Qısaltma</title>
  <meta name="description" content="Ovlink-də qeydiyyatdan keçin. Pulsuz hesab yaradın, linklərinizi qısaldın və idarə etməyə başlayın." />
  <meta name="keywords" content="<%= (seo && seo.keywords) ? seo.keywords : '' %>" />
  <style nonce="<%= nonce %>">
    .step { display: none; }
    .step.active { display: block; animation: fadeIn 0.5s; }
    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(10px); }
      to { opacity: 1; transform: translateY(0); }
    }
  </style>
</head>

<body class="home-page auth-policy-page">

  <% if (siteSettings && siteSettings.announcement_enabled === '1' && (siteSettings.announcement_text_az || siteSettings.announcement_text_tr || siteSettings.announcement_text_en)) { %>
    <div id="siteAnnouncement" class="site-announcement" data-az="<%= siteSettings.announcement_text_az || '' %>" data-tr="<%= siteSettings.announcement_text_tr || '' %>" data-en="<%= siteSettings.announcement_text_en || '' %>">
      <div class="container">
        <i class="fa-solid fa-bullhorn"></i>
        <span id="siteAnnouncementText"><%= siteSettings.announcement_text_az || siteSettings.announcement_text_tr || siteSettings.announcement_text_en %></span>
      </div>
    </div>
  <% } %>

  <nav class="navbar navbar-expand-lg navbar-light home-navbar shadow-sm">
    <div class="container">
      <a class="navbar-brand fw-bold d-flex align-items-center" href="/">
        <img src="/logo.webp" alt="Ovlink" class="home-brand-logo" />
      </a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#authPageNavbarContent"
        aria-controls="authPageNavbarContent" aria-expanded="false" aria-label="Menu toggle">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="authPageNavbarContent">
        <ul class="navbar-nav ms-auto align-items-lg-center">
          <li class="nav-item" id="navAuthGuestLogin">
            <a class="nav-link" href="/login"><i class="fa-solid fa-right-to-bracket"></i> <span data-i18n="nav_login">Giriş</span></a>
          </li>
          <li class="nav-item" id="navAuthGuestReg">
            <a class="nav-link" href="/register"><i class="fa-solid fa-user-plus"></i> <span data-i18n="nav_register">Qeydiyyat</span></a>
          </li>
          <li class="nav-item dropdown nav-user-dropdown d-none" id="navAuthUser">
            <a class="nav-link dropdown-toggle position-relative" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
              <i class="fa-solid fa-user-circle me-1"></i>
              <span id="navUserEmail" data-i18n="nav_my_account">Hesabım</span>
              <span id="navNotifBadge" class="notif-badge d-none">0</span>
            </a>
            <ul class="dropdown-menu dropdown-menu-end">
              <li><a class="dropdown-item" href="/dashboard"><i class="fa-solid fa-chart-line me-2"></i><span data-i18n="dashboard_stats_link">Statistika</span></a></li>
              <li><a class="dropdown-item" href="/account"><i class="fa-solid fa-user-gear me-2"></i><span data-i18n="profile_settings_title">Profil Parametrləri</span></a></li>
              <li>
                <a class="dropdown-item d-flex align-items-center justify-content-between" href="/notifications">
                  <span><i class="fa-solid fa-bell me-2"></i><span data-i18n="notif_center_title">Bildiriş Mərkəzi</span></span>
                  <span id="navNotifBadgeMenu" class="notif-menu-badge d-none">0</span>
                </a>
              </li>
              <li><hr class="dropdown-divider" /></li>
              <li><a id="navLogoutBtn" class="dropdown-item" href="#"><i class="fa-solid fa-right-from-bracket me-2"></i><span data-i18n="nav_logout">Çıxış</span></a></li>
            </ul>
          </li>
        </ul>

        <div class="dropdown ms-2 me-2">
          <button id="langToggleBtn" class="btn btn-sm fw-bold dropdown-toggle lang-pill" type="button" data-bs-toggle="dropdown" aria-expanded="false">AZ</button>
          <ul class="dropdown-menu dropdown-menu-end">
            <li><button class="dropdown-item lang-option" data-lang="az" type="button">AZ</button></li>
            <li><button class="dropdown-item lang-option" data-lang="tr" type="button">TR</button></li>
            <li><button class="dropdown-item lang-option" data-lang="en" type="button">EN</button></li>
          </ul>
        </div>

        <button class="theme-toggle home-theme-btn" aria-label="Temayı Değiştir">
          <i class="fa-solid fa-sun"></i>
        </button>
      </div>
    </div>
  </nav>

    <main class="auth-main-shell">
    <section id="hero" class="d-flex align-items-center auth-hero">
      <div class="container">
        <div class="text-center auth-hero-head">
          <div class="badge hero-chip rounded-pill px-3 py-2 mb-4 shadow-sm fw-semibold">
            <i class="fa-solid fa-link me-1"></i><span data-i18n="hero_badge">Ovlink - Next-Gen Link Management</span>
          </div>
          <h1 class="hero-title auth-display-title" data-i18n="register_title">Qeydiyyat</h1>
          <p class="hero-subtitle auth-display-subtitle" data-i18n="register_subtitle">Yeni hesab yaradın</p>
        </div>

        <div class="glass-card home-form-card auth-home-card">
          <div class="auth-head-icon" aria-hidden="true">
            <i class="fa-solid fa-user-plus"></i>
          </div>

          <div id="step1" class="step active">
            <form id="registerForm" novalidate>
              <div class="mb-3 auth-field">
                <label for="email" class="form-label" data-i18n="login_email">E-poçt Ünvanı</label>
                <div class="input-group auth-input shadow-sm">
                  <span class="input-group-text"><i class="fa-solid fa-envelope"></i></span>
                  <input type="email" class="form-control" id="email" required placeholder="numune@email.com" data-i18n="login_email_placeholder">
                </div>
              </div>

              <div class="mb-3 auth-field">
                <label for="password" class="form-label" data-i18n="login_pass">Şifrə</label>
                <div class="input-group auth-input shadow-sm">
                  <span class="input-group-text"><i class="fa-solid fa-lock"></i></span>
                  <input type="password" class="form-control" id="password" required placeholder="******">
                </div>
              </div>

              <button type="submit" class="btn btn-primary btn-lg w-100 rounded-pill py-3 fw-bold shadow-lg home-primary-btn auth-submit-btn btn-animated btn-magnetic btn-stagger">
                <span data-i18n="register_btn">Qeydiyyatdan Keç</span> <i class="fa-solid fa-user-plus ms-2"></i>
              </button>

              <div class="auth-divider"><span data-i18n="auth_or">vəya</span></div>

              <a href="/auth/google" class="btn w-100 rounded-pill fw-semibold py-3 auth-google-btn btn-animated btn-stagger">
                <i class="fa-brands fa-google me-2"></i><span data-i18n="register_google">Google ilə qeydiyyat</span>
              </a>
            </form>

            <p id="regMessage" class="text-center small mt-3 mb-0 auth-message"></p>
          </div>

          <div id="step2" class="step">
            <h2 class="h4 fw-bold mb-2 text-center" data-i18n="verify_title">Təsdiqləmə</h2>
            <p class="text-muted mb-3 text-center" data-i18n="verify_subtitle">E-poçt ünvanınıza gələn 6 rəqəmli kodu daxil edin.</p>

            <form id="verifyForm" novalidate>
              <div class="mb-3 auth-field">
                <label for="vCode" class="form-label" data-i18n="verify_code">Təsdiqləmə Kodu</label>
                <div class="input-group auth-input shadow-sm">
                  <span class="input-group-text"><i class="fa-solid fa-key"></i></span>
                  <input type="text" class="form-control" id="vCode" maxlength="6" required placeholder="123456" inputmode="numeric" autocomplete="one-time-code">
                </div>
              </div>

              <button type="submit" class="btn btn-primary btn-lg w-100 rounded-pill py-3 fw-bold shadow-lg home-primary-btn auth-submit-btn btn-animated btn-magnetic btn-stagger">
                <span data-i18n="verify_btn">Təsdiqlə</span> <i class="fa-solid fa-check-circle ms-2"></i>
              </button>
            </form>

            <p id="verifyMessage" class="text-center small mt-3 mb-0 auth-message"></p>
          </div>

          <p class="auth-links mb-0">
            <span data-i18n="have_account">Artıq hesabınız var?</span>
            <a href="/login" data-i18n="login_link">Giriş</a>
          </p>

          <div class="policy-back">
            <a href="/" class="btn home-outline-btn rounded-pill" data-i18n="nav_home">Ana Səhifə</a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <script nonce="<%= nonce %>">
    let userEmail = "";

    document.getElementById('registerForm').addEventListener('submit', async (e) => {
      e.preventDefault();
      const email = document.getElementById('email').value;
      const password = document.getElementById('password').value;
      const msg = document.getElementById('regMessage');

      msg.textContent = currentLang === 'az' ? "İşlənilir..." : (currentLang === 'en' ? "Processing..." : "İşleniyor...");
      msg.className = "text-center text-muted small";

      try {
        if (!getCsrfToken()) {
          await refreshCsrfToken();
        }
        const res = await postJsonWithCsrf('/api/register', { email, password, lang: currentLang });
        const data = await res.json();

        if (res.ok) {
          userEmail = email;
          document.getElementById('step1').classList.remove('active');
          document.getElementById('step2').classList.add('active');
          setTimeout(() => document.getElementById('vCode')?.focus(), 50);
        } else {
          msg.className = "text-center text-danger small";
          msg.textContent = data.error;
        }
      } catch (err) {
        msg.textContent = currentLang === 'az' ? "Xəta baş verdi." : (currentLang === 'en' ? "An error occurred." : "Hata oluştu.");
      }
    });

    document.getElementById('verifyForm').addEventListener('submit', async (e) => {
      e.preventDefault();
      const code = document.getElementById('vCode').value;
      const msg = document.getElementById('verifyMessage');

      try {
        if (!getCsrfToken()) {
          await refreshCsrfToken();
        }
        const res = await postJsonWithCsrf('/api/verify-email', { email: userEmail, verificationCode: code, lang: currentLang });
        const data = await res.json();

        if (res.ok) {
          msg.className = "text-center text-success small";
          msg.textContent = data.message;
          setClientSession({ email: userEmail, isAdmin: false });
          setTimeout(() => {
            window.location.href = '/';
          }, 1500);
        } else {
          msg.className = "text-center text-danger small";
          msg.textContent = data.error;
        }
      } catch (err) {
        msg.textContent = currentLang === 'az' ? "Xəta baş verdi." : (currentLang === 'en' ? "An error occurred." : "Hata oluştu.");
      }
    });
  </script>

  <%- include('partials/public-footer', { footerClass: 'site-footer' }) %>

  <script nonce="<%= nonce %>" src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js" integrity="sha384-geWF76RCwLtnZ8qwWowPQNguL3RmwHVBC9FhGdlKrxdiJJigb/j/68SIy3Te4Bkz" crossorigin="anonymous"></script>
  <script nonce="<%= nonce %>" src="/lang.js?v=<%= assetVersion %>"></script>
  <script nonce="<%= nonce %>" src="/script.js?v=<%= assetVersion %>"></script>
</body>

</html>



