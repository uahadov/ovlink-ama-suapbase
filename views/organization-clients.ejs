<!doctype html>
<html lang="<%= lang %>" dir="<%= lang === 'ar' ? 'rtl' : 'ltr' %>">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="csrf-token" content="<%= csrfToken %>">
<meta name="robots" content="noindex,nofollow">
<title><%= lang==='tr'?'Müşteri Portföyü':lang==='en'?'Client Portfolio':'Müştəri portfeli' %> · Ovlink</title>
<link rel="stylesheet" href="/home.css">
<style nonce="<%= nonce %>">
:root{color-scheme:dark}body{margin:0;background:var(--c-bg,#101114);color:var(--c-text,#f5f5f5);font-family:Inter,system-ui,sans-serif}button,input,select{font:inherit}button{cursor:pointer}button:disabled{cursor:not-allowed;opacity:.5}button:focus-visible,input:focus-visible{outline:2px solid #fff;outline-offset:3px}.layout{display:grid;grid-template-columns:minmax(240px,300px) minmax(0,1fr);min-height:100vh}.side{padding:30px 20px;border-right:1px solid var(--c-border,#303136);background:var(--c-surface,#16171a)}.brand{font-size:20px;font-weight:800;letter-spacing:-.05em;text-decoration:none;color:inherit}.sub{font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:var(--c-muted,#a1a1aa)}.side-list{display:grid;gap:8px;margin-top:22px}.client{width:100%;text-align:left;display:flex;justify-content:space-between;gap:12px;border:1px solid var(--c-border,#383940);border-radius:12px;background:transparent;color:inherit;padding:14px}.client[aria-current=true]{border-color:#d6d6d6;background:rgba(255,255,255,.08)}.client small{font-size:11px;color:#a1a1aa}.main{max-width:1080px;width:100%;margin:0 auto;box-sizing:border-box;padding:34px clamp(16px,3.5vw,56px)}.top{display:flex;align-items:center;justify-content:space-between;gap:14px;flex-wrap:wrap}.heading{margin:0;font-size:clamp(27px,3vw,40px);letter-spacing:-.055em}.muted{color:#a4a5aa;font-size:14px}.card{border:1px solid var(--c-border,#383940);border-radius:18px;background:var(--c-surface,#18191d);padding:24px;margin-top:20px}.actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:18px}.btn{border-radius:10px;border:1px solid #4a4b51;padding:11px 16px;background:transparent;color:inherit;font-weight:600}.btn.primary{background:#ececec;color:#101014;border-color:transparent}.btn.danger{border-color:#a77676;color:#f9d7d7}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:10px}.metric{background:rgba(255,255,255,.035);border:1px solid #383940;border-radius:13px;padding:15px}.metric strong{display:block;font-size:30px;letter-spacing:-.04em}.field{display:grid;gap:7px;margin-top:14px}.field label{color:#d5d5d5;font-size:13px}.field input,.field select{width:100%;box-sizing:border-box;padding:12px;border:1px solid #44454e;border-radius:10px;background:#202125;color:white}.status{min-height:20px;margin-top:14px;color:#c4c4c4;font-size:13px}.campaign{display:flex;justify-content:space-between;gap:12px;padding:12px 0;border-bottom:1px solid #303137}.campaign:last-child{border:0}.skip{position:absolute;left:-999px}.skip:focus{left:12px;top:12px;z-index:50;background:#fff;color:#000;padding:10px}@media(max-width:760px){.layout{grid-template-columns:minmax(0,1fr)}.side,.main{min-width:0}.side-list{max-width:100%;min-width:0}.side{border-right:0;border-bottom:1px solid #34343a;padding:18px}.side-list{grid-auto-columns:minmax(180px,1fr);grid-auto-flow:column;overflow-x:auto}.main{padding:24px 16px}.card{padding:17px}.heading{font-size:28px}}@media(prefers-reduced-motion:reduce){*,*::before,*::after{animation:none!important;transition:none!important}}
</style>
</head>
<body>
<a class="m-skip-link skip" href="#mainContent">Skip to content</a>
<div class="layout">
<aside class="side" aria-label="Client navigation"><a class="brand" href="/dashboard">Ovlink</a><p class="sub" id="portfolioLabel">PORTFOLIO / CLIENTS</p>
<div class="actions"><label class="sub"><input id="showArchived" type="checkbox"> <span id="archivedLabel">Archived</span></label></div>
<nav class="side-list" id="clientList" aria-label="Clients"></nav>
</aside>
<main class="main" id="mainContent"><div class="top"><div><p class="sub">OVLINK / AGENCY</p><h1 class="heading" id="pageTitle">Müştəri portfeli</h1></div><div class="actions"><a class="btn" href="/workspaces">Workspaces</a><button class="btn primary" id="newClient">+ New client</button></div></div>
<p class="muted" id="description">Manage your agency's client campaigns from one place. Access remains separated by client.</p>
<p class="status" id="notice" role="status" aria-live="polite"></p>
<section class="card" id="createPanel" hidden aria-labelledby="createTitle"><h2 id="createTitle">Add client</h2><form id="createForm"><div class="field"><label for="clientName">Client name</label><input id="clientName" maxlength="100" minlength="2" required autocomplete="organization"></div><div class="field"><label for="clientEmail">Contact email (optional)</label><input id="clientEmail" type="email" maxlength="254" autocomplete="off"></div><div class="actions"><button class="btn primary" type="submit">Create client</button><button class="btn" type="button" id="cancelCreate">Cancel</button></div></form></section>
<section class="card" id="detail" hidden aria-labelledby="selectedTitle"><div class="top"><div><p class="sub" id="clientStatus"></p><h2 id="selectedTitle"></h2></div><div class="actions"><button class="btn" id="toggleArchive"></button></div></div><div class="actions"><button type="button" class="btn" id="loadReport">View report</button><a class="btn" id="downloadReport" href="#" rel="nofollow" download="ovlink-client-report.csv">Export CSV</a></div><p class="muted" id="reportSummary" aria-live="polite"></p><div class="grid"><div class="metric"><span class="muted">Campaigns</span><strong id="campaignCount">0</strong></div><div class="metric"><span class="muted">Links</span><strong id="linkCount">0</strong></div></div><form id="campaignForm" class="actions"><label class="field" for="campaignName" style="flex:1 1 200px">New campaign<input id="campaignName" required minlength="2" maxlength="100" placeholder="Campaign name"></label><button class="btn primary" type="submit" style="align-self:end">Create campaign</button></form><h3>Campaigns</h3><div id="campaignList" aria-live="polite"></div></section>
<section class="card" id="empty"><h2>Choose a client</h2><p class="muted">Create your first client or select one from the list.</p></section>
</main></div>
<script nonce="<%= nonce %>">
(()=>{'use strict';const org=<%- JSON.stringify(orgId) %>,lang=<%- JSON.stringify(lang) %>,csrf=document.querySelector('meta[name="csrf-token"]').content;
const dictionary={az:{title:'Müştəri portfeli',newClient:'+ Müştəri əlavə et',desc:'Bütün müştəri kampaniyalarını bir yerdən idarə edin. Məlumatlar müştəriyə görə ayrılır.',archived:'Arxiv',create:'Müştəri əlavə et',cancel:'İmtina',campaigns:'Kampaniyalar',links:'Linklər',newCampaign:'Yeni kampaniya',createCampaign:'Kampaniya yarat',choose:'Müştəri seçin',noCampaign:'Hələ kampaniya yoxdur',archive:'Arxivlə',restore:'Bərpa et'},tr:{title:'Müşteri portföyü',newClient:'+ Müşteri ekle',desc:'Tüm müşteri kampanyalarını tek yerden yönetin. Veriler müşteri bazında ayrılır.',archived:'Arşiv',create:'Müşteri ekle',cancel:'İptal',campaigns:'Kampanyalar',links:'Bağlantılar',newCampaign:'Yeni kampanya',createCampaign:'Kampanya oluştur',choose:'Müşteri seçin',noCampaign:'Henüz kampanya yok',archive:'Arşivle',restore:'Geri yükle'},en:{title:'Client portfolio',newClient:'+ New client',desc:'Manage client campaigns in one place. Data stays scoped per client.',archived:'Archived',create:'Add client',cancel:'Cancel',campaigns:'Campaigns',links:'Links',newCampaign:'New campaign',createCampaign:'Create campaign',choose:'Choose a client',noCampaign:'No campaigns yet',archive:'Archive',restore:'Restore'}};const t=dictionary[lang]||dictionary.az;
const el=id=>document.getElementById(id),path=`/api/organizations/${encodeURIComponent(org)}/clients`;let clients=[],selected=null;const notice=message=>{el('notice').textContent=message||''};
const set=(id,v)=>{el(id).textContent=v};
set('pageTitle',t.title);set('newClient',t.newClient);set('description',t.desc);set('archivedLabel',t.archived);set('createTitle',t.create);set('cancelCreate',t.cancel);set('campaignCount',0);set('linkCount',0);el('campaignName').placeholder=t.newCampaign;el('campaignForm').querySelector('label').firstChild.textContent=t.newCampaign;el('campaignForm').querySelector('button').textContent=t.createCampaign;el('createForm').querySelector('button').textContent=t.create;el('empty').querySelector('h2').textContent=t.choose;
async function api(url,method='GET',body){const r=await fetch(url,{method,credentials:'same-origin',headers:{'x-csrf-token':csrf,'content-type':'application/json'},body:body===undefined?undefined:JSON.stringify(body)});const data=await r.json().catch(()=>({}));if(!r.ok)throw new Error(data.error||'Request failed ('+r.status+')');return data}
async function load(){try{const data=await api(path+(el('showArchived').checked?'?include_archived=1':''));clients=data.clients;render();if(selected&&clients.some(x=>x.id===selected))await select(selected);else if(clients.length)await select(clients[0].id);else{selected=null;el('detail').hidden=true;el('empty').hidden=false}}catch(err){notice(err.message)}}
function render(){el('clientList').replaceChildren();for(const c of clients){const b=document.createElement('button');b.type='button';b.className='client';b.setAttribute('aria-current',String(c.id===selected));const label=document.createElement('span');label.textContent=c.display_name;const small=document.createElement('small');small.textContent=c.status;b.append(label,small);b.addEventListener('click',()=>select(c.id));el('clientList').append(b)}}
async function select(id){selected=id;el('downloadReport').href=path+'/'+encodeURIComponent(id)+'/report.csv';el('reportSummary').textContent='';const c=clients.find(x=>x.id===id);if(!c)return;render();el('empty').hidden=true;el('detail').hidden=false;set('selectedTitle',c.display_name);set('clientStatus',c.status);set('campaignCount',c.campaign_count);set('linkCount',c.link_count);set('toggleArchive',c.status==='active'?t.archive:t.restore);el('campaignForm').hidden=c.status!=='active';await campaigns()}
async function campaigns(){if(!selected)return;try{const data=await api(`${path}/${encodeURIComponent(selected)}/campaigns`);el('campaignList').replaceChildren();if(!data.campaigns.length){const p=document.createElement('p');p.className='muted';p.textContent=t.noCampaign;el('campaignList').append(p)}for(const c of data.campaigns){const row=document.createElement('div');row.className='campaign';const name=document.createElement('span');name.textContent=c.name;const info=document.createElement('span');info.className='muted';info.textContent=String(c.link_count)+' '+t.links;row.append(name,info);el('campaignList').append(row)}}catch(err){notice(err.message)}}
el('showArchived').addEventListener('change',load);el('newClient').addEventListener('click',()=>{el('createPanel').hidden=false;el('clientName').focus()});el('cancelCreate').addEventListener('click',()=>{el('createPanel').hidden=true});el('createForm').addEventListener('submit',async event=>{event.preventDefault();try{const name=el('clientName').value.trim(),email=el('clientEmail').value.trim();const data=await api(path,'POST',{name,...(email?{contact_email:email}:{})});notice('');el('createForm').reset();el('createPanel').hidden=true;await load();await select(data.client.id)}catch(err){notice(err.message)}});
el('loadReport').addEventListener('click',async()=>{if(!selected)return;try{const r=await api(path+'/'+encodeURIComponent(selected)+'/report?days=30');el('reportSummary').textContent='30 days · '+r.totals.campaigns+' campaigns · '+r.totals.links+' links · '+r.totals.clicks+' clicks · '+r.totals.uniques+' unique visits · '+r.totals.conversions+' conversions';}catch(e){notice(e.message)}});
el('toggleArchive').addEventListener('click',async()=>{const c=clients.find(x=>x.id===selected);if(!c)return;try{await api(`${path}/${encodeURIComponent(selected)}/${c.status==='active'?'archive':'restore'}`,'POST',{});await load()}catch(err){notice(err.message)}});
el('campaignForm').addEventListener('submit',async event=>{event.preventDefault();if(!selected)return;try{await api(`${path}/${encodeURIComponent(selected)}/campaigns`,'POST',{name:el('campaignName').value.trim()});el('campaignForm').reset();await load()}catch(err){notice(err.message)}});
load();})();
</script>
</body></html>
