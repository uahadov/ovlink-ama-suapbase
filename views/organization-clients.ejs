<!doctype html>
<html lang="<%= lang %>" dir="<%= lang === 'ar' ? 'rtl' : 'ltr' %>">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="csrf-token" content="<%= csrfToken %>">
<meta name="robots" content="noindex,nofollow">
<title><%= lang==='tr'?'Müşteri Portföyü':lang==='en'?'Client Portfolio':'Müştəri portfeli' %> · Ovlink</title>
<link rel="stylesheet" href="/home.css">
<style nonce="<%= nonce %>">
:root{color-scheme:dark}[hidden]{display:none!important}body{margin:0;background:var(--c-bg,#101114);color:var(--c-text,#f5f5f5);font-family:Inter,system-ui,sans-serif}button,input,select{font:inherit}button{cursor:pointer}button:disabled{cursor:not-allowed;opacity:.5}button:focus-visible,input:focus-visible,select:focus-visible,a:focus-visible{outline:2px solid #fff;outline-offset:3px}.layout{display:grid;grid-template-columns:minmax(240px,300px) minmax(0,1fr);min-height:100vh}.side{padding:30px 20px;border-right:1px solid var(--c-border,#303136);background:var(--c-surface,#16171a)}.brand{font-size:20px;font-weight:800;letter-spacing:-.05em;text-decoration:none;color:inherit}.sub{font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:var(--c-muted,#a1a1aa)}.side-list{display:grid;gap:8px;margin-top:22px}.client{width:100%;text-align:left;display:flex;justify-content:space-between;align-items:center;gap:12px;border:1px solid var(--c-border,#383940);border-radius:12px;background:transparent;color:inherit;padding:14px}.client[aria-current=true]{border-color:#d6d6d6;background:rgba(255,255,255,.08)}.client small{font-size:11px;color:#a1a1aa}.main{max-width:1080px;width:100%;margin:0 auto;box-sizing:border-box;padding:34px clamp(16px,3.5vw,56px)}.top{display:flex;align-items:center;justify-content:space-between;gap:14px;flex-wrap:wrap}.heading{margin:0;font-size:clamp(27px,3vw,40px);letter-spacing:-.055em}.muted{color:#a4a5aa;font-size:14px}.card{border:1px solid var(--c-border,#383940);border-radius:18px;background:var(--c-surface,#18191d);padding:24px;margin-top:20px}.actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:18px}.btn{border-radius:10px;border:1px solid #4a4b51;padding:11px 16px;background:transparent;color:inherit;font-weight:600;text-decoration:none;display:inline-flex;align-items:center;justify-content:center}.btn.primary{background:#ececec;color:#101014;border-color:transparent}.btn.danger{border-color:#a77676;color:#f9d7d7}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:10px;margin-top:14px}.metric{background:rgba(255,255,255,.035);border:1px solid #383940;border-radius:13px;padding:15px}.metric strong{display:block;font-size:30px;letter-spacing:-.04em}.field{display:grid;gap:7px;margin-top:14px}.field label{color:#d5d5d5;font-size:13px}.field input,.field select{width:100%;box-sizing:border-box;padding:12px;border:1px solid #44454e;border-radius:10px;background:#202125;color:white}.status{min-height:20px;margin-top:14px;color:#c4c4c4;font-size:13px}.campaign,.link-row{display:flex;justify-content:space-between;align-items:center;gap:12px;padding:12px 0;border-bottom:1px solid #303137;flex-wrap:wrap}.campaign:last-child,.link-row:last-child{border:0}.client-head{display:flex;align-items:center;gap:14px;min-width:0}.client-logo{width:42px;height:42px;border-radius:10px;border:1px solid #383940;object-fit:cover;background:#202125;display:inline-flex;align-items:center;justify-content:center;font-weight:700;font-size:16px;flex:0 0 auto}.settings-tag{font-size:12px;color:#a4a5aa;margin:6px 0 0}.skip{position:absolute;left:-999px}.skip:focus{left:12px;top:12px;z-index:50;background:#fff;color:#000;padding:10px}@media(max-width:760px){.layout{grid-template-columns:minmax(0,1fr)}.side,.main{min-width:0}.side-list{max-width:100%;min-width:0}.side{border-right:0;border-bottom:1px solid #34343a;padding:18px}.side-list{grid-auto-columns:minmax(180px,1fr);grid-auto-flow:column;overflow-x:auto}.main{padding:24px 16px}.card{padding:17px}.heading{font-size:28px}}@media(prefers-reduced-motion:reduce){*,*::before,*::after{animation:none!important;transition:none!important}}
</style>
</head>
<body>
<a class="m-skip-link skip" href="#mainContent">Skip to content</a>
<div class="layout">
<aside class="side" aria-label="Client navigation"><a class="brand" href="/dashboard">Ovlink</a><p class="sub" id="portfolioLabel">PORTFOLIO / CLIENTS</p>
<div class="actions"><label class="sub"><input id="showArchived" type="checkbox"> <span id="archivedLabel">Archived</span></label></div>
<nav class="side-list" id="clientList" aria-label="Clients"></nav>
</aside>
<main class="main" id="mainContent"><div class="top"><div><p class="sub">OVLINK / AGENCY</p><h1 class="heading" id="pageTitle">Müştəri portfeli</h1></div><div class="actions"><a class="btn" href="/workspaces" id="backWorkspaces">Workspaces</a><button class="btn primary" id="newClient" type="button">+ New client</button></div></div>
<p class="muted" id="description">Manage your agency's client campaigns from one place. Access remains separated by client.</p>
<p class="status" id="notice" role="status" aria-live="polite"></p>
<section class="card" id="createPanel" hidden aria-labelledby="createTitle"><h2 id="createTitle">Add client</h2><form id="createForm"><div class="field"><label for="clientName" id="lblClientName">Client name</label><input id="clientName" maxlength="100" minlength="2" required autocomplete="organization"></div><div class="field"><label for="clientEmail" id="lblClientEmail">Contact email (optional)</label><input id="clientEmail" type="email" maxlength="254" autocomplete="off"></div><div class="field"><label for="clientLogo" id="lblClientLogo">Logo URL (HTTPS, optional)</label><input id="clientLogo" type="url" maxlength="500" placeholder="https://example.com/logo.png" autocomplete="off"></div><div class="grid"><div class="field"><label for="reportLocale" id="lblReportLocale">Report language</label><select id="reportLocale"><option value="az">AZ</option><option value="tr">TR</option><option value="en">EN</option></select></div><div class="field"><label for="reportFreq" id="lblReportFreq">Report schedule</label><select id="reportFreq"><option value="none">None</option><option value="weekly">Weekly</option><option value="monthly">Monthly</option></select></div></div><div class="actions"><button class="btn primary" type="submit" id="submitCreate">Create client</button><button class="btn" type="button" id="cancelCreate">Cancel</button></div></form></section>
<section class="card" id="editPanel" hidden aria-labelledby="editTitle"><h2 id="editTitle">Edit client</h2><form id="editForm"><div class="field"><label for="editName" id="lblEditName">Client name</label><input id="editName" maxlength="100" minlength="2" required></div><div class="field"><label for="editLogo" id="lblEditLogo">Logo URL (HTTPS, optional)</label><input id="editLogo" type="url" maxlength="500" placeholder="https://example.com/logo.png"></div><div class="grid"><div class="field"><label for="editLocale" id="lblEditLocale">Report language</label><select id="editLocale"><option value="az">AZ</option><option value="tr">TR</option><option value="en">EN</option></select></div><div class="field"><label for="editFreq" id="lblEditFreq">Report schedule</label><select id="editFreq"><option value="none">None</option><option value="weekly">Weekly</option><option value="monthly">Monthly</option></select></div></div><div class="actions"><button class="btn primary" type="submit" id="submitEdit">Save changes</button><button class="btn" type="button" id="cancelEdit">Cancel</button></div></form></section>
<section class="card" id="detail" hidden aria-labelledby="selectedTitle"><div class="top"><div class="client-head"><div id="clientLogoWrap" class="client-logo" aria-hidden="true"></div><div><p class="sub" id="clientStatus"></p><h2 id="selectedTitle" style="margin:2px 0 0"></h2><p class="settings-tag" id="clientSettings"></p></div></div><div class="actions"><button type="button" class="btn" id="editClient">Edit</button><button type="button" class="btn" id="toggleArchive"></button></div></div><div class="actions"><button type="button" class="btn" id="loadReport">View report</button><a class="btn" id="downloadReport" href="#" rel="nofollow" download="ovlink-client-report.csv">Export CSV</a></div><p class="muted" id="reportSummary" aria-live="polite"></p><div class="grid"><div class="metric"><span class="muted" id="metricCampaigns">Campaigns</span><strong id="campaignCount">0</strong></div><div class="metric"><span class="muted" id="metricLinks">Links</span><strong id="linkCount">0</strong></div></div><form id="campaignForm" class="actions"><label class="field" for="campaignName" style="flex:1 1 200px"><span id="lblNewCampaign">New campaign</span><input id="campaignName" required minlength="2" maxlength="100" placeholder="Campaign name"></label><button class="btn primary" type="submit" id="submitCampaign" style="align-self:end">Create campaign</button></form><h3 id="campaignsHeading">Campaigns</h3><div id="campaignList" aria-live="polite"></div><h3 id="linksHeading" style="margin-top:22px">Client links</h3><div id="linkList" aria-live="polite"></div></section>
<section class="card" id="empty"><h2 id="emptyTitle">Choose a client</h2><p class="muted" id="emptyDesc">Create your first client or select one from the list.</p></section>
</main></div>
<script nonce="<%= nonce %>">
(()=>{'use strict';const org=<%- JSON.stringify(orgId) %>,lang=<%- JSON.stringify(lang) %>,csrf=document.querySelector('meta[name="csrf-token"]').content;
const dictionary={
 az:{title:'Müştəri portfeli',newClient:'+ Müştəri əlavə et',desc:'Bütün müştəri kampaniyalarını bir yerdən idarə edin. Məlumatlar müştəriyə görə ayrılır.',archived:'Arxiv',create:'Müştəri əlavə et',edit:'Redaktə et',save:'Yadda saxla',cancel:'İmtina',campaigns:'Kampaniyalar',links:'Linklər',clientLinks:'Müştəri linkləri',noLinks:'Hələ link əlavə edilməyib',newCampaign:'Yeni kampaniya',createCampaign:'Kampaniya yarat',choose:'Müştəri seçin',chooseDesc:'İlk müştərinizi yaradın və ya siyahıdan birini seçin.',noCampaign:'Hələ kampaniya yoxdur',archive:'Arxivlə',restore:'Bərpa et',viewReport:'Hesabata bax',exportCsv:'CSV yüklə',nameLbl:'Müştəri adı',emailLbl:'Əlaqə e-poçtu (istəyə bağlı)',logoLbl:'Logo URL (HTTPS, istəyə bağlı)',repLang:'Hesabat dili',repFreq:'Hesabat tezliyi',days:'30 gün',clicks:'klik',uniques:'unikal',convs:'konversiya',saved:'Dəyişikliklər yadda saxlanıldı.'},
 tr:{title:'Müşteri portföyü',newClient:'+ Müşteri ekle',desc:'Tüm müşteri kampanyalarını tek yerden yönetin. Veriler müşteri bazında ayrılır.',archived:'Arşiv',create:'Müşteri ekle',edit:'Düzenle',save:'Kaydet',cancel:'İptal',campaigns:'Kampanyalar',links:'Bağlantılar',clientLinks:'Müşteri bağlantıları',noLinks:'Henüz bağlantı eklenmedi',newCampaign:'Yeni kampanya',createCampaign:'Kampanya oluştur',choose:'Müşteri seçin',chooseDesc:'İlk müşterinizi oluşturun veya listeden seçin.',noCampaign:'Henüz kampanya yok',archive:'Arşivle',restore:'Geri yükle',viewReport:'Raporu gör',exportCsv:'CSV indir',nameLbl:'Müşteri adı',emailLbl:'İletişim e-postası (isteğe bağlı)',logoLbl:'Logo URL (HTTPS, isteğe bağlı)',repLang:'Rapor dili',repFreq:'Rapor sıklığı',days:'30 gün',clicks:'tıklama',uniques:'tekil',convs:'dönüşüm',saved:'Değişiklikler kaydedildi.'},
 en:{title:'Client portfolio',newClient:'+ New client',desc:'Manage client campaigns in one place. Data stays scoped per client.',archived:'Archived',create:'Add client',edit:'Edit',save:'Save changes',cancel:'Cancel',campaigns:'Campaigns',links:'Links',clientLinks:'Client links',noLinks:'No links attached yet',newCampaign:'New campaign',createCampaign:'Create campaign',choose:'Choose a client',chooseDesc:'Create your first client or select one from the list.',noCampaign:'No campaigns yet',archive:'Archive',restore:'Restore',viewReport:'View report',exportCsv:'Export CSV',nameLbl:'Client name',emailLbl:'Contact email (optional)',logoLbl:'Logo URL (HTTPS, optional)',repLang:'Report language',repFreq:'Report schedule',days:'30 days',clicks:'clicks',uniques:'unique visits',convs:'conversions',saved:'Changes saved.'}
};
const t=dictionary[lang]||dictionary.az;
const el=id=>document.getElementById(id),path=`/api/organizations/${encodeURIComponent(org)}/clients`;
let clients=[],selected=null,caps={create:true,update:true,create_campaign:true,export_csv:true};
const notice=message=>{el('notice').textContent=message||''};
const set=(id,v)=>{const n=el(id);if(n)n.textContent=v};
set('pageTitle',t.title);set('newClient',t.newClient);set('description',t.desc);set('archivedLabel',t.archived);
set('createTitle',t.create);set('submitCreate',t.create);set('cancelCreate',t.cancel);
set('editTitle',t.edit);set('editClient',t.edit);set('submitEdit',t.save);set('cancelEdit',t.cancel);
set('lblClientName',t.nameLbl);set('lblClientEmail',t.emailLbl);set('lblClientLogo',t.logoLbl);
set('lblReportLocale',t.repLang);set('lblReportFreq',t.repFreq);
set('lblEditName',t.nameLbl);set('lblEditLogo',t.logoLbl);set('lblEditLocale',t.repLang);set('lblEditFreq',t.repFreq);
set('loadReport',t.viewReport);set('downloadReport',t.exportCsv);
set('metricCampaigns',t.campaigns);set('metricLinks',t.links);set('campaignsHeading',t.campaigns);set('linksHeading',t.clientLinks);
set('lblNewCampaign',t.newCampaign);set('submitCampaign',t.createCampaign);el('campaignName').placeholder=t.newCampaign;
set('emptyTitle',t.choose);set('emptyDesc',t.chooseDesc);set('campaignCount',0);set('linkCount',0);
async function api(url,method='GET',body){const r=await fetch(url,{method,credentials:'same-origin',headers:{'x-csrf-token':csrf,'content-type':'application/json'},body:body===undefined?undefined:JSON.stringify(body)});const data=await r.json().catch(()=>({}));if(!r.ok)throw new Error(data.error||'Request failed ('+r.status+')');return data}
async function load(){try{const data=await api(path+(el('showArchived').checked?'?include_archived=1':''));clients=data.clients||[];if(data.capabilities)caps=data.capabilities;el('newClient').hidden=!caps.create;render();if(selected&&clients.some(x=>x.id===selected))await select(selected);else if(clients.length)await select(clients[0].id);else{selected=null;el('detail').hidden=true;el('editPanel').hidden=true;el('empty').hidden=false}}catch(err){notice(err.message)}}
function render(){el('clientList').replaceChildren();for(const c of clients){const b=document.createElement('button');b.type='button';b.className='client';b.setAttribute('aria-current',String(c.id===selected));const label=document.createElement('span');label.textContent=c.display_name;const small=document.createElement('small');small.textContent=c.status;b.append(label,small);b.addEventListener('click',()=>select(c.id));el('clientList').append(b)}}
function renderLogo(c){const w=el('clientLogoWrap');w.replaceChildren();if(c.logo_url&&/^https:\/\//i.test(c.logo_url)){const img=document.createElement('img');img.src=c.logo_url;img.alt='';img.referrerPolicy='no-referrer';img.style.cssText='width:100%;height:100%;border-radius:10px;object-fit:cover';img.onerror=()=>{w.textContent=(c.display_name||'C').slice(0,2).toUpperCase()};w.append(img)}else{w.textContent=(c.display_name||'C').slice(0,2).toUpperCase()}}
async function select(id){selected=id;el('editPanel').hidden=true;el('downloadReport').href=path+'/'+encodeURIComponent(id)+'/report.csv';el('downloadReport').hidden=!caps.export_csv;el('reportSummary').textContent='';const c=clients.find(x=>x.id===id);if(!c)return;render();el('empty').hidden=true;el('detail').hidden=false;renderLogo(c);set('selectedTitle',c.display_name);set('clientStatus',c.status);const rs=c.report_settings||{};set('clientSettings',[rs.locale?rs.locale.toUpperCase():null,rs.report_frequency&&rs.report_frequency!=='none'?rs.report_frequency:null,rs.timezone||null].filter(Boolean).join(' · '));set('campaignCount',c.campaign_count);set('linkCount',c.link_count);set('toggleArchive',c.status==='active'?t.archive:t.restore);el('toggleArchive').hidden=!caps.update;el('editClient').hidden=!caps.update;el('campaignForm').hidden=!(caps.create_campaign&&c.status==='active');await Promise.all([campaigns(),links()])}
async function campaigns(){if(!selected)return;try{const data=await api(`${path}/${encodeURIComponent(selected)}/campaigns`);el('campaignList').replaceChildren();if(!data.campaigns.length){const p=document.createElement('p');p.className='muted';p.textContent=t.noCampaign;el('campaignList').append(p)}for(const c of data.campaigns){const row=document.createElement('div');row.className='campaign';const name=document.createElement('span');name.textContent=c.name;const info=document.createElement('span');info.className='muted';info.textContent=String(c.link_count)+' '+t.links;row.append(name,info);el('campaignList').append(row)}}catch(err){notice(err.message)}}
async function links(){if(!selected)return;try{const data=await api(`${path}/${encodeURIComponent(selected)}/links`);el('linkList').replaceChildren();const items=data.links||[];if(!items.length){const p=document.createElement('p');p.className='muted';p.textContent=t.noLinks;el('linkList').append(p);return}for(const item of items){const row=document.createElement('div');row.className='link-row';const left=document.createElement('span');left.textContent='/'+item.short+(item.title?' · '+item.title:'');const right=document.createElement('span');right.className='muted';right.textContent=item.campaign_name||'';row.append(left,right);el('linkList').append(row)}}catch(_e){el('linkList').replaceChildren()}}
el('showArchived').addEventListener('change',load);
el('newClient').addEventListener('click',()=>{el('editPanel').hidden=true;el('createPanel').hidden=false;el('clientName').focus()});
el('cancelCreate').addEventListener('click',()=>{el('createPanel').hidden=true});
el('editClient').addEventListener('click',()=>{const c=clients.find(x=>x.id===selected);if(!c)return;el('createPanel').hidden=true;el('editName').value=c.display_name||'';el('editLogo').value=c.logo_url||'';const rs=c.report_settings||{};el('editLocale').value=rs.locale||lang;el('editFreq').value=rs.report_frequency||'none';el('editPanel').hidden=false;el('editName').focus()});
el('cancelEdit').addEventListener('click',()=>{el('editPanel').hidden=true});
el('createForm').addEventListener('submit',async event=>{event.preventDefault();try{const name=el('clientName').value.trim(),email=el('clientEmail').value.trim(),logo=el('clientLogo').value.trim();const report_settings={locale:el('reportLocale').value,report_frequency:el('reportFreq').value};const data=await api(path,'POST',{name,...(email?{contact_email:email}:{}),...(logo?{logo_url:logo}:{}),report_settings});notice('');el('createForm').reset();el('createPanel').hidden=true;await load();await select(data.client.id)}catch(err){notice(err.message)}});
el('editForm').addEventListener('submit',async event=>{event.preventDefault();if(!selected)return;try{const name=el('editName').value.trim(),logo=el('editLogo').value.trim();const report_settings={locale:el('editLocale').value,report_frequency:el('editFreq').value};await api(`${path}/${encodeURIComponent(selected)}`,'PATCH',{name,logo_url:logo||null,report_settings});el('editPanel').hidden=true;notice(t.saved);await load()}catch(err){notice(err.message)}});
el('loadReport').addEventListener('click',async()=>{if(!selected)return;try{const r=await api(path+'/'+encodeURIComponent(selected)+'/report?days=30');el('reportSummary').textContent=`${t.days} · ${r.totals.campaigns} ${t.campaigns.toLowerCase()} · ${r.totals.links} ${t.links.toLowerCase()} · ${r.totals.clicks} ${t.clicks} · ${r.totals.uniques} ${t.uniques} · ${r.totals.conversions} ${t.convs}`;}catch(e){notice(e.message)}});
el('toggleArchive').addEventListener('click',async()=>{const c=clients.find(x=>x.id===selected);if(!c)return;try{await api(`${path}/${encodeURIComponent(selected)}/${c.status==='active'?'archive':'restore'}`,'POST',{});await load()}catch(err){notice(err.message)}});
el('campaignForm').addEventListener('submit',async event=>{event.preventDefault();if(!selected)return;try{await api(`${path}/${encodeURIComponent(selected)}/campaigns`,'POST',{name:el('campaignName').value.trim()});el('campaignForm').reset();await load()}catch(err){notice(err.message)}});
load();})();
</script>
</body></html>
