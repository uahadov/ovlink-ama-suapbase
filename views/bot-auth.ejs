<!DOCTYPE html>
<html lang="az">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="csrf-token" content="<%= csrfToken %>">
  <title data-i18n="bot_auth_title">Bot Bağlantısı - Ovlink</title>
  <link rel="icon" href="/logo.ico" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
  <link rel="stylesheet" href="/style.css?v=<%= assetVersion %>">
  <style nonce="<%= nonce %>">
    /* Custom Styles for Bot Auth Page */
    .bot-auth-wrapper {
      min-height: calc(100vh - 80px);
      display: flex;
      flex-direction: column;
      justify-content: center;
      position: relative;
      z-index: 2;
      padding: 3rem 0 5rem 0;
    }

    /* Ambient Background Glows */
    .ambient-glow {
      position: absolute;
      border-radius: 50%;
      filter: blur(100px);
      z-index: 1;
      opacity: 0.5;
      animation: float 10s infinite ease-in-out alternate;
      pointer-events: none;
    }
    .glow-primary {
      background: rgba(99, 102, 241, 0.35);
      width: 600px;
      height: 600px;
      top: -10%;
      left: 10%;
    }
    .glow-info {
      background: rgba(6, 182, 212, 0.25);
      width: 500px;
      height: 500px;
      bottom: -10%;
      right: 10%;
      animation-delay: -5s;
    }

    /* Main Auth Card (Centered) */
    .bot-auth-card {
      border-radius: 32px;
      padding: 3.5rem 3rem;
      background: rgba(255, 255, 255, 0.95);
      backdrop-filter: blur(40px);
      -webkit-backdrop-filter: blur(40px);
      border: 1px solid rgba(255, 255, 255, 1);
      box-shadow: 0 30px 60px -10px rgba(0, 0, 0, 0.15), 0 0 0 1px rgba(0, 0, 0, 0.05);
      position: relative;
      overflow: hidden;
      margin-bottom: 3rem;
      z-index: 3;
    }
    body.dark-mode .bot-auth-card {
      background: rgba(30, 41, 59, 0.85);
      border: 1px solid rgba(255, 255, 255, 0.1);
      box-shadow: 0 30px 60px -10px rgba(0, 0, 0, 0.5), 0 0 0 1px rgba(0, 0, 0, 0.2);
    }

    /* Platform Head */
    .platform-header {
      margin-bottom: 2rem;
    }
    .platform-icon-wrapper {
      width: 80px;
      height: 80px;
      border-radius: 24px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-size: 2.5rem;
      margin-bottom: 1rem;
      box-shadow: 0 15px 30px -10px rgba(0,0,0,0.2);
    }
    .platform-telegram {
      background: linear-gradient(135deg, #229ED9 0%, #0088cc 100%);
      color: #fff;
    }
    .platform-discord {
      background: linear-gradient(135deg, #5865F2 0%, #4752C4 100%);
      color: #fff;
    }

    /* User Profile Badge */
    .user-profile-badge {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.5rem 1.25rem;
      background: rgba(99, 102, 241, 0.1);
      border: 1px solid rgba(99, 102, 241, 0.2);
      border-radius: 99px;
      font-weight: 600;
      color: #4f46e5;
      font-size: 0.95rem;
    }
    body.dark-mode .user-profile-badge {
      background: rgba(99, 102, 241, 0.15);
      border-color: rgba(99, 102, 241, 0.3);
      color: #818cf8;
    }

    /* Status Circle Icons */
    .status-icon-circle {
      width: 72px;
      height: 72px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 1.5rem;
      font-size: 2.2rem;
      animation: scaleIn 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
    }
    .status-success {
      background: rgba(16, 185, 129, 0.15);
      color: #10b981;
      border: 1px solid rgba(16, 185, 129, 0.3);
    }
    .status-error {
      background: rgba(239, 68, 68, 0.15);
      color: #ef4444;
      border: 1px solid rgba(239, 68, 68, 0.3);
    }
    .status-info {
      background: rgba(56, 189, 248, 0.15);
      color: #0284c7;
      border: 1px solid rgba(56, 189, 248, 0.3);
    }
    body.dark-mode .status-info { color: #38bdf8; }

    /* Action Buttons */
    .action-btn {
      padding: 1rem 2rem;
      border-radius: 16px;
      font-size: 1.1rem;
      font-weight: 600;
      transition: all 0.3s ease;
      letter-spacing: 0.3px;
    }
    .action-btn:hover {
      transform: translateY(-2px);
      box-shadow: 0 10px 25px -5px rgba(99, 102, 241, 0.4);
    }

    /* Feature Cards (Bottom Grid) */
    .features-container {
      position: relative;
      z-index: 3;
    }
    .feature-glass-card {
      background: rgba(255, 255, 255, 0.6);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border-radius: 24px;
      padding: 2.5rem 2rem;
      height: 100%;
      border: 1px solid rgba(255, 255, 255, 0.8);
      box-shadow: 0 15px 35px -10px rgba(0, 0, 0, 0.08);
      transition: transform 0.3s ease, box-shadow 0.3s ease;
      text-align: center;
    }
    .feature-glass-card:hover {
      transform: translateY(-8px);
      box-shadow: 0 25px 45px -15px rgba(0, 0, 0, 0.15);
    }
    body.dark-mode .feature-glass-card {
      background: rgba(30, 41, 59, 0.5);
      border: 1px solid rgba(255, 255, 255, 0.08);
      box-shadow: 0 15px 35px -10px rgba(0, 0, 0, 0.3);
    }
    body.dark-mode .feature-glass-card:hover {
      box-shadow: 0 25px 45px -15px rgba(0, 0, 0, 0.5);
    }

    .feature-icon-wrapper {
      width: 64px;
      height: 64px;
      border-radius: 20px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-size: 1.8rem;
      margin-bottom: 1.5rem;
      background: rgba(99, 102, 241, 0.1);
      color: #6366f1;
    }
    body.dark-mode .feature-icon-wrapper {
      background: rgba(99, 102, 241, 0.2);
      color: #818cf8;
    }

    .feature-icon-green { background: rgba(16, 185, 129, 0.1); color: #10b981; }
    body.dark-mode .feature-icon-green { background: rgba(16, 185, 129, 0.2); color: #34d399; }
    
    .feature-icon-orange { background: rgba(245, 158, 11, 0.1); color: #f59e0b; }
    body.dark-mode .feature-icon-orange { background: rgba(245, 158, 11, 0.2); color: #fbbf24; }

    @keyframes scaleIn {
      from { transform: scale(0); opacity: 0; }
      to { transform: scale(1); opacity: 1; }
    }
    @keyframes float {
      0% { transform: translateY(0) scale(1); }
      100% { transform: translateY(-30px) scale(1.05); }
    }
  </style>
</head>

<body class="home-page app-page animated-gradient-bg">

  <div class="ambient-glow glow-primary"></div>
  <div class="ambient-glow glow-info"></div>
  <div id="particlesContainer" class="particles-container"></div>

  <nav class="navbar navbar-expand-lg navbar-light home-navbar shadow-sm position-relative z-3">
    <div class="container">
      <a class="navbar-brand fw-bold d-flex align-items-center" href="/">
        <img src="/logo.png" alt="Ovlink" class="home-brand-logo" />
      </a>
      <div class="ms-auto d-flex align-items-center gap-2">
        <button class="theme-toggle home-theme-btn theme-toggle-animated" aria-label="Temanı Dəyiş" data-i18n-title="theme_toggle_aria">
          <i class="fa-solid fa-sun"></i>
        </button>
      </div>
    </div>
  </nav>

  <main class="bot-auth-wrapper">
    <div class="container">
      
      <!-- Top Row: Centered Auth Card -->
      <div class="row justify-content-center">
        <div class="col-lg-6 col-md-8">
          
          <div class="bot-auth-card text-center">
            
            <div class="platform-header">
              <div class="platform-icon-wrapper <%= platform === 'telegram' ? 'platform-telegram' : 'platform-discord' %>">
                <i class="fa-brands fa-<%= platform %>"></i>
              </div>
              <h2 class="fw-bolder mb-2"><%= platform === 'telegram' ? 'Telegram' : 'Discord' %> Botu</h2>
              <% if (platformUsername) { %>
                <div class="user-profile-badge">
                  <i class="fa-solid fa-at"></i><%= platformUsername %>
                </div>
              <% } %>
            </div>

            <% if (status === 'success') { %>
              <!-- Uğurlu Bağlantı -->
              <div class="status-icon-circle status-success mx-auto">
                <i class="fa-solid fa-check"></i>
              </div>
              
              <h3 class="fw-bold mb-3">Uğurla Bağlandı!</h3>
              <p class="mb-4 opacity-75 px-3">
                Ovlink hesabınız <strong><%= platform === 'telegram' ? 'Telegram' : 'Discord' %></strong> profilinizlə əlaqələndirildi. İndi daha yüksək limitlərlə botdan tam istifadə edə bilərsiniz.
              </p>

              <% if (platform === 'telegram') { %>
                <a href="https://t.me/OvlinkBOT" class="btn btn-primary w-100 action-btn home-primary-btn">
                  <i class="fa-brands fa-telegram me-2"></i> Telegram-a Qayıt
                </a>
              <% } else { %>
                <a href="/" class="btn btn-primary w-100 action-btn home-primary-btn">
                  <i class="fa-solid fa-house me-2"></i> Ana Səhifəyə Get
                </a>
              <% } %>

            <% } else if (status === 'confirm' && user) { %>
              <!-- Təsdiq Ekranı -->
              <div class="status-icon-circle status-info mx-auto">
                <i class="fa-solid fa-link"></i>
              </div>

              <h3 class="fw-bold mb-2">Hesabı Təsdiqləyin</h3>
              <p class="mb-4 opacity-75">
                Bu profili aşağıdakı hesabınıza bağlamaq istəyirsiniz?
              </p>
              
              <div class="p-3 bg-light rounded-4 mb-4 text-center dark-bg-opacity mx-auto" style="max-width: 300px; border: 1px solid rgba(0,0,0,0.05);">
                <div class="small text-muted mb-1" data-i18n="bot_auth_your_account">Ovlink Hesabınız</div>
                <div class="fw-bold fs-6"><%= user.email %></div>
              </div>

              <form method="POST" action="/bot/auth/confirm">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <input type="hidden" name="platform" value="<%= platform %>">
                <input type="hidden" name="id" value="<%= platformUserId %>">
                <input type="hidden" name="name" value="<%= platformUsername %>">
                
                <button type="submit" class="btn btn-primary w-100 action-btn home-primary-btn mb-3">
                  <i class="fa-solid fa-circle-check me-2"></i> Bəli, Bağla
                </button>
              </form>

              <a href="/" class="text-muted text-decoration-none fw-medium hover-primary transition-all small">
                Ləğv et
              </a>

            <% } else if (status === 'error') { %>
              <!-- Xəta Ekranı -->
              <div class="status-icon-circle status-error mx-auto">
                <i class="fa-solid fa-xmark"></i>
              </div>

              <h3 class="fw-bold mb-3">Bağlantı Xətası</h3>
              <p class="mb-4 opacity-75">
                <%= errorMessage || '' %> <span data-i18n="bot_auth_error_fallback" class="<%= errorMessage ? 'd-none' : '' %>">Gözlənilməz xəta baş verdi. Zəhmət olmasa yenidən cəhd edin.</span>
              </p>

              <a href="/" class="btn btn-secondary w-100 action-btn">
                <i class="fa-solid fa-house me-2"></i> Ana Səhifəyə Qayıt
              </a>

            <% } else { %>
              <!-- Giriş Edilməyib -->
              <div class="status-icon-circle status-info mx-auto">
                <i class="fa-solid fa-shield-halved"></i>
              </div>

              <h3 class="fw-bold mb-3">Hesab Təsdiqi</h3>
              <p class="mb-4 opacity-75 px-2">
                Profilinizi bağlamaq üçün zəhmət olmasa Ovlink hesabınıza daxil olun və ya yeni hesab yaradın.
              </p>

              <div class="d-grid gap-3">
                <a href="/login?redirect=<%= encodeURIComponent('/bot/auth?platform=' + platform + '&id=' + platformUserId + '&name=' + encodeURIComponent(platformUsername)) %>" class="btn btn-primary w-100 action-btn home-primary-btn d-flex align-items-center justify-content-center">
                  <i class="fa-solid fa-right-to-bracket me-2"></i> Giriş Et
                </a>
                <a href="/register?redirect=<%= encodeURIComponent('/bot/auth?platform=' + platform + '&id=' + platformUserId + '&name=' + encodeURIComponent(platformUsername)) %>" class="btn btn-outline-secondary w-100 action-btn d-flex align-items-center justify-content-center">
                  <i class="fa-solid fa-user-plus me-2"></i> Yeni Hesab Yarat
                </a>
              </div>
            <% } %>

          </div>
          
        </div>
      </div>

      <!-- Bottom Row: Features Grid -->
      <div class="row features-container mt-4">
        <div class="col-12 text-center mb-5">
          <h4 class="fw-bold opacity-75" style="letter-spacing: -0.5px;">Niyə Botdan İstifade Etməliyəm?</h4>
        </div>
        
        <div class="col-lg-4 col-md-6 mb-4">
          <div class="feature-glass-card">
            <div class="feature-icon-wrapper">
              <i class="fa-solid fa-bolt"></i>
            </div>
            <h5 class="fw-bold mb-2">Sürətli Qısaltma</h5>
            <p class="mb-0 opacity-75 small">Sayta daxil olmadan istənilən linki bota göndərin və dərhal qısaldılmış versiyasını əldə edin.</p>
          </div>
        </div>
        
        <div class="col-lg-4 col-md-6 mb-4">
          <div class="feature-glass-card">
            <div class="feature-icon-wrapper feature-icon-green">
              <i class="fa-solid fa-qrcode"></i>
            </div>
            <h5 class="fw-bold mb-2">Anında QR Kodlar</h5>
            <p class="mb-0 opacity-75 small">Linkləriniz üçün dərhal yüksək keyfiyyətli QR kodları birbaşa mesajlaşma çatından yükləyin.</p>
          </div>
        </div>
        
        <div class="col-lg-4 col-md-6 mb-4 mx-auto">
          <div class="feature-glass-card">
            <div class="feature-icon-wrapper feature-icon-orange">
              <i class="fa-solid fa-chart-pie"></i>
            </div>
            <h5 class="fw-bold mb-2">Canlı Statistika</h5>
            <p class="mb-0 opacity-75 small">Linklərinizə neçə dəfə klikləndiyini, baxışları və günlük limit vəziyyətinizi asanlıqla yoxlayın.</p>
          </div>
        </div>
      </div>

    </div>
  </main>

  <!-- Script for Theme Toggle -->
  <script nonce="<%= nonce %>" src="/script.js?v=<%= assetVersion %>"></script>
  <script nonce="<%= nonce %>" src="/lang.js"></script>
</body>

</html>
