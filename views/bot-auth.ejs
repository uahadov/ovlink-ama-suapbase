<!doctype html>
<html lang="az">
<head>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=<%= (typeof assetVersion !== 'undefined' ? assetVersion : '1') %>" />
  <link rel="icon" href="/favicon.ico?v=<%= (typeof assetVersion !== 'undefined' ? assetVersion : '1') %>" />
  <link rel="apple-touch-icon" href="/logo.png?v=<%= (typeof assetVersion !== 'undefined' ? assetVersion : '1') %>" />
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="csrf-token" content="<%= csrfToken %>">
  <title data-i18n="bot_auth_title">Bot Doğrulaması - Ovlink</title>
  
  <link rel="manifest" href="/site.webmanifest" />

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin>
  <link rel="preload" href="/vendor/fontawesome/webfonts/fa-solid-900.woff2?v=<%= (typeof assetVersion !== 'undefined' ? assetVersion : '1') %>" as="font" type="font/woff2" crossorigin />
  <link rel="stylesheet" href="/vendor/fontawesome/css/all.min.css?v=<%= (typeof assetVersion !== 'undefined' ? assetVersion : '1') %>" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" integrity="sha512-iecdLmaskl7CVkqkXNQ/ZH/XLlvWZOJyj7Yy7tcenmpD1ypASozpmT/E0iPtmFIB46ZmdtAc9eNBvH0H/ZpiBw==" crossorigin="anonymous" referrerpolicy="no-referrer" />

  <link rel="stylesheet" href="/home.css?v=<%= assetVersion %>" />
</head>

<body class="ovx home-page bot-auth-page">

  <!-- Skip to content for accessibility -->
  <a href="#mainContent" class="m-skip-link" data-i18n="skip_to_content">Skip to content</a>

  <!-- Ambient background glow -->
  <div id="cursorGlow" aria-hidden="true"></div>

  <% if (siteSettings && siteSettings.announcement_enabled === '1' && (siteSettings.announcement_text_az || siteSettings.announcement_text_tr || siteSettings.announcement_text_en)) { %>
    <div id="siteAnnouncement" class="site-announcement" data-az="<%= siteSettings.announcement_text_az || '' %>" data-tr="<%= siteSettings.announcement_text_tr || '' %>" data-en="<%= siteSettings.announcement_text_en || '' %>">
      <div class="shell">
        <i class="fa-solid fa-bullhorn"></i>
        <span id="siteAnnouncementText"><%= siteSettings.announcement_text_az || siteSettings.announcement_text_tr || siteSettings.announcement_text_en %></span>
      </div>
    </div>
  <% } %>

  <%- include('partials/home-navbar') %>

  <main class="m-page-shell m-page-shell--top" id="mainContent">
    <div class="shell">

      <!-- Centered Monolith Bot Auth Card -->
      <div class="m-bot-card">

        <!-- Platform Header -->
        <div class="m-bot-avatar <%= platform === 'telegram' ? 'm-bot-avatar--telegram' : 'm-bot-avatar--discord' %>" aria-hidden="true">
          <i class="fa-brands fa-<%= platform %>"></i>
        </div>

        <div class="m-kicker mb-2" data-i18n="bot_auth_gateway_badge">Bot Gateway</div>
        <h1 class="m-gateway-title" style="font-size: clamp(22px, 3.5vw, 28px); margin-bottom: 8px;">
          <%= platform === 'telegram' ? 'Telegram' : 'Discord' %> Bot
        </h1>

        <% if (platformUsername) { %>
          <div class="m-bot-user-pill">
            <i class="fa-solid fa-at" aria-hidden="true"></i>
            <span><%= platformUsername %></span>
          </div>
        <% } %>

        <!-- Pairing Code Box with 1-Click Copy -->
        <% if (platformUserId) { %>
          <div class="m-bot-pairing-box">
            <div class="m-bot-pairing-info">
              <span class="m-bot-pairing-label" data-i18n="bot_auth_pairing_code">Qoşulma Kodu / ID</span>
              <code class="m-bot-pairing-code" id="pairingCodeVal"><%= platformUserId %></code>
            </div>
            <button type="button" class="m-copy-btn" id="copyPairingCodeBtn" data-copy="<%= platformUserId %>" aria-label="Copy code">
              <i class="fa-regular fa-clone" aria-hidden="true"></i>
              <span class="m-copy-text" data-i18n="bot_auth_copy">Kopyala</span>
            </button>
          </div>
        <% } %>

        <% if (status === 'success') { %>
          <!-- SUCCESS STATE -->
          <div class="m-bot-status-glyph m-bot-status-glyph--success" aria-hidden="true">
            <i class="fa-solid fa-check"></i>
          </div>

          <h2 class="m-gateway-title" data-i18n="bot_auth_success_title">Uğurla Bağlandı!</h2>
          <p class="m-gateway-sub" data-i18n="bot_auth_success_desc">
            Ovlink hesabınız bot profilinizlə əlaqələndirildi. İndi daha yüksək limitlərlə botdan tam istifadə edə bilərsiniz.
          </p>

          <div class="m-actions-row">
            <% if (platform === 'telegram') { %>
              <a href="https://t.me/OvlinkBOT" class="m-cta m-cta--white">
                <i class="fa-brands fa-telegram" aria-hidden="true"></i>
                <span data-i18n="bot_auth_return_telegram">Telegram-a Qayıt</span>
              </a>
            <% } else { %>
              <a href="/" class="m-cta m-cta--white">
                <i class="fa-solid fa-house" aria-hidden="true"></i>
                <span data-i18n="bot_auth_go_home">Ana Səhifəyə Get</span>
              </a>
            <% } %>
            <a href="/dashboard" class="m-cta m-cta--outline">
              <i class="fa-solid fa-chart-line" aria-hidden="true"></i>
              <span data-i18n="dashboard_title">Dashboard</span>
            </a>
          </div>

        <% } else if (status === 'confirm' && user) { %>
          <!-- CONFIRM STATE (Logged In) -->
          <div class="m-bot-status-glyph m-bot-status-glyph--info" aria-hidden="true">
            <i class="fa-solid fa-link"></i>
          </div>

          <h2 class="m-gateway-title" data-i18n="bot_auth_confirm_title">Hesabı Təsdiqləyin</h2>
          <p class="m-gateway-sub" data-i18n="bot_auth_confirm_desc">
            Bu bot profilini aşağıdakı Ovlink hesabınıza bağlamaq istəyirsiniz?
          </p>

          <div class="m-bot-account-box">
            <div class="m-bot-account-icon" aria-hidden="true">
              <i class="fa-regular fa-user"></i>
            </div>
            <div class="m-bot-account-meta">
              <div class="m-bot-account-label" data-i18n="bot_auth_your_account">Ovlink Hesabınız</div>
              <div class="m-bot-account-email"><%= user.email %></div>
            </div>
          </div>

          <form method="POST" action="/bot/auth/confirm" class="m-actions-row" style="flex-direction: column; width: 100%;">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <input type="hidden" name="platform" value="<%= platform %>">
            <input type="hidden" name="id" value="<%= platformUserId %>">
            <input type="hidden" name="name" value="<%= platformUsername %>">

            <button type="submit" class="m-cta m-cta--white" style="width: 100%; justify-content: center;">
              <i class="fa-solid fa-circle-check" aria-hidden="true"></i>
              <span data-i18n="bot_auth_confirm_btn">Hesabı Təsdiqlə və Bağla</span>
            </button>
            <a href="/" class="m-cta m-cta--outline" style="width: 100%; justify-content: center;">
              <span data-i18n="bot_auth_cancel_btn">Ləğv et</span>
            </a>
          </form>

        <% } else if (status === 'error') { %>
          <!-- ERROR STATE -->
          <div class="m-bot-status-glyph m-bot-status-glyph--danger" aria-hidden="true">
            <i class="fa-solid fa-xmark"></i>
          </div>

          <h2 class="m-gateway-title" data-i18n="bot_auth_error_title">Bağlantı Xətası</h2>
          <p class="m-gateway-sub">
            <%= errorMessage || '' %>
            <span data-i18n="bot_auth_error_fallback" class="<%= errorMessage ? 'd-none' : '' %>">
              Doğrulama xətası baş verdi. Zəhmət olmasa yenidən cəhd edin.
            </span>
          </p>

          <div class="m-actions-row">
            <a href="/" class="m-cta m-cta--outline">
              <i class="fa-solid fa-house" aria-hidden="true"></i>
              <span data-i18n="bot_auth_go_home">Ana Səhifəyə Get</span>
            </a>
          </div>

        <% } else { %>
          <!-- LOGIN REQUIRED STATE (Guest) -->
          <div class="m-bot-status-glyph m-bot-status-glyph--info" aria-hidden="true">
            <i class="fa-solid fa-shield-halved"></i>
          </div>

          <h2 class="m-gateway-title" data-i18n="bot_auth_login_req_title">Hesab Girişi Tələb Olunur</h2>
          <p class="m-gateway-sub" data-i18n="bot_auth_login_req_desc">
            Bot profilinizi bağlamaq üçün zəhmət olmasa Ovlink hesabınıza daxil olun və ya yeni hesab yaradın.
          </p>

          <div class="m-bot-steps">
            <div class="m-bot-step">
              <div class="m-bot-step-num">Step 01</div>
              <div class="m-bot-step-title" data-i18n="bot_auth_step1">1. Ovlink Hesabına Daxil Olun</div>
            </div>
            <div class="m-bot-step">
              <div class="m-bot-step-num">Step 02</div>
              <div class="m-bot-step-title" data-i18n="bot_auth_step2">2. Bot Əlaqəsini Təsdiqləyin</div>
            </div>
          </div>

          <div class="m-actions-row" style="flex-direction: column; width: 100%;">
            <a href="/login?redirect=<%= encodeURIComponent('/bot/auth?platform=' + platform + '&id=' + platformUserId + '&name=' + encodeURIComponent(platformUsername)) %>" class="m-cta m-cta--white" style="width: 100%; justify-content: center;">
              <i class="fa-solid fa-right-to-bracket" aria-hidden="true"></i>
              <span data-i18n="bot_auth_login_btn">Daxil Ol</span>
            </a>
            <a href="/register?redirect=<%= encodeURIComponent('/bot/auth?platform=' + platform + '&id=' + platformUserId + '&name=' + encodeURIComponent(platformUsername)) %>" class="m-cta m-cta--outline" style="width: 100%; justify-content: center;">
              <i class="fa-solid fa-user-plus" aria-hidden="true"></i>
              <span data-i18n="bot_auth_register_btn">Qeydiyyatdan Keç</span>
            </a>
          </div>
        <% } %>

      </div>

      <!-- Feature Grid: Why Use Bot -->
      <div style="text-align: center; margin-top: 48px; margin-bottom: 24px;">
        <h3 class="m-section-h2" style="font-size: 22px; font-weight: 700; color: var(--c-white);" data-i18n="bot_auth_why_title">
          Niyə Botdan İstifadə Etməliyəm?
        </h3>
      </div>

      <div class="m-bot-features-grid">
        <article class="m-bot-feature-card">
          <div class="m-bot-feature-icon" aria-hidden="true">
            <i class="fa-solid fa-bolt"></i>
          </div>
          <h4 class="m-bot-feature-title" data-i18n="bot_auth_feat_speed_title">Sürətli Qısaltma</h4>
          <p class="m-bot-feature-desc" data-i18n="bot_auth_feat_speed_desc">
            Sayta daxil olmadan istənilən linki bota göndərin və dərhal qısaldılmış versiyasını əldə edin.
          </p>
        </article>

        <article class="m-bot-feature-card">
          <div class="m-bot-feature-icon" aria-hidden="true">
            <i class="fa-solid fa-qrcode"></i>
          </div>
          <h4 class="m-bot-feature-title" data-i18n="bot_auth_feat_qr_title">Anında QR Kodlar</h4>
          <p class="m-bot-feature-desc" data-i18n="bot_auth_feat_qr_desc">
            Linkləriniz üçün dərhal yüksək keyfiyyətli QR kodları birbaşa mesajlaşma çatından yükləyin.
          </p>
        </article>

        <article class="m-bot-feature-card">
          <div class="m-bot-feature-icon" aria-hidden="true">
            <i class="fa-solid fa-chart-pie"></i>
          </div>
          <h4 class="m-bot-feature-title" data-i18n="bot_auth_feat_stats_title">Canlı Statistika</h4>
          <p class="m-bot-feature-desc" data-i18n="bot_auth_feat_stats_desc">
            Linklərinizə neçə dəfə klikləndiyini, baxışları və günlük limit vəziyyətinizi asanlıqla yoxlayın.
          </p>
        </article>
      </div>

    </div>
  </main>

  <%- include('partials/home-footer') %>

  <script nonce="<%= nonce %>" src="/lang.js?v=<%= assetVersion %>"></script>
  <script nonce="<%= nonce %>" src="/script.js?v=<%= assetVersion %>"></script>
  <script nonce="<%= nonce %>">
    (function () {
      /* ─── Navbar dropdowns & mobile menu are managed by partials/home-navbar ─── */

      /* ─── Button Ripple Effect ─── */
      document.querySelectorAll('.m-cta, .m-btn-solid').forEach(function (btn) {
        btn.addEventListener('click', function (e) {
          var r = btn.getBoundingClientRect();
          var size = Math.max(r.width, r.height);
          var span = document.createElement('span');
          span.className = 'm-ripple';
          span.style.width = span.style.height = size + 'px';
          span.style.left = (e.clientX - r.left - size / 2) + 'px';
          span.style.top = (e.clientY - r.top - size / 2) + 'px';
          btn.appendChild(span);
          setTimeout(function () { span.remove(); }, 600);
        });
      });

      /* ─── 1-Click Copy Pairing Code ─── */
      var copyBtn = document.getElementById('copyPairingCodeBtn');
      if (copyBtn) {
        copyBtn.addEventListener('click', function () {
          var textToCopy = copyBtn.getAttribute('data-copy') || '';
          if (!textToCopy) return;

          function showCopied() {
            copyBtn.classList.add('copied');
            var icon = copyBtn.querySelector('i');
            var text = copyBtn.querySelector('.m-copy-text');
            if (icon) icon.className = 'fa-solid fa-check';
            if (text) text.textContent = (window.ovlinkI18n && window.ovlinkI18n.t) ? window.ovlinkI18n.t('bot_auth_copied') : 'Copied!';
            setTimeout(function () {
              copyBtn.classList.remove('copied');
              if (icon) icon.className = 'fa-regular fa-clone';
              if (text) text.textContent = (window.ovlinkI18n && window.ovlinkI18n.t) ? window.ovlinkI18n.t('bot_auth_copy') : 'Copy';
            }, 2000);
          }

          if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(textToCopy).then(showCopied).catch(function () {
              legacyCopy(textToCopy);
            });
          } else {
            legacyCopy(textToCopy);
          }

          function legacyCopy(val) {
            var input = document.createElement('input');
            input.value = val;
            document.body.appendChild(input);
            input.select();
            try { document.execCommand('copy'); showCopied(); } catch (_) {}
            document.body.removeChild(input);
          }
        });
      }
    })();
  </script>
</body>
</html>
