<!DOCTYPE html>
<html lang="az">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="csrf-token" content="<%= csrfToken %>">
  <title>Bot Bağlantısı - Ovlink</title>
  <link rel="icon" href="/logo.ico" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
  <link rel="stylesheet" href="/style.css?v=<%= assetVersion %>">
  <style>
    /* Custom Styles for Bot Auth Page */
    .bot-auth-wrapper {
      min-height: calc(100vh - 80px);
      display: flex;
      align-items: center;
      position: relative;
      z-index: 2;
      padding: 4rem 0;
    }

    /* Ambient Background Glows */
    .ambient-glow {
      position: absolute;
      border-radius: 50%;
      filter: blur(100px);
      z-index: 1;
      opacity: 0.6;
      animation: float 10s infinite ease-in-out alternate;
    }
    .glow-primary {
      background: rgba(99, 102, 241, 0.4);
      width: 500px;
      height: 500px;
      top: -10%;
      left: -10%;
    }
    .glow-info {
      background: rgba(6, 182, 212, 0.3);
      width: 400px;
      height: 400px;
      bottom: -10%;
      right: -5%;
      animation-delay: -5s;
    }

    /* Content Styling */
    .bot-hero-content {
      padding-right: 3rem;
    }
    
    .bot-icon-container {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 96px;
      height: 96px;
      border-radius: 28px;
      margin-bottom: 2rem;
      background: linear-gradient(135deg, rgba(255,255,255,0.1), rgba(255,255,255,0));
      backdrop-filter: blur(20px);
      border: 1px solid rgba(255,255,255,0.2);
      box-shadow: 0 25px 50px -12px rgba(0,0,0,0.15);
      position: relative;
    }
    body.dark-mode .bot-icon-container {
      background: linear-gradient(135deg, rgba(255,255,255,0.05), rgba(255,255,255,0));
      border: 1px solid rgba(255,255,255,0.1);
    }
    
    .bot-icon-telegram { color: #0088cc; text-shadow: 0 4px 15px rgba(0,136,204,0.4); }
    body.dark-mode .bot-icon-telegram { color: #38bdf8; text-shadow: 0 4px 15px rgba(56,189,248,0.4); }
    
    .bot-icon-discord { color: #5865F2; text-shadow: 0 4px 15px rgba(88,101,242,0.4); }

    .bot-feature-list {
      list-style: none;
      padding: 0;
      margin-top: 2.5rem;
    }
    .bot-feature-item {
      display: flex;
      align-items: flex-start;
      margin-bottom: 1.5rem;
      transition: transform 0.3s ease;
    }
    .bot-feature-item:hover {
      transform: translateX(10px);
    }
    .feature-icon-wrapper {
      width: 48px;
      height: 48px;
      border-radius: 14px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.25rem;
      margin-right: 1.25rem;
      flex-shrink: 0;
      background: rgba(255,255,255,0.5);
      box-shadow: 0 4px 15px rgba(0,0,0,0.05);
    }
    body.dark-mode .feature-icon-wrapper {
      background: rgba(255,255,255,0.05);
      box-shadow: inset 0 1px 0 rgba(255,255,255,0.1);
    }

    /* Glass Auth Card */
    .bot-auth-card {
      border-radius: 32px;
      padding: 3rem;
      background: rgba(255, 255, 255, 0.7);
      backdrop-filter: blur(40px);
      -webkit-backdrop-filter: blur(40px);
      border: 1px solid rgba(255, 255, 255, 0.5);
      box-shadow: 0 30px 60px -15px rgba(0, 0, 0, 0.1), inset 0 1px 0 rgba(255, 255, 255, 0.8);
      position: relative;
      overflow: hidden;
    }
    body.dark-mode .bot-auth-card {
      background: rgba(30, 41, 59, 0.6);
      border: 1px solid rgba(255, 255, 255, 0.08);
      box-shadow: 0 30px 60px -15px rgba(0, 0, 0, 0.4), inset 0 1px 0 rgba(255, 255, 255, 0.1);
    }

    /* Card Status Elements */
    .status-icon-circle {
      width: 80px;
      height: 80px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 1.5rem;
      font-size: 2.5rem;
      animation: scaleIn 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
    }
    .status-success {
      background: rgba(16, 185, 129, 0.1);
      color: #10b981;
      box-shadow: 0 0 30px rgba(16, 185, 129, 0.2);
    }
    .status-error {
      background: rgba(239, 68, 68, 0.1);
      color: #ef4444;
      box-shadow: 0 0 30px rgba(239, 68, 68, 0.2);
    }
    .status-info {
      background: rgba(99, 102, 241, 0.1);
      color: #6366f1;
      box-shadow: 0 0 30px rgba(99, 102, 241, 0.2);
    }

    .user-profile-badge {
      display: inline-flex;
      align-items: center;
      gap: 0.75rem;
      padding: 0.75rem 1.5rem;
      background: rgba(255, 255, 255, 0.5);
      border: 1px solid rgba(255, 255, 255, 0.3);
      border-radius: 99px;
      font-weight: 600;
      color: #334155;
      margin-bottom: 2rem;
    }
    body.dark-mode .user-profile-badge {
      background: rgba(0, 0, 0, 0.2);
      border-color: rgba(255, 255, 255, 0.05);
      color: #e2e8f0;
    }
    
    .action-btn {
      padding: 1rem 2rem;
      border-radius: 16px;
      font-size: 1.1rem;
      font-weight: 600;
      transition: all 0.3s ease;
      letter-spacing: 0.3px;
    }
    .action-btn:hover {
      transform: translateY(-2px);
      box-shadow: 0 10px 25px -5px rgba(99, 102, 241, 0.4);
    }

    @keyframes scaleIn {
      from { transform: scale(0); opacity: 0; }
      to { transform: scale(1); opacity: 1; }
    }
    @keyframes float {
      0% { transform: translateY(0) scale(1); }
      100% { transform: translateY(-20px) scale(1.05); }
    }
  </style>
</head>

<body class="home-page app-page animated-gradient-bg">

  <div class="ambient-glow glow-primary"></div>
  <div class="ambient-glow glow-info"></div>
  <div id="particlesContainer" class="particles-container"></div>

  <nav class="navbar navbar-expand-lg navbar-light home-navbar shadow-sm position-relative z-3">
    <div class="container">
      <a class="navbar-brand fw-bold d-flex align-items-center" href="/">
        <img src="/logo.png" alt="Ovlink" class="home-brand-logo" />
      </a>
      <div class="ms-auto d-flex align-items-center gap-2">
        <button class="theme-toggle home-theme-btn theme-toggle-animated" aria-label="Temanı Dəyiş">
          <i class="fa-solid fa-sun"></i>
        </button>
      </div>
    </div>
  </nav>

  <main class="bot-auth-wrapper">
    <div class="container">
      <div class="row align-items-center">
        
        <!-- Left Side: Hero Info -->
        <div class="col-lg-6 mb-5 mb-lg-0 bot-hero-content">
          <div class="bot-icon-container">
            <% if (platform === 'telegram') { %>
              <i class="fa-brands fa-telegram fa-4x bot-icon-telegram"></i>
            <% } else { %>
              <i class="fa-brands fa-discord fa-4x bot-icon-discord"></i>
            <% } %>
          </div>
          
          <h1 class="display-4 fw-bolder mb-3" style="letter-spacing: -1px;">
            Ovlink Bot-a <br><span class="text-primary bg-clip-text">Qoşulun</span>
          </h1>
          
          <p class="lead opacity-75 mb-4">
            <%= platform === 'telegram' ? 'Telegram' : 'Discord' %> hesabınızı bağlayaraq linklərinizi anında idarə edin, QR kodlar yaradın və detallı statistikanızı birbaşa mesajlaşma tətbiqinizdən izləyin.
          </p>

          <ul class="bot-feature-list">
            <li class="bot-feature-item">
              <div class="feature-icon-wrapper text-primary">
                <i class="fa-solid fa-bolt"></i>
              </div>
              <div>
                <h5 class="fw-bold mb-1">Sürətli Qısaltma</h5>
                <p class="mb-0 opacity-75 small">Bot-a istənilən linki göndərin və dərhal qısaldılmış versiyasını əldə edin.</p>
              </div>
            </li>
            <li class="bot-feature-item">
              <div class="feature-icon-wrapper text-success">
                <i class="fa-solid fa-qrcode"></i>
              </div>
              <div>
                <h5 class="fw-bold mb-1">Anında QR Kodlar</h5>
                <p class="mb-0 opacity-75 small">Yaratdığınız linklər üçün yüksək keyfiyyətli QR kodları birbaşa çatdan yükləyin.</p>
              </div>
            </li>
            <li class="bot-feature-item">
              <div class="feature-icon-wrapper text-warning">
                <i class="fa-solid fa-chart-pie"></i>
              </div>
              <div>
                <h5 class="fw-bold mb-1">Canlı Statistika</h5>
                <p class="mb-0 opacity-75 small">Kklikləri, baxışları və hesabınızın limit durumunu asanlıqla yoxlayın.</p>
              </div>
            </li>
          </ul>
        </div>

        <!-- Right Side: Auth Card -->
        <div class="col-lg-6">
          <div class="bot-auth-card text-center">
            
            <% if (platformUsername) { %>
              <div class="user-profile-badge shadow-sm">
                <% if (platform === 'telegram') { %>
                  <i class="fa-brands fa-telegram text-info"></i>
                <% } else { %>
                  <i class="fa-brands fa-discord" style="color: #5865F2;"></i>
                <% } %>
                @<%= platformUsername %>
              </div>
            <% } %>

            <% if (status === 'success') { %>
              <!-- Uğurlu Bağlantı -->
              <div class="status-icon-circle status-success">
                <i class="fa-solid fa-check"></i>
              </div>
              
              <h3 class="fw-bold mb-3">Hesabınız Uğurla Bağlandı!</h3>
              <p class="mb-4 opacity-75 px-3">
                Əla! Ovlink hesabınız <strong><%= platform === 'telegram' ? 'Telegram' : 'Discord' %></strong> profilinizlə əlaqələndirildi. İndi daha yüksək limitlərlə botdan istifadə edə bilərsiniz.
              </p>

              <% if (platform === 'telegram') { %>
                <a href="https://t.me/OvlinkBOT" class="btn btn-primary w-100 action-btn home-primary-btn">
                  <i class="fa-brands fa-telegram me-2"></i>Telegram-a Qayıt
                </a>
              <% } else { %>
                <a href="/" class="btn btn-primary w-100 action-btn home-primary-btn">
                  <i class="fa-solid fa-house me-2"></i>Ana Səhifəyə Get
                </a>
              <% } %>
              
              <div class="mt-4 pt-3 border-top border-secondary border-opacity-10">
                <span class="text-muted small"><i class="fa-solid fa-shield-halved me-1"></i> Təhlükəsiz şəkildə bağlandı</span>
              </div>

            <% } else if (status === 'confirm' && user) { %>
              <!-- Təsdiq Ekranı (İstifadəçi Giriş Edib) -->
              <div class="status-icon-circle status-info">
                <i class="fa-solid fa-link"></i>
              </div>

              <h3 class="fw-bold mb-2">Bağlantını Təsdiqləyin</h3>
              <p class="mb-4 opacity-75">
                Bu bot profilini aşağıdakı Ovlink hesabına bağlamaq istədiyinizdən əminsiniz?
              </p>
              
              <div class="p-3 bg-light rounded-3 mb-4 d-inline-block text-start w-100 dark-bg-opacity">
                <div class="d-flex align-items-center">
                  <div class="bg-primary bg-opacity-10 p-2 rounded-circle me-3">
                    <i class="fa-solid fa-user text-primary"></i>
                  </div>
                  <div>
                    <div class="small text-muted">Ovlink Hesabı</div>
                    <div class="fw-bold"><%= user.email %></div>
                  </div>
                </div>
              </div>

              <form method="POST" action="/bot/auth/confirm">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <input type="hidden" name="platform" value="<%= platform %>">
                <input type="hidden" name="id" value="<%= platformUserId %>">
                <input type="hidden" name="name" value="<%= platformUsername %>">
                
                <button type="submit" class="btn btn-primary w-100 action-btn home-primary-btn mb-3">
                  Bağlantını Təsdiqlə
                </button>
              </form>

              <a href="/" class="text-muted text-decoration-none fw-medium hover-primary transition-all">
                Ləğv et və ana səhifəyə qayıt
              </a>

            <% } else if (status === 'error') { %>
              <!-- Xəta Ekranı -->
              <div class="status-icon-circle status-error">
                <i class="fa-solid fa-xmark"></i>
              </div>

              <h3 class="fw-bold mb-3">Bağlantı Alınmadı</h3>
              <p class="mb-4 opacity-75">
                <%= errorMessage || 'Gözlənilməz xəta baş verdi. Zəhmət olmasa yenidən cəhd edin.' %>
              </p>

              <a href="/" class="btn btn-secondary w-100 action-btn">
                <i class="fa-solid fa-house me-2"></i>Ana Səhifəyə Qayıt
              </a>

            <% } else { %>
              <!-- Giriş Edilməyib -->
              <div class="status-icon-circle status-info">
                <i class="fa-solid fa-shield-halved"></i>
              </div>

              <h3 class="fw-bold mb-3">Hesab Təsdiqi Tələb Olunur</h3>
              <p class="mb-4 opacity-75">
                Bot profilinizi bağlamaq və yüksək limitlərdən istifadə etmək üçün zəhmət olmasa Ovlink hesabınıza daxil olun və ya yeni hesab yaradın.
              </p>

              <div class="d-grid gap-3">
                <a href="/login?redirect=<%= encodeURIComponent('/bot/auth?platform=' + platform + '&id=' + platformUserId + '&name=' + encodeURIComponent(platformUsername)) %>" class="btn btn-primary w-100 action-btn home-primary-btn d-flex align-items-center justify-content-center">
                  <i class="fa-solid fa-right-to-bracket me-2"></i> Giriş Et
                </a>
                <a href="/register?redirect=<%= encodeURIComponent('/bot/auth?platform=' + platform + '&id=' + platformUserId + '&name=' + encodeURIComponent(platformUsername)) %>" class="btn btn-outline-secondary w-100 action-btn d-flex align-items-center justify-content-center">
                  <i class="fa-solid fa-user-plus me-2"></i> Hesab Yarat
                </a>
              </div>
              
              <div class="mt-4 pt-3 border-top border-secondary border-opacity-10 text-start">
                <p class="text-muted small mb-0"><i class="fa-solid fa-circle-info me-1"></i> Hesabınızı bağlamaq pulsuzdur və istədiyiniz zaman bot üzərindən əlaqəni kəsə bilərsiniz.</p>
              </div>
            <% } %>

          </div>
        </div>
        
      </div>
    </div>
  </main>

  <!-- Script for Theme Toggle -->
  <script src="/script.js?v=<%= assetVersion %>"></script>
</body>

</html>
