<!doctype html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="csrf-token" content="<%= csrfToken %>">
  <title data-i18n="ws_accept_title">Workspace dəvəti</title>
  <link rel="icon" href="/logo.ico" />
  <link rel="preconnect" href="https://cdn.jsdelivr.net">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
  <link rel="stylesheet" href="/style.css?v=<%= assetVersion %>" />
</head>

<body class="home-page app-page animated-gradient-bg">

  <div id="particlesContainer" class="particles-container"></div>

  <%- include('partials/public-navbar') %>

  <main class="app-main">
    <section class="container">
      <div class="app-shell">
        <div class="policy-head">
          <h1 class="policy-title" data-i18n="ws_accept_title">Workspace dəvəti</h1>
        </div>

        <div class="policy-card app-card">
          <% if (state === 'ready') { %>
            <p class="mb-1" data-i18n="ws_accept_desc">Siz workspace-ə dəvət olundunuz:</p>
            <h5 class="fw-bold mb-3"><i class="fa-solid fa-users me-2"></i><%= workspaceName %></h5>
            <form method="POST" action="/workspaces/accept">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <input type="hidden" name="token" value="<%= token %>">
              <div class="d-flex gap-2 flex-wrap">
                <button type="submit" class="btn btn-primary rounded-pill" data-i18n="ws_accept_btn">Dəvəti qəbul et</button>
                <a href="/dashboard" class="btn btn-outline-secondary rounded-pill" data-i18n="ws_accept_decline">İmtina et</a>
              </div>
            </form>
          <% } else if (state === 'login_required') { %>
            <p class="mb-3" data-i18n="ws_accept_login_first">Dəvəti qəbul etmək üçün əvvəlcə hesabınıza daxil olun, sonra bu linki yenidən açın.</p>
            <a href="/login" class="btn btn-primary rounded-pill" data-i18n="nav_login">Giriş</a>
          <% } else if (state === 'wrong_email') { %>
            <div class="alert alert-warning py-2 small" data-i18n="ws_accept_wrong_email">Bu dəvət başqa bir e-poçt ünvanı üçün göndərilib. Düzgün hesabla daxil olun.</div>
            <p class="small text-muted mb-0"><span data-i18n="ws_accept_invited_email">Dəvət olunan ünvan:</span> <code><%= invitedEmailMasked %></code></p>
          <% } else if (state === 'already_member' || state === 'accepted') { %>
            <div class="alert alert-success py-2 small" data-i18n="ws_accept_already">Siz bu workspace-in üzvüsünüz.</div>
            <a href="/dashboard" class="btn btn-primary rounded-pill" data-i18n="ws_open_dashboard">Linklər</a>
          <% } else { %>
            <div class="alert alert-danger py-2 small" data-i18n="ws_accept_invalid">Bu dəvət etibarsızdır, vaxtı bitib və ya ləğv edilib.</div>
            <a href="/dashboard" class="btn btn-outline-secondary rounded-pill" data-i18n="ws_open_dashboard">Linklər</a>
          <% } %>
        </div>

      </div>
    </section>
  </main>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/lang.js?v=<%= assetVersion %>"></script>
  <script src="/script.js?v=<%= assetVersion %>"></script>
</body>

</html>
