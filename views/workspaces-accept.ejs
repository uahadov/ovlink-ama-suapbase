<!doctype html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="csrf-token" content="<%= csrfToken %>">
  <title data-i18n="ws_accept_title">Workspace dəvəti</title>
  <link rel="icon" href="/logo.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  
  <link rel="preload" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" as="style" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" media="print" id="bs-css" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap" media="print" id="gf-css" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" media="print" id="fa-css" />
  <script nonce="<%= nonce %>">
    var bs = document.getElementById("bs-css"); if (bs) bs.media = "all";
    var gf = document.getElementById("gf-css"); if (gf) gf.media = "all";
    document.getElementById("fa-css").media = "all";
  </script>
  <noscript>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
  </noscript>
  
  <link rel="stylesheet" href="/style.css?v=<%= assetVersion %>" />
</head>

<body class="home-page app-page animated-gradient-bg">

  <div id="particlesContainer" class="particles-container"></div>

  <%- include('partials/public-navbar') %>

  <main class="app-main">
    <section class="container d-flex justify-content-center align-items-center" style="min-height: calc(100vh - 100px);">
      <div class="app-shell" style="max-width: 500px; width: 100%;">
        <div class="policy-card app-card text-center p-4 p-md-5">
          <div class="mb-4">
            <div class="d-inline-flex justify-content-center align-items-center bg-primary bg-opacity-10 text-primary rounded-circle mb-3" style="width: 72px; height: 72px;">
              <i class="fa-solid fa-users fa-2x"></i>
            </div>
            <h2 class="fw-bold mb-2" data-i18n="ws_accept_title">Workspace dəvəti</h2>
          </div>

          <% if (state === 'ready') { %>
            <p class="text-muted mb-2" data-i18n="ws_accept_desc">Siz workspace-ə dəvət olundunuz:</p>
            <h4 class="fw-bold text-gradient mb-4"><%= workspaceName %></h4>
            
            <form method="POST" action="/workspaces/accept">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <input type="hidden" name="token" value="<%= token %>">
              <div class="d-flex justify-content-center align-items-center gap-3 flex-wrap">
                <button type="submit" class="btn btn-primary rounded-pill px-4 py-2" data-i18n="ws_accept_btn">Dəvəti qəbul et</button>
                <a href="/dashboard" class="btn btn-outline-secondary rounded-pill px-4 py-2" data-i18n="ws_accept_decline">İmtina et</a>
              </div>
            </form>
          <% } else if (state === 'login_required') { %>
            <p class="mb-4 text-muted" data-i18n="ws_accept_login_first">Dəvəti qəbul etmək üçün əvvəlcə hesabınıza daxil olun, sonra bu linki yenidən açın.</p>
            <a href="/login" class="btn btn-primary rounded-pill px-4 py-2" data-i18n="nav_login">Giriş</a>
          <% } else if (state === 'wrong_email') { %>
            <div class="alert alert-warning py-3 mb-3 small" data-i18n="ws_accept_wrong_email">Bu dəvət başqa bir e-poçt ünvanı üçün göndərilib. Düzgün hesabla daxil olun.</div>
            <p class="small text-muted mb-0"><span data-i18n="ws_accept_invited_email">Dəvət olunan ünvan:</span> <code class="fw-bold"><%= invitedEmailMasked %></code></p>
          <% } else if (state === 'already_member' || state === 'accepted') { %>
            <div class="alert alert-success py-3 mb-4" data-i18n="ws_accept_already"><i class="fa-solid fa-check-circle me-2"></i> Siz bu workspace-in üzvüsünüz.</div>
            <a href="/dashboard" class="btn btn-primary rounded-pill px-4 py-2" data-i18n="ws_open_dashboard">Linklər</a>
          <% } else { %>
            <div class="alert alert-danger py-3 mb-4" data-i18n="ws_accept_invalid"><i class="fa-solid fa-circle-exclamation me-2"></i> Bu dəvət etibarsızdır, vaxtı bitib və ya ləğv edilib.</div>
            <a href="/dashboard" class="btn btn-outline-secondary rounded-pill px-4 py-2" data-i18n="ws_open_dashboard">Linklər</a>
          <% } %>
        </div>
      </div>
    </section>
  </main>

  <script nonce="<%= nonce %>" defer src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script nonce="<%= nonce %>" src="/lang.js?v=<%= assetVersion %>"></script>
  <script nonce="<%= nonce %>" src="/script.js?v=<%= assetVersion %>"></script>
</body>

</html>

