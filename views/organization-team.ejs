<!doctype html>
<html lang="<%= lang %>" dir="<%= lang === 'ar' ? 'rtl' : 'ltr' %>">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="csrf-token" content="<%= csrfToken %>"><meta name="robots" content="noindex,nofollow">
<title><%= lang==='tr'?'Takım Yönetimi':lang==='en'?'Team Management':'Komanda idarəetməsi' %> · Ovlink</title>
<link rel="stylesheet" href="/home.css">
<style nonce="<%= nonce %>">
:root{color-scheme:dark}body{margin:0;background:var(--c-bg,#111215);color:var(--c-text,#f4f4f5);font-family:Inter,system-ui,sans-serif}.shell{width:min(1080px,calc(100% - 32px));margin:0 auto;padding:36px 0 80px}.top,.actions{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:14px}.actions{justify-content:flex-start}.title{font-size:clamp(29px,4vw,44px);letter-spacing:-.05em;margin:8px 0}.eyebrow{text-transform:uppercase;letter-spacing:.15em;font-size:11px;color:var(--c-muted,#a6a6ac)}.muted{color:var(--c-muted,#a6a6ac);font-size:14px}.card{background:var(--c-surface,#1a1b1e);border:1px solid var(--c-border,#36383e);border-radius:17px;padding:22px;margin:20px 0}.card h2{font-size:20px;margin:0 0 12px}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:12px}.field{display:grid;gap:8px;min-width:160px}.field label{font-size:13px;color:#cfcfd2}input,select{color:inherit;background:#242529;border:1px solid #55555d;padding:12px;border-radius:10px;font:inherit;width:100%;box-sizing:border-box}input:focus-visible,select:focus-visible,button:focus-visible,a:focus-visible{outline:2px solid #eee;outline-offset:3px}.btn{border:1px solid #55565e;background:transparent;color:inherit;padding:10px 14px;border-radius:10px;cursor:pointer;font:600 13px/1.4 Inter,system-ui,sans-serif}.btn.primary{background:#eee;color:#151518;border-color:#eee}.btn.danger{border-color:#866267;color:#f3caca}.btn:disabled{opacity:.48;cursor:not-allowed}.person,.invite{border:1px solid #36383e;border-radius:12px;padding:14px;margin-top:10px;display:flex;justify-content:space-between;align-items:center;gap:14px;flex-wrap:wrap}.person strong,.invite strong{display:block}.person small,.invite small{color:#a6a6ac}.right{display:flex;align-items:center;gap:8px;flex-wrap:wrap}.right select{min-width:145px;width:auto}.status{min-height:25px;line-height:1.5;margin-top:12px;color:#ccc}.tag{font-size:11px;border:1px solid #444;border-radius:100px;padding:4px 10px}.empty{padding:14px 0;color:#aaa}.m-skip-link{position:absolute;left:-9999px;z-index:30}.m-skip-link:focus{left:12px;top:12px;padding:12px;background:#eee;color:#000}.hidden{display:none!important}@media(max-width:760px){.shell{padding-top:23px}.card{padding:16px}.person,.invite{align-items:stretch}.right{width:100%}.right select{flex:1}.actions .btn{flex:1 1 auto}}@media(prefers-reduced-motion:reduce){*,*::before,*::after{transition:none!important;animation:none!important}}
</style>
</head>
<body>
<a class="m-skip-link" href="#mainContent">Skip to content</a>
<main class="shell" id="mainContent">
<div class="top"><div><a href="/workspaces" class="muted">Ovlink / Workspace</a><p class="eyebrow">OVLINK · ORGANIZATIONS</p><h1 class="title" id="pageTitle">Komanda idarəetməsi</h1></div><button id="reload" class="btn" type="button">Refresh</button></div>
<p id="intro" class="muted">Dəvətləri, rolları və komanda üzvlərini idarə edin.</p>
<p id="notice" class="status" aria-live="polite" role="status"></p>
<section class="card" id="invitePanel" aria-labelledby="inviteTitle"><h2 id="inviteTitle">Dəvət göndər</h2>
<form id="inviteForm"><div class="grid"><div class="field"><label id="emailLabel" for="inviteEmail">E-poçt</label><input id="inviteEmail" type="email" autocomplete="off" required maxlength="254"></div><div class="field"><label id="roleLabel" for="inviteRole">Rol</label><select id="inviteRole"><option value="analyst">Analyst</option><option value="manager">Manager</option><option value="client_viewer">Client Viewer</option><option value="admin" id="inviteAdmin">Admin</option></select></div></div><div class="actions" style="margin-top:14px"><button id="sendInvite" class="btn primary" type="submit">Göndər</button></div></form></section>
<section class="card" aria-labelledby="membersTitle"><div class="top"><h2 id="membersTitle">Üzvlər</h2><span class="tag" id="memberCount">0</span></div><div id="membersList" aria-live="polite"></div></section>
<section class="card" aria-labelledby="invitesTitle"><div class="top"><h2 id="invitesTitle">Dəvətlər</h2><span class="tag" id="inviteCount">0</span></div><div id="invitesList" aria-live="polite"></div></section>
<section class="card" id="transferPanel" aria-labelledby="transferTitle" hidden><h2 id="transferTitle">Sahibliyin ötürülməsi</h2><p id="transferDesc" class="muted">Yalnız təsdiqlənmiş komanda üzvünə sahiblik verilə bilər. Abunə sahibinin hesabı dəyişmir.</p><form id="transferForm" class="grid"><div class="field"><label id="targetLabel" for="transferTarget">Yeni sahib</label><select id="transferTarget" required></select></div><div class="actions" style="align-items:end"><button class="btn danger" id="transferButton" type="submit">Sahibliyi ötür</button></div></form></section>
</main>
<script nonce="<%= nonce %>">
(()=>{'use strict';
const orgId=<%- JSON.stringify(orgId) %>,lang=<%- JSON.stringify(lang) %>,csrf=document.querySelector('meta[name="csrf-token"]').content,root='/api/organizations/'+encodeURIComponent(orgId);
const labels={az:{title:'Komanda idarəetməsi',intro:'Dəvətləri, rolları və komanda üzvlərini idarə edin.',reload:'Yenilə',invite:'Dəvət göndər',email:'E-poçt',role:'Rol',send:'Göndər',members:'Üzvlər',invites:'Dəvətlər',transfer:'Sahibliyin ötürülməsi',transferDesc:'Yalnız təsdiqlənmiş komanda üzvünə sahiblik verilə bilər. Abunə sahibinin hesabı dəyişmir.',target:'Yeni sahib',transferBtn:'Sahibliyi ötür',pending:'Gözləyir',accepted:'Qəbul edilib',expired:'Müddəti bitib',revoked:'Ləğv edilib',remove:'Üzvü çıxar',leave:'Komandadan çıx',reissue:'Yenidən göndər',revoke:'Ləğv et',change:'Rolu dəyiş',owner:'Sahib',confirm:'Bu əməliyyatı təsdiqləyirsiniz?',sent:'Dəvət yaradıldı; e-poçt serveri qəbul etdi. Çatdırılma təsdiqlənməyib.',queued:'Dəvət yaradıldı; e-poçt göndərişi təsdiqlənməyib.',failed:'Əməliyyat uğursuz oldu',empty:'Hələ məlumat yoxdur',id:'İstifadəçi',confirmTransfer:'Sahibliyi ötürmək istəyirsiniz? Abunə sahibinin hesabı dəyişməyəcək.'},tr:{title:'Takım yönetimi',intro:'Davetleri, rolleri ve takım üyelerini yönetin.',reload:'Yenile',invite:'Davet gönder',email:'E-posta',role:'Rol',send:'Gönder',members:'Üyeler',invites:'Davetler',transfer:'Sahipliği devret',transferDesc:'Sadece doğrulanmış bir üyeye sahiplik verilebilir. Faturalama sahibi değişmez.',target:'Yeni sahip',transferBtn:'Sahipliği devret',pending:'Bekliyor',accepted:'Kabul edildi',expired:'Süresi doldu',revoked:'İptal edildi',remove:'Üyeyi çıkar',leave:'Takımdan ayrıl',reissue:'Yeniden gönder',revoke:'İptal et',change:'Rolü değiştir',owner:'Sahip',confirm:'Bu işlemi onaylıyor musunuz?',sent:'Davet oluşturuldu ve e-posta sunucusu kabul etti. Teslimat doğrulanmadı.',queued:'Davet oluşturuldu, gönderim doğrulanmadı.',failed:'İşlem başarısız oldu',empty:'Henüz veri yok',id:'Kullanıcı',confirmTransfer:'Sahiplik devredilsin mi? Faturalama sahibi değişmeyecek.'},en:{title:'Team management',intro:'Manage invitations, team roles and access.',reload:'Refresh',invite:'Invite teammate',email:'Email',role:'Role',send:'Send invite',members:'Members',invites:'Invitations',transfer:'Transfer ownership',transferDesc:'Ownership can only transfer to an existing verified member. Billing owner stays unchanged.',target:'New owner',transferBtn:'Transfer ownership',pending:'Pending',accepted:'Accepted',expired:'Expired',revoked:'Revoked',remove:'Remove member',leave:'Leave team',reissue:'Reissue',revoke:'Revoke',change:'Change role',owner:'Owner',confirm:'Confirm this action?',sent:'Invitation created; mail server accepted, delivery not confirmed.',queued:'Invitation created, mail sending not confirmed.',failed:'Request failed',empty:'Nothing yet',id:'User',confirmTransfer:'Transfer ownership? Billing owner remains unchanged.'}};
const t=labels[lang]||labels.az,el=id=>document.getElementById(id);let data=null,busy=false;
for(const [id,val] of Object.entries({pageTitle:t.title,intro:t.intro,reload:t.reload,inviteTitle:t.invite,emailLabel:t.email,roleLabel:t.role,sendInvite:t.send,membersTitle:t.members,invitesTitle:t.invites,transferTitle:t.transfer,transferDesc:t.transferDesc,targetLabel:t.target,transferButton:t.transferBtn}))el(id).textContent=val;
function note(v){el('notice').textContent=v||''}function button(txt,handler,cls='btn'){const b=document.createElement('button');b.type='button';b.className=cls;b.textContent=txt;b.disabled=busy;b.addEventListener('click',handler);return b}
async function api(route,method='GET',body){const res=await fetch(route,{method,credentials:'same-origin',headers:{'content-type':'application/json','x-csrf-token':csrf},body:body===undefined?undefined:JSON.stringify(body),cache:'no-store'});const payload=await res.json().catch(()=>({}));if(!res.ok)throw Error(payload.error||`${t.failed}: ${res.status}`);return payload}
async function operation(task){if(busy)return;busy=true;note('');try{await task()}catch(e){note(e.message||t.failed)}finally{busy=false}}
async function refresh(){try{data=await api(root+'/team');render()}catch(e){note(e.message||t.failed)}}
const roles=['admin','manager','analyst','client_viewer'];
function dropdown(value){const select=document.createElement('select');for(const role of roles){const o=document.createElement('option');o.value=role;o.textContent=role;if(value===role)o.selected=true;select.append(o)}return select}
function render(){const caps=data.capabilities||{},owner=data.owner_user_id,me=data.current_user_id;
 el('invitePanel').hidden=!caps.invite;el('inviteAdmin').disabled=!caps.invite_admin;el('transferPanel').hidden=!caps.transfer_owner;
 const members=el('membersList');members.replaceChildren();el('memberCount').textContent=data.member_limit?`${data.members.length} / ${data.member_limit}`:String(data.members.length);
 for(const m of data.members){const row=document.createElement('div');row.className='person';const left=document.createElement('div'),strong=document.createElement('strong'),desc=document.createElement('small');strong.textContent=t.id+' #'+m.user_id+(m.user_id===owner?' · '+t.owner:'');desc.textContent=m.role;left.append(strong,desc);row.append(left);const right=document.createElement('div');right.className='right';
  if(caps.change_role&&m.user_id!==owner&&m.role!=='owner'){const sel=dropdown(m.role);right.append(sel,button(t.change,()=>operation(async()=>{if(!confirm(t.confirm))return;await api(root+'/members/'+m.user_id,'PATCH',{role:sel.value});await refresh()})))}
  if(m.user_id!==owner&&(m.user_id===me||caps.remove))right.append(button(m.user_id===me?t.leave:t.remove,()=>operation(async()=>{if(!confirm(t.confirm))return;await api(root+'/members/'+(m.user_id===me?'me':m.user_id),'DELETE');await refresh()}),'btn danger'));
  row.append(right);members.append(row)
 }
 if(!data.members.length){const e=document.createElement('p');e.className='empty';e.textContent=t.empty;members.append(e)}
 const invitations=el('invitesList');invitations.replaceChildren();el('inviteCount').textContent=String(data.invites.length);
 for(const i of data.invites){const row=document.createElement('div');row.className='invite';const detail=document.createElement('div'),label=document.createElement('strong'),sm=document.createElement('small');const state=i.accepted_at?t.accepted:i.revoked_at?t.revoked:new Date(i.expires_at).getTime()<=Date.now()?t.expired:t.pending;label.textContent=i.role+' · '+state;sm.textContent=i.id;detail.append(label,sm);row.append(detail);const right=document.createElement('div');right.className='right';if(caps.invite&&!i.accepted_at&&!i.revoked_at&&(i.role!=='admin'||caps.invite_admin)){right.append(button(t.reissue,()=>operation(async()=>{if(!confirm(t.confirm))return;const r=await api(root+'/invitations/'+i.id+'/reissue','POST',{});note(r.email_sent?t.sent:t.queued);await refresh()})));right.append(button(t.revoke,()=>operation(async()=>{if(!confirm(t.confirm))return;await api(root+'/invitations/'+i.id,'DELETE');await refresh()}),'btn danger'))}row.append(right);invitations.append(row)}
 if(!data.invites.length){const e=document.createElement('p');e.className='empty';e.textContent=t.empty;invitations.append(e)}
 const select=el('transferTarget');select.replaceChildren();for(const m of data.members){if(m.user_id===owner)continue;const option=document.createElement('option');option.value=String(m.user_id);option.textContent=t.id+' #'+m.user_id+' ('+m.role+')';select.append(option)}el('transferButton').disabled=!select.options.length;
}
el('reload').addEventListener('click',()=>operation(refresh));
el('inviteForm').addEventListener('submit',e=>{e.preventDefault();operation(async()=>{const email=el('inviteEmail').value.trim(),role=el('inviteRole').value;const res=await api(root+'/invitations?lang='+encodeURIComponent(lang),'POST',{email,role});el('inviteForm').reset();await refresh();note(res.email_sent?t.sent:t.queued)})});
el('transferForm').addEventListener('submit',e=>{e.preventDefault();operation(async()=>{if(!confirm(t.confirmTransfer))return;await api(root+'/transfer-owner','POST',{target_user_id:Number(el('transferTarget').value)});await refresh()})});
refresh();
})();
</script>
</body></html>
