<!doctype html>
<html lang="<%= (seo && seo.lang) ? seo.lang : 'en' %>">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="csrf-token" content="<%= csrfToken %>">
  <title><%= (seo && seo.title) ? seo.title : 'Ovlink' %></title>
  <link rel="icon" href="/logo.ico" />
  <link rel="manifest" href="/site.webmanifest" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap" media="print" id="gf-css" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" media="print" id="fa-css" />
  <script nonce="<%= nonce %>">
    document.getElementById("gf-css").media = "all";
    document.getElementById("fa-css").media = "all";
  </script>
  <noscript>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
  </noscript>
  
  <link rel="stylesheet" href="/style.css?v=<%= assetVersion %>" />
  <meta name="description" content="<%= (seo && seo.description) ? seo.description : '' %>" />
  <meta name="keywords" content="<%= (seo && seo.keywords) ? seo.keywords : '' %>" />
  <link rel="canonical" href="<%= (seo && seo.canonical) ? seo.canonical : '' %>" />
  <link rel="alternate" hreflang="en" href="<%= (seo && seo.hreflangEn) ? seo.hreflangEn : '' %>" />
  <link rel="alternate" hreflang="az" href="<%= (seo && seo.hreflangAz) ? seo.hreflangAz : '' %>" />
  <link rel="alternate" hreflang="tr" href="<%= (seo && seo.hreflangTr) ? seo.hreflangTr : '' %>" />
  <link rel="alternate" hreflang="x-default" href="<%= (seo && seo.hreflangXDefault) ? seo.hreflangXDefault : '' %>" />
  <meta property="og:title" content="<%= (seo && seo.ogTitle) ? seo.ogTitle : '' %>" />
  <meta property="og:description" content="<%= (seo && seo.ogDescription) ? seo.ogDescription : '' %>" />
  <meta property="og:url" content="<%= (seo && seo.ogUrl) ? seo.ogUrl : '' %>" />
  <meta property="og:type" content="website" />
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content="<%= (seo && seo.twitterTitle) ? seo.twitterTitle : '' %>" />
  <meta name="twitter:description" content="<%= (seo && seo.twitterDescription) ? seo.twitterDescription : '' %>" />
  <% if (seo && seo.jsonLd) { %>
  <script nonce="<%= nonce %>" type="application/ld+json"><%- seo.jsonLd %></script>
  <% } %>
</head>

<body class="home-page policy-page animated-gradient-bg">

  <% if (siteSettings && siteSettings.announcement_enabled === '1' && (siteSettings.announcement_text_az || siteSettings.announcement_text_tr || siteSettings.announcement_text_en)) { %>
    <div id="siteAnnouncement" class="site-announcement" data-az="<%= siteSettings.announcement_text_az || '' %>" data-tr="<%= siteSettings.announcement_text_tr || '' %>" data-en="<%= siteSettings.announcement_text_en || '' %>">
      <div class="container">
        <i class="fa-solid fa-bullhorn"></i>
        <span id="siteAnnouncementText"><%= siteSettings.announcement_text_az || siteSettings.announcement_text_tr || siteSettings.announcement_text_en %></span>
      </div>
    </div>
  <% } %>

  <div id="particlesContainer" class="particles-container"></div>

  <%- include('partials/public-navbar') %>

  <main class="policy-main">
    <section class="container">
      <div class="policy-shell">
        <div class="policy-head">
          <div class="badge hero-chip rounded-pill px-3 py-2 mb-3 shadow-sm fw-semibold">
            <i class="fa-solid fa-link me-1"></i><span data-i18n="hero_badge">Ovlink - Next-Gen Link Management</span>
          </div>
          <h1 class="policy-title" data-i18n="faq_page_title">FAQ</h1>
        </div>

        <div class="policy-list">
          <article class="policy-card">
            <p data-i18n="faq_page_intro">Ovlink ilə bağlı ən çox verilən suallar və qısa cavablar.</p>
          </article>

          <article class="policy-card faq-list-card">
            <details class="faq-item"><summary data-i18n="faq_q1">Ovlink nədir?</summary><p data-i18n="faq_a1">Ovlink qısa link yaratmaq, paylaşmaq və idarə etmək üçün URL qısaltma xidmətidir.</p></details>
            <details class="faq-item"><summary data-i18n="faq_q2">Ovlink pulsuzdurmu?</summary><p data-i18n="faq_a2">Əsas qısaltma funksiyaları standart istifadə üçün mövcuddur. Fair-use və xidmət şərtləri tətbiq olunur.</p></details>
            <details class="faq-item"><summary data-i18n="faq_q3">Qısaldılmış link nədir?</summary><p data-i18n="faq_a3">Qısaldılmış link uzun URL-i daha qısa formaya salan və eyni ünvana yönləndirən linkdir.</p></details>
            <details class="faq-item"><summary data-i18n="faq_q4">Qısa linki necə yaradıram?</summary><p data-i18n="faq_a4">Ana səhifədə hədəf URL daxil edib istəyə bağlı parametrlərlə link yarada bilərsiniz.</p></details>
            <details class="faq-item"><summary data-i18n="faq_q5">Xüsusi ad (alias) seçə bilərəm?</summary><p data-i18n="faq_a5">Bəli, boşdursa linkiniz üçün xüsusi ad təyin edə bilərsiniz.</p></details>
            <details class="faq-item"><summary data-i18n="faq_q6">Linkə şifrə qoya bilərəm?</summary><p data-i18n="faq_a6">Bəli. Şifrəli linklərdə ziyarətçi yönləndirmədən əvvəl təsdiq etməlidir.</p></details>
            <details class="faq-item"><summary data-i18n="faq_q7">Bitmə tarixi və klik limiti var?</summary><p data-i18n="faq_a7">Bəli. Link yaradarkən bitmə tarixi və maksimum klik limiti təyin edilə bilər.</p></details>
            <details class="faq-item"><summary data-i18n="faq_q8">Kimsə qısa linkə klik edəndə nə olur?</summary><p data-i18n="faq_a8">Ziyarətçi əvvəlcə siyasət və təhlükəsizlik yoxlamalarından keçir, sonra icazə varsa yönləndirilir.</p></details>
            <details class="faq-item"><summary data-i18n="faq_q9">Zərərli linklər silinə bilərmi?</summary><p data-i18n="faq_a9">Bəli. Şikayət olunan linklər yoxlanıla və təhlükəsizlik səbəbi ilə məhdudlaşdırıla/deaktiv edilə bilər.</p></details>
            <details class="faq-item"><summary data-i18n="faq_q10">Hansı məlumatlar emal olunur?</summary><p data-i18n="faq_a10">Xidmətin işləməsi üçün hesab/link məlumatları və texniki metadata emal oluna bilər.</p></details>
            <details class="faq-item"><summary data-i18n="faq_q11">Cookie istifadə olunurmu?</summary><p data-i18n="faq_a11">Bəli. Essential cookie-lər sessiya və təhlükəsizlik üçün istifadə olunur.</p></details>
            <details class="faq-item"><summary data-i18n="faq_q12">Link açılmırsa səbəb nə ola bilər?</summary><p data-i18n="faq_a12">Bitmə vaxtı, klik limiti, moderasiya, hədəf sayt problemi və ya siyasət məhdudiyyəti ola bilər.</p></details>
            <details class="faq-item"><summary data-i18n="faq_q13">Şikayəti necə göndərim?</summary><p data-i18n="faq_a13">Saytdakı report axınından istifadə edib link və səbəbi qeyd edə bilərsiniz.</p></details>
            <details class="faq-item"><summary data-i18n="faq_q14">Dəstək ilə necə əlaqə saxlayım?</summary><p data-i18n="faq_a14">/contact səhifəsində göstərilən dəstək kanallarından istifadə edin.</p></details>
          </article>
        </div>

        <div class="policy-back">
          <a href="/" class="btn home-outline-btn rounded-pill" data-i18n="nav_home">Ana Səhifə</a>
        </div>
      </div>
    </section>
  </main>

  <%- include('partials/public-footer', { footerClass: 'site-footer' }) %>

  <script nonce="<%= nonce %>" src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script nonce="<%= nonce %>" src="/lang.js?v=<%= assetVersion %>"></script>
  <script nonce="<%= nonce %>" src="/script.js?v=<%= assetVersion %>"></script>
</body>

</html>



