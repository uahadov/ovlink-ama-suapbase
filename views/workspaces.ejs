<!doctype html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="csrf-token" content="<%= csrfToken %>">
  <title data-i18n="ws_title">Workspace</title>
  <link rel="icon" href="/logo.ico" />
  <link rel="preload" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" as="style" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
  
  <link rel="stylesheet" href="/style.css?v=<%= assetVersion %>" />
</head>

<body class="home-page app-page animated-gradient-bg">

  <% if (siteSettings && siteSettings.announcement_enabled === '1' && (siteSettings.announcement_text_az || siteSettings.announcement_text_tr || siteSettings.announcement_text_en)) { %>
    <div id="siteAnnouncement" class="site-announcement" data-az="<%= siteSettings.announcement_text_az || '' %>" data-tr="<%= siteSettings.announcement_text_tr || '' %>" data-en="<%= siteSettings.announcement_text_en || '' %>">
      <div class="container">
        <i class="fa-solid fa-bullhorn"></i>
        <span id="siteAnnouncementText"><%= siteSettings.announcement_text_az || siteSettings.announcement_text_tr || siteSettings.announcement_text_en %></span>
      </div>
    </div>
  <% } %>

  <div id="particlesContainer" class="particles-container"></div>

  <%- include('partials/public-navbar') %>

  <main class="app-main">
    <section class="container">
      <div class="app-shell">
        <div class="policy-head">
          <div class="badge hero-chip rounded-pill px-3 py-2 mb-3 shadow-sm fw-semibold">
            <i class="fa-solid fa-users me-1"></i><span data-i18n="hero_badge">Ovlink - Next-Gen Link Management</span>
          </div>
          <h1 class="policy-title" data-i18n="ws_title">Workspace</h1>
          <p class="hero-subtitle" data-i18n="ws_subtitle">Komandanız üçün ümumi link workspace-i</p>
        </div>

        <div id="wsLoading" class="policy-card app-card small text-muted" data-i18n="ws_loading">Yüklənir...</div>

        <!-- Pro deyilsə: yüksəltme kartı -->
        <div id="wsUpsellSection" class="policy-card app-card d-none">
          <h5 class="mb-3 fw-bold"><i class="fa-solid fa-crown me-2"></i><span data-i18n="ws_pro_required">Workspace yalnız Pro plandadır</span></h5>
          <p class="small text-muted" data-i18n="ws_pro_required_desc">Komanda workspace-i, üzv dəvətləri və SAML SSO (Okta) Pro abunəliyinin bir hissəsidir.</p>
          <a href="/pricing" class="btn btn-primary rounded-pill" data-i18n="ws_upgrade_btn">Pro-ya keç</a>
        </div>

        <!-- Workspace yoxdursa: yaratma kartı -->
        <div id="wsCreateSection" class="policy-card app-card d-none">
          <h5 class="mb-3 fw-bold"><i class="fa-solid fa-plus me-2"></i><span data-i18n="ws_create_title">Workspace yarat</span></h5>
          <p class="small text-muted" data-i18n="ws_create_desc">Bir workspace yaradın, komandanızı dəvət edin və eyni hesab üzərindən birgə link yaradın.</p>
          <form id="wsCreateForm" class="row g-2 align-items-end">
            <div class="col-12 col-md-8">
              <label class="form-label small fw-bold text-muted" for="wsCreateName" data-i18n="ws_create_name_label">Workspace adı</label>
              <input id="wsCreateName" class="form-control" type="text" maxlength="64" placeholder="Şirkətim" data-i18n-placeholder="ws_create_name_placeholder">
            </div>
            <div class="col-12 col-md-4 d-grid">
              <button type="submit" class="btn btn-primary rounded-pill" data-i18n="ws_create_btn">Yarat</button>
            </div>
            <div class="col-12"><div id="wsCreateMsg" class="small"></div></div>
          </form>
        </div>

        <!-- Workspace varsa: idarəetmə -->
        <div id="wsDetailSection" class="d-none w-100">
          <div class="policy-card app-card mb-4">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
              <div>
                <h4 class="mb-1 fw-bold text-gradient"><i class="fa-solid fa-users me-2"></i><span id="wsDisplayName">-</span></h4>
                <div class="small text-muted"><span data-i18n="ws_your_role">Rolunuz:</span> <span id="wsMyRole" class="badge bg-secondary bg-opacity-25 text-body fw-normal ms-1">-</span></div>
              </div>
              <div class="d-flex gap-2 flex-wrap">
                <a id="wsOpenDashboardBtn" href="/dashboard" class="btn btn-primary rounded-pill"><i class="fa-solid fa-plus me-1"></i><span data-i18n="ws_create_link_btn">Link Yarat</span></a>
                <button type="button" id="wsRenameBtn" class="btn btn-outline-secondary rounded-pill d-none" data-i18n="ws_rename_btn">Adı dəyiş</button>
                <button type="button" id="wsLeaveBtn" class="btn btn-outline-danger rounded-pill d-none" data-bs-toggle="modal" data-bs-target="#wsLeaveModal"><i class="fa-solid fa-arrow-right-from-bracket me-1"></i><span data-i18n="ws_leave_btn">Ayrıl</span></button>
              </div>
            </div>
            
            <div id="wsProWarning" class="alert alert-warning mt-4 mb-0 py-2 small d-none" data-i18n="ws_owner_pro_expired"><i class="fa-solid fa-triangle-exclamation me-2"></i>Sahibin Pro abunəliyi bitib — workspace yalnız oxuma rejimindədir.</div>
            
            <form id="wsRenameForm" class="row g-2 mt-4 d-none">
              <div class="col-12 col-md-8">
                <input id="wsRenameInput" class="form-control" type="text" maxlength="64">
              </div>
              <div class="col-12 col-md-4 d-grid">
                <button type="submit" class="btn btn-primary rounded-pill" data-i18n="ws_rename_save">Yadda saxla</button>
              </div>
            </form>
            
            <!-- Quick Stats Row -->
            <div class="row g-3 mt-3">
              <div class="col-12 col-md-6">
                <div class="p-3 rounded border d-flex align-items-center justify-content-between ws-stat-card">
                  <div>
                    <h6 class="mb-0 text-muted small fw-bold text-uppercase" data-i18n="ws_stat_total_members">Üzvlər</h6>
                    <h3 class="mb-0 fw-bold ws-stat-num" id="wsStatMembers">0</h3>
                  </div>
                  <div class="text-primary bg-primary bg-opacity-10 p-3 rounded-circle d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                    <i class="fa-solid fa-user-group fs-5"></i>
                  </div>
                </div>
              </div>
              <div class="col-12 col-md-6">
                <div class="p-3 rounded border d-flex align-items-center justify-content-between ws-stat-card">
                  <div>
                    <h6 class="mb-0 text-muted small fw-bold text-uppercase" data-i18n="ws_stat_status">Status</h6>
                    <h3 class="mb-0 fw-bold text-success fs-5 mt-1" id="wsStatStatus">Active</h3>
                  </div>
                  <div class="text-success bg-success bg-opacity-10 p-3 rounded-circle d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                    <i class="fa-solid fa-bolt fs-5"></i>
                  </div>
                </div>
              </div>
            </div>
            
          </div>

          <!-- Üzvlər -->
          <div class="policy-card app-card mb-4" id="wsMembersCard">
            <div class="d-flex justify-content-between align-items-center mb-3">
              <h5 class="mb-0 fw-bold"><i class="fa-solid fa-user-group me-2 text-primary"></i><span data-i18n="ws_members_title">Üzvlər</span></h5>
            </div>
            <div class="table-responsive app-table-wrap">
              <table class="table app-table align-middle mb-0">
                <thead>
                  <tr>
                    <th data-i18n="ws_member_email">E-poçt</th>
                    <th data-i18n="ws_member_role">Rol</th>
                    <th data-i18n="ws_member_joined">Qoşuldu</th>
                    <th class="text-end" data-i18n="ws_member_actions">Əməliyyatlar</th>
                  </tr>
                </thead>
                <tbody id="wsMembersBody"></tbody>
              </table>
            </div>
          </div>

          <!-- Dəvət -->
          <div class="policy-card app-card mb-4 d-none" id="wsInviteCard">
            <h5 class="mb-3 fw-bold"><i class="fa-solid fa-paper-plane me-2 text-primary"></i><span data-i18n="ws_invite_title">Üzv dəvət et</span></h5>
            <form id="wsInviteForm" class="row g-2 align-items-end">
              <div class="col-12 col-md-6">
                <label class="form-label small fw-bold text-muted" for="wsInviteEmail" data-i18n="ws_invite_email_label">E-poçt</label>
                <input id="wsInviteEmail" class="form-control" type="email" placeholder="istifadeci@sirket.com" data-i18n-placeholder="ws_invite_email_placeholder" required>
              </div>
              <div class="col-6 col-md-3">
                <label class="form-label small fw-bold text-muted" for="wsInviteRole" data-i18n="ws_invite_role_label">Rol</label>
                <select id="wsInviteRole" class="form-select">
                  <option value="member" data-i18n="ws_role_member">Üzv</option>
                  <option value="admin" data-i18n="ws_role_admin">Admin</option>
                </select>
              </div>
              <div class="col-6 col-md-3 d-grid">
                <button type="submit" class="btn btn-primary rounded-pill" data-i18n="ws_invite_btn">Dəvət et</button>
              </div>
              <div class="col-12"><div id="wsInviteMsg" class="small mt-2"></div></div>
            </form>
            <div id="wsPendingInvitesWrap" class="mt-4 d-none">
              <h6 class="fw-bold small text-muted text-uppercase mb-2" data-i18n="ws_invitations_pending">Gözləyən dəvətlər</h6>
              <ul id="wsPendingInvitesList" class="list-group list-group-flush border rounded"></ul>
            </div>
          </div>

          <!-- SSO (SAML / Okta) -->
          <div class="policy-card app-card mb-4 d-none" id="wsSsoCard">
            <h5 class="mb-3 fw-bold"><i class="fa-solid fa-shield-halved me-2 text-primary"></i><span data-i18n="ws_sso_title">SSO (SAML 2.0)</span></h5>
            <p class="small text-muted" data-i18n="ws_sso_desc">Okta və ya digər SAML 2.0 IdP metadata XML-i əlavə edin; komandanız korporativ girişlə daxil ola bilər.</p>
            <div id="wsSsoStatusWrap" class="small mb-3"></div>
            <form id="wsSsoForm" class="d-none">
              <div class="mb-3">
                <label class="form-label small fw-bold text-muted" for="wsSsoMetadata" data-i18n="ws_sso_metadata_label">IdP Metadata XML</label>
                <textarea id="wsSsoMetadata" class="form-control font-monospace" rows="6" placeholder='<EntityDescriptor ...>'></textarea>
              </div>
              <div class="d-flex gap-2 flex-wrap">
                <button type="submit" class="btn btn-primary rounded-pill px-4" data-i18n="ws_sso_save">Saxla</button>
                <button type="button" id="wsSsoRemoveBtn" class="btn btn-outline-danger rounded-pill px-4 d-none" data-i18n="ws_sso_disable">SSO-nu sil</button>
              </div>
            </form>
            <div id="wsSsoMsg" class="small mt-2"></div>
          </div>

          <!-- Təhlükəli zona -->
          <div class="policy-card app-card border-danger d-none" id="wsDangerCard">
            <h5 class="mb-3 fw-bold text-danger"><i class="fa-solid fa-triangle-exclamation me-2"></i><span data-i18n="ws_danger_title">Təhlükəli zona</span></h5>
            <p class="small text-muted mb-4" data-i18n="ws_danger_desc">Workspace silinərsə üzvlər çıxarılır; linklər yaradıcıların şəxsi hesabına qayıdır və yönləndirmələr dayanmır.</p>
            <button type="button" id="wsDeleteBtn" class="btn btn-danger rounded-pill px-4" data-i18n="ws_delete_btn">Workspace-i sil</button>
          </div>
        </div>
        
        <!-- Leave Workspace Modal -->
        <div class="modal fade" id="wsLeaveModal" tabindex="-1" aria-hidden="true">
          <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg">
              <div class="modal-header border-bottom-0 pb-0">
                <h5 class="modal-title fw-bold text-danger"><i class="fa-solid fa-right-from-bracket me-2"></i><span data-i18n="ws_leave_modal_title">Workspace-dən ayrıl</span></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
              </div>
              <div class="modal-body py-4">
                <p class="mb-0" data-i18n="ws_leave_modal_desc">Gerçekten çıkmak istiyor musunuz? Yeniden davet edilene kadar bu workspace'e katılamazsınız.</p>
              </div>
              <div class="modal-footer border-top-0 pt-0">
                <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal" data-i18n="modal_cancel">Hayır, İptal</button>
                <button type="button" id="wsLeaveConfirmBtn" class="btn btn-danger rounded-pill px-4" disabled>
                  <span data-i18n="ws_leave_modal_confirm">Evet, Ayrıl</span> (<span id="wsLeaveCountdown">3</span>)
                </button>
              </div>
            </div>
          </div>
        </div>

      </div>
    </section>
  </main>

  <script nonce="<%= nonce %>" defer src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script nonce="<%= nonce %>">window.__wsPlanIsPro = <%- (plan && plan.tier === 'pro' && plan.is_active) ? 'true' : 'false' %>;</script>
  <script nonce="<%= nonce %>" src="/lang.js?v=<%= assetVersion %>"></script>
  <script nonce="<%= nonce %>" src="/script.js?v=<%= assetVersion %>"></script>
</body>

</html>

