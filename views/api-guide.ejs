<!doctype html>
<html lang="<%= (seo && seo.lang) ? seo.lang : 'en' %>">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="csrf-token" content="<%= csrfToken %>">
  <title><%= (seo && seo.title) ? seo.title : 'Ovlink' %></title>
  <link rel="icon" href="/logo.ico" />
  <link rel="manifest" href="/site.webmanifest" />
  <link rel="preconnect" href="https://cdn.jsdelivr.net">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" integrity="sha384-9ndCyUaIbzAi2FUVXJi0CjmCapSmO7SnpJef0486qhLnuZ2cdeRhO02iuK6FUUVM" crossorigin="anonymous" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" integrity="sha384-iw3OoTErCYJJB9mCa8LNS2hbsQ7M3C0EpIsO/H5+EGAkPGc6rk+V8i04oW/K5xq0" crossorigin="anonymous" />
  <link rel="stylesheet" href="/style.css?v=<%= assetVersion %>" />
  <meta name="description" content="<%= (seo && seo.description) ? seo.description : '' %>" />
  <meta name="keywords" content="<%= (seo && seo.keywords) ? seo.keywords : '' %>" />
  <link rel="canonical" href="<%= (seo && seo.canonical) ? seo.canonical : '' %>" />
  <link rel="alternate" hreflang="en" href="<%= (seo && seo.hreflangEn) ? seo.hreflangEn : '' %>" />
  <link rel="alternate" hreflang="az" href="<%= (seo && seo.hreflangAz) ? seo.hreflangAz : '' %>" />
  <link rel="alternate" hreflang="tr" href="<%= (seo && seo.hreflangTr) ? seo.hreflangTr : '' %>" />
  <link rel="alternate" hreflang="x-default" href="<%= (seo && seo.hreflangXDefault) ? seo.hreflangXDefault : '' %>" />
  <meta property="og:title" content="<%= (seo && seo.ogTitle) ? seo.ogTitle : '' %>" />
  <meta property="og:description" content="<%= (seo && seo.ogDescription) ? seo.ogDescription : '' %>" />
  <meta property="og:url" content="<%= (seo && seo.ogUrl) ? seo.ogUrl : '' %>" />
  <meta property="og:type" content="website" />
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content="<%= (seo && seo.twitterTitle) ? seo.twitterTitle : '' %>" />
  <meta name="twitter:description" content="<%= (seo && seo.twitterDescription) ? seo.twitterDescription : '' %>" />
  <% if (seo && seo.jsonLd) { %>
  <script nonce="<%= nonce %>" type="application/ld+json"><%- seo.jsonLd %></script>
  <% } %>
</head>

<body class="home-page policy-page api-guide-page animated-gradient-bg">

  <% if (siteSettings && siteSettings.announcement_enabled === '1' && (siteSettings.announcement_text_az || siteSettings.announcement_text_tr || siteSettings.announcement_text_en)) { %>
    <div id="siteAnnouncement" class="site-announcement" data-az="<%= siteSettings.announcement_text_az || '' %>" data-tr="<%= siteSettings.announcement_text_tr || '' %>" data-en="<%= siteSettings.announcement_text_en || '' %>">
      <div class="container">
        <i class="fa-solid fa-bullhorn"></i>
        <span id="siteAnnouncementText"><%= siteSettings.announcement_text_az || siteSettings.announcement_text_tr || siteSettings.announcement_text_en %></span>
      </div>
    </div>
  <% } %>

  <div id="particlesContainer" class="particles-container"></div>

  <%- include('partials/public-navbar') %>

  <main class="policy-main">
    <section class="container">
      <div class="policy-shell">
        <div class="policy-head">
          <div class="badge hero-chip rounded-pill px-3 py-2 mb-3 shadow-sm fw-semibold">
            <i class="fa-solid fa-plug me-1"></i><span data-i18n="hero_badge">Ovlink - Next-Gen Link Management</span>
          </div>
          <h1 class="policy-title" data-i18n="api_guide_page_title">API Usage Guide</h1>
          <p class="hero-subtitle" data-i18n="api_guide_page_intro">Pro API key ilə avtomatik link yaratmaq və hesab məlumatlarını oxumaq üçün sürətli bələdçi.</p>
        </div>

        <div class="policy-list">
          <article class="policy-card api-guide-card">
            <h3><i class="fa-solid fa-key me-2"></i><span data-i18n="api_guide_auth_title">1) API key ilə autentifikasiya</span></h3>
            <p data-i18n="api_guide_auth_text">Sorğularda API key göndərmək üçün <code>x-api-key</code> və ya <code>Authorization: Bearer ...</code> istifadə edin.</p>
            <ul>
              <li data-i18n="api_guide_auth_item1">Endpoint: <code>GET /api/pro/v1/account</code></li>
              <li data-i18n="api_guide_auth_item2">Pro plan aktiv deyilsə cavab: <code>403 Pro plan required</code></li>
            </ul>
          </article>

          <article class="policy-card api-guide-card">
            <h3><i class="fa-solid fa-link me-2"></i><span data-i18n="api_guide_shorten_title">2) API ilə link yaratmaq</span></h3>
            <p data-i18n="api_guide_shorten_text">Yeni endpoint: <code>POST /api/pro/v1/shorten</code>. JSON body-də ən azı <code>original_url</code> göndərin.</p>
            <ul>
              <li data-i18n="api_guide_shorten_item1"><code>custom_alias</code> (opsional)</li>
              <li data-i18n="api_guide_shorten_item2"><code>custom_domain</code> (opsional, hesabınıza bağlı və aktiv olmalıdır)</li>
              <li data-i18n="api_guide_shorten_item3"><code>max_clicks</code>, <code>expires_at</code> (opsional)</li>
            </ul>
          </article>

          <article class="policy-card api-guide-card">
            <h3><i class="fa-solid fa-terminal me-2"></i><span data-i18n="api_guide_examples_title">Kod nümunələri</span></h3>
            <div class="api-guide-tabs" role="tablist" aria-label="Code samples">
              <button type="button" class="api-guide-tab-btn is-active" data-api-sample-tab="curl" role="tab" aria-selected="true">curl</button>
              <button type="button" class="api-guide-tab-btn" data-api-sample-tab="powershell" role="tab" aria-selected="false">PowerShell</button>
              <button type="button" class="api-guide-tab-btn" data-api-sample-tab="nodejs" role="tab" aria-selected="false">Node.js</button>
              <button type="button" class="api-guide-tab-btn" data-api-sample-tab="python" role="tab" aria-selected="false">Python</button>
              <button type="button" class="api-guide-tab-btn" data-api-sample-tab="csharp" role="tab" aria-selected="false">C#</button>
              <button type="button" class="api-guide-tab-btn" data-api-sample-tab="cpp" role="tab" aria-selected="false">C++</button>
            </div>

            <section class="api-guide-sample-panel is-active" data-api-sample-panel="curl" role="tabpanel">
              <div class="api-guide-code-wrap">
                <div class="api-guide-code-head">
                  <span class="api-guide-code-lang">curl</span>
                  <button type="button" class="btn btn-sm btn-outline-light" data-copy-target="apiGuideCurl" data-i18n="api_guide_copy_btn">Kopyala</button>
                </div>
                <pre id="apiGuideCurl" class="api-guide-code-pre"><code>curl -X POST "https://ovlink.sbs/api/pro/v1/shorten" \
  -H "Content-Type: application/json" \
  -H "x-api-key: ovk_your_api_key_here" \
  -d '{
    "original_url": "https://example.com/product/123",
    "custom_alias": "my-product",
    "max_clicks": 500
  }'</code></pre>
              </div>
            </section>

            <section class="api-guide-sample-panel" data-api-sample-panel="powershell" role="tabpanel" hidden>
              <div class="api-guide-code-wrap">
                <div class="api-guide-code-head">
                  <span class="api-guide-code-lang">PowerShell (Invoke-RestMethod)</span>
                  <button type="button" class="btn btn-sm btn-outline-light" data-copy-target="apiGuidePowerShell" data-i18n="api_guide_copy_btn">Kopyala</button>
                </div>
                <pre id="apiGuidePowerShell" class="api-guide-code-pre"><code>$headers = @{ "x-api-key" = "ovk_your_api_key_here" }

$body = @{
  original_url = "https://example.com/product/123"
  custom_alias = "my-product"
  max_clicks   = 500
} | ConvertTo-Json -Compress

Invoke-RestMethod -Method Post `
  -Uri "https://ovlink.sbs/api/pro/v1/shorten" `
  -Headers $headers `
  -ContentType "application/json" `
  -Body $body</code></pre>
              </div>
            </section>

            <section class="api-guide-sample-panel" data-api-sample-panel="nodejs" role="tabpanel" hidden>
              <div class="api-guide-code-wrap">
                <div class="api-guide-code-head">
                  <span class="api-guide-code-lang">Node.js (fetch)</span>
                  <button type="button" class="btn btn-sm btn-outline-light" data-copy-target="apiGuideNode" data-i18n="api_guide_copy_btn">Kopyala</button>
                </div>
                <pre id="apiGuideNode" class="api-guide-code-pre"><code>const res = await fetch("https://ovlink.sbs/api/pro/v1/shorten", {
  method: "POST",
  headers: {
    "Content-Type": "application/json",
    "x-api-key": process.env.OVLINK_API_KEY
  },
  body: JSON.stringify({
    original_url: "https://example.com/campaign/spring",
    custom_alias: "spring-campaign"
  })
});

const data = await res.json();
console.log(data);</code></pre>
              </div>
            </section>

            <section class="api-guide-sample-panel" data-api-sample-panel="python" role="tabpanel" hidden>
              <div class="api-guide-code-wrap">
                <div class="api-guide-code-head">
                  <span class="api-guide-code-lang">Python (requests)</span>
                  <button type="button" class="btn btn-sm btn-outline-light" data-copy-target="apiGuidePython" data-i18n="api_guide_copy_btn">Kopyala</button>
                </div>
                <pre id="apiGuidePython" class="api-guide-code-pre"><code>import requests

url = "https://ovlink.sbs/api/pro/v1/shorten"
headers = {
    "x-api-key": "ovk_your_api_key_here",
    "Content-Type": "application/json"
}
payload = {
    "original_url": "https://example.com/blog/new-post",
    "custom_alias": "new-post"
}

r = requests.post(url, headers=headers, json=payload, timeout=15)
print(r.status_code, r.json())</code></pre>
              </div>
            </section>

            <section class="api-guide-sample-panel" data-api-sample-panel="csharp" role="tabpanel" hidden>
              <div class="api-guide-code-wrap">
                <div class="api-guide-code-head">
                  <span class="api-guide-code-lang">C# (HttpClient)</span>
                  <button type="button" class="btn btn-sm btn-outline-light" data-copy-target="apiGuideCSharp" data-i18n="api_guide_copy_btn">Kopyala</button>
                </div>
                <pre id="apiGuideCSharp" class="api-guide-code-pre"><code>using System.Net.Http;
using System.Net.Http.Headers;
using System.Text;

var client = new HttpClient();
client.DefaultRequestHeaders.Add("x-api-key", "ovk_your_api_key_here");

var json = """
{
  "original_url": "https://example.com/docs",
  "custom_alias": "docs-link"
}
""";

var content = new StringContent(json, Encoding.UTF8, "application/json");
var response = await client.PostAsync("https://ovlink.sbs/api/pro/v1/shorten", content);
var body = await response.Content.ReadAsStringAsync();
Console.WriteLine(body);</code></pre>
              </div>
            </section>

            <section class="api-guide-sample-panel" data-api-sample-panel="cpp" role="tabpanel" hidden>
              <div class="api-guide-code-wrap">
                <div class="api-guide-code-head">
                  <span class="api-guide-code-lang">C++ (libcurl)</span>
                  <button type="button" class="btn btn-sm btn-outline-light" data-copy-target="apiGuideCpp" data-i18n="api_guide_copy_btn">Kopyala</button>
                </div>
                <pre id="apiGuideCpp" class="api-guide-code-pre"><code>#include &lt;curl/curl.h&gt;
#include &lt;string&gt;

int main() {
  CURL* curl = curl_easy_init();
  if (!curl) return 1;

  std::string payload = R"({
    "original_url":"https://example.com/page",
    "custom_alias":"cpp-demo"
  })";

  struct curl_slist* headers = nullptr;
  headers = curl_slist_append(headers, "Content-Type: application/json");
  headers = curl_slist_append(headers, "x-api-key: ovk_your_api_key_here");

  curl_easy_setopt(curl, CURLOPT_URL, "https://ovlink.sbs/api/pro/v1/shorten");
  curl_easy_setopt(curl, CURLOPT_HTTPHEADER, headers);
  curl_easy_setopt(curl, CURLOPT_POSTFIELDS, payload.c_str());
  curl_easy_setopt(curl, CURLOPT_POST, 1L);

  CURLcode rc = curl_easy_perform(curl);
  curl_slist_free_all(headers);
  curl_easy_cleanup(curl);
  return rc == CURLE_OK ? 0 : 1;
}</code></pre>
              </div>
            </section>
          </article>

          <article class="policy-card api-guide-card">
            <h3><i class="fa-solid fa-shield-halved me-2"></i><span data-i18n="api_guide_security_title">Təhlükəsizlik qeydləri</span></h3>
            <ul>
              <li data-i18n="api_guide_security_item1">API key-i frontend koduna yerləşdirməyin, yalnız backend/server mühitində saxlayın.</li>
              <li data-i18n="api_guide_security_item2">Sızma şübhəsində key-i dərhal rotate/revoke edin.</li>
              <li data-i18n="api_guide_security_item3">Webhook secret və API key dəyərləri yalnız bir dəfə göstərilir.</li>
            </ul>
          </article>
        </div>

        <div class="policy-back d-flex flex-wrap gap-2 justify-content-center">
          <a href="/account" class="btn home-outline-btn rounded-pill" data-i18n="api_guide_back_account_btn">Pro panelə qayıt</a>
          <a href="/" class="btn home-outline-btn rounded-pill" data-i18n="nav_home">Ana Səhifə</a>
        </div>
      </div>
    </section>
  </main>

  <%- include('partials/public-footer', { footerClass: 'site-footer' }) %>

  <script nonce="<%= nonce %>" src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js" integrity="sha384-geWF76RCwLtnZ8qwWowPQNguL3RmwHVBC9FhGdlKrxdiJJigb/j/68SIy3Te4Bkz" crossorigin="anonymous"></script>
  <script nonce="<%= nonce %>" src="/lang.js?v=<%= assetVersion %>"></script>
  <script nonce="<%= nonce %>" src="/script.js?v=<%= assetVersion %>"></script>
</body>

</html>



