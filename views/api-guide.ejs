<!doctype html>
<html lang="<%= (seo && seo.lang) ? seo.lang : 'en' %>">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="csrf-token" content="<%= csrfToken %>">
  <title><%= (seo && seo.title) ? seo.title : 'Ovlink — API Usage Guide' %></title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=<%= assetVersion %>" />
  <link rel="icon" href="/logo.ico" />
  <link rel="manifest" href="/site.webmanifest" />

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

  <link rel="stylesheet" href="/home.css?v=<%= assetVersion %>" />

  <meta name="description" content="<%= (seo && seo.description) ? seo.description : '' %>" />
  <meta name="keywords" content="<%= (seo && seo.keywords) ? seo.keywords : '' %>" />
  <link rel="canonical" href="<%= (seo && seo.canonical) ? seo.canonical : '' %>" />
  <link rel="alternate" hreflang="en" href="<%= (seo && seo.hreflangEn) ? seo.hreflangEn : '' %>" />
  <link rel="alternate" hreflang="az" href="<%= (seo && seo.hreflangAz) ? seo.hreflangAz : '' %>" />
  <link rel="alternate" hreflang="tr" href="<%= (seo && seo.hreflangTr) ? seo.hreflangTr : '' %>" />
  <link rel="alternate" hreflang="x-default" href="<%= (seo && seo.hreflangXDefault) ? seo.hreflangXDefault : '' %>" />
  <meta property="og:title" content="<%= (seo && seo.ogTitle) ? seo.ogTitle : '' %>" />
  <meta property="og:description" content="<%= (seo && seo.ogDescription) ? seo.ogDescription : '' %>" />
  <meta property="og:url" content="<%= (seo && seo.ogUrl) ? seo.ogUrl : '' %>" />
  <meta property="og:type" content="website" />
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content="<%= (seo && seo.twitterTitle) ? seo.twitterTitle : '' %>" />
  <meta name="twitter:description" content="<%= (seo && seo.twitterDescription) ? seo.twitterDescription : '' %>" />
  <% if (seo && seo.jsonLd) { %>
  <script nonce="<%= nonce %>" type="application/ld+json"><%- seo.jsonLd %></script>
  <% } %>
</head>

<body class="ovx home-page resources-page api-guide-page">

  <!-- Top reading progress bar -->
  <div id="readingProgress" class="m-reading-progress" aria-hidden="true"></div>

  <!-- Skip to content for accessibility -->
  <a href="#mainContent" class="m-skip-link" data-i18n="skip_to_content">Skip to content</a>

  <!-- Ambient background glow -->
  <div id="cursorGlow" aria-hidden="true"></div>

  <% if (siteSettings && siteSettings.announcement_enabled === '1' && (siteSettings.announcement_text_az || siteSettings.announcement_text_tr || siteSettings.announcement_text_en)) { %>
    <div id="siteAnnouncement" class="site-announcement" data-az="<%= siteSettings.announcement_text_az || '' %>" data-tr="<%= siteSettings.announcement_text_tr || '' %>" data-en="<%= siteSettings.announcement_text_en || '' %>">
      <div class="shell">
        <i class="fa-solid fa-bullhorn"></i>
        <span id="siteAnnouncementText"><%= siteSettings.announcement_text_az || siteSettings.announcement_text_tr || siteSettings.announcement_text_en %></span>
      </div>
    </div>
  <% } %>

  <%- include('partials/home-navbar') %>

  <main class="m-page-shell m-page-shell--top" id="mainContent">
    <div class="shell" style="max-width: 1080px; width: 100%;">

      <!-- Header / Hero Section -->
      <section class="m-content-hero" aria-labelledby="apiGuideHeading">
        <div class="m-hero-eyebrow mb-3" style="display:inline-flex; align-items:center; gap:8px; margin-bottom: 18px;">
          <span class="m-live-dot" aria-hidden="true"></span>
          <span data-i18n="hero_badge">Ovlink - Next-Gen Link Management</span>
        </div>
        <h1 id="apiGuideHeading" data-i18n="api_guide_page_title">API Usage Guide</h1>
        <p data-i18n="api_guide_page_intro">
          Pro API key ilə avtomatik link yaratmaq və hesab məlumatlarını oxumaq üçün sürətli bələdçi.
        </p>
      </section>

      <!-- 2-Column Documentation Shell: Sticky TOC + Content -->
      <div class="m-legal-layout">

        <!-- Left Sticky TOC -->
        <nav class="m-legal-toc" aria-label="Table of Contents">
          <div class="m-legal-toc-title">Mündəricat</div>
          <a href="#sec-auth" class="m-legal-toc-link active" data-i18n="api_guide_auth_title">1) API key ilə autentifikasiya</a>
          <a href="#sec-shorten" class="m-legal-toc-link" data-i18n="api_guide_shorten_title">2) API ilə link yaratmaq</a>
          <a href="#sec-samples" class="m-legal-toc-link" data-i18n="api_guide_examples_title">Kod nümunələri</a>
          <a href="#sec-security" class="m-legal-toc-link" data-i18n="api_guide_security_title">Təhlükəsizlik qeydləri</a>
          <a href="#sec-quickstart" class="m-legal-toc-link" data-i18n="api_guide_back_account_btn">Pro panelə qayıt</a>
        </nav>

        <!-- Right Content Articles -->
        <div class="m-legal-content">

          <!-- Section 1: Authentication -->
          <article class="m-legal-section" id="sec-auth">
            <div class="m-legal-section-header">
              <i class="fa-solid fa-key" style="color: var(--c-white);" aria-hidden="true"></i>
              <h2 class="m-legal-section-title" data-i18n="api_guide_auth_title">1) API key ilə autentifikasiya</h2>
            </div>
            <p class="m-legal-section-text" data-i18n="api_guide_auth_text">
              Sorğularda API key göndərmək üçün <code>x-api-key</code> və ya <code>Authorization: Bearer ...</code> istifadə edin.
            </p>

            <div class="m-api-spec-box">
              <div class="m-api-endpoint-bar">
                <span class="m-method-badge m-method-badge--get">GET</span>
                <span class="m-endpoint-url">https://ovlink.sbs/api/pro/v1/account</span>
              </div>
              <ul class="m-help-steps-list" style="margin: 0;">
                <li class="m-help-step-item">
                  <i class="fa-solid fa-circle-info" style="color: var(--c-muted); font-size: 13px; margin-top: 3px;" aria-hidden="true"></i>
                  <span data-i18n="api_guide_auth_item1">Endpoint: <code>GET /api/pro/v1/account</code></span>
                </li>
                <li class="m-help-step-item">
                  <i class="fa-solid fa-shield-halved" style="color: #ef4444; font-size: 13px; margin-top: 3px;" aria-hidden="true"></i>
                  <span data-i18n="api_guide_auth_item2">Pro plan aktiv deyilsə cavab: <code>403 Pro plan required</code></span>
                </li>
              </ul>
            </div>
          </article>

          <!-- Section 2: Create Link Endpoint -->
          <article class="m-legal-section" id="sec-shorten">
            <div class="m-legal-section-header">
              <i class="fa-solid fa-link" style="color: var(--c-white);" aria-hidden="true"></i>
              <h2 class="m-legal-section-title" data-i18n="api_guide_shorten_title">2) API ilə link yaratmaq</h2>
            </div>
            <p class="m-legal-section-text" data-i18n="api_guide_shorten_text">
              Yeni endpoint: <code>POST /api/pro/v1/shorten</code>. JSON body-də ən azı <code>original_url</code> göndərin.
            </p>

            <div class="m-api-spec-box">
              <div class="m-api-endpoint-bar">
                <span class="m-method-badge m-method-badge--post">POST</span>
                <span class="m-endpoint-url">https://ovlink.sbs/api/pro/v1/shorten</span>
              </div>
              <div style="font-size: 12.5px; font-weight: 600; color: var(--c-white);">Parametrlər (JSON Body):</div>
              <ul class="m-help-steps-list" style="margin: 0;">
                <li class="m-help-step-item">
                  <span class="m-help-step-num" style="background: rgba(74,222,128,0.1); color: #4ade80; border-color: rgba(74,222,128,0.3);">REQ</span>
                  <span><code>original_url</code>: Qısaldılacaq hədəf veb ünvan (mütləq).</span>
                </li>
                <li class="m-help-step-item">
                  <span class="m-help-step-num">OPT</span>
                  <span data-i18n="api_guide_shorten_item1"><code>custom_alias</code> (opsional)</span>
                </li>
                <li class="m-help-step-item">
                  <span class="m-help-step-num">OPT</span>
                  <span data-i18n="api_guide_shorten_item2"><code>custom_domain</code> (opsional, hesabınıza bağlı və aktiv olmalıdır)</span>
                </li>
                <li class="m-help-step-item">
                  <span class="m-help-step-num">OPT</span>
                  <span data-i18n="api_guide_shorten_item3"><code>max_clicks</code>, <code>expires_at</code> (opsional)</span>
                </li>
              </ul>
            </div>
          </article>

          <!-- Section 3: Code Samples Terminal -->
          <article class="m-legal-section" id="sec-samples">
            <div class="m-legal-section-header">
              <i class="fa-solid fa-terminal" style="color: var(--c-white);" aria-hidden="true"></i>
              <h2 class="m-legal-section-title" data-i18n="api_guide_examples_title">Kod nümunələri</h2>
            </div>
            <p class="m-legal-section-text">
              Proqramlaşdırma dilinizi seçin və hazır inteqrasiya kodunu bir kliklə layihənizə kopyalayın:
            </p>

            <!-- Bespoke UX: Code Terminal -->
            <div class="m-api-terminal">
              <div class="m-api-terminal-head">
                <div class="m-api-tabs-nav" role="tablist" aria-label="Code samples">
                  <button type="button" class="m-api-tab-btn active" data-tab="curl">curl</button>
                  <button type="button" class="m-api-tab-btn" data-tab="powershell">PowerShell</button>
                  <button type="button" class="m-api-tab-btn" data-tab="nodejs">Node.js</button>
                  <button type="button" class="m-api-tab-btn" data-tab="python">Python</button>
                  <button type="button" class="m-api-tab-btn" data-tab="csharp">C#</button>
                  <button type="button" class="m-api-tab-btn" data-tab="cpp">C++</button>
                </div>
                <button type="button" id="copyCodeBtn" class="m-copy-btn" title="Kodu kopyala">
                  <i class="fa-solid fa-copy" aria-hidden="true"></i>
                  <span data-i18n="api_guide_copy_btn">Kopyala</span>
                </button>
              </div>

              <!-- curl Snippet -->
              <pre id="snippet-curl" class="m-api-code-pre"><code>curl -X POST "https://ovlink.sbs/api/pro/v1/shorten" \
  -H "Content-Type: application/json" \
  -H "x-api-key: ovk_your_api_key_here" \
  -d '{
    "original_url": "https://example.com/product/123",
    "custom_alias": "my-product",
    "max_clicks": 500
  }'</code></pre>

              <!-- PowerShell Snippet -->
              <pre id="snippet-powershell" class="m-api-code-pre" style="display: none;"><code>$headers = @{ "x-api-key" = "ovk_your_api_key_here" }

$body = @{
  original_url = "https://example.com/product/123"
  custom_alias = "my-product"
  max_clicks   = 500
} | ConvertTo-Json -Compress

Invoke-RestMethod -Method Post `
  -Uri "https://ovlink.sbs/api/pro/v1/shorten" `
  -Headers $headers `
  -ContentType "application/json" `
  -Body $body</code></pre>

              <!-- Node.js Snippet -->
              <pre id="snippet-nodejs" class="m-api-code-pre" style="display: none;"><code>const res = await fetch("https://ovlink.sbs/api/pro/v1/shorten", {
  method: "POST",
  headers: {
    "Content-Type": "application/json",
    "x-api-key": process.env.OVLINK_API_KEY
  },
  body: JSON.stringify({
    original_url: "https://example.com/campaign/spring",
    custom_alias: "spring-campaign"
  })
});

const data = await res.json();
console.log(data);</code></pre>

              <!-- Python Snippet -->
              <pre id="snippet-python" class="m-api-code-pre" style="display: none;"><code>import requests

url = "https://ovlink.sbs/api/pro/v1/shorten"
headers = {
    "x-api-key": "ovk_your_api_key_here",
    "Content-Type": "application/json"
}
payload = {
    "original_url": "https://example.com/blog/new-post",
    "custom_alias": "new-post"
}

r = requests.post(url, headers=headers, json=payload, timeout=15)
print(r.status_code, r.json())</code></pre>

              <!-- C# Snippet -->
              <pre id="snippet-csharp" class="m-api-code-pre" style="display: none;"><code>using System.Net.Http;
using System.Net.Http.Headers;
using System.Text;

var client = new HttpClient();
client.DefaultRequestHeaders.Add("x-api-key", "ovk_your_api_key_here");

var json = """
{
  "original_url": "https://example.com/docs",
  "custom_alias": "docs-link"
}
""";

var content = new StringContent(json, Encoding.UTF8, "application/json");
var response = await client.PostAsync("https://ovlink.sbs/api/pro/v1/shorten", content);
var body = await response.Content.ReadAsStringAsync();
Console.WriteLine(body);</code></pre>

              <!-- C++ Snippet -->
              <pre id="snippet-cpp" class="m-api-code-pre" style="display: none;"><code>#include &lt;curl/curl.h&gt;
#include &lt;string&gt;

int main() {
  CURL* curl = curl_easy_init();
  if (!curl) return 1;

  std::string payload = R"({
    "original_url":"https://example.com/page",
    "custom_alias":"cpp-demo"
  })";

  struct curl_slist* headers = nullptr;
  headers = curl_slist_append(headers, "Content-Type: application/json");
  headers = curl_slist_append(headers, "x-api-key: ovk_your_api_key_here");

  curl_easy_setopt(curl, CURLOPT_URL, "https://ovlink.sbs/api/pro/v1/shorten");
  curl_easy_setopt(curl, CURLOPT_HTTPHEADER, headers);
  curl_easy_setopt(curl, CURLOPT_POSTFIELDS, payload.c_str());
  curl_easy_setopt(curl, CURLOPT_POST, 1L);

  CURLcode rc = curl_easy_perform(curl);
  curl_slist_free_all(headers);
  curl_easy_cleanup(curl);
  return rc == CURLE_OK ? 0 : 1;
}</code></pre>
            </div>
          </article>

          <!-- Section 4: Security Best Practices -->
          <article class="m-legal-section" id="sec-security">
            <div class="m-legal-section-header">
              <i class="fa-solid fa-shield-halved" style="color: #4ade80;" aria-hidden="true"></i>
              <h2 class="m-legal-section-title" data-i18n="api_guide_security_title">Təhlükəsizlik qeydləri</h2>
            </div>
            <ul class="m-help-steps-list">
              <li class="m-help-step-item">
                <i class="fa-solid fa-triangle-exclamation" style="color: #f59e0b; font-size: 13px; margin-top: 3px;" aria-hidden="true"></i>
                <span data-i18n="api_guide_security_item1">API key-i frontend koduna yerləşdirməyin, yalnız backend/server mühitində saxlayın.</span>
              </li>
              <li class="m-help-step-item">
                <i class="fa-solid fa-arrows-rotate" style="color: var(--c-white); font-size: 13px; margin-top: 3px;" aria-hidden="true"></i>
                <span data-i18n="api_guide_security_item2">Sızma şübhəsində key-i dərhal rotate/revoke edin.</span>
              </li>
              <li class="m-help-step-item">
                <i class="fa-solid fa-eye-slash" style="color: #ef4444; font-size: 13px; margin-top: 3px;" aria-hidden="true"></i>
                <span data-i18n="api_guide_security_item3">Webhook secret və API key dəyərləri yalnız bir dəfə göstərilir.</span>
              </li>
            </ul>
          </article>

          <!-- Section 5: Quickstart Pro Panel Callout -->
          <article class="m-legal-section" id="sec-quickstart">
            <div class="m-legal-section-header">
              <i class="fa-solid fa-rocket" style="color: var(--c-white);" aria-hidden="true"></i>
              <h2 class="m-legal-section-title">İnteqrasiyaya İndi Başlayın</h2>
            </div>
            <p class="m-legal-section-text">
              Pro plan hesabı ilə API açarınızı dərhal yaradın və bir neçə dəqiqə ərzində avtomatlaşdırmanı işə salın.
            </p>
            <div style="margin-top: 18px; display: flex; gap: 12px; align-items: center; flex-wrap: wrap;">
              <a href="/account" class="m-cta m-cta--white" style="padding: 10px 22px; font-size: 13.5px;">
                <i class="fa-solid fa-user-gear" aria-hidden="true"></i>
                <span data-i18n="api_guide_back_account_btn">Pro panelə qayıt</span>
                <i class="fa-solid fa-arrow-right" style="font-size: 11px;" aria-hidden="true"></i>
              </a>
              <a href="/docs" class="m-cta m-cta--outline" style="padding: 10px 20px; font-size: 13.5px;">
                <span data-i18n="nav_docs">Documentation</span>
              </a>
            </div>
          </article>

        </div>

      </div>

      <!-- Action Navigation Footer -->
      <div style="display: flex; gap: 14px; justify-content: center; align-items: center; flex-wrap: wrap; margin-top: 48px;">
        <a href="/" class="m-cta m-cta--outline" style="padding: 10px 22px; font-size: 13.5px;">
          <i class="fa-solid fa-arrow-left" style="font-size: 11px;" aria-hidden="true"></i>
          <span data-i18n="nav_home">Home</span>
        </a>
        <a href="/docs" class="m-cta m-cta--outline" style="padding: 10px 22px; font-size: 13.5px;">
          <span data-i18n="nav_docs">Documentation</span>
        </a>
        <a href="/account" class="m-cta m-cta--white" style="padding: 10px 22px; font-size: 13.5px;">
          <span data-i18n="api_guide_back_account_btn">Pro panelə qayıt</span>
          <i class="fa-solid fa-arrow-right" style="font-size: 11px;" aria-hidden="true"></i>
        </a>
      </div>

    </div>
  </main>

  <%- include('partials/home-footer') %>

  <script nonce="<%= nonce %>" src="/lang.js?v=<%= assetVersion %>"></script>
  <script nonce="<%= nonce %>" src="/script.js?v=<%= assetVersion %>"></script>
  <script nonce="<%= nonce %>">
    (function () {
      /* ─── Reading Progress Bar ─── */
      var progressBar = document.getElementById('readingProgress');
      function updateProgress() {
        if (!progressBar) return;
        var totalHeight = document.documentElement.scrollHeight - window.innerHeight;
        if (totalHeight <= 0) return;
        var progress = (window.scrollY / totalHeight) * 100;
        progressBar.style.width = Math.min(100, Math.max(0, progress)) + '%';
      }
      window.addEventListener('scroll', updateProgress, { passive: true });

      /* ─── ScrollSpy for TOC ─── */
      var tocLinks = document.querySelectorAll('.m-legal-toc-link');
      var sections = document.querySelectorAll('.m-legal-section');
      if (sections.length && tocLinks.length && 'IntersectionObserver' in window) {
        var observer = new IntersectionObserver(function(entries) {
          entries.forEach(function(entry) {
            if (entry.isIntersecting) {
              var id = entry.target.getAttribute('id');
              tocLinks.forEach(function(link) {
                if (link.getAttribute('href') === '#' + id) {
                  link.classList.add('active');
                } else {
                  link.classList.remove('active');
                }
              });
            }
          });
        }, { rootMargin: '-20% 0px -70% 0px' });
        sections.forEach(function(sec) { observer.observe(sec); });
      }

      /* ─── Code Sample Tab Switching & Copy ─── */
      var tabBtns = document.querySelectorAll('.m-api-tab-btn');
      var snippets = {
        'curl': document.getElementById('snippet-curl'),
        'powershell': document.getElementById('snippet-powershell'),
        'nodejs': document.getElementById('snippet-nodejs'),
        'python': document.getElementById('snippet-python'),
        'csharp': document.getElementById('snippet-csharp'),
        'cpp': document.getElementById('snippet-cpp')
      };
      var currentTab = 'curl';

      tabBtns.forEach(function(btn) {
        btn.addEventListener('click', function() {
          tabBtns.forEach(function(b) { b.classList.remove('active'); });
          btn.classList.add('active');
          var target = btn.getAttribute('data-tab');
          currentTab = target;
          Object.keys(snippets).forEach(function(k) {
            if (snippets[k]) {
              snippets[k].style.display = (k === target) ? 'block' : 'none';
            }
          });
        });
      });

      var copyBtn = document.getElementById('copyCodeBtn');
      if (copyBtn) {
        copyBtn.addEventListener('click', function() {
          var el = snippets[currentTab];
          if (!el) return;
          var code = el.textContent || '';
          navigator.clipboard.writeText(code).then(function() {
            var span = copyBtn.querySelector('span');
            var icon = copyBtn.querySelector('i');
            if (span) span.textContent = 'Kopyalandı!';
            if (icon) icon.className = 'fa-solid fa-check';
            copyBtn.classList.add('copied');
            setTimeout(function() {
              if (span) span.textContent = 'Kopyala';
              if (icon) icon.className = 'fa-solid fa-copy';
              copyBtn.classList.remove('copied');
            }, 1800);
          }).catch(function() {});
        });
      }

      /* ─── Navbar interactive logic ─── */
      function setupDropdown(btnId, panelId) {
        var btn = document.getElementById(btnId);
        var panel = document.getElementById(panelId);
        if (!btn || !panel) return;
        btn.addEventListener('click', function(e) {
          e.stopPropagation();
          var isExpanded = panel.classList.contains('open');
          document.querySelectorAll('.m-lang-panel, .m-user-panel').forEach(function(p) { p.classList.remove('open'); });
          document.querySelectorAll('.m-lang-btn, .m-user-btn').forEach(function(b) { b.setAttribute('aria-expanded', 'false'); });
          if (!isExpanded) {
            panel.classList.add('open');
            btn.setAttribute('aria-expanded', 'true');
          }
        });
      }
      setupDropdown('langToggleBtn', 'ovxLangPanel');
      setupDropdown('langToggleBtnMobile', 'ovxLangPanelMobile');
      setupDropdown('navUserMenuBtn', 'ovxUserPanel');
      document.addEventListener('click', function() {
        document.querySelectorAll('.m-lang-panel, .m-user-panel').forEach(function(p) { p.classList.remove('open'); });
        document.querySelectorAll('.m-lang-btn, .m-user-btn').forEach(function(b) { b.setAttribute('aria-expanded', 'false'); });
      });

      /* ─── Mobile Menu ─── */
      var burger = document.getElementById('mBurger');
      var mobileMenu = document.getElementById('mMobileMenu');
      var mClose = document.getElementById('mMobileClose');
      function closeMobileMenu() {
        if (mobileMenu && mobileMenu.classList.contains('open')) {
          mobileMenu.classList.remove('open');
          document.body.style.overflow = '';
          if (burger) burger.setAttribute('aria-expanded', 'false');
        }
      }
      if (burger && mobileMenu) {
        burger.addEventListener('click', function(){
          mobileMenu.classList.add('open');
          document.body.style.overflow = 'hidden';
          burger.setAttribute('aria-expanded', 'true');
        });
      }
      if (mClose) mClose.addEventListener('click', closeMobileMenu);
      document.addEventListener('keydown', function(e){
        if (e.key === 'Escape') closeMobileMenu();
      });

      /* ─── Button ripple effect ─── */
      document.querySelectorAll('.m-cta, .m-btn-solid').forEach(function(btn) {
        btn.addEventListener('click', function(e) {
          var r = btn.getBoundingClientRect();
          var size = Math.max(r.width, r.height);
          var span = document.createElement('span');
          span.className = 'm-ripple';
          span.style.width = span.style.height = size + 'px';
          span.style.left  = (e.clientX - r.left  - size / 2) + 'px';
          span.style.top   = (e.clientY - r.top   - size / 2) + 'px';
          btn.appendChild(span);
          setTimeout(function(){ span.remove(); }, 600);
        });
      });
    })();
  </script>
</body>

</html>
