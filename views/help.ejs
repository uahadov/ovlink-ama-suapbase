<!doctype html>
<html lang="<%= (seo && seo.lang) ? seo.lang : 'en' %>">

<head>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=<%= (typeof assetVersion !== 'undefined' ? assetVersion : '1') %>" />
  <link rel="icon" href="/favicon.ico?v=<%= (typeof assetVersion !== 'undefined' ? assetVersion : '1') %>" />
  <link rel="apple-touch-icon" href="/logo.png?v=<%= (typeof assetVersion !== 'undefined' ? assetVersion : '1') %>" />
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="csrf-token" content="<%= csrfToken %>">
  <title><%= (seo && seo.title) ? seo.title : 'Ovlink — Help Center' %></title>
  
  <link rel="manifest" href="/site.webmanifest" />

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin>
  <link rel="preload" href="/vendor/fontawesome/webfonts/fa-solid-900.woff2?v=<%= (typeof assetVersion !== 'undefined' ? assetVersion : '1') %>" as="font" type="font/woff2" crossorigin />
  <link rel="stylesheet" href="/vendor/fontawesome/css/all.min.css?v=<%= (typeof assetVersion !== 'undefined' ? assetVersion : '1') %>" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" integrity="sha512-iecdLmaskl7CVkqkXNQ/ZH/XLlvWZOJyj7Yy7tcenmpD1ypASozpmT/E0iPtmFIB46ZmdtAc9eNBvH0H/ZpiBw==" crossorigin="anonymous" referrerpolicy="no-referrer" />

  <link rel="stylesheet" href="/home.css?v=<%= assetVersion %>" />

  <meta name="description" content="<%= (seo && seo.description) ? seo.description : '' %>" />
  <meta name="keywords" content="<%= (seo && seo.keywords) ? seo.keywords : '' %>" />
  <link rel="canonical" href="<%= (seo && seo.canonical) ? seo.canonical : '' %>" />
  <link rel="alternate" hreflang="en" href="<%= (seo && seo.hreflangEn) ? seo.hreflangEn : '' %>" />
  <link rel="alternate" hreflang="az" href="<%= (seo && seo.hreflangAz) ? seo.hreflangAz : '' %>" />
  <link rel="alternate" hreflang="tr" href="<%= (seo && seo.hreflangTr) ? seo.hreflangTr : '' %>" />
  <link rel="alternate" hreflang="x-default" href="<%= (seo && seo.hreflangXDefault) ? seo.hreflangXDefault : '' %>" />
  <meta property="og:title" content="<%= (seo && seo.ogTitle) ? seo.ogTitle : '' %>" />
  <meta property="og:description" content="<%= (seo && seo.ogDescription) ? seo.ogDescription : '' %>" />
  <meta property="og:url" content="<%= (seo && seo.ogUrl) ? seo.ogUrl : '' %>" />
  <meta property="og:type" content="website" />
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content="<%= (seo && seo.twitterTitle) ? seo.twitterTitle : '' %>" />
  <meta name="twitter:description" content="<%= (seo && seo.twitterDescription) ? seo.twitterDescription : '' %>" />
  <% if (seo && seo.jsonLd) { %>
  <script nonce="<%= nonce %>" type="application/ld+json"><%- seo.jsonLd %></script>
  <% } %>
</head>

<body class="ovx home-page resources-page help-page">

  <!-- Skip to content for accessibility -->
  <a href="#mainContent" class="m-skip-link" data-i18n="skip_to_content">Skip to content</a>

  <!-- Ambient background glow -->
  <div id="cursorGlow" aria-hidden="true"></div>

  <% if (siteSettings && siteSettings.announcement_enabled === '1' && (siteSettings.announcement_text_az || siteSettings.announcement_text_tr || siteSettings.announcement_text_en)) { %>
    <div id="siteAnnouncement" class="site-announcement" data-az="<%= siteSettings.announcement_text_az || '' %>" data-tr="<%= siteSettings.announcement_text_tr || '' %>" data-en="<%= siteSettings.announcement_text_en || '' %>">
      <div class="shell">
        <i class="fa-solid fa-bullhorn"></i>
        <span id="siteAnnouncementText"><%= siteSettings.announcement_text_az || siteSettings.announcement_text_tr || siteSettings.announcement_text_en %></span>
      </div>
    </div>
  <% } %>

  <%- include('partials/home-navbar') %>

  <main class="m-page-shell m-page-shell--top" id="mainContent">
    <div class="shell" style="max-width: 1080px; width: 100%;">

      <!-- Header / Hero Section -->
      <section class="m-content-hero" aria-labelledby="helpPageHeading">
        <div class="m-hero-eyebrow mb-3" style="display:inline-flex; align-items:center; gap:8px; margin-bottom: 18px;">
          <span class="m-live-dot" aria-hidden="true"></span>
          <span data-i18n="hero_badge">Ovlink - Next-Gen Link Management</span>
        </div>
        <h1 id="helpPageHeading" data-i18n="help_page_title">Yardım Mərkəzi</h1>
        <p data-i18n="help_page_intro">
          Ovlink istifadəçiləri üçün addım-addım yardım və problem həlli bələdçisi.
        </p>
      </section>

      <!-- 3 Step-by-Step Walkthrough Guides Bento Grid -->
      <div class="m-help-grid">

        <!-- Guide 1: Shorten Link -->
        <article class="m-help-card">
          <div class="m-help-card-header">
            <div class="m-help-card-icon">
              <i class="fa-solid fa-route" aria-hidden="true"></i>
            </div>
            <h2 class="m-help-card-title" data-i18n="help_guide1_title">Bələdçi 1: Link qısaltmaq</h2>
          </div>
          <ol class="m-help-steps-list">
            <li class="m-help-step-item">
              <span class="m-help-step-num">01</span>
              <span data-i18n="help_guide1_step1">Ana səhifəyə keçin.</span>
            </li>
            <li class="m-help-step-item">
              <span class="m-help-step-num">02</span>
              <span data-i18n="help_guide1_step2">Hədəf URL daxil edin.</span>
            </li>
            <li class="m-help-step-item">
              <span class="m-help-step-num">03</span>
              <span data-i18n="help_guide1_step3">İstəyə bağlı olaraq alias, şifrə, bitmə tarixi, klik limiti və domen seçin.</span>
            </li>
            <li class="m-help-step-item">
              <span class="m-help-step-num">04</span>
              <span data-i18n="help_guide1_step4">Qısa linki yaradın və kopyalayın.</span>
            </li>
          </ol>
          <div style="margin-top: auto; padding-top: 12px; border-top: 1px solid var(--c-border);">
            <a href="/" class="m-cta m-cta--outline" style="width: 100%; justify-content: center; padding: 8px 14px; font-size: 12.5px;">
              <span>İndi Link Qısaldın</span>
              <i class="fa-solid fa-arrow-right" style="font-size: 11px;" aria-hidden="true"></i>
            </a>
          </div>
        </article>

        <!-- Guide 2: Share and Track -->
        <article class="m-help-card">
          <div class="m-help-card-header">
            <div class="m-help-card-icon">
              <i class="fa-solid fa-share-nodes" aria-hidden="true"></i>
            </div>
            <h2 class="m-help-card-title" data-i18n="help_guide2_title">Bələdçi 2: Linki paylaşmaq və izləmək</h2>
          </div>
          <ol class="m-help-steps-list">
            <li class="m-help-step-item">
              <span class="m-help-step-num">01</span>
              <span data-i18n="help_guide2_step1">Yaradılmış qısa URL-i paylaşın.</span>
            </li>
            <li class="m-help-step-item">
              <span class="m-help-step-num">02</span>
              <span data-i18n="help_guide2_step2">Hesab/statistika səhifələrindən performansı izləyin.</span>
            </li>
          </ol>
          <div style="background: rgba(255, 255, 255, 0.02); border: 1px solid var(--c-border); border-radius: 10px; padding: 12px 14px; font-size: 12.5px; color: var(--c-muted); line-height: 1.5;">
            <i class="fa-solid fa-chart-line" style="color: var(--c-white); margin-right: 6px;" aria-hidden="true"></i>
            Hər klik üçün ölkə, cihaz, əməliyyat sistemi və yönləndirici mənbə real vaxt rejimində qeydə alınır.
          </div>
          <div style="margin-top: auto; padding-top: 12px; border-top: 1px solid var(--c-border);">
            <a href="/login" class="m-cta m-cta--outline" style="width: 100%; justify-content: center; padding: 8px 14px; font-size: 12.5px;">
              <span>Statistikalara Bax</span>
              <i class="fa-solid fa-arrow-right" style="font-size: 11px;" aria-hidden="true"></i>
            </a>
          </div>
        </article>

        <!-- Guide 3: Safe Browsing & Verification -->
        <article class="m-help-card">
          <div class="m-help-card-header">
            <div class="m-help-card-icon">
              <i class="fa-solid fa-shield-halved" aria-hidden="true"></i>
            </div>
            <h2 class="m-help-card-title" data-i18n="help_guide3_title">Bələdçi 3: Linkləri təhlükəsiz açmaq</h2>
          </div>
          <ul class="m-help-steps-list">
            <li class="m-help-step-item">
              <i class="fa-solid fa-circle-check" style="color: #4ade80; font-size: 13px; margin-top: 3px;" aria-hidden="true"></i>
              <span data-i18n="help_guide3_tip1">Paylaşmadan əvvəl hədəf ünvanın kontekstini yoxlayın.</span>
            </li>
            <li class="m-help-step-item">
              <i class="fa-solid fa-circle-check" style="color: #4ade80; font-size: 13px; margin-top: 3px;" aria-hidden="true"></i>
              <span data-i18n="help_guide3_tip2">Aldadıcı yönləndirmə və etiketləmədən istifadə etməyin.</span>
            </li>
            <li class="m-help-step-item">
              <i class="fa-solid fa-triangle-exclamation" style="color: #f59e0b; font-size: 13px; margin-top: 3px;" aria-hidden="true"></i>
              <span data-i18n="help_guide3_tip3">Xəbərdarlıq görünərsə davam etməzdən əvvəl yoxlayın.</span>
            </li>
          </ul>
          <div style="margin-top: auto; padding-top: 12px; border-top: 1px solid var(--c-border);">
            <a href="/abuse-safety" class="m-cta m-cta--outline" style="width: 100%; justify-content: center; padding: 8px 14px; font-size: 12.5px;">
              <span>Təhlükəsizlik Siyasəti</span>
              <i class="fa-solid fa-arrow-right" style="font-size: 11px;" aria-hidden="true"></i>
            </a>
          </div>
        </article>

      </div>

      <!-- Bespoke UX: Interactive Troubleshooting Diagnostic Matrix -->
      <section class="m-troubleshoot-matrix" aria-labelledby="troubleshootHeading">
        <div class="m-troubleshoot-header">
          <div>
            <h2 id="troubleshootHeading" style="font-size: 20px; font-weight: 700; color: var(--c-white); letter-spacing: -0.02em; margin: 0 0 4px 0;" data-i18n="help_troubleshoot_title">
              Problemlərin həlli siyahısı
            </h2>
            <div style="font-size: 13px; color: var(--c-muted);">
              Rastlaşdığınız problemi seçin — dərhal həll qaydası və diaqnostika təlimatı göstəriləcək.
            </div>
          </div>
          <span class="m-verified-badge" style="gap: 6px; font-size: 12px;">
            <i class="fa-solid fa-circle-nodes" style="font-size: 11px;" aria-hidden="true"></i>
            <span>İnteraktiv Diaqnostika</span>
          </span>
        </div>

        <div class="m-troubleshoot-grid">
          <!-- Issue 1 -->
          <div class="m-troubleshoot-item active" data-solution="1">
            <div class="m-troubleshoot-item-left">
              <i class="fa-solid fa-hourglass-end" style="color: #f59e0b; font-size: 14px;" aria-hidden="true"></i>
              <span style="font-size: 13.5px; font-weight: 600; color: var(--c-white);" data-i18n="help_troubleshoot_item1">Linkin vaxtı bitib?</span>
            </div>
            <span class="m-troubleshoot-status-badge">Yoxla</span>
          </div>

          <!-- Issue 2 -->
          <div class="m-troubleshoot-item" data-solution="2">
            <div class="m-troubleshoot-item-left">
              <i class="fa-solid fa-gauge-high" style="color: #ef4444; font-size: 14px;" aria-hidden="true"></i>
              <span style="font-size: 13.5px; font-weight: 600; color: var(--c-white);" data-i18n="help_troubleshoot_item2">Klik limiti dolub?</span>
            </div>
            <span class="m-troubleshoot-status-badge">Yoxla</span>
          </div>

          <!-- Issue 3 -->
          <div class="m-troubleshoot-item" data-solution="3">
            <div class="m-troubleshoot-item-left">
              <i class="fa-solid fa-shield-halved" style="color: #ef4444; font-size: 14px;" aria-hidden="true"></i>
              <span style="font-size: 13.5px; font-weight: 600; color: var(--c-white);" data-i18n="help_troubleshoot_item3">Link moderasiya ilə deaktiv edilib?</span>
            </div>
            <span class="m-troubleshoot-status-badge">Yoxla</span>
          </div>

          <!-- Issue 4 -->
          <div class="m-troubleshoot-item" data-solution="4">
            <div class="m-troubleshoot-item-left">
              <i class="fa-solid fa-server" style="color: var(--c-white); font-size: 14px;" aria-hidden="true"></i>
              <span style="font-size: 13.5px; font-weight: 600; color: var(--c-white);" data-i18n="help_troubleshoot_item4">Hədəf sayt işləyir?</span>
            </div>
            <span class="m-troubleshoot-status-badge">Yoxla</span>
          </div>

          <!-- Issue 5 -->
          <div class="m-troubleshoot-item" data-solution="5">
            <div class="m-troubleshoot-item-left">
              <i class="fa-solid fa-network-wired" style="color: #60a5fa; font-size: 14px;" aria-hidden="true"></i>
              <span style="font-size: 13.5px; font-weight: 600; color: var(--c-white);" data-i18n="help_troubleshoot_item5">Brauzer/şəbəkə ayarları sorğunu bloklayır?</span>
            </div>
            <span class="m-troubleshoot-status-badge">Yoxla</span>
          </div>
        </div>

        <!-- Diagnostic Dynamic Output Box -->
        <div class="m-diagnostic-detail" id="diagnosticOutputBox" style="display: block;">
          <div style="display: flex; align-items: flex-start; justify-content: space-between; gap: 14px;">
            <div>
              <div id="diagnosticTitle" style="font-size: 15px; font-weight: 700; color: var(--c-white); margin-bottom: 6px;">
                Linkin Bitmə Tarixinin Yoxlanılması
              </div>
              <div id="diagnosticText" style="font-size: 13.5px; color: var(--c-text); line-height: 1.65;">
                Link yaradılarkən təyin edilmiş bitmə tarixi keçdikdə yönləndirmə avtomatik dayandırılır. Hesabınıza daxil olaraq link parametrlərindən tarixi uzada və ya limiti ləğv edə bilərsiniz.
              </div>
            </div>
            <a href="/login" id="diagnosticActionBtn" class="m-cta m-cta--white" style="flex-shrink: 0; padding: 8px 16px; font-size: 12.5px;">
              İdarə Panelinə Keç
            </a>
          </div>
        </div>
      </section>

      <!-- Report & Direct Assistance Card -->
      <section class="m-card-monolith" style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 20px; margin-bottom: 32px;">
        <div style="display: flex; align-items: center; gap: 16px;">
          <div style="width: 48px; height: 48px; border-radius: 12px; background: rgba(239, 68, 68, 0.08); border: 1px solid rgba(239, 68, 68, 0.25); display: flex; align-items: center; justify-content: center; font-size: 20px; color: #ef4444;">
            <i class="fa-solid fa-flag" aria-hidden="true"></i>
          </div>
          <div>
            <div style="font-size: 16px; font-weight: 700; color: var(--c-white); margin-bottom: 3px;" data-i18n="help_report_title">
              Şikayət göndərmək
            </div>
            <div style="font-size: 13px; color: var(--c-muted); max-width: 540px;" data-i18n="help_report_text">
              Report axınında qısa link və səbəb qeyd edin və ya /contact səhifəsindən dəstəyə yazın.
            </div>
          </div>
        </div>
        <div style="display: flex; gap: 12px; align-items: center; flex-wrap: wrap;">
          <a href="/abuse-safety" class="m-cta m-cta--outline" style="padding: 10px 20px; font-size: 13px;">
            <span>Şikayət Qaydaları</span>
          </a>
          <a href="/contact" class="m-cta m-cta--white" style="padding: 10px 20px; font-size: 13px;">
            <i class="fa-solid fa-envelope" aria-hidden="true"></i>
            <span>Dəstək ilə Əlaqə</span>
          </a>
        </div>
      </section>

      <!-- Action Navigation Footer -->
      <div style="display: flex; gap: 14px; justify-content: center; align-items: center; flex-wrap: wrap; margin-top: 48px;">
        <a href="/" class="m-cta m-cta--outline" style="padding: 10px 22px; font-size: 13.5px;">
          <i class="fa-solid fa-arrow-left" style="font-size: 11px;" aria-hidden="true"></i>
          <span data-i18n="nav_home">Home</span>
        </a>
        <a href="/faq" class="m-cta m-cta--outline" style="padding: 10px 22px; font-size: 13.5px;">
          <span data-i18n="faq_page_title">Tez-tez verilən suallar</span>
        </a>
        <a href="/docs" class="m-cta m-cta--white" style="padding: 10px 22px; font-size: 13.5px;">
          <span data-i18n="nav_docs">Documentation</span>
          <i class="fa-solid fa-arrow-right" style="font-size: 11px;" aria-hidden="true"></i>
        </a>
      </div>

    </div>
  </main>

  <%- include('partials/home-footer') %>

  <script nonce="<%= nonce %>" src="/lang.js?v=<%= assetVersion %>"></script>
  <script nonce="<%= nonce %>" src="/script.js?v=<%= assetVersion %>"></script>
  <script nonce="<%= nonce %>">
    (function () {
      /* ─── Interactive Diagnostic Matrix UX ─── */
      var solutions = {
        '1': {
          title: 'Linkin Bitmə Tarixinin Yoxlanılması',
          text: 'Link yaradılarkən təyin edilmiş bitmə tarixi keçdikdə yönləndirmə avtomatik dayandırılır. Hesabınıza daxil olaraq link parametrlərindən tarixi uzada və ya limiti ləğv edə bilərsiniz.',
          btnText: 'İdarə Panelinə Keç',
          btnHref: '/login'
        },
        '2': {
          title: 'Maksimum Klik Limitinin Dolması',
          text: 'Link üçün təyin edilmiş maksimum klik sayı bitdikdə sistem təhlükəsizlik məqsədilə yönləndirməni dondurur. Link redaktəsi vasitəsilə klik sayını artıra və ya limitsiz edə bilərsiniz.',
          btnText: 'Klikləri İdarə Et',
          btnHref: '/login'
        },
        '3': {
          title: 'Moderasiya və ya Anti-Abuse Səbəbilə Dayandırma',
          text: 'Bir link 4 və ya daha çox şikayət aldıqda və ya avtomatlaşdırılmış təhlükəsizlik skaneri (URLhaus) tərəfindən riskli aşkar edildikdə avtomatik bloklanır. Əgər bunun səhv olduğunu düşünürsünüzsə, zəhmət olmasa təhlükəsizlik komandamızla əlaqə saxlayın.',
          btnText: 'Apellyasiya Göndər',
          btnHref: '/contact?subject=appeal'
        },
        '4': {
          title: 'Hədəf Veb Saytın İşləməməsi',
          text: 'Qısa link işlək vəziyyətdə olsa da, yönləndirildiyi əsas sayt (orijinal URL) server xətası (500, 502, 404) verə bilər. Birbaşa brauzer ünvan sətrində hədəf URL-in cavab verib-vermədiyini yoxlayın.',
          btnText: 'URL-i Test Et',
          btnHref: '/'
        },
        '5': {
          title: 'Brauzer və Şəbəkə Blokerləri',
          text: 'Bəzi aqressiv reklam və ya skript bloklayıcı əlavələr yönləndirmə sorğularını bloklaya bilər. Veb brauzerinizi gizli (incognito) pəncərədə açıb linki yenidən yoxlayın və ya DNS provayderinizi yoxlayın.',
          btnText: 'Dəstəyə Yazın',
          btnHref: '/contact'
        }
      };

      var items = document.querySelectorAll('.m-troubleshoot-item');
      var titleEl = document.getElementById('diagnosticTitle');
      var textEl = document.getElementById('diagnosticText');
      var btnEl = document.getElementById('diagnosticActionBtn');

      items.forEach(function(item) {
        item.addEventListener('click', function() {
          items.forEach(function(i) { i.classList.remove('active'); });
          item.classList.add('active');
          var solId = item.getAttribute('data-solution');
          var data = solutions[solId];
          if (data) {
            if (titleEl) titleEl.textContent = data.title;
            if (textEl) textEl.textContent = data.text;
            if (btnEl) {
              btnEl.textContent = data.btnText;
              btnEl.href = data.btnHref;
            }
          }
        });
      });

      /* ─── Navbar dropdowns & mobile menu are managed by partials/home-navbar ─── */

      /* ─── Button ripple effect ─── */
      document.querySelectorAll('.m-cta, .m-btn-solid').forEach(function(btn) {
        btn.addEventListener('click', function(e) {
          var r = btn.getBoundingClientRect();
          var size = Math.max(r.width, r.height);
          var span = document.createElement('span');
          span.className = 'm-ripple';
          span.style.width = span.style.height = size + 'px';
          span.style.left  = (e.clientX - r.left  - size / 2) + 'px';
          span.style.top   = (e.clientY - r.top   - size / 2) + 'px';
          btn.appendChild(span);
          setTimeout(function(){ span.remove(); }, 600);
        });
      });
    })();
  </script>
</body>

</html>
