<!doctype html>
<html lang="<%= (seo && seo.lang) ? seo.lang : 'en' %>">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="csrf-token" content="<%= csrfToken %>">
  <title><%= (seo && seo.title) ? seo.title : 'Ovlink' %></title>
  <link rel="icon" href="/logo.ico" />
  <link rel="manifest" href="/site.webmanifest" />
  <link rel="preconnect" href="https://cdn.jsdelivr.net">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" integrity="sha384-9ndCyUaIbzAi2FUVXJi0CjmCapSmO7SnpJef0486qhLnuZ2cdeRhO02iuK6FUUVM" crossorigin="anonymous" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" integrity="sha384-iw3OoTErCYJJB9mCa8LNS2hbsQ7M3C0EpIsO/H5+EGAkPGc6rk+V8i04oW/K5xq0" crossorigin="anonymous" />
  <link rel="stylesheet" href="/style.css?v=<%= assetVersion %>" />
  <meta name="description" content="<%= (seo && seo.description) ? seo.description : '' %>" />
  <meta name="keywords" content="<%= (seo && seo.keywords) ? seo.keywords : '' %>" />
  <link rel="canonical" href="<%= (seo && seo.canonical) ? seo.canonical : '' %>" />
  <link rel="alternate" hreflang="en" href="<%= (seo && seo.hreflangEn) ? seo.hreflangEn : '' %>" />
  <link rel="alternate" hreflang="az" href="<%= (seo && seo.hreflangAz) ? seo.hreflangAz : '' %>" />
  <link rel="alternate" hreflang="tr" href="<%= (seo && seo.hreflangTr) ? seo.hreflangTr : '' %>" />
  <link rel="alternate" hreflang="x-default" href="<%= (seo && seo.hreflangXDefault) ? seo.hreflangXDefault : '' %>" />
  <meta property="og:title" content="<%= (seo && seo.ogTitle) ? seo.ogTitle : '' %>" />
  <meta property="og:description" content="<%= (seo && seo.ogDescription) ? seo.ogDescription : '' %>" />
  <meta property="og:url" content="<%= (seo && seo.ogUrl) ? seo.ogUrl : '' %>" />
  <meta property="og:type" content="website" />
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content="<%= (seo && seo.twitterTitle) ? seo.twitterTitle : '' %>" />
  <meta name="twitter:description" content="<%= (seo && seo.twitterDescription) ? seo.twitterDescription : '' %>" />
  <% if (seo && seo.jsonLd) { %>
  <script nonce="<%= nonce %>" type="application/ld+json"><%- seo.jsonLd %></script>
  <% } %>
</head>

<body class="home-page policy-page animated-gradient-bg">

  <% if (siteSettings && siteSettings.announcement_enabled === '1' && (siteSettings.announcement_text_az || siteSettings.announcement_text_tr || siteSettings.announcement_text_en)) { %>
    <div id="siteAnnouncement" class="site-announcement" data-az="<%= siteSettings.announcement_text_az || '' %>" data-tr="<%= siteSettings.announcement_text_tr || '' %>" data-en="<%= siteSettings.announcement_text_en || '' %>">
      <div class="container">
        <i class="fa-solid fa-bullhorn"></i>
        <span id="siteAnnouncementText"><%= siteSettings.announcement_text_az || siteSettings.announcement_text_tr || siteSettings.announcement_text_en %></span>
      </div>
    </div>
  <% } %>

  <div id="particlesContainer" class="particles-container"></div>

  <%- include('partials/public-navbar') %>

  <main class="policy-main">
    <section class="container">
      <div class="policy-shell">
        <div class="policy-head">
          <div class="badge hero-chip rounded-pill px-3 py-2 mb-3 shadow-sm fw-semibold">
            <i class="fa-solid fa-link me-1"></i><span data-i18n="hero_badge">Ovlink - Next-Gen Link Management</span>
          </div>
          <h1 class="policy-title" data-i18n="help_page_title">Help Center</h1>
        </div>

        <div class="policy-list">
          <article class="policy-card">
            <p data-i18n="help_page_intro">Ovlink istifadəçiləri üçün addım-addım yardım və problem həlli bələdçisi.</p>
          </article>

          <article class="policy-card">
            <h3 class="fw-bold"><i class="fa-solid fa-route me-2"></i><span data-i18n="help_guide1_title">Bələdçi 1: Link qısaltmaq</span></h3>
            <ol>
              <li data-i18n="help_guide1_step1">Ana səhifəyə keçin.</li>
              <li data-i18n="help_guide1_step2">Hədəf URL daxil edin.</li>
              <li data-i18n="help_guide1_step3">İstəyə bağlı olaraq alias, şifrə, bitmə tarixi, klik limiti və domen seçin.</li>
              <li data-i18n="help_guide1_step4">Qısa linki yaradın və kopyalayın.</li>
            </ol>
          </article>

          <article class="policy-card">
            <h3 class="fw-bold"><i class="fa-solid fa-share-nodes me-2"></i><span data-i18n="help_guide2_title">Bələdçi 2: Linki paylaşmaq və izləmək</span></h3>
            <ol>
              <li data-i18n="help_guide2_step1">Yaradılmış qısa URL-i paylaşın.</li>
              <li data-i18n="help_guide2_step2">Hesab/statistika səhifələrindən performansı izləyin.</li>
            </ol>
          </article>

          <article class="policy-card">
            <h3 class="fw-bold"><i class="fa-solid fa-shield-halved me-2"></i><span data-i18n="help_guide3_title">Bələdçi 3: Linkləri təhlükəsiz açmaq</span></h3>
            <ul>
              <li data-i18n="help_guide3_tip1">Paylaşmadan əvvəl hədəf ünvanın kontekstini yoxlayın.</li>
              <li data-i18n="help_guide3_tip2">Aldadıcı yönləndirmə və etiketləmədən istifadə etməyin.</li>
              <li data-i18n="help_guide3_tip3">Xəbərdarlıq görünərsə davam etməzdən əvvəl yoxlayın.</li>
            </ul>
          </article>

          <article class="policy-card">
            <h3 class="fw-bold"><i class="fa-solid fa-circle-question me-2"></i><span data-i18n="help_troubleshoot_title">Problemlərin həlli siyahısı</span></h3>
            <ul>
              <li data-i18n="help_troubleshoot_item1">Linkin vaxtı bitib?</li>
              <li data-i18n="help_troubleshoot_item2">Klik limiti dolub?</li>
              <li data-i18n="help_troubleshoot_item3">Link moderasiya ilə deaktiv edilib?</li>
              <li data-i18n="help_troubleshoot_item4">Hədəf sayt işləyir?</li>
              <li data-i18n="help_troubleshoot_item5">Brauzer/şəbəkə ayarları sorğunu bloklayır?</li>
            </ul>
          </article>

          <article class="policy-card">
            <h3 class="fw-bold"><i class="fa-solid fa-flag me-2"></i><span data-i18n="help_report_title">Şikayət göndərmək</span></h3>
            <p data-i18n="help_report_text">Report axınında qısa link və səbəb qeyd edin və ya /contact səhifəsindən dəstəyə yazın.</p>
          </article>
        </div>

        <div class="policy-back">
          <a href="/" class="btn home-outline-btn rounded-pill" data-i18n="nav_home">Ana Səhifə</a>
        </div>
      </div>
    </section>
  </main>

  <%- include('partials/public-footer', { footerClass: 'site-footer' }) %>

  <script nonce="<%= nonce %>" src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js" integrity="sha384-geWF76RCwLtnZ8qwWowPQNguL3RmwHVBC9FhGdlKrxdiJJigb/j/68SIy3Te4Bkz" crossorigin="anonymous"></script>
  <script nonce="<%= nonce %>" src="/lang.js?v=<%= assetVersion %>"></script>
  <script nonce="<%= nonce %>" src="/script.js?v=<%= assetVersion %>"></script>
</body>

</html>



