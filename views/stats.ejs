<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="csrf-token" content="<%= csrfToken %>">
  <link rel="icon" href="/logo.ico" />
  <title data-i18n="stats_page_title">Link Statistikası</title>
  <link rel="preload" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" as="style" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" media="print" id="bs-css" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap" media="print" id="gf-css" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" media="print" id="fa-css" />
  <script nonce="<%= nonce %>">
    var bs = document.getElementById("bs-css"); if (bs) bs.media = "all";
    var mc = document.getElementById("main-css"); if (mc) mc.media = "all";
    var gf = document.getElementById("gf-css"); if (gf) gf.media = "all";
    document.getElementById("fa-css").media = "all";
  </script>
  <noscript>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
  </noscript>
  
  <link rel="stylesheet" href="/style.css?v=<%= assetVersion %>" media="print" id="main-css" />
  <script nonce="<%= nonce %>" src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
</head>

<body class="home-page app-page stats-page animated-gradient-bg">

  <% if (siteSettings && siteSettings.announcement_enabled === '1' && (siteSettings.announcement_text_az || siteSettings.announcement_text_tr || siteSettings.announcement_text_en)) { %>
    <div id="siteAnnouncement" class="site-announcement" data-az="<%= siteSettings.announcement_text_az || '' %>" data-tr="<%= siteSettings.announcement_text_tr || '' %>" data-en="<%= siteSettings.announcement_text_en || '' %>">
      <div class="container">
        <i class="fa-solid fa-bullhorn"></i>
        <span id="siteAnnouncementText"><%= siteSettings.announcement_text_az || siteSettings.announcement_text_tr || siteSettings.announcement_text_en %></span>
      </div>
    </div>
  <% } %>

  <div id="particlesContainer" class="particles-container"></div>

  <%- include('partials/public-navbar') %>

  <main class="app-main">
    <div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
      <h1 class="m-0">Statistika</h1>
      <a class="btn btn-outline-secondary btn-sm" href="/dashboard"><span data-i18n="stats_back">Geri</span></a>
    </div>

    <div class="card p-3 mb-3">
      <div class="row g-2">
        <div class="col-md-6">
          <div class="small text-muted" data-i18n="stats_shortened">Qısaldılmış</div>
          <div class="fw-bold" id="shortText">-</div>
        </div>
        <div class="col-md-6">
          <div class="small text-muted" data-i18n="stats_original">Orijinal</div>
          <div class="text-break" id="origText">-</div>
        </div>
      </div>
      <hr />
      <div class="d-flex gap-2 flex-wrap">
        <span class="badge text-bg-primary"><span data-i18n="stats_total">Ümumi</span>: <span id="totalClicksValue">0</span></span>
        <span class="badge text-bg-secondary"><span data-i18n="stats_created">Yaradılma</span>: <span id="createdAtValue">-</span></span>
      </div>
      <div class="alert alert-warning mt-3 mb-0 d-none" id="statsHint">
        Bu səhifənin işləməsi üçün backend-də <code>GET /api/stats/:short</code> endpoint-i olmalıdır.
      </div>
      <div class="alert alert-danger mt-3 mb-0 d-none" id="statsMessage"></div>
    </div>

    <div class="card p-3 mb-3">
      <h5 class="mb-3">Gündəlik kliklər</h5>
      <canvas id="clickChart" height="120"></canvas>
    </div>

    <div class="row g-3">
      <div class="col-md-6">
        <div class="card p-3">
          <h5 class="mb-3">Ən çox yönləndirən mənbələr</h5>
          <ul class="list-group" id="refList"></ul>
        </div>
      </div>
      <div class="col-md-6">
        <div class="card p-3">
          <h5 class="mb-3">Ölkə bölgüsü</h5>
          <ul class="list-group" id="countryList"></ul>
        </div>
      </div>
    </div>
    </div>
  </main>

  <script nonce="<%= nonce %>">
    const qs = new URLSearchParams(location.search);
    const short = qs.get("short");

    function liRow(label, value) {
      const li = document.createElement("li");
      li.className = "list-group-item d-flex justify-content-between align-items-center";

      const left = document.createElement("span");
      left.className = "text-truncate";
      left.textContent = String(label ?? "");

      const right = document.createElement("span");
      right.className = "badge text-bg-dark";
      right.textContent = String(value ?? "");

      li.appendChild(left);
      li.appendChild(right);
      return li;
    }

    async function load() {
      const hintEl = document.getElementById("statsHint");
      const messageEl = document.getElementById("statsMessage");
      const showError = (msg) => {
        if (!messageEl) return;
        messageEl.textContent = msg;
        messageEl.classList.remove("d-none");
      };
      if (messageEl) messageEl.classList.add("d-none");
      if (!short) {
        showError("short parametri yoxdur.");
        return;
      }

      try {
        const res = await fetch(`/api/stats/${encodeURIComponent(short)}`, { credentials: "include" });
        const data = await res.json().catch(() => ({}));

        if (!res.ok || data.error) {
          showError(data.error || "Statistika alına bilmədi.");
          return;
        }

        if (hintEl) hintEl.classList.add("d-none");

        const shortFull = `${location.protocol}//${location.host}/${data.short || short}`;
        document.getElementById("shortText").innerText = shortFull;
        document.getElementById("origText").innerText = data.original || "-";
        document.getElementById("totalClicksValue").innerText = data.clicks_total ?? 0;
        document.getElementById("createdAtValue").innerText = data.created_at ? new Date(data.created_at).toLocaleString() : "-";

        const points = Array.isArray(data.clicks_by_day) ? data.clicks_by_day : [];
        const labels = points.map((p) => p.date);
        const values = points.map((p) => p.count);

        new Chart(document.getElementById("clickChart"), {
          type: "line",
          data: { labels, datasets: [{ label: "Klik", data: values, tension: 0.25 }] },
          options: { responsive: true, plugins: { legend: { display: true } } },
        });

        const refList = document.getElementById("refList");
        refList.innerHTML = "";
        (data.top_referrers || []).slice(0, 8).forEach((x) => refList.appendChild(liRow(x.ref || "unknown", x.count || 0)));
        if (!refList.children.length) refList.appendChild(liRow("Məlumat yoxdur", "-"));

        const cList = document.getElementById("countryList");
        cList.innerHTML = "";
        (data.top_countries || []).slice(0, 8).forEach((x) => cList.appendChild(liRow(x.country || "unknown", x.count || 0)));
        if (!cList.children.length) cList.appendChild(liRow("Məlumat yoxdur", "-"));
      } catch (err) {
        showError("Bağlantı xətası: " + err.message);
      }
    }

    load();
  </script>
  <%- include('partials/public-footer', { footerClass: 'site-footer' }) %>
  <script nonce="<%= nonce %>" defer src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script nonce="<%= nonce %>" src="/lang.js?v=<%= assetVersion %>"></script>
  <script nonce="<%= nonce %>" src="/script.js?v=<%= assetVersion %>"></script>

</body>

</html>


